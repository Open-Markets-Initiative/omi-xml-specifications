<OmiItchNasdaqPdf>

  <!-- Nasdaq Options Spread Depth of Market GLIMPSE 2.1 -->

  <Messages>

    <!-- System Event Message -->
    <Message>
      <Name>System Event Message</Name>
      <Dependency>Sequenced Message Type</Dependency>
      <Branch>Sequenced Message</Branch>
      <Code>S</Code>
      <Type>System</Type>
      <Category>Application</Category>
      <Description>The system event message type is used to signal a market or data feed handler event.</Description>
      <Fields>
        <Field>
          <Name>Tracking Number</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Internal system tracking number</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Nanoseconds since midnight.</Description>
        </Field>
        <Field>
          <Name>Event Code</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Refer to System Event Codes below</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Complex Strategy Directory Message -->
    <Message>
      <Name>Complex Strategy Directory Message</Name>
      <Dependency>Sequenced Message Type</Dependency>
      <Branch>Sequenced Message</Branch>
      <Code>s</Code>
      <Type>Administrative</Type>
      <Category>Application</Category>
      <Description>A Complex Strategy Directory Message containing the strategy definition will be sent whenever a complex order is added in the system.</Description>
      <Fields>
        <Field>
          <Name>Tracking Number</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Internal System Tracking Number</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Nanoseconds since midnight</Description>
        </Field>
        <Field>
          <Name>Strategy ID</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Option ID assigned daily. Valid for trading day</Description>
        </Field>
        <Field>
          <Name>Strategy Type</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Strategy Type</Description>
        </Field>
        <Field>
          <Name>Underlying Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>13</Size>
          <Description>Underlying Symbol for the strategy. All legs in this strategy belong to this Underlying</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Alpha</Type>
          <Size>16</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Number of legs</Name>
          <Type>Integer</Type>
          <Size>1</Size>
          <Description>Number of legs in the strategy</Description>
        </Field>
        <Field>
          <Name>Leg Information</Name>
          <Type>group</Type>
          <Size>1</Size>
          <Description>Leg Information</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Strategy Trading Action Message -->
    <Message>
      <Name>Strategy Trading Action Message</Name>
      <Dependency>Sequenced Message Type</Dependency>
      <Branch>Sequenced Message</Branch>
      <Code>H</Code>
      <Type>Administrative</Type>
      <Category>Application</Category>
      <Description>The options system uses this administrative message to indicate the current trading status of a strategy within the options market.</Description>
      <Fields>
        <Field>
          <Name>Tracking Number</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Internal system tracking number</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Nanoseconds since midnight</Description>
        </Field>
        <Field>
          <Name>Strategy ID</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Integer ID of the Strategy, as defined in the Complex Strategy Message.</Description>
        </Field>
        <Field>
          <Name>Current Trading State</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Reflects the current trading state for the strategy in the options market.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Add Order Short Form Message -->
    <Message>
      <Name>Add Order Short Form Message</Name>
      <Dependency>Sequenced Message Type</Dependency>
      <Branch>Sequenced Message</Branch>
      <Code>r</Code>
      <Type>Order</Type>
      <Category>Application</Category>
      <Description>An Add Order Message indicates that a new order has been accepted and was added to the displayable book.</Description>
      <Fields>
        <Field>
          <Name>Tracking Number</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Internal system tracking number</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>The time, expressed as the number of nanoseconds after midnight.</Description>
        </Field>
        <Field>
          <Name>Strategy ID</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Integer ID of the Strategy, as defined in the Complex Strategy Message.</Description>
        </Field>
        <Field>
          <Name>Order Reference Number</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>The unique reference number assigned to the new order. The order reference number is increasing, but not necessarily sequential.</Description>
        </Field>
        <!-- Changed: Side named Depth Side to keep it apart from the leg Side enum -->
        <Field>
          <Name>Depth Side</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Indicates the side of the order. When Side = O or P price can be ignored.</Description>
        </Field>
        <Field>
          <Name>Order Capacity</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Order Capacity</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>The display price of the new order being added to the book. The price will be zero for market orders. Fixed point format with 3 whole number places followed by 2 decimal digits.</Description>
        </Field>
        <Field>
          <Name>Volume</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>The total quantity of the new order being added to the book</Description>
        </Field>
        <Field>
          <Name>Scope</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Scope</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Alpha</Type>
          <Size>3</Size>
          <Description>Reserved for future use</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Add Order Long Form Message -->
    <Message>
      <Name>Add Order Long Form Message</Name>
      <Dependency>Sequenced Message Type</Dependency>
      <Branch>Sequenced Message</Branch>
      <Code>o</Code>
      <Type>Order</Type>
      <Category>Application</Category>
      <Description>An Add Order Message indicates that a new order has been accepted and was added to the displayable book.</Description>
      <Fields>
        <Field>
          <Name>Tracking Number</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Internal system tracking number</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>The time, expressed as the number of nanoseconds after midnight.</Description>
        </Field>
        <Field>
          <Name>Strategy ID</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Integer ID of the Strategy, as defined in the Complex Strategy Message.</Description>
        </Field>
        <Field>
          <Name>Order Reference Number</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>The unique reference number assigned to the new order. The order reference number is increasing, but not necessarily sequential.</Description>
        </Field>
        <!-- Changed: Side named Depth Side to keep it apart from the leg Side enum -->
        <Field>
          <Name>Depth Side</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Indicates the side of the order. When Side = O or P price can be ignored.</Description>
        </Field>
        <Field>
          <Name>Order Capacity</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Order Capacity</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>The display price of the new order being added to the book. The price will be zero for market orders. Fixed point format with 6 whole number places followed by 4 decimal digits.</Description>
        </Field>
        <Field>
          <Name>Volume</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>The total quantity of the new order being added to the book</Description>
        </Field>
        <Field>
          <Name>Scope</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Scope</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Alpha</Type>
          <Size>3</Size>
          <Description>Reserved for future use</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Snapshot Message -->
    <Message>
      <Name>Snapshot Message</Name>
      <Dependency>Sequenced Message Type</Dependency>
      <Branch>Sequenced Message</Branch>
      <Code>M</Code>
      <Type>Snapshot</Type>
      <Category>Application</Category>
      <Description>The Snapshot message reflects the Spread Depth of Market Feed sequence number at the time the GLIMPSE spin was requested.</Description>
      <Fields>
        <!-- Changed: Numeric (ASCII digits) typed Alphanumeric -->
        <Field>
          <Name>Sequence Number</Name>
          <Type>Alphanumeric</Type>
          <Size>20</Size>
          <Description>Spread Depth of Market Feed sequence number when the Glimpse snapshot was taken. To keep the stream current, process the Spread Depth of Market Feed messages beginning with this sequence number.</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Groups>

    <!-- Leg Information -->
    <Group>
      <Name>Leg Information</Name>
      <Dependency>Number of legs</Dependency>
      <Description>Leg Information, legs repeated</Description>
      <Fields>
        <Field>
          <Name>Option ID</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Option ID for this leg, valid for the trading day. The same ID as the corresponding Option in the Options Directory Message. Zero (0) for Stock Leg.</Description>
        </Field>
        <Field>
          <Name>Security Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Denotes the option root symbol (security symbol)</Description>
        </Field>
        <Field>
          <Name>Expiration Year</Name>
          <Type>Integer</Type>
          <Size>1</Size>
          <Description>Last two digits of the year of the option expiration</Description>
        </Field>
        <Field>
          <Name>Expiration Month</Name>
          <Type>Integer</Type>
          <Size>1</Size>
          <Description>Expiration Month of the option (1-12)</Description>
        </Field>
        <Field>
          <Name>Expiration Day</Name>
          <Type>Integer</Type>
          <Size>1</Size>
          <Description>Day of the Month of expiration (1-31)</Description>
        </Field>
        <Field>
          <Name>Explicit Strike Price</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Explicit strike price. Refer to Data Types for field processing notes. Zero (0) for Stock Leg.</Description>
        </Field>
        <Field>
          <Name>Option Type</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Option Type</Description>
        </Field>
        <Field>
          <Name>Side</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Indicates the side of the leg</Description>
        </Field>
        <Field>
          <Name>Leg Ratio</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Leg Ratio</Description>
        </Field>
      </Fields>
    </Group>

  </Groups>

