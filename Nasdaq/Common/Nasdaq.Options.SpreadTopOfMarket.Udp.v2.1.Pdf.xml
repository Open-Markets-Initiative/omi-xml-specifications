          <Name>Timestamp</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Nanoseconds since midnight</Description>
        </Field>
        <Field>
          <Name>Strategy ID</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Integer ID of the strategy, as defined in the Strategy Directory Message.</Description>
        </Field>
        <Field>
          <Name>Quote Condition</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Quote Condition</Description>
        </Field>
        <Field>
          <Name>Bid Market Size</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>The aggregate market size on Bid side.</Description>
        </Field>
        <Field>
          <Name>Bid Price</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Best bid price in fixed point format with 6 whole number places followed by 4 decimal digits</Description>
        </Field>
        <Field>
          <Name>Bid Size</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Aggregated number of contracts on the bid side being displayed in the options market at the current time.</Description>
        </Field>
        <Field>
          <Name>Bid Cust Size</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Customer quantity on the bid side.</Description>
        </Field>
        <Field>
          <Name>Bid ProCust Size</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Customer professional quantity on the bid side.</Description>
        </Field>
        <Field>
          <Name>Bid DNTT Size</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Aggregated Bid DNTT (Do not Trade Through) Limit Size</Description>
        </Field>
        <Field>
          <Name>Bid DNTT Market Size</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>The aggregated DNTT (Do Not Trade Through) Market Size on Bid Size.</Description>
        </Field>
        <Field>
          <Name>Ask Market Size</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Aggregate market quantity on Ask side.</Description>
        </Field>
        <Field>
          <Name>Ask Price</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Best ask price in fixed point format with 6 whole number places followed by 4 decimal digits</Description>
        </Field>
        <Field>
          <Name>Ask Size</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Aggregated number of contracts on the ask side being displayed in the options market at the current time.</Description>
        </Field>
        <Field>
          <Name>Ask Cust Size</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Customer quantity on the ask side.</Description>
        </Field>
        <Field>
          <Name>Ask ProCust Size</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Customer professional quantity on the ask side.</Description>
        </Field>
        <Field>
          <Name>Ask DNTT Size</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Aggregated Ask DNTT (Do not Trade Through) Limit Size</Description>
        </Field>
        <Field>
          <Name>Ask DNTT Market Size</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>The aggregated DNTT (Do Not Trade Through) Market Size on Ask Size.</Description>
        </Field>
      </Fields>
    </Message>

