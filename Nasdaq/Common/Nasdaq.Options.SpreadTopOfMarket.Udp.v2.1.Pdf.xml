          <Name>Current Trading State</Name>
          <Type>Alphabetic</Type>
          <Size>1</Size>
          <Description>Current Trading State</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Strategy Best Bid And Ask Update Message -->
    <Message>
      <Name>Strategy Best Bid And Ask Update Message</Name>
      <Dependency>Message Type</Dependency>
      <Code>E</Code>
      <Type>Quote</Type>
      <Category>Application</Category>
      <Description>The options system will continuously calculate its best bid and ask position for active strategies on the options market during the trading day.</Description>
      <Fields>
        <Field>
          <Name>Tracking Number</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Internal system tracking number</Description>
        </Field>
