    <!-- Derivative Directory Message -->
    <Message>
      <Name>Derivative Directory Message</Name>
      <Dependency>Sequenced Message Type</Dependency>
      <Branch>Sequenced Message</Branch>
      <Code>m</Code>
      <Type>Administrative</Type>
      <Category>Application</Category>
      <Description>Derivative Directory Message for active options symbols.</Description>
      <Fields>
        <Field>
          <Name>Tracking Number</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Internal System tracking number</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>The time, expressed as the number of nanoseconds after midnight.</Description>
        </Field>
        <Field>
          <Name>Instrument ID</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Integer ID of the option, as defined in the Options Directory Message.</Description>
        </Field>
        <Field>
          <Name>Security Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Denotes the option root symbol (security symbol)</Description>
        </Field>
        <Field>
          <Name>Expiration Year</Name>
          <Type>Integer</Type>
          <Size>1</Size>
          <Description>Last two digits of the year of the option expiration</Description>
        </Field>
        <Field>
          <Name>Expiration Month</Name>
          <Type>Integer</Type>
          <Size>1</Size>
          <Description>Expiration Month of the option (1-12)</Description>
        </Field>
        <Field>
          <Name>Expiration Day</Name>
          <Type>Integer</Type>
          <Size>1</Size>
          <Description>Day of the Month of expiration (1-31)</Description>
        </Field>
        <Field>
          <Name>Explicit Strike Price</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Explicit strike price. Refer to Data Types for field processing notes.</Description>
        </Field>
        <Field>
          <Name>Option Type</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Option Type</Description>
        </Field>
        <Field>
          <Name>Underlying Symbol</Name>
          <Type>Alpha</Type>
          <Size>13</Size>
          <Description>Denotes the unique symbol assigned to the underlying security within the Exchange System.</Description>
        </Field>
        <Field>
          <Name>Closing Type</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Closing Type</Description>
        </Field>
        <Field>
          <Name>Tradable</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Tradable</Description>
        </Field>
        <Field>
          <Name>MPV</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Minimum Price Variation</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Alpha</Type>
          <Size>16</Size>
          <Description>Reserved for future use.</Description>
        </Field>
      </Fields>
    </Message>

