        <Field>
          <Tag>21</Tag>
          <Name>HandlInst</Name>
          <Required>Y</Required>
          <Type>Char</Type>
          <Description>Always 1 (Automated execution).</Description>
        </Field>
        <Field>
          <Tag>55</Tag>
          <Name>Symbol</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>Ticker symbol in native INET symbology (root and suffix included).</Description>
        </Field>
        <Field>
          <Tag>54</Tag>
          <Name>Side</Name>
          <Required>Y</Required>
          <Type>Char</Type>
          <Description>Side of order.</Description>
        </Field>
        <Field>
          <Tag>38</Tag>
