  <!-- TRF Trades FilterView (NLS 2.0), August 2, 2013 edition -->

  <Messages>

    <!-- System Event Message -->
    <Message>
      <Name>System Event Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>S</Code>
      <Category>Technical</Category>
      <Description>System Event Messages is used to signal key market or data feed control events.</Description>
      <Fields>
        <Field>
          <Name>Event Code</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Denotes the NLS type of system event for which the message is being generated.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trade Report Message -->
    <Message>
      <Name>Trade Report Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>T</Code>
      <Category>Trade</Category>
      <Description>The following message is used to relay NASDAQ execution system and TRF trade transactions that are reported for the current business day. Please note that NASDAQ only reports one-side of a trade execution on the NASDAQ Last Sale (NLS) feed and other data feed products.</Description>
      <Fields>
        <Field>
          <Name>Market Center Identifier</Name>
          <Type>Alphabetic</Type>
          <Size>1</Size>
          <Description>Denotes the NASDAQ market system that generated the trade report message.</Description>
        </Field>
        <Field>
          <Name>Issue Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Denotes the NASDAQ-assigned issue symbol of the security for which the trade report is being generated.</Description>
        </Field>
        <Field>
          <Name>Security Class</Name>
          <Type>Alphabetic</Type>
          <Size>1</Size>
          <Description>Indicates the primary listing market for the issue.</Description>
        </Field>
        <Field>
          <Name>Trade Control Number</Name>
          <Type>Alphanumeric</Type>
          <Size>10</Size>
          <Description>Indicates the source's internal control number associated with the given trade transaction.</Description>
        </Field>
        <Field>
          <Name>Trade Price</Name>
          <Type>Numeric</Type>
          <Size>10</Size>
          <Format>$$$$$$dddd</Format>
          <Description>Denotes the report price on the trade transaction. Price format is $$$$$$dddd.</Description>
        </Field>
        <Field>
          <Name>Trade Size</Name>
          <Type>Numeric</Type>
          <Size>9</Size>
          <Description>Indicates the reported number of shares on the trade transaction.</Description>
        </Field>
        <Field>
          <Name>Sale Condition Modifier</Name>
          <Type>struct</Type>
          <Size>4</Size>
          <Description>Sale condition modifier consists of four levels.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trade Cancel Error Message -->
    <Message>
      <Name>Trade Cancel Error Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>X</Code>
      <Category>Trade</Category>
      <Description>The following message is used in the event that a NASDAQ or TRF trade transaction is cancelled on the same business day that it is reported.</Description>
      <Fields>
        <Field>
          <Name>Market Center Identifier</Name>
          <Type>Alphabetic</Type>
          <Size>1</Size>
          <Description>Denotes the NASDAQ market system that generated the trade report and cancel/error message.</Description>
        </Field>
        <Field>
          <Name>Issue Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Denotes the NASDAQ-assigned issue symbol of the security for which the trade report is being generated.</Description>
        </Field>
        <Field>
          <Name>Security Class</Name>
          <Type>Alphabetic</Type>
          <Size>1</Size>
          <Description>Indicates the primary listing market for the issue.</Description>
        </Field>
        <Field>
          <Name>Original Trade Control Number</Name>
          <Type>Alphanumeric</Type>
          <Size>10</Size>
          <Description>Indicates the source's internal control number associated with the given trade transaction.</Description>
        </Field>
        <Field>
          <Name>Original Trade Price</Name>
          <Type>Numeric</Type>
          <Size>10</Size>
          <Format>$$$$$$dddd</Format>
          <Description>Reported price for the transaction. Price format is $$$$$$dddd.</Description>
        </Field>
        <Field>
          <Name>Original Trade Size</Name>
          <Type>Numeric</Type>
          <Size>9</Size>
          <Description>Reported number of shares for transaction.</Description>
        </Field>
        <Field>
          <Name>Original Sale Condition Modifier</Name>
          <Type>struct</Type>
          <Size>4</Size>
          <Description>Defines the sale condition modifiers as reported on the original trade transaction.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trade Correction Message -->
    <Message>
      <Name>Trade Correction Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>C</Code>
      <Category>Trade</Category>
      <Description>The following message is used in the event that a TRF trade transaction is corrected on the same business day that it is reported.</Description>
      <Fields>
        <Field>
          <Name>Market Center Identifier</Name>
          <Type>Alphabetic</Type>
          <Size>1</Size>
          <Description>Denotes the NASDAQ market system that generated the trade report and cancel/error message.</Description>
        </Field>
        <Field>
          <Name>Issue Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Denotes the NASDAQ-assigned issue symbol of the security for which the trade correction message is being generated.</Description>
        </Field>
        <Field>
          <Name>Security Class</Name>
          <Type>Alphabetic</Type>
          <Size>1</Size>
          <Description>Indicates the primary listing market for the issue.</Description>
        </Field>
        <Field>
          <Name>Original Trade Control Number</Name>
          <Type>Alphanumeric</Type>
          <Size>10</Size>
          <Description>Indicates the source's internal control number associated with the given trade transaction.</Description>
        </Field>
        <Field>
          <Name>Original Trade Price</Name>
          <Type>Numeric</Type>
          <Size>10</Size>
          <Format>$$$$$$dddd</Format>
          <Description>Reported price on the original trade transaction. Price format is $$$$$$dddd.</Description>
        </Field>
        <Field>
          <Name>Original Trade Size</Name>
          <Type>Numeric</Type>
          <Size>9</Size>
          <Description>Reported number of shares on the original trade transaction.</Description>
        </Field>
        <Field>
          <Name>Original Sale Condition Modifier</Name>
          <Type>struct</Type>
          <Size>4</Size>
          <Description>Indicates sale condition modifiers associated with the original transaction.</Description>
        </Field>
        <Field>
          <Name>Corrected Trade Control Number</Name>
          <Type>Alphanumeric</Type>
          <Size>10</Size>
          <Description>Indicates the NASDAQ internal control number associated with the adjusted trade transaction.</Description>
        </Field>
        <Field>
          <Name>Corrected Trade Price</Name>
          <Type>Numeric</Type>
          <Size>10</Size>
          <Format>$$$$$$dddd</Format>
          <Description>Indicates the price for the corrected trade transaction. Price format is $$$$$$dddd.</Description>
        </Field>
        <Field>
          <Name>Corrected Trade Size</Name>
          <Type>Numeric</Type>
          <Size>9</Size>
          <Description>Indicates the number of shares for the corrected trade transaction.</Description>
        </Field>
        <Field>
          <Name>Corrected Sale Condition Modifier</Name>
          <Type>struct</Type>
          <Size>4</Size>
          <Description>Denotes the sale condition modifiers associated with the corrected trade transaction.</Description>
        </Field>
      </Fields>
    </Message>

