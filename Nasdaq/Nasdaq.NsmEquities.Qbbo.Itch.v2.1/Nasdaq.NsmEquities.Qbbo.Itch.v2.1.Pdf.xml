    <!-- BBO Quotation Message -->
    <Message>
      <Name>BBO Quotation Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>Q</Code>
      <Category>Market</Category>
      <Description>BBO products will broadcast a real-time update every time that the exchange's best bid and offer quote is updated during the trading day.</Description>
      <Fields>
        <Field>
          <Name>Tracking Number</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Nasdaq internal tracking number</Description>
        </Field>
        <Field>
          <Name>Time Stamp</Name>
          <Type>Timestamp</Type>
          <Size>6</Size>
          <Description>Timestamp</Description>
        </Field>
        <Field>
          <Name>Stock</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Denotes the security symbol for the issue in the execution system.</Description>
        </Field>
        <Field>
          <Name>Security Class</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Indicates the primary listing market for the stock.</Description>
        </Field>
        <Field>
          <Name>Best Bid Price</Name>
          <Type>Price (4)</Type>
          <Size>4</Size>
          <Description>Denotes the best bid price, or the highest price for market buy order(s) in the execution system.</Description>
        </Field>
        <Field>
          <Name>Best Bid Size</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Denotes the aggregated number of shares available for display within the execution system at the best bid price.</Description>
        </Field>
        <Field>
          <Name>Best Offer Price</Name>
          <Type>Price (4)</Type>
          <Size>4</Size>
          <Description>Denotes the Nasdaq exchange's best offer price, or the lowest price for market sell order(s) in the execution system.</Description>
        </Field>
        <Field>
          <Name>Best Offer Size</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Denotes the aggregated number of shares available for display within the execution system at the best offer price.</Description>
        </Field>
      </Fields>
    </Message>

