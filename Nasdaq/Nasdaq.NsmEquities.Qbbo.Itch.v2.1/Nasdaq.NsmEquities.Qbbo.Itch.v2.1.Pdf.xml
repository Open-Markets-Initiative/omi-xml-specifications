    <!-- IPO Quoting Period Update Message -->
    <Message>
      <Name>IPO Quoting Period Update Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>K</Code>
      <Category>Administrative</Category>
      <Description>Indicates the anticipated IPO quotation release time of a security.</Description>
      <Fields>
        <Field>
          <Name>Tracking</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Nasdaq internal tracking number</Description>
        </Field>
        <Field>
          <Name>Time Stamp</Name>
          <Type>Timestamp</Type>
          <Size>6</Size>
          <Description>Time at which the IPO message was generated</Description>
        </Field>
        <Field>
          <Name>Stock</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Denotes the security symbol for the issue in the Nasdaq execution system.</Description>
        </Field>
        <Field>
          <Name>IPO Quotation Release Time</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Denotes the IPO release time, in seconds since midnight, for quotation to the nearest second.</Description>
        </Field>
        <Field>
          <Name>IPO Quotation Release Qualifier</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Denotes the IPO release qualifier</Description>
        </Field>
        <Field>
          <Name>IPO Price</Name>
          <Type>Price (4)</Type>
          <Size>4</Size>
          <Description>Denotes the IPO price to be used for intraday net change calculations.</Description>
        </Field>
      </Fields>
    </Message>

