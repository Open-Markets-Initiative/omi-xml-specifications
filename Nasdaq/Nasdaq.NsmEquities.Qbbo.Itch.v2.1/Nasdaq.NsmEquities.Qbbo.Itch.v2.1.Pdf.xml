<OmiItchNasdaqEquitiesPdf>

  <Messages>

    <!-- System Event Message -->
    <Message>
      <Name>System Event Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>S</Code>
      <Category>Technical</Category>
      <Description>The System Event message is used to signal key market or data feed control events.</Description>
      <Fields>
        <Field>
          <Name>Tracking Number</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Nasdaq internal tracking number</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Type>Timestamp</Type>
          <Size>6</Size>
          <Description>Time stamp</Description>
        </Field>
        <Field>
          <Name>Event Code</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Denotes the type of event for which the message is being generated.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Stock Directory Message -->
    <Message>
      <Name>Stock Directory Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>R</Code>
      <Category>Administrative</Category>
      <Description>At the start of each trading day, Nasdaq disseminates stock directory messages for all active symbols in its market center system.</Description>
      <Fields>
        <Field>
          <Name>Tracking Number</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Nasdaq Internal Tracking Number</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Type>Timestamp</Type>
          <Size>6</Size>
          <Description>Time at which the directory message was generated. Refer to Data Types for field processing notes.</Description>
        </Field>
        <Field>
          <Name>Stock</Name>
          <Type>Alpha</Type>
          <Size>8</Size>
          <Description>Denotes the security symbol for the issue in the execution system.</Description>
        </Field>
        <Field>
          <Name>Market Category</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Indicates Listing market or listing market tier for the issue</Description>
        </Field>
        <Field>
          <Name>Financial Status Indicator</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>For Nasdaq-listed issues, this field indicates when a firm is not in compliance with Nasdaq continued listing requirements.</Description>
        </Field>
        <Field>
          <Name>Round Lot Size</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Indicates the number of shares that represent a round lot for the issue</Description>
        </Field>
        <Field>
          <Name>Round Lots Only</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Indicates if Nasdaq system limits order entry for issue</Description>
        </Field>
        <Field>
          <Name>Issue Classification</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Identifies the security class for the issue as assigned by Nasdaq. See Appendix for allowable values.</Description>
        </Field>
        <Field>
          <Name>Issue Sub-type</Name>
          <Type>Alpha</Type>
          <Size>2</Size>
          <Description>Identifies the security sub-type for the issue as assigned by Nasdaq. See Appendix for allowable values.</Description>
        </Field>
        <Field>
          <Name>Authenticity</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Denotes if an issue or quoting participant record is set-up in Nasdaq systems in a live/production, test, or demo state.</Description>
        </Field>
        <Field>
          <Name>Short Sale Threshold Indicator</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Indicates if a security is subject to mandatory close-out of short sales under SEC Rule 203(b)(3).</Description>
        </Field>
        <Field>
          <Name>IPO Flag</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Indicates if the Nasdaq security is set up for IPO release.</Description>
        </Field>
        <Field>
          <Name>LULD Reference Price Tier</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Indicates which Limit Up / Limit Down price band calculation parameter is to be used for the instrument.</Description>
        </Field>
        <Field>
          <Name>ETP Flag</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Indicates whether the security is an exchange traded product (ETP).</Description>
        </Field>
        <Field>
          <Name>ETP Leverage Factor</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Tracks the integral relationship of the ETP to the underlying index.</Description>
        </Field>
        <Field>
          <Name>Inverse Indicator</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Indicates the directional relationship between the ETP and underlying index.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Stock Trading Action Message -->
    <Message>
      <Name>Stock Trading Action Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>H</Code>
      <Category>Administrative</Category>
      <Description>Nasdaq uses this administrative message to indicate the current trading status of a security to the trading community.</Description>
      <Fields>
        <Field>
          <Name>Tracking Number</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Nasdaq internal tracking number</Description>
        </Field>
        <Field>
          <Name>Time Stamp</Name>
          <Type>Timestamp</Type>
          <Size>6</Size>
          <Description>Timestamp</Description>
        </Field>
        <Field>
          <Name>Stock</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Nasdaq-assigned indicator for issue for which the stock trading action message is being generated.</Description>
        </Field>
        <Field>
          <Name>Security Class</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Indicates the primary listing market for the issue.</Description>
        </Field>
        <Field>
          <Name>Current Trading State</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Reflects the current trading state for the issue.</Description>
        </Field>
        <Field>
          <Name>Reason</Name>
          <Type>Alphanumeric</Type>
          <Size>4</Size>
          <Description>Reflects the Market Ops or MarketWatch code for the trading state change.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Reg SHO Restriction Message -->
    <Message>
      <Name>Reg SHO Restriction Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>Y</Code>
      <Category>Administrative</Category>
      <Description>Nasdaq introduced the Reg SHO Short Sale Price Test Restricted Indicator message format.</Description>
      <Fields>
        <Field>
          <Name>Tracking Number</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Nasdaq internal tracking number</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Type>Timestamp</Type>
          <Size>6</Size>
          <Description>Time at which the market participant position message was generated</Description>
        </Field>
        <Field>
          <Name>Stock</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Stock symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Reg SHO Action</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Denotes the Reg SHO Short Sale Price Test Restriction status for the issue at the time of the message dissemination.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- MWCB Decline Level Message -->
    <Message>
      <Name>MWCB Decline Level Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>V</Code>
      <Category>Administrative</Category>
      <Description>Informs data recipients what the daily MWCB breach points are set to for the current trading day.</Description>
      <Fields>
        <Field>
          <Name>Tracking Number</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Nasdaq internal tracking number</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Type>Timestamp</Type>
          <Size>6</Size>
          <Description>Time at which the MWCB Decline Level message was generated</Description>
        </Field>
        <Field>
          <Name>Level 1</Name>
          <Type>Price (8)</Type>
          <Size>8</Size>
          <Description>Denotes the MWCB Level 1 Value.</Description>
        </Field>
        <Field>
          <Name>Level 2</Name>
          <Type>Price (8)</Type>
          <Size>8</Size>
          <Description>Denotes the MWCB Level 2 Value.</Description>
        </Field>
        <Field>
          <Name>Level 3</Name>
          <Type>Price (8)</Type>
          <Size>8</Size>
          <Description>Denotes the MWCB Level 3 Value.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- MWCB Breach Message -->
    <Message>
      <Name>MWCB Breach Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>W</Code>
      <Category>Administrative</Category>
      <Description>Informs data recipients when a MWCB has breached one of the established levels</Description>
      <Fields>
        <Field>
          <Name>Tracking Number</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Nasdaq internal tracking number</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Type>Timestamp</Type>
          <Size>6</Size>
          <Description>Time at which the MWCB Breaker Status message was generated</Description>
        </Field>
        <Field>
          <Name>Breached Level</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Denotes the MWCB Level that was breached.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Operational Halt Message -->
    <Message>
      <Name>Operational Halt Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>h</Code>
      <Category>Administrative</Category>
      <Description>The Exchange uses this message to indicate the current Operational Status of a security to the trading community.</Description>
      <Fields>
        <Field>
          <Name>Tracking Number</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Nasdaq internal tracking number</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Type>Integer</Type>
          <Size>6</Size>
          <Description>Time at which the Operational Halt message was generated. Refer to Data Types for field processing notes.</Description>
        </Field>
        <Field>
          <Name>Stock</Name>
          <Type>Alpha</Type>
          <Size>8</Size>
          <Description>Denotes the security symbol for the issue in the execution system</Description>
        </Field>
