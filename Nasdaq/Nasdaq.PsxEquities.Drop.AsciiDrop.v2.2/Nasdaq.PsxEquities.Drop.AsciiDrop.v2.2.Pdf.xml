<OmiItchNasdaqEquitiesPdf>

  <!-- Nasdaq PSX DROP 2.20 -->

  <Messages>

    <!-- Changed: the single Trade Message Line format is split into one message per Type value, all with the same fields; the shared Match / Time in Force and Liquidity Code / Cancel Reason fields are named for what each message carries -->

    <!-- New Order Accepted Message -->

    <Message>
      <Name>New Order Accepted Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Sequenced Message</Branch>
      <Code>A</Code>
      <Origin>Exchange</Origin>
      <Description>New order accepted.</Description>
      <Fields>
        <Field>
          <Name>Comma</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Field separator.</Description>
        </Field>
        <Field>
          <Name>Source</Name>
          <Type>Alphanumeric</Type>
          <Size>6</Size>
          <Description>The source of the order. Typically the account of the OUCH port used to enter the order, but can also have the special value "$PHON " for orders received via the phone desk.</Description>
        </Field>
        <Field>
          <Name>Comma</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Field separator.</Description>
        </Field>
        <Field>
          <Name>User</Name>
          <Type>Alphanumeric</Type>
          <Size>4</Size>
          <Description>The free form User field as specified by the order entry firm when the order was entered.</Description>
        </Field>
        <Field>
          <Name>Comma</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Field separator.</Description>
        </Field>
        <Field>
          <Name>Token</Name>
          <Type>Alphanumeric</Type>
          <Size>10</Size>
          <Description>The free form Token field as specified by the order entry firm when the order was entered.</Description>
        </Field>
        <Field>
          <Name>Comma</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Field separator.</Description>
        </Field>
        <Field>
          <Name>Replaced Token</Name>
          <Type>Alphanumeric</Type>
          <Size>10</Size>
          <Description>The free form Token field as specified by the order entry firm when the order was entered. Only used on a replaced message.</Description>
        </Field>
        <Field>
          <Name>Comma</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Field separator.</Description>
        </Field>
        <Field>
          <Name>Buy Sell</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>The side of the trade executed.</Description>
        </Field>
        <Field>
          <Name>Comma</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Field separator.</Description>
        </Field>
        <Field>
          <Name>Shares</Name>
          <Type>Numeric</Type>
          <Size>6</Size>
          <Description>For a new order accept, the total number of shares entered; for a cancel, the incremental number of shares canceled; for an execution, the incremental number of shares executed in this trade; for a broken execution, the number of shares in the previously transmitted execution.</Description>
        </Field>
        <Field>
          <Name>Comma</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Field separator.</Description>
        </Field>
        <Field>
          <Name>Stock</Name>
          <Type>Alpha</Type>
          <Size>8</Size>
          <Description>The stock symbol.</Description>
        </Field>
        <Field>
          <Name>Comma</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Field separator.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Numeric</Type>
          <Size>11</Size>
          <Description>For a new order accepted, the limit price of the order; for an execution, the execution price; for a cancel, the limit price of the open order.</Description>
        </Field>
        <Field>
          <Name>Comma</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Field separator.</Description>
        </Field>
        <Field>
          <Name>Firm</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>The order entry firm.</Description>
        </Field>
        <Field>
          <Name>Comma</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Field separator.</Description>
        </Field>
        <Field>
          <Name>Reference</Name>
          <Type>Numeric</Type>
          <Size>12</Size>
          <Description>The order unique reference number assigned by Nasdaq to this order.</Description>
        </Field>
        <Field>
          <Name>Comma</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Field separator.</Description>
        </Field>
        <Field>
          <Name>Match Number</Name>
          <Type>Numeric</Type>
          <Size>12</Size>
          <Description>The match number assigned by Nasdaq to this trade. Each match consists of an execution between a buy order and a sell order.</Description>
        </Field>
        <Field>
          <Name>Comma</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Field separator.</Description>
        </Field>
        <Field>
          <Name>Capacity</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>The capacity as specified by the order entry firm.</Description>
        </Field>
        <Field>
          <Name>Comma</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Field separator.</Description>
        </Field>
        <Field>
          <Name>Liquidity Code</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>For execution messages, the liquidity code value.</Description>
        </Field>
        <Field>
          <Name>Comma</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Field separator.</Description>
        </Field>
        <Field>
          <Name>Clearing Code</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>The clearing path this trade will take.</Description>
        </Field>
      </Fields>
    </Message>

