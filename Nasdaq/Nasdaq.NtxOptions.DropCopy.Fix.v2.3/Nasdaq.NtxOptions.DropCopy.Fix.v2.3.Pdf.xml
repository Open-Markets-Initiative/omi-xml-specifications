<OmiFixPdf>

  <!-- Nasdaq Texas Options (formerly BX Options) FIX DROP v2.3f -->

  <Header>
    <Fields>
      <Field>
        <Tag>8</Tag>
        <Name>BeginString</Name>
        <Required>Y</Required>
        <Type>String</Type>
        <Fixed>Y</Fixed>
        <Description>FIX.4.2. Must be the first field in message.</Description>
      </Field>
      <Field>
        <Tag>9</Tag>
        <Name>BodyLength</Name>
        <Required>Y</Required>
        <Type>Length</Type>
        <Fixed>Y</Fixed>
        <Description>Must be second field in the message.</Description>
      </Field>
      <Field>
        <Tag>35</Tag>
        <Name>MsgType</Name>
        <Required>Y</Required>
        <Type>String</Type>
        <Fixed>Y</Fixed>
        <Description>Must be the third field in the message.</Description>
      </Field>
      <Field>
        <Tag>34</Tag>
        <Name>MsgSeqNum</Name>
        <Required>Y</Required>
        <Type>SeqNum</Type>
        <Description>Message sequence number.</Description>
      </Field>
      <Field>
        <Tag>49</Tag>
        <Name>SenderCompID</Name>
        <Required>Y</Required>
        <Type>String</Type>
        <Description>SenderCompID as assigned by NASDAQ. The maximum size is 4 to 6 characters.</Description>
      </Field>
      <Field>
        <Tag>56</Tag>
        <Name>TargetCompID</Name>
        <Required>Y</Required>
        <Type>String</Type>
        <Description>TargetCompID as assigned by NASDAQ. The maximum size is 4 to 6 characters.</Description>
      </Field>
      <Field>
        <Tag>52</Tag>
        <Name>SendingTime</Name>
        <Required>Y</Required>
        <Type>UTCTimestamp</Type>
        <Description>Required by FIX but not validated by NASDAQ.</Description>
      </Field>
      <Field>
        <Tag>50</Tag>
        <Name>SenderSubID</Name>
        <Required>N</Required>
        <Type>String</Type>
        <Description>Ignored. When sending execution report NASDAQ will send INET in this field.</Description>
      </Field>
      <Field>
        <Tag>57</Tag>
        <Name>TargetSubID</Name>
        <Required>N</Required>
        <Type>String</Type>
        <Description>Ignored. When sending execution report NASDAQ will duplicate first 4 characters of Client Order Id in this field.</Description>
      </Field>
      <Field>
        <Tag>43</Tag>
        <Name>PossDupFlag</Name>
        <Required>N</Required>
        <Type>Boolean</Type>
        <Description>Should be present on retransmitted messages, whether prompted by the sending system or as the result of a resend request.</Description>
      </Field>
      <Field>
        <Tag>97</Tag>
        <Name>PossResend</Name>
        <Required>N</Required>
        <Type>Boolean</Type>
        <Description>Required when message may be duplicate of another message sent under a different sequence number.</Description>
      </Field>
      <Field>
        <Tag>122</Tag>
        <Name>OrigSendingTime</Name>
        <Required>N</Required>
        <Type>UTCTimestamp</Type>
        <Description>Required for message resends but not validated by NASDAQ.</Description>
      </Field>
    </Fields>
  </Header>

  <Trailer>
    <Fields>
      <Field>
        <Tag>10</Tag>
        <Name>CheckSum</Name>
        <Required>Y</Required>
        <Type>String</Type>
        <Fixed>Y</Fixed>
        <Description>Modulo 256 checksum of all characters in message up to and including the delimiter preceding the CheckSum field. Three digits with leading zeroes if necessary.</Description>
      </Field>
    </Fields>
  </Trailer>

  <!-- Changed: Required C (conditional) is transcribed N, with the condition in the description -->

  <Messages>

    <!-- Heartbeat (0) -->
    <!-- Added: the session messages (Heartbeat to Logon) carry the standard FIX 4.2 fields (section 2) -->
    <Message>
      <Name>Heartbeat</Name>
      <MsgType>0</MsgType>
      <Category>admin</Category>
      <Origin>Client,Exchange</Origin>
      <Description>Standard FIX 4.2 session message. Sent when the agreed HeartbeatInterval has elapsed since the last message sent, and in reply to a Test Request.</Description>
      <Fields>
        <Field>
          <Tag>112</Tag>
          <Name>TestReqID</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Required when the heartbeat is the result of a Test Request message. FIX 4.2 standard field.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- TestRequest (1) -->
    <Message>
      <Name>TestRequest</Name>
      <MsgType>1</MsgType>
      <Category>admin</Category>
      <Origin>Client,Exchange</Origin>
      <Description>Standard FIX 4.2 session message.</Description>
      <Fields>
        <Field>
          <Tag>112</Tag>
          <Name>TestReqID</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>Identifier included in the Test Request message to be returned in the resulting Heartbeat. FIX 4.2 standard field.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- ResendRequest (2) -->
    <Message>
      <Name>ResendRequest</Name>
      <MsgType>2</MsgType>
      <Category>admin</Category>
      <Origin>Client,Exchange</Origin>
      <Description>Standard FIX 4.2 session message. Open (EndSeqNo 0) and closed sequence ranges are honored.</Description>
      <Fields>
        <Field>
          <Tag>7</Tag>
          <Name>BeginSeqNo</Name>
          <Required>Y</Required>
          <Type>SeqNum</Type>
          <Description>Message sequence number of first message in range to be resent. FIX 4.2 standard field.</Description>
        </Field>
        <Field>
          <Tag>16</Tag>
          <Name>EndSeqNo</Name>
          <Required>Y</Required>
          <Type>SeqNum</Type>
          <Description>Message sequence number of last message in range to be resent; 0 for infinity. FIX 4.2 standard field.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Reject (3) -->
    <Message>
      <Name>Reject</Name>
      <MsgType>3</MsgType>
      <Category>admin</Category>
      <Origin>Client,Exchange</Origin>
      <Description>Standard FIX 4.2 session message. Session level rejects indicate violations of the session protocol or missing (or invalid) fields.</Description>
      <Fields>
        <Field>
          <Tag>45</Tag>
          <Name>RefSeqNum</Name>
          <Required>Y</Required>
          <Type>SeqNum</Type>
          <Description>MsgSeqNum of rejected message. FIX 4.2 standard field.</Description>
        </Field>
        <Field>
          <Tag>371</Tag>
          <Name>RefTagID</Name>
          <Required>N</Required>
          <Type>Int</Type>
          <Description>The tag number of the FIX field being referenced. FIX 4.2 standard field.</Description>
        </Field>
        <Field>
          <Tag>372</Tag>
          <Name>RefMsgType</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>The MsgType of the FIX message being referenced. FIX 4.2 standard field.</Description>
        </Field>
        <Field>
          <Tag>373</Tag>
          <Name>SessionRejectReason</Name>
          <Required>N</Required>
          <Type>Int</Type>
          <Description>Code to identify reason for a session-level Reject message. FIX 4.2 standard field.</Description>
        </Field>
        <Field>
          <Tag>58</Tag>
          <Name>Text</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Where possible, message to explain reason for rejection. FIX 4.2 standard field.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- SequenceReset (4) -->
    <Message>
      <Name>SequenceReset</Name>
      <MsgType>4</MsgType>
      <Category>admin</Category>
      <Origin>Client,Exchange</Origin>
      <Description>Standard FIX 4.2 session message. Gap Fill (GapFillFlag = Y) messages follow standard sequencing; Reset (GapFillFlag not Y) is used only as a last resort, by human intervention.</Description>
      <Fields>
        <Field>
          <Tag>123</Tag>
          <Name>GapFillFlag</Name>
          <Required>N</Required>
          <Type>Boolean</Type>
          <Description>Indicates that the Sequence Reset message is replacing administrative or application messages which will not be resent. FIX 4.2 standard field.</Description>
        </Field>
        <Field>
          <Tag>36</Tag>
          <Name>NewSeqNo</Name>
          <Required>Y</Required>
          <Type>SeqNum</Type>
          <Description>New sequence number. FIX 4.2 standard field.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Logout (5) -->
    <Message>
      <Name>Logout</Name>
      <MsgType>5</MsgType>
      <Category>admin</Category>
      <Origin>Client,Exchange</Origin>
      <Description>Standard FIX 4.2 session message. Either side may issue a Logout to gracefully close the session.</Description>
      <Fields>
        <Field>
          <Tag>58</Tag>
          <Name>Text</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Free format text. FIX 4.2 standard field.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Logon (A) -->
    <Message>
      <Name>Logon</Name>
      <MsgType>A</MsgType>
      <Category>admin</Category>
      <Origin>Client,Exchange</Origin>
      <Description>The Logon must be the first message sent by the subscriber after the TCP connection is established. The IP Address of the subscriber, the SenderCompId and TargetCompId will be validated; if validation fails the connection will be dropped. After an unexpected disconnect, a Logon Acknowledgement with a sequence number greater than expected means in-flight messages were missed and should be recovered with a Resend Request.</Description>
      <Fields>
        <Field>
          <Tag>98</Tag>
          <Name>EncryptMethod</Name>
          <Required>Y</Required>
          <Type>Int</Type>
          <Description>FIX 4.2 standard required field. Ignored: FIX level encryption is not supported.</Description>
        </Field>
        <Field>
          <Tag>108</Tag>
          <Name>HeartBtInt</Name>
          <Required>Y</Required>
          <Type>Int</Type>
          <Description>HeartbeatInterval must be specified by the subscriber in whole seconds; the accepted value is returned on the Logon Acknowledgement. A value as low as possible is recommended so disconnects are detected sooner.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- ExecutionReport (8) -->
    <Message>
      <Name>ExecutionReport</Name>
      <MsgType>8</MsgType>
      <Category>app</Category>
      <Origin>Exchange</Origin>
      <Description>Relays order receipt, changes to an existing order (accepted cancel and replace requests), order status information and fill information on working orders. Each execution message describes the current state of the order and execution status as understood by NASDAQ; state changes are sent as separate messages and are not used to also convey new partial fill details. Manual trades omit order related tags (ClOrdID, QuoteID, Price, OrdType, TimeInForce) and OrdStatus, report ExecType 2 and ExecTransType 0 with OrderQty, LeavesQty, CumQty and AvgPx 0. Trade cancellations report ExecTransType 1 with ExecRefID; successful post trade allocations or corrections report a trade cancel followed by a new trade, both with ExecRefID.</Description>
      <Fields>
        <Field>
          <Tag>37</Tag>
          <Name>OrderID</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>OrderID, as assigned by NASDAQ, is required to be unique for each chain of orders for a given day</Description>
        </Field>
        <!-- Changed: FIX 4.2 name AllocID (printed AllocId) -->
        <Field>
          <Tag>70</Tag>
          <Name>AllocID</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Named AllocId in the document. Unique identifier of transaction that caused the execution. Will be 0 if not available</Description>
        </Field>
        <Field>
          <Tag>17</Tag>
          <Name>ExecID</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>Unique Identifier of execution message. In case where the execTransType is either 1 (Partial Fill) or 2 (Filled), this identifier is match number of actual execution</Description>
        </Field>
        <Field>
          <Tag>20</Tag>
          <Name>ExecTransType</Name>
          <Required>Y</Required>
          <Type>Char</Type>
          <Description>Identifies transaction type: 0 = New, 1 = Cancel. Trade breaks will be sent with an ExecTransType of 1. NASDAQ does not support trade corrections.</Description>
        </Field>
        <Field>
          <Tag>76</Tag>
          <Name>ExecBroker</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Exec Broker associated with the order as specified in order entry (DNR, SRCH, FIND). Will not be available in quote or sweep executions</Description>
        </Field>
        <Field>
          <Tag>150</Tag>
          <Name>ExecType</Name>
          <Required>Y</Required>
          <Type>Char</Type>
          <Description>Describes the type of execution report. Same possible values as OrdStatus. 2 (Filled) for manual trades, trade cancellations and post trade allocations or corrections.</Description>
        </Field>
        <Field>
          <Tag>39</Tag>
          <Name>OrdStatus</Name>
          <Required>N</Required>
          <Type>Char</Type>
          <Description>Conditional: necessary for electronic trades and absent for manual trades. Describes the current state of a CHAIN of orders, same scope as OrderQty, CumQty, LeavesQty, and AvgPx: 0 = New, 1 = Partial Fill, 2 = Filled, 4 = Canceled, 5 = Replaced (see section 9 for notes on replacements)</Description>
        </Field>
        <Field>
          <Tag>55</Tag>
          <Name>Symbol</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>Symbol root</Description>
        </Field>
        <Field>
          <Tag>54</Tag>
          <Name>Side</Name>
          <Required>Y</Required>
          <Type>Char</Type>
        </Field>
        <Field>
          <Tag>38</Tag>
          <Name>OrderQty</Name>
          <Required>Y</Required>
          <Type>Qty</Type>
          <Description>Original order quantity</Description>
        </Field>
        <Field>
          <Tag>32</Tag>
          <Name>LastShares</Name>
          <Required>Y</Required>
          <Type>Qty</Type>
          <Description>Quantity of contracts bought/sold on this (last) fill.</Description>
        </Field>
        <Field>
          <Tag>31</Tag>
          <Name>LastPx</Name>
          <Required>Y</Required>
          <Type>Price</Type>
          <Description>Price of this (last) fill.</Description>
        </Field>
        <Field>
          <Tag>151</Tag>
          <Name>LeavesQty</Name>
          <Required>Y</Required>
          <Type>Qty</Type>
          <Description>Amount of contracts open for further execution. If the OrdStatus is Cancelled, DoneForTheDay, Expired, Calculated, or Rejected (in which case the order is no longer active) then LeavesQty could be 0, otherwise LeavesQty = OrderQty - CumQty.</Description>
        </Field>
        <Field>
          <Tag>14</Tag>
          <Name>CumQty</Name>
          <Required>Y</Required>
          <Type>Qty</Type>
          <Description>Currently executed contracts for chain of orders.</Description>
        </Field>
        <Field>
          <Tag>6</Tag>
          <Name>AvgPx</Name>
          <Required>Y</Required>
          <Type>Price</Type>
          <Description>Calculated average price of all fills on this order.</Description>
        </Field>
        <!-- Changed: FIX 4.2 name ExecRefID (printed ExecRefId); listed twice in the table, transcribed once -->
        <Field>
          <Tag>19</Tag>
          <Name>ExecRefID</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Appears on Breaks only and contains the ExecID of the trade being broken. Listed twice in the document table (also as ExecRefId: in trade break messages, will refer to the execId of the prior trade being broken).</Description>
        </Field>
        <Field>
          <Tag>11</Tag>
          <Name>ClOrdID</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>ClOrdId of the Fix/OTTO order being reported</Description>
        </Field>
        <Field>
          <Tag>117</Tag>
          <Name>QuoteID</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Identifier of quote/sweep being reported. If TIF = 3 (IOC) and this tag is present, it refers to a sweep-id sent by the client. If TIF = 0 (DAY) and this tag is present, it refers to a quote-id sent by the client. 8-byte binary SQF Ids are encoded as 16-byte ASCII strings where each byte is represented by two 0-F ASCII characters, e.g. 5E for 0x5e.</Description>
        </Field>
        <Field>
          <Tag>44</Tag>
          <Name>Price</Name>
          <Required>N</Required>
          <Type>Price</Type>
          <Description>As specified in the NewOrder</Description>
        </Field>
        <Field>
          <Tag>41</Tag>
          <Name>OrigClOrdID</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>ClOrdID of the previous order (NOT the initial order of the day) when reporting replace.</Description>
        </Field>
        <Field>
          <Tag>109</Tag>
          <Name>ClientID</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>Used for firm identification in third-party transactions. If a ClientID was specified in the original order then it will be returned in all subsequent execution reports; otherwise this will refer to the clientId assigned by the port of order entry</Description>
        </Field>
        <Field>
          <Tag>1</Tag>
          <Name>Account</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Must be 32 characters or less.</Description>
        </Field>
        <Field>
          <Tag>18</Tag>
          <Name>ExecInst</Name>
          <Required>N</Required>
          <Type>MultipleValueString</Type>
          <Description>Can contain multiple instructions, space delimited. f = InterMarket Sweep Order (ISO), G = All or none. Will not be available in a quote or sweep execution</Description>
        </Field>
        <Field>
          <Tag>75</Tag>
          <Name>TradeDate</Name>
          <Required>N</Required>
          <Type>LocalMktDate</Type>
        </Field>
        <Field>
          <Tag>59</Tag>
          <Name>TimeInForce</Name>
          <Required>N</Required>
          <Type>Char</Type>
          <Description>Specifies how long the order remains in effect: 0 = Market Hours (Day), 1 = Good Till cancel (GTC), 2 = OPG (Opening Cross), 3 = Immediate or Cancel (IOC), 4 = Fill or Kill (FOK). In case of a quote, the tif will be 0 and in case of a sweep the tif will be 3</Description>
        </Field>
        <Field>
          <Tag>60</Tag>
          <Name>TransactTime</Name>
          <Required>N</Required>
          <Type>UTCTimestamp</Type>
          <Description>Time of execution/order creation (expressed in GMT).</Description>
        </Field>
        <Field>
          <Tag>40</Tag>
          <Name>OrdType</Name>
          <Required>N</Required>
          <Type>Char</Type>
          <Description>1 = Market, 2 = Limit. This tag will not be present for a sweep or quote execution</Description>
        </Field>
        <!-- Changed: FIX 4.2 name Rule80A (printed Rule80A/OrderCapacity) -->
        <Field>
          <Tag>47</Tag>
          <Name>Rule80A</Name>
          <Required>N</Required>
          <Type>Char</Type>
          <Description>Named Rule80A/OrderCapacity in the document. Capacity: C = Customer, F = Firm, M = Market Maker, P = Professional Customer, O = Other exchange registered market maker, B = Broker Dealer, J = Joint BackOffice</Description>
        </Field>
        <Field>
          <Tag>58</Tag>
          <Name>Text</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Free format text string. In case of orders, replaces and fills, will be an optional 13 character supplementary id if specified on order entry. In case of cancel will also contain NASDAQ cancel reason code (see Cancel Order Reasons: #IOC, #USR, #HLT, #SUP, #SYS).</Description>
        </Field>
        <Field>
          <Tag>9730</Tag>
          <Name>LiquidityIndicator</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>Liquidity code of the execution. NON-STANDARD field (BX).</Description>
        </Field>
        <!-- Changed: no Req'd entry in the document; transcribed N -->
        <Field>
          <Tag>30</Tag>
          <Name>LastMkt</Name>
          <Required>N</Required>
          <Type>Exchange</Type>
          <Description>For option linkage trades, away execution exchange. No Req'd entry in the document.</Description>
        </Field>
        <Field>
          <Tag>77</Tag>
          <Name>OpenClose</Name>
          <Required>Y</Required>
          <Type>Char</Type>
          <Description>O = opening position, C = closing position. Tag will not be available in a quote or sweep execution</Description>
        </Field>
        <Field>
          <Tag>167</Tag>
          <Name>SecurityType</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>OPT = options</Description>
        </Field>
        <Field>
          <Tag>200</Tag>
          <Name>MaturityMonthYear</Name>
          <Required>Y</Required>
          <Type>MonthYear</Type>
          <Description>Format: YYYYMM (expiration date)</Description>
        </Field>
        <Field>
          <Tag>205</Tag>
          <Name>MaturityDay</Name>
          <Required>Y</Required>
          <Type>Int</Type>
          <Description>Format: DD (Expiration date-day of the month).</Description>
        </Field>
        <Field>
          <Tag>201</Tag>
          <Name>PutOrCall</Name>
          <Required>Y</Required>
          <Type>Int</Type>
          <Description>0 = put, 1 = call</Description>
        </Field>
        <Field>
          <Tag>202</Tag>
          <Name>StrikePrice</Name>
          <Required>Y</Required>
          <Type>Price</Type>
          <Description>Strike Price for option. Valid values: 0 - 999999.99999999</Description>
        </Field>
        <Field>
          <Tag>440</Tag>
          <Name>ClearingAccount</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Up to 5-character alphanumeric.</Description>
        </Field>
        <Field>
          <Tag>439</Tag>
          <Name>ClearingFirm</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>CMTA Number (firm that will clear the trade) up to 5-character numeric. If this tag was supplied on order entry, it will be passed along here</Description>
        </Field>
        <Field>
          <Tag>9373</Tag>
          <Name>AuctionType</Name>
          <Required>N</Required>
          <Type>Char</Type>
          <Description>Auction type of this order: P = PRISM Auction, Y = Customer to Customer Cross, B = Block Auction</Description>
        </Field>
        <Field>
          <Tag>9371</Tag>
          <Name>NWTOrdType</Name>
          <Required>N</Required>
          <Type>Char</Type>
          <Description>Named NWT OrdType in the document. The NWT (No worse than) order type for the PRISM auction order: 1 = MKT, 2 = LIMIT</Description>
        </Field>
        <Field>
          <Tag>9372</Tag>
          <Name>NWTPrice</Name>
          <Required>N</Required>
          <Type>Price</Type>
          <Description>Named NWT Price in the document. The NWT (No worse than) limit price for the PRISM auction order.</Description>
        </Field>
        <Field>
          <Tag>9370</Tag>
          <Name>AuctionID</Name>
          <Required>N</Required>
          <Type>Int</Type>
          <Description>Named AuctionId in the document. Auction ID of the PRISM auction.</Description>
        </Field>
        <Field>
          <Tag>9578</Tag>
          <Name>BillingCode</Name>
          <Required>N</Required>
          <Type>Char</Type>
          <Description>P = PRISM auction Priority Market Maker</Description>
        </Field>
      </Fields>
    </Message>

    <!-- OrderMassCancelReport (r) -->
    <Message>
      <Name>OrderMassCancelReport</Name>
      <MsgType>r</MsgType>
      <Category>app</Category>
      <Origin>Exchange</Origin>
      <Description>Purge Notification/Purge Reset/Underlying Reset Response: Rapid Fire risk protection and Kill Switch purge or reset notifications, and responses to a firm's purge or underlying reset request.</Description>
      <Fields>
        <Field>
          <Tag>109</Tag>
          <Name>ClientID</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>NASDAQ MPID/ Firm mnemonic</Description>
        </Field>
        <Field>
          <Tag>37</Tag>
          <Name>OrderID</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>Exchange assigned unique Identifier of the notification for the trading session.</Description>
        </Field>
        <Field>
          <Tag>530</Tag>
          <Name>RequestType</Name>
          <Required>N</Required>
          <Type>Char</Type>
          <Description>Present if this is a response to Firm's purge or Reset Request: 8 = Reset, 2 = Purge</Description>
        </Field>
        <Field>
          <Tag>531</Tag>
          <Name>Response</Name>
          <Required>Y</Required>
          <Type>Char</Type>
          <Description>8 = Purge/Reset Request Successful, 9 = Rapid Fire Notification, K = Kill Switch Purge/Reset Notification</Description>
        </Field>
        <Field>
          <Tag>311</Tag>
          <Name>UnderlyingSymbol</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Present if tag 531 is 9 or this is a response to firm reset/purged by underlying. If this tag is absent, the purge/reset is for all underlyings</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

