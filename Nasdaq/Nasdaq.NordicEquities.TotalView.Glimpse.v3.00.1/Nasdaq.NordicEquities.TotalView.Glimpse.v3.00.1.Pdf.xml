        <Field>
          <Name>Timestamp</Name>
          <Type>Timestamp</Type>
          <Size>8</Size>
          <Description>Nanoseconds since midnight</Description>
        </Field>
        <Field>
          <Name>Tracking Number</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Nasdaq Nordic internal tracking number</Description>
        </Field>
        <Field>
          <Name>Order Reference Number</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Unique reference number assigned to the new order</Description>
        </Field>
        <Field>
          <Name>Buy/Sell Indicator</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>The type of order being added</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Integer</Type>
          <Size>4</Size>
