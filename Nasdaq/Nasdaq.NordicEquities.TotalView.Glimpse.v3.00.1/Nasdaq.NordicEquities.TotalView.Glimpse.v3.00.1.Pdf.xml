<OmiItchNordicPdf>

  <Messages>

    <!-- System Event Message -->
    <Message>
      <Name>System Event Message</Name>
      <Dependency>Sequenced Message Type</Dependency>
      <Branch>Sequenced Message</Branch>
      <Code>S</Code>
      <Category>Technical</Category>
      <Origin>Exchange</Origin>
      <Description>Signals a market or data feed handler event</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Timestamp</Type>
          <Size>8</Size>
          <Description>Nanoseconds since midnight</Description>
        </Field>
        <Field>
          <Name>Tracking Number</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Nasdaq Nordic internal tracking number</Description>
        </Field>
        <Field>
          <Name>Event Code</Name>
          <Type>Alpha-numeric</Type>
          <Size>1</Size>
          <Description>System event code</Description>
        </Field>
      </Fields>
    </Message>
    
    <!-- Order Book Trading Action Message -->
    <Message>
      <Name>Order Book Trading Action Message</Name>
      <Dependency>Sequenced Message Type</Dependency>
      <Branch>Sequenced Message</Branch>
      <Code>H</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>Indicates the current trading status of a security</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Timestamp</Type>
          <Size>8</Size>
          <Description>Nanoseconds since midnight</Description>
        </Field>
        <Field>
          <Name>Tracking Number</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Nasdaq Nordic internal tracking number</Description>
        </Field>
        <Field>
          <Name>Order Book</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Order book id</Description>
        </Field>
        <Field>
          <Name>Symbol State</Name>
          <Type>Alpha-numeric</Type>
          <Size>1</Size>
          <Description>Trading state of the order book</Description>
        </Field>
        <Field>
          <Name>Extension</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Whether the cross has been extended</Description>
        </Field>
        <Field>
          <Name>Reason</Name>
          <Type>Alpha-numeric</Type>
          <Size>4</Size>
          <Description>Halt reason code</Description>
        </Field>
      </Fields>
    </Message>
    
    <!-- Order Book Directory Message -->
    <Message>
      <Name>Order Book Directory Message</Name>
      <Dependency>Sequenced Message Type</Dependency>
      <Branch>Sequenced Message</Branch>
      <Code>R</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>Disseminated for all active order books at the start of each trading day</Description>
