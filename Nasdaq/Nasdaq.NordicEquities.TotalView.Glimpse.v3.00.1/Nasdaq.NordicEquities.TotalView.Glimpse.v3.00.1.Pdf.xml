        </Field>
        <Field>
          <Name>Order Book</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Order book the order is being added to</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Price (4)</Type>
          <Size>4</Size>
          <Description>Display price of the new order</Description>
        </Field>
      </Fields>
    </Message>
    
