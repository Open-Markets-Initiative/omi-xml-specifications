        <Field>
          <Name>Timestamp</Name>
          <Type>Timestamp</Type>
          <Size>8</Size>
          <Description>Nanoseconds since midnight</Description>
        </Field>
        <Field>
          <Name>Tracking Number</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Nasdaq Nordic internal tracking number</Description>
        </Field>
        <Field>
          <Name>Order Book</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Primary identifier of an order book</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alpha-numeric</Type>
          <Size>16</Size>
          <Description>Human readable name of the security</Description>
        </Field>
        <Field>
          <Name>ISIN</Name>
          <Type>Alpha-numeric</Type>
          <Size>12</Size>
          <Description>Isin code identifying security</Description>
        </Field>
        <Field>
          <Name>Financial Product</Name>
          <Type>Integer</Type>
          <Size>1</Size>
          <Description>Type of financial product</Description>
        </Field>
        <Field>
          <Name>Trading Currency</Name>
          <Type>Alpha</Type>
          <Size>3</Size>
          <Description>Trading currency</Description>
        </Field>
        <Field>
          <Name>MIC</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Market identifier code</Description>
        </Field>
        <Field>
          <Name>Market Segment ID</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Market segment this order book belongs to</Description>
        </Field>
        <Field>
          <Name>Note Codes Bit Field 1</Name>
          <Type>bitfield</Type>
          <Size>1</Size>
          <Description>Note codes, logical Or to identify multiple</Description>
        </Field>
        <Field>
          <Name>Note Codes Bit Field 2</Name>
          <Type>bitfield</Type>
          <Size>1</Size>
          <Description>Note codes, logical Or to identify multiple</Description>
        </Field>
        <Field>
          <Name>Note Codes Bit Field 3</Name>
          <Type>bitfield</Type>
          <Size>1</Size>
          <Description>Note codes, logical Or to identify multiple</Description>
        </Field>
        <Field>
          <Name>Note Codes Bit Field 4</Name>
          <Type>bitfield</Type>
          <Size>1</Size>
          <Description>Note codes, logical Or to identify multiple</Description>
        </Field>
        <Field>
          <Name>Note Codes Bit Field 5</Name>
          <Type>bitfield</Type>
          <Size>1</Size>
          <Description>Note codes, logical Or to identify multiple</Description>
        </Field>
        <Field>
          <Name>Note Codes Bit Field 6</Name>
          <Type>bitfield</Type>
          <Size>1</Size>
          <Description>Note codes, logical Or to identify multiple</Description>
        </Field>
        <Field>
          <Name>Note Codes Bit Field 7</Name>
          <Type>bitfield</Type>
          <Size>1</Size>
          <Description>Note codes, logical Or to identify multiple</Description>
        </Field>
        <Field>
          <Name>Note Codes Bit Field 8</Name>
          <Type>bitfield</Type>
          <Size>1</Size>
          <Description>Note codes, logical Or to identify multiple</Description>
        </Field>
        <Field>
          <Name>Round Lot Size</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of shares representing a round lot</Description>
        </Field>
        <Field>
          <Name>Nordic@Mid MIC</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Venue Mic if a Nordic At Mid order book applies</Description>
        </Field>
        <Field>
          <Name>AOD MIC</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Venue Mic if an auction on demand order book applies</Description>
        </Field>
        <Field>
          <Name>Notation of Qty</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Measurement units the quantity is expressed in</Description>
        </Field>
        <Field>
          <Name>Notional Amount</Name>
          <Type>Price(5)</Type>
          <Size>8</Size>
          <Description>Notional amount if specified</Description>
        </Field>
        <Field>
          <Name>Currency</Name>
          <Type>Alpha</Type>
          <Size>3</Size>
          <Description>Currency of the notional amount</Description>
        </Field>
        <Field>
          <Name>Price notation</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Populated with M if price is monetary value</Description>
        </Field>
        <Field>
          <Name>Multiplier for calculating Quantity in measurement unit</Name>
          <Type>Price(6)</Type>
          <Size>8</Size>
          <Description>Multiplier to calculate quantity in measurement units</Description>
        </Field>
      </Fields>
    </Message>
    
    <!-- Add Order Message -->
    <Message>
      <Name>Add Order Message</Name>
      <Dependency>Sequenced Message Type</Dependency>
      <Branch>Sequenced Message</Branch>
      <Code>A</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>An order added to the book without Mpid attribution</Description>
