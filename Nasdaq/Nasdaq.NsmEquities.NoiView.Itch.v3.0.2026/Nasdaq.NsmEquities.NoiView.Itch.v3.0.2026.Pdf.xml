<OmiItchNsmEquitiesPdf>
  
  <Messages>

    <!-- System Event Message -->
    <Message>
      <Name>System Event</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>S</Code>
      <Category>Technical</Category>
      <Description>Signals a market or data feed handler event</Description>
      <Fields>
        <Field>
          <Name>Tracking Number</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Nasdaq internal tracking number</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Type>Timestamp</Type>
          <Size>6</Size>
          <Description>Time of system event generation</Description>
        </Field>
        <Field>
          <Name>Event Code</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>System Event Code identifier</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Stock Directory Message -->
    <Message>
      <Name>Stock Directory Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>R</Code>
      <Category>Technical</Category>
      <Description>Disseminates stock directory info for all active symbols at start of trading day</Description>
      <Fields>
        <Field>
          <Name>Tracking Number</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Nasdaq internal tracking number</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Type>Integer</Type>
          <Size>6</Size>
          <Description>Time Stamp</Description>
        </Field>
        <Field>
          <Name>Stock</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Security symbol in Nasdaq execution system</Description>
        </Field>
        <Field>
          <Name>Market Category</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Listing market or listing market tier for the issue</Description>
        </Field>
        <Field>
          <Name>Financial Status Indicator</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Nasdaq-listed compliance status</Description>
        </Field>
        <Field>
          <Name>Round Lot Size</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of shares in a round lot</Description>
        </Field>
        <Field>
          <Name>Round Lots Only</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Indicates if system limits order entry to round lots</Description>
        </Field>
        <Field>
          <Name>Issue Classification</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Security class assigned by Nasdaq</Description>
        </Field>
        <Field>
          <Name>Issue Sub-Type</Name>
          <Type>Alphanumeric</Type>
          <Size>2</Size>
          <Description>Security sub-type assigned by Nasdaq</Description>
        </Field>
        <Field>
          <Name>Authenticity</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Live/production, test, or demo state</Description>
        </Field>
        <Field>
          <Name>Short Sale Threshold Indicator</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Subject to mandatory close-out under SEC Rule 203(b)(3)</Description>
        </Field>
        <Field>
          <Name>IPO Flag</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Indicates if security is set up for IPO release</Description>
        </Field>
        <Field>
          <Name>LULD Reference Price Tier</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Limit Up / Limit Down price band calculation parameter</Description>
        </Field>
        <Field>
          <Name>ETP Flag</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Indicates if security is an exchange traded product</Description>
        </Field>
        <Field>
          <Name>ETP Leverage Factor</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Integral relationship of ETP to underlying index</Description>
        </Field>
        <Field>
          <Name>Inverse Indicator</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Directional relationship between ETP and underlying index</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Stock Trading Action Message -->
    <Message>
      <Name>Stock Trading Action Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>H</Code>
      <Category>Technical</Category>
      <Description>Indicates the current trading status of a security</Description>
      <Fields>
        <Field>
          <Name>Tracking Number</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Nasdaq internal tracking number</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Type>Timestamp</Type>
          <Size>6</Size>
          <Description>Time of message generation</Description>
        </Field>
        <Field>
          <Name>Stock</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Security symbol in Nasdaq execution system</Description>
        </Field>
        <Field>
          <Name>Current Trading State</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Current trading state for the issue</Description>
        </Field>
        <Field>
          <Name>Reason</Name>
          <Type>Alphanumeric</Type>
          <Size>4</Size>
          <Description>Market Ops or MarketWatch code for trading state change</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Reg SHO Short Sale Price Test Restricted Indicator Message -->
    <Message>
      <Name>Reg SHO Short Sale Price Test Restricted Indicator Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>Y</Code>
      <Category>Technical</Category>
      <Description>Indicates Rule 201 Reg SHO restriction status for a security</Description>
      <Fields>
        <Field>
          <Name>Tracking Number</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Nasdaq internal tracking number</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Type>Timestamp</Type>
          <Size>6</Size>
          <Description>Time of message generation</Description>
        </Field>
        <Field>
          <Name>Stock</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Stock symbol right padded with spaces</Description>
        </Field>
        <Field>
          <Name>Reg SHO Action</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Reg SHO restriction status at time of dissemination</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Net Order Imbalance Indicator Message -->
    <Message>
      <Name>Net Order Imbalance Indicator Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>I</Code>
      <Category>Technical</Category>
      <Description>Net Order Imbalance Indicator for Opening, Closing, and Extended Trading crosses</Description>
      <Fields>
        <Field>
          <Name>Tracking Number</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Nasdaq internal tracking number</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Type>Timestamp</Type>
          <Size>6</Size>
          <Description>Time of message generation</Description>
        </Field>
        <Field>
          <Name>Paired Shares</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Total shares eligible to match at Current Reference Price</Description>
        </Field>
        <Field>
          <Name>Imbalance Shares</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Shares not paired at Current Reference Price</Description>
        </Field>
        <Field>
          <Name>Imbalance Direction</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Market side of the imbalance</Description>
        </Field>
        <Field>
          <Name>Stock</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Security symbol for the NOII message</Description>
        </Field>
        <Field>
          <Name>Far Price</Name>
          <Type>Price (4)</Type>
          <Size>4</Size>
          <Description>Hypothetical clearing price for cross orders only</Description>
        </Field>
        <Field>
          <Name>Near Price</Name>
          <Type>Price (4)</Type>
          <Size>4</Size>
          <Description>Hypothetical clearing price for cross and continuous orders</Description>
        </Field>
        <Field>
          <Name>Current Reference Price</Name>
          <Type>Price (4)</Type>
          <Size>4</Size>
          <Description>Price at which NOII shares are calculated</Description>
        </Field>
        <Field>
          <Name>Cross Type</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Type of Nasdaq cross</Description>
        </Field>
        <Field>
          <Name>Price Variation Indicator</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Deviation percentage of Near Indicative Clearing Price to Current Reference Price</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Cross Trade Message -->
    <Message>
      <Name>Cross Trade Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>Q</Code>
      <Category>Technical</Category>
      <Description>Indicates Nasdaq has completed its cross process for a specific security</Description>
      <Fields>
        <Field>
          <Name>Tracking Number</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Nasdaq internal tracking number</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Type>Timestamp</Type>
          <Size>6</Size>
          <Description>Time of message generation</Description>
        </Field>
        <Field>
          <Name>Shares</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Number of shares matched in the Nasdaq Cross</Description>
        </Field>
        <Field>
          <Name>Stock</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Security symbol associated with the cross trade</Description>
        </Field>
        <Field>
          <Name>Cross Price</Name>
          <Type>Price (4)</Type>
          <Size>4</Size>
          <Description>Price at which the cross occurred</Description>
        </Field>
        <Field>
          <Name>Match Number</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Nasdaq generated day-unique match number</Description>
        </Field>
        <Field>
          <Name>Cross Type</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Nasdaq cross session for the message</Description>
        </Field>
      </Fields>
    </Message>

    <!-- IPO Quoting Period Update Message -->
    <Message>
      <Name>IPO Quoting Period Update Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>K</Code>
      <Category>Technical</Category>
      <Description>Indicates the anticipated IPO quotation release time of a security</Description>
      <Fields>
        <Field>
          <Name>Tracking Number</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Nasdaq internal tracking number</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Type>Timestamp</Type>
          <Size>6</Size>
          <Description>Time of message generation</Description>
        </Field>
        <Field>
          <Name>Stock</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Security symbol in Nasdaq execution system</Description>
        </Field>
        <Field>
          <Name>IPO Quotation Release Time</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>IPO release time for quotation in HHMMSS format</Description>
        </Field>
        <Field>
          <Name>IPO Quotation Release Qualifier</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Indicates anticipated release or cancellation/postponement</Description>
        </Field>
        <Field>
          <Name>IPO Price</Name>
          <Type>Price (4)</Type>
          <Size>4</Size>
          <Description>IPO price for intraday net change calculations</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Direct Listing with Capital Raise Price Discovery Message -->
    <Message>
      <Name>Direct Listing with Capital Raise Price Discovery Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>O</Code>
      <Category>Technical</Category>
      <Description>Disseminated for DLCR securities once volatility test has passed</Description>
      <Fields>
        <Field>
          <Name>Tracking Number</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Nasdaq internal tracking number</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Type>Integer</Type>
          <Size>6</Size>
          <Description>Nanoseconds since midnight</Description>
        </Field>
        <Field>
          <Name>Stock</Name>
          <Type>Alpha</Type>
          <Size>8</Size>
          <Description>Stock symbol right padded with spaces</Description>
        </Field>
        <Field>
          <Name>Open Eligibility Status</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Indicates if security is eligible for trading release</Description>
        </Field>
        <Field>
          <Name>Minimum Allowable Price</Name>
          <Type>Price (4)</Type>
          <Size>4</Size>
          <Description>20% below Registration Statement Lower Price</Description>
        </Field>
        <Field>
          <Name>Maximum Allowable Price</Name>
          <Type>Price (4)</Type>
          <Size>4</Size>
          <Description>80% above Registration Statement Highest Price</Description>
        </Field>
        <Field>
          <Name>Near Execution Price</Name>
          <Type>Price (4)</Type>
          <Size>4</Size>
          <Description>Reference price when DLCR volatility test has passed</Description>
        </Field>
        <Field>
          <Name>Near Execution Time</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Time at which near execution price was set</Description>
        </Field>
        <Field>
          <Name>Lower Price Range Collar</Name>
          <Type>Price (4)</Type>
          <Size>4</Size>
          <Description>Lower Auction Collar Threshold (10% below Near Execution Price)</Description>
        </Field>
        <Field>
          <Name>Upper Price Range Collar</Name>
          <Type>Price (4)</Type>
          <Size>4</Size>
          <Description>Upper Auction Collar Threshold (10% above Near Execution Price)</Description>
        </Field>
      </Fields>
    </Message>
    
  </Messages>
  
