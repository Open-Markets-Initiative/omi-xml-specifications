          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Nanoseconds since midnight.</Description>
        </Field>
        <Field>
          <Name>Instrument ID</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Instrument Id assigned daily, valid for trading day.</Description>
        </Field>
        <Field>
          <Name>Auction ID</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Uniquely identifies the Auction for the trading day.</Description>
        </Field>
        <Field>
          <Name>Auction Type</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Auction Type</Description>
        </Field>
        <Field>
          <Name>Auction Duration</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>User defined for Auction Duration. In milliseconds between 3,000 and 300,000.</Description>
        </Field>
        <Field>
          <Name>AuctionEvent</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>AuctionEvent</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Auction Quantity. Opening auction will present paired quantity in this field.</Description>
        </Field>
        <Field>
          <Name>Side</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Indicates the market side of the imbalance in case of Opening or the direction of the auction in case of Auction.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Price for the auction; hidden prices are set to zero.</Description>
        </Field>
        <Field>
          <Name>Imbalance Volume</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Imbalance volume for opening auction. Will be 0 for other auctions</Description>
        </Field>
        <Field>
          <Name>Exec Flag</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Exec Flag</Description>
        </Field>
        <Field>
          <Name>Order Capacity</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Order Capacity</Description>
        </Field>
        <Field>
          <Name>Owner ID</Name>
          <Type>Alpha</Type>
          <Size>6</Size>
          <Description>Block Auction may provide Owner ID; Spaces when not set</Description>
        </Field>
        <Field>
          <Name>Giveup</Name>
          <Type>Alpha</Type>
          <Size>6</Size>
          <Description>Block Auction may provide Giveup; Spaces when not set</Description>
        </Field>
        <Field>
          <Name>CMTA</Name>
          <Type>Alpha</Type>
          <Size>6</Size>
          <Description>Block Auction may provide CMTA; Spaces when not set</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Alpha</Type>
          <Size>16</Size>
