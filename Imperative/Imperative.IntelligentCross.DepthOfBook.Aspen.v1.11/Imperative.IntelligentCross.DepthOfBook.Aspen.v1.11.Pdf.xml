<OmiAspenPdf>

  <Messages>

    <!-- Market Event Message -->
    <Message>
      <Name>Market Event Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>A</Code>
      <Description>This message appears on all quote channels and indicates the beginning of a spin message cycle</Description>
      <Fields>
        <Field>
          <Name>Reserved</Name>
          <Type>Alpha</Type>
          <Size>2</Size>
          <Description>Reserved for future use</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Nanoseconds Since Epoch (UTC)</Description>
        </Field>
        <Field>
          <Name>Event</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Event Values</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Symbol Information Message -->
    <Message>
      <Name>Symbol Information Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>B</Code>
      <Description>Symbol Information</Description>
      <Fields>
        <Field>
          <Name>Symbol ID</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Symbol Index</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Nanoseconds Since Epoch (UTC)</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alpha</Type>
          <Size>11</Size>
          <Description>Stock Symbol</Description>
        </Field>
        <Field>
          <Name>Listing Market</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Code identifying the primary listing market</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Reserved for future use</Description>
        </Field>
        <Field>
          <Name>Round Lot Size</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>size of one round lot</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Symbol State Message -->
    <Message>
      <Name>Symbol State Message</Name>
      <Branch>payload</Branch>
