        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alpha</Type>
          <Size>11</Size>
          <Description>Stock Symbol</Description>
        </Field>
        <Field>
          <Name>State</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>State Values</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Reserved for future use</Description>
        </Field>
        <Field>
          <Name>Info</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>optional text</Description>
        </Field>
      </Fields>
    </Message>

    <!-- New Order Add Message -->
    <Message>
      <Name>New Order Add Message</Name>
