        </Field>
        <Field>
          <Name>Order ID</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Market Issued Unique Order ID</Description>
        </Field>
        <Field>
          <Name>Side</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>'B'/'S'</Description>
        </Field>
        <Field>
          <Name>Shares</Name>
          <Type>Integer</Type>
