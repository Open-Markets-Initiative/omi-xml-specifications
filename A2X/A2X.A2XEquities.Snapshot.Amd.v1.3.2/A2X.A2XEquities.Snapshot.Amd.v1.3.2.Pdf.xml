<OmiAmdPdf>

  <Messages>

    <!-- Heartbeat Message -->
    <Message>
      <Name>Heartbeat Message</Name>
      <Description>The Heartbeat message carries no data</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Category>Continuous</Category>
      <Code>1</Code>
      <Fields/>
    </Message>

    <!-- Snapshot Start Message -->
    <Message>
      <Name>Snapshot Start Message</Name>
      <Description>A Snapshot Start message is published as the first message in a snapshot to identify the continous stream</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Category></Category>
      <Code>10</Code>
      <Fields>
        <Field>
          <Name>streamSeqNo</Name>
          <Type>u32</Type>
          <Size>4</Size>
          <Description>The sequence number of the last message</Description>
        </Field>
        <Field>
          <Name>securityCount</Name>
          <Type>u16</Type>
          <Size>2</Size>
          <Description>Number of securities reported in this</Description>
        </Field>
        <Field>
          <Name>timestamp</Name>
          <Type>u64</Type>
          <Size>8</Size>
          <Description>Timestamp of this snapshot</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Book Status Message -->
    <Message>
      <Name>Book Status Message</Name>
      <Description>A Book Status message is published to report the trading and market status of each security and the number of open orders on the order book for the security at the time of the snapshot</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Category></Category>
      <Code>11</Code>
      <Fields>
        <Field>
          <Name>securityId</Name>
          <Type>u16</Type>
          <Size>2</Size>
          <Description>Numeric identifier of the relevant security</Description>
        </Field>
        <Field>
          <Name>tradingStatus</Name>
          <Type>u8</Type>
          <Size>1</Size>
          <Description>Trading Status</Description>
        </Field>
        <Field>
          <Name>marketFlags</Name>
          <Type>bitfield</Type>
          <Size>1</Size>
          <Description>market flags</Description>
        </Field>
        <Field>
          <Name>entries</Name>
          <Type>u16</Type>
          <Size>2</Size>
          <Description>Number of open orders in the book for this</Description>
        </Field>
        <Field>
          <Name>closingBuyQty</Name>
          <Type>u32</Type>
          <Size>4</Size>
          <Description>Total order quantity on the buy side during</Description>
        </Field>
        <Field>
          <Name>closingSellQty</Name>
          <Type>u32</Type>
          <Size>4</Size>
          <Description>Total order quantity on the sell side during</Description>
        </Field>
        <Field>
          <Name>indicativePrice</Name>
          <Type>u64</Type>
          <Size>8</Size>
          <Description>Indicative auction price</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Book Entry Message -->
    <Message>
      <Name>Book Entry Message</Name>
      <Description>An appropriate number of Book Entry messages is published after each Book Status message to provide details of each order and allow the book to be built</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Category></Category>
      <Code>12</Code>
      <Fields>
        <Field>
          <Name>securityId</Name>
          <Type>u16</Type>
          <Size>2</Size>
          <Description>Numeric identifier of the relevant security</Description>
        </Field>
        <Field>
          <Name>quantity</Name>
          <Type>u32</Type>
          <Size>4</Size>
          <Description>Number of open shares</Description>
        </Field>
        <Field>
          <Name>price</Name>
          <Type>u64</Type>
          <Size>8</Size>
          <Description>The price of the order</Description>
        </Field>
        <Field>
          <Name>orderRef</Name>
          <Type>u32</Type>
          <Size>4</Size>
          <Description>Order reference number</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Market at Close Book Entry Message -->
    <Message>
      <Name>Market at Close Book Entry Message</Name>
      <Description>A2X will publish the volume of the 5 best bid and offer orders per security in chronological order</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Category></Category>
      <Code>18</Code>
      <Fields>
        <Field>
          <Name>securityId</Name>
          <Type>u16</Type>
          <Size>2</Size>
          <Description>Numeric identifier of the relevant security</Description>
        </Field>
        <Field>
          <Name>quantity</Name>
          <Type>u32</Type>
          <Size>4</Size>
          <Description>Number of open shares</Description>
        </Field>
        <Field>
          <Name>price</Name>
          <Type>u64</Type>
          <Size>8</Size>
          <Description>The price of the order</Description>
        </Field>
        <Field>
          <Name>orderRef</Name>
          <Type>u32</Type>
          <Size>4</Size>
          <Description>Order reference number</Description>
        </Field>
      </Fields>
    </Message>
  </Messages>

  <Bitfields>

    <!-- Market Flags -->
    <Bitfield>
      <Name>Market Flags</Name>
      <Description>Market Flagss</Description>
      <Fields>
        <Field>
          <Name>Unused</Name>
          <Bits>5</Bits>
          <Description>Reserved for future use</Description>
        </Field>
        <Field>
          <Name>Mac Run</Name>
          <Bits>1</Bits>
          <Description>Locked</Description>
        </Field>
        <Field>
          <Name>Mac Open</Name>
          <Bits>1</Bits>
          <Description>Open</Description>
        </Field>
        <Field>
          <Name>Trading</Name>
          <Bits>1</Bits>
          <Description>Continuous Trading</Description>
        </Field>
      </Fields>
    </Bitfield>
    
  </Bitfields>

  <Enums>

    <!-- Side -->
    <Enum>
      <Name>Side</Name>
      <Values>
        <Value>
          <Data>1</Data>
          <Name>Buy Order</Name>
        </Value>
        <Value>
          <Data>2</Data>
          <Name>Sell Order</Name>
        </Value>
      </Values>
    </Enum>
    
  </Enums>

</OmiAmdPdf>