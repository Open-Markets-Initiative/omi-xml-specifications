<OmiBjsePdf>

  <!--
    Bjse Binary market data v1.1, session management messages.

    Transcribed from the Beijing Stock Exchange and NEEQ Market Data Interface Specification
    (Binary) V1.1, chapter 4.2 Administrative Messages. These three messages exist only on a market
    quotation gateway session; the multicast distribution protocol carries its own management
    packets instead.

    All three are transmitted by both sides of the session, so each carries both origins.

    Field types come from Table 5-2 Session Layer Definition, with CompID resolved to char[20] by
    Table 5-1. The document is in Chinese; names are the document's own English field names, and
    descriptions are translated.
  -->

  <Messages>

    <!-- Logon Message -->
    <Message>
      <Name>Logon Message</Name>
      <Dependency>msgtype</Dependency>
      <Branch>payload</Branch>
      <Code>1</Code>
      <Category>Session</Category>
      <Origin>Firm,Exchange</Origin>
      <Description>The first message the Vendor Supplied System sends to the market quotation gateway, which confirms a successful logon with a Logon of its own, so both sides transmit this message type.</Description>
      <Fields>
        <Field>
          <Name>SenderCompID</Name>
          <Type>CompID</Type>
          <Size>20</Size>
          <Description>Sender code</Description>
        </Field>
        <Field>
          <Name>TargetCompID</Name>
          <Type>CompID</Type>
          <Size>20</Size>
          <Description>Receiver code</Description>
        </Field>
        <Field>
          <Name>HeartBtInt</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Heartbeat interval in seconds, provided to the gateway by the Vendor Supplied System at logon</Description>
        </Field>
        <Field>
          <Name>Password</Name>
          <Type>char[16]</Type>
          <Size>16</Size>
          <Description>Password</Description>
        </Field>
        <Field>
          <Name>DefaultApplVerID</Name>
          <Type>char[32]</Type>
          <Size>32</Size>
          <Description>Binary protocol version, in the form n.xy; the communication version of this specification is 1.00</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Logout Message -->
    <Message>
      <Name>Logout Message</Name>
      <Dependency>msgtype</Dependency>
      <Branch>payload</Branch>
      <Code>2</Code>
      <Category>Session</Category>
      <Origin>Firm,Exchange</Origin>
      <Description>Sent by the gateway to refuse a logon request it does not accept; the Vendor Supplied System may also send it to end the connection, so both sides transmit this message type.</Description>
      <Fields>
        <Field>
          <Name>SessionStatus</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Session status at logout</Description>
        </Field>
        <Field>
          <Name>Text</Name>
          <Type>char[200]</Type>
          <Size>200</Size>
          <Description>Further explanation of the logout reason, up to 200 bytes that may include Chinese characters</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Heartbeat Message -->
    <Message>
      <Name>Heartbeat Message</Name>
      <Dependency>msgtype</Dependency>
      <Branch>payload</Branch>
      <Code>3</Code>
      <Category>Session</Category>
      <Origin>Firm,Exchange</Origin>
      <Description>Sent by either side when it is idle so that the other can check the Tcp connection, so both sides transmit this message type. BodyLength is 0 and the message carries no body.</Description>
    </Message>

  </Messages>

  <Enums>

    <!-- SessionStatus -->
    <Enum>
      <Name>SessionStatus</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>Session Active</Name>
        </Value>
        <Value>
          <Data>1</Data>
          <Name>Session Password Changed</Name>
        </Value>
        <Value>
          <Data>2</Data>
          <Name>Session Password Due To Expire</Name>
        </Value>
        <Value>
          <Data>3</Data>
          <Name>New Session Password Does Not Comply With Policy</Name>
        </Value>
        <Value>
          <Data>4</Data>
          <Name>Session Logout Complete</Name>
        </Value>
        <Value>
          <Data>5</Data>
          <Name>Invalid Username Or Password</Name>
        </Value>
        <Value>
          <Data>6</Data>
          <Name>Account Locked</Name>
        </Value>
        <Value>
          <Data>7</Data>
          <Name>Logons Are Not Allowed At This Time</Name>
        </Value>
        <Value>
          <Data>8</Data>
          <Name>Password Expired</Name>
        </Value>
        <Value>
          <Data>9</Data>
          <Name>MsgSeqNum Received Too Low</Name>
          <Description>MsgSeqNum(34) received is too small</Description>
        </Value>
        <Value>
          <Data>10</Data>
          <Name>NextExpectedMsgSeqNum Received Too High</Name>
          <Description>NextExpectedMsgSeqNum(789) received is too large</Description>
        </Value>
        <Value>
          <Data>101</Data>
          <Name>Other</Name>
        </Value>
        <Value>
          <Data>102</Data>
          <Name>Invalid Message</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiBjsePdf>
