<OmiNairobiMitchPdf>

  <!--
    Nairobi Equities MITCH-UDP v1.22, Replay channel administrative messages.

    Transcribed from the Nairobi Securities Exchange Equity Trading System Market Data Feed
    (MITCH-UDP) Specification v1.22 (24 November 2020), section 7. Each message's Length and
    Message Type fields are the message header of the unit header file, so the tables here start
    at offset 3. Types are the document's own (7.4): Price is four bytes with four implied decimal
    places, Long Price eight bytes with up to eight; integers are little endian.

    Where the document gives one label to fields that need different value sets or layouts, the
    field is qualified and the description records the document's label: Status becomes Login
    Status, Replay Status and Snapshot Status; Action becomes Price Point Action and Top Of Book
    Action; Flags is named after its message; the Sub Book bit fields are Sub Book Flags and
    Price Point Sub Book Flags, apart from the single valued Sub Book code. Bits the document
    leaves undefined are reserved.
  -->

  <Messages>

    <!-- Login Request Message -->
    <Message>
      <Name>Login Request Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x01</Code>
      <Category>Administrative</Category>
      <Origin>Firm</Origin>
      <Description>Used by the client to login to the Replay or Snapshot channel.</Description>
      <Fields>
        <Field>
          <Name>Username</Name>
          <Type>Alpha</Type>
          <Size>6</Size>
          <Description>CompID assigned to the client.</Description>
        </Field>
        <Field>
          <Name>Password</Name>
          <Type>Alpha</Type>
          <Size>10</Size>
          <Description>Password assigned to the CompID.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Login Response Message -->
    <Message>
      <Name>Login Response Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x02</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>Used by the server to accept or reject a login request to the Replay or Snapshot channel.</Description>
      <Fields>
        <Field>
          <Name>Login Status</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Status of the login request. The document names this field Status.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Replay Request Message -->
    <Message>
      <Name>Replay Request Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x03</Code>
      <Category>Administrative</Category>
      <Origin>Firm</Origin>
      <Description>Used by the client to request a retransmission of messages on the Replay channel.</Description>
      <Fields>
        <Field>
          <Name>Market Data Group</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Identity of the market data group the replay request relates to.</Description>
        </Field>
        <Field>
          <Name>First Message</Name>
          <Type>UInt32</Type>
          <Size>4</Size>
          <Description>Sequence number of the first message in range to be retransmitted.</Description>
        </Field>
        <Field>
          <Name>Count</Name>
          <Type>UInt16</Type>
          <Size>2</Size>
          <Description>Number of messages to be resent.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Replay Response Message -->
    <Message>
      <Name>Replay Response Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x04</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>Used by the server to respond to a retransmission request on the Replay channel.</Description>
      <Fields>
        <Field>
          <Name>Market Data Group</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Identity of the market data group the replay request relates to.</Description>
        </Field>
        <Field>
          <Name>First Message</Name>
          <Type>UInt32</Type>
          <Size>4</Size>
          <Description>Sequence number of the first message in range to be retransmitted. This will be zero if Status is not "A".</Description>
        </Field>
        <Field>
          <Name>Count</Name>
          <Type>UInt16</Type>
          <Size>2</Size>
          <Description>Number of messages to be resent. This will be zero if Status is not "A".</Description>
        </Field>
        <Field>
          <Name>Replay Status</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Status of the replay request. The document names this field Status.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Logout Request Message -->
    <Message>
      <Name>Logout Request Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x05</Code>
      <Category>Administrative</Category>
      <Origin>Firm</Origin>
      <Description>Used by the client to logout of the Replay or Snapshot channel.</Description>
      <Fields>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- Login Status -->
    <Enum>
      <Name>Login Status</Name>
      <Values>
        <Value>
          <Data>A</Data>
          <Name>Login Accepted</Name>
        </Value>
        <Value>
          <Data>a</Data>
          <Name>Comp Id Inactive Locked</Name>
        </Value>
        <Value>
          <Data>b</Data>
          <Name>Login Limit Reached</Name>
        </Value>
        <Value>
          <Data>c</Data>
          <Name>Service Unavailable</Name>
        </Value>
        <Value>
          <Data>d</Data>
          <Name>Concurrent Limit Reached</Name>
        </Value>
        <Value>
          <Data>e</Data>
          <Name>Failed Other</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Replay Status -->
    <Enum>
      <Name>Replay Status</Name>
      <Values>
        <Value>
          <Data>A</Data>
          <Name>Request Accepted</Name>
        </Value>
        <Value>
          <Data>D</Data>
          <Name>Request Limit Reached</Name>
        </Value>
        <Value>
          <Data>I</Data>
          <Name>Invalid Market Data Group</Name>
        </Value>
        <Value>
          <Data>O</Data>
          <Name>Out Of Range</Name>
        </Value>
        <Value>
          <Data>U</Data>
          <Name>Replay Unavailable</Name>
        </Value>
        <Value>
          <Data>c</Data>
          <Name>Concurrent Limit Reached</Name>
        </Value>
        <Value>
          <Data>d</Data>
          <Name>Unsupported Message Type</Name>
        </Value>
        <Value>
          <Data>e</Data>
          <Name>Failed Other</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiNairobiMitchPdf>
