<OmiAmdPdf>
  
  <Messages>

    <!--Login Message-->
    <Message>
      <Name>Login Message</Name>
      <Description>Sent to authenticate with the replay server before using the message replay service.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Member</Origin>
      <Category>Replay</Category>
      <Code>13</Code>
      <Fields>
        <Field>
          <Name>username</Name>
          <Type>char(10)</Type>
          <Size>10</Size>
          <Description>As assigned by Aquis for the recipient</Description>
        </Field>
        <Field>
          <Name>password</Name>
          <Type>char(10)</Type>
          <Size>10</Size>
          <Description>As assigned by Aquis for the recipient</Description>
        </Field>
      </Fields>
    </Message>

    <!--Replay Request Message-->
    <Message>
      <Name>Replay Request Message</Name>
      <Description>Sent to request a particular message or range of messages from the replay server.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Member</Origin>
      <Category>Replay</Category>
      <Code>14</Code>
      <Fields>
        <Field>
          <Name>beginSeqNo</Name>
          <Type>u32</Type>
          <Size>4</Size>
          <Description>Stream seqNo of first message requested</Description>
        </Field>
        <Field>
          <Name>endSeqNo</Name>
          <Type>u32</Type>
          <Size>4</Size>
          <Description>Stream seqNo of last message requested</Description>
        </Field>
      </Fields>
    </Message>

    <!--Replay Response Message-->
    <Message>
      <Name>Replay Response Message</Name>
      <Description>Sent by Aquis to acknowledge a successful login or report problems with a Resend Request.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>Session</Category>
      <Code>15</Code>
      <Fields>
        <Field>
          <Name>responseCode</Name>
          <Type>u8</Type>
          <Size>1</Size>
          <Description>Response code</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>
  
  <Bitfields/>
  
  <Enums>

    <!--responseCode-->
    <Enum>
      <Name>responseCode</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>Login Successful</Name>
        </Value>
        <Value>
          <Data>1</Data>
          <Name>Bad beginSeqNo in Resend Request</Name>
        </Value>
        <Value>
          <Data>2</Data>
          <Name>Bad endSeqNo in Resend Request</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>
  
</OmiAmdPdf>