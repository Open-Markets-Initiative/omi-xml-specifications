          <Name>Binary MMT</Name>
          <Type>bitfield</Type>
          <Size>4</Size>
          <Description>Post-trade regulatory flags (MMT)</Description>
        </Field>
      </Fields>
    </Message>

    <!--Tick Table Data Message-->
    <Message>
      <Name>Tick Table Data Message</Name>
      <Description>Published pre-market to specify dynamic tick tables and static ticks controlling valid price increments for securities on the order book.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>MarketData</Category>
      <Code>7</Code>
      <Fields>
        <Field>
          <Name>tickTableID</Name>
          <Type>u8</Type>
          <Size>1</Size>
          <Description>Numeric identifier for this tick table or static tick</Description>
        </Field>
        <Field>
          <Name>name</Name>
          <Type>char(10)</Type>
          <Size>10</Size>
          <Description>Short name</Description>
        </Field>
        <Field>
          <Name>threshold</Name>
          <Type>u64</Type>
          <Size>8</Size>
          <Description>The price threshold at which this tick data applies</Description>
        </Field>
        <Field>
          <Name>tickSize</Name>
          <Type>u64</Type>
          <Size>8</Size>
          <Description>The tick size (price increment)</Description>
        </Field>
      </Fields>
    </Message>

    <!--Security Definition Message-->
    <Message>
      <Name>Security Definition Message</Name>
      <Description>Published pre-market to identify securities traded on Aquis, associating securityID with a particular security.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>MarketData</Category>
      <Code>8</Code>
      <Fields>
        <Field>
          <Name>securityID</Name>
          <Type>u16</Type>
          <Size>2</Size>
          <Description>Numeric identifier of the relevant security</Description>
        </Field>
        <Field>
          <Name>UMTF</Name>
          <Type>char(6)</Type>
          <Size>6</Size>
          <Description>Uniform UMTF code for the security</Description>
        </Field>
        <Field>
          <Name>ISIN</Name>
          <Type>char(12)</Type>
          <Size>12</Size>
          <Description>ISIN for the security</Description>
        </Field>
        <Field>
          <Name>currency</Name>
          <Type>char(3)</Type>
          <Size>3</Size>
          <Description>Trading currency for the security</Description>
        </Field>
        <Field>
          <Name>MIC</Name>
          <Type>char(4)</Type>
          <Size>4</Size>
          <Description>MIC for the security's market of listing</Description>
        </Field>
        <Field>
          <Name>tickTableId</Name>
          <Type>u8</Type>
          <Size>1</Size>
          <Description>Numeric identifier for this security's tick table</Description>
        </Field>
        <Field>
          <Name>Security Definition flags</Name>
          <Type>bitfield</Type>
          <Size>2</Size>
          <Description>Security flags</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>char(20)</Type>
          <Size>20</Size>
          <Description>Reserved</Description>
        </Field>
        <Field>
          <Name>lotSize</Name>
          <Type>u64</Type>
          <Size>8</Size>
          <Description>Lot size for the security; always set to 1,000,000,000 to represent a lot size of 1</Description>
        </Field>
        <Field>
          <Name>lotSizeDecimal</Name>
          <Type>u8</Type>
          <Size>1</Size>
          <Description>Number of decimals implied in lotSize; always set to 9</Description>
        </Field>
      </Fields>
    </Message>

