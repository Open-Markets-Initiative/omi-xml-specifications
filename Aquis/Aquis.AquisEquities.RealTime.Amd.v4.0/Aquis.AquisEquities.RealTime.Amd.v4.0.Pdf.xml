      <Code>6</Code>
      <Fields>
        <Field>
          <Name>securityID</Name>
          <Type>u16</Type>
          <Size>2</Size>
          <Description>Numeric identifier of the relevant security</Description>
        </Field>
        <Field>
          <Name>quantity</Name>
          <Type>u32</Type>
          <Size>4</Size>
          <Description>Number of shares of the original trade</Description>
        </Field>
        <Field>
          <Name>price</Name>
          <Type>u64</Type>
          <Size>8</Size>
          <Description>The execution price of the original trade</Description>
        </Field>
        <Field>
          <Name>tradeRef</Name>
          <Type>u32</Type>
          <Size>4</Size>
          <Description>Trade reference of the busted trade</Description>
        </Field>
        <Field>
          <Name>timestamp</Name>
          <Type>u64</Type>
          <Size>8</Size>
          <Description>Timestamp of this market data event</Description>
        </Field>
