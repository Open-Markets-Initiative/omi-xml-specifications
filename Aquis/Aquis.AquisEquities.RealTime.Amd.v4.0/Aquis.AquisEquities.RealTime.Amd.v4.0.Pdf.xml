    <!--Trade Message-->
    <Message>
      <Name>Trade</Name>
      <Description>Published whenever an order trades, partially or fully.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>MarketData</Category>
      <Code>5</Code>
      <Fields>
        <Field>
          <Name>securityID</Name>
          <Type>u16</Type>
          <Size>2</Size>
          <Description>Numeric identifier of the relevant security</Description>
        </Field>
        <Field>
          <Name>tradeType</Name>
          <Type>u8</Type>
          <Size>1</Size>
          <Description>Code identifying type of trade</Description>
        </Field>
        <Field>
          <Name>quantity</Name>
          <Type>u32</Type>
          <Size>4</Size>
          <Description>Number of shares traded</Description>
        </Field>
        <Field>
          <Name>price</Name>
          <Type>u64</Type>
          <Size>8</Size>
          <Description>The execution price</Description>
        </Field>
        <Field>
          <Name>orderRef</Name>
          <Type>u32</Type>
          <Size>4</Size>
          <Description>Unique order reference number for the day; zero if against hidden quantity or a MaC trade</Description>
        </Field>
        <Field>
          <Name>tradeRef</Name>
          <Type>u32</Type>
          <Size>4</Size>
          <Description>Trade reference number</Description>
        </Field>
        <Field>
          <Name>timestamp</Name>
          <Type>u64</Type>
          <Size>8</Size>
          <Description>Timestamp of this market data event</Description>
        </Field>
        <Field>
          <Name>Binary MMT</Name>
          <Type>bitfield</Type>
          <Size>4</Size>
          <Description>Post-trade regulatory flags (MMT)</Description>
        </Field>
        <Field>
          <Name>mdFlags</Name>
          <Type>bitfield</Type>
          <Size>1</Size>
          <Description>Refer to mdFlags for values</Description>
        </Field>
      </Fields>
    </Message>

    <!--Trade Bust Message-->
    <Message>
      <Name>Trade Bust Message</Name>
