<OmiAmdPdf>
  
  <Messages>

    <!--Order Add Message-->
    <Message>
      <Name>OrderAdd</Name>
      <Description>The Order Add message is published when order quantity is posted to the order book for a particular security.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>MarketData</Category>
      <Code>2</Code>
      <Fields>
        <Field>
          <Name>securityID</Name>
          <Type>u16</Type>
          <Size>2</Size>
          <Description>Numeric identifier of the relevant security</Description>
        </Field>
        <Field>
          <Name>side</Name>
          <Type>u8</Type>
          <Size>1</Size>
          <Description>Side of the order</Description>
        </Field>
        <Field>
          <Name>quantity</Name>
          <Type>u32</Type>
          <Size>4</Size>
          <Description>Number of shares being added to the book</Description>
        </Field>
        <Field>
          <Name>price</Name>
          <Type>u64</Type>
          <Size>8</Size>
          <Description>The price of the order</Description>
        </Field>
        <Field>
          <Name>orderRef</Name>
          <Type>u32</Type>
          <Size>4</Size>
          <Description>Unique order reference number for the day</Description>
        </Field>
        <Field>
          <Name>timestamp</Name>
          <Type>u64</Type>
          <Size>8</Size>
          <Description>Timestamp of this market data event</Description>
        </Field>
        <Field>
          <Name>mdFlags</Name>
          <Type>bitfield</Type>
          <Size>1</Size>
          <Description>Refer to mdFlags for values</Description>
        </Field>
      </Fields>
    </Message>

