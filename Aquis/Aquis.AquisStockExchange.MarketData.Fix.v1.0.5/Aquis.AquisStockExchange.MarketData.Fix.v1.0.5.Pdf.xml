    <!-- Trade Capture Report (3.2.3). Its field names wrap across lines ("SecondaryTradeRep ortID", "TradeReportTransTy pe", "NoTradePriceConditi ons"). The MMT flags (6001 - 6050) are the tags "Trade Capture Report messages are accompanied with", printed in their own table after the message's (3.2.3): Tag, Description, Comments, no Req'd column, so each is optional. The message prints neither a Required column for them nor a place, so they follow the message's own fields -->
    <Message>
      <Name>Trade Capture Report</Name>
      <MsgType>AE</MsgType>
      <Category>app</Category>
      <Origin>Exchange</Origin>
      <Description>The Trade Capture Report outbound message is sent after a successful Trade Capture Report Request Acknowledgement has been sent.</Description>
      <Fields>
        <Field>
          <Tag>571</Tag>
          <Name>TradeReportID</Name>
          <Required>Y</Required>
          <Description>Transaction Reference from the submitted inbound Trade Capture Report. Populated with AQSE ID (818) if receiving party is not part of submitters participant group. For cancels a C will be appended to the original.</Description>
        </Field>
        <Field>
          <Tag>818</Tag>
          <Name>SecondaryTradeReportID</Name>
          <Required>N</Required>
          <Description>The AQSE trade number that was generated from the submitted inbound trade capture report. Not returned on cancels.</Description>
        </Field>
        <Field>
          <Tag>881</Tag>
          <Name>SecondaryTradeReportRefID</Name>
          <Required>N</Required>
          <Description>When amending/cancelling a Trade Report, it is the AQSE generated identifier for the trade being amended.</Description>
        </Field>
        <Field>
          <Tag>487</Tag>
          <Name>TradeReportTransType</Name>
          <Required>Y</Required>
          <Description>Identifies Trade Report message transaction type. 0 = New, 1 = Cancel, 2 = Replace</Description>
        </Field>
        <Field>
          <Tag>568</Tag>
          <Name>TradeRequestID</Name>
          <Required>N</Required>
          <Description>The TradeRequestID from the original Trade Capture Report Request message. Only populated if being sent to the originating Market Maker.</Description>
        </Field>
        <Field>
          <Tag>828</Tag>
          <Name>TrdType</Name>
          <Required>Y</Required>
          <Description>Type of trade. AQSE supported values: 0 = Regular Trade (O), 38 = Large in Scale (L), 101 = Negotiated Trade in Liquid Financial Instruments, 102 = Negotiated Trade in Illiquid Financial Instruments, 103 = Negotiated Trade Subject to Conditions Other Than the Current Market Price</Description>
        </Field>
        <Field>
          <Tag>829</Tag>
          <Name>TrdSubType</Name>
          <Required>Y</Required>
          <Description>Further qualification to the trade type. AQSE supported values: 15 = B, 18 = M, 22 = P, 26 = R, 37 = X</Description>
        </Field>
        <Field>
          <Tag>830</Tag>
          <Name>TrdTypeBenchRef</Name>
          <Required>N</Required>
          <Description>AQSE supported values: 0 = No Benchmark or Reference Price Trade (-), 1 = Benchmark Trade (B), 2 = Reference Price Trade (S)</Description>
        </Field>
        <Group>
          <Name>NoTradePriceConditions</Name>
          <Required>N</Required>
        </Group>
        <Field>
          <Tag>1134</Tag>
          <Name>ReportedPxDiff</Name>
          <Required>N</Required>
          <Description>If there is a reported price difference and TrdType (828) and TrdSubType (829) are not provided, then set Trade Conditions = D.</Description>
        </Field>
        <Field>
          <Tag>55</Tag>
          <Name>Symbol</Name>
          <Required>N</Required>
          <Description>Will always be set to [N/A].</Description>
        </Field>
        <Field>
          <Tag>48</Tag>
          <Name>SecurityID</Name>
          <Required>Y</Required>
          <Description>The ISIN of the security being referenced.</Description>
        </Field>
        <Field>
          <Tag>22</Tag>
          <Name>SecurityIDSource</Name>
          <Required>Y</Required>
          <Description>This field will be always set to the IDSource for ISIN. 4 = ISIN</Description>
        </Field>
        <Field>
          <Tag>32</Tag>
          <Name>LastQty</Name>
          <Required>Y</Required>
          <Description>The number of shares agreed to be traded.</Description>
        </Field>
        <Field>
          <Tag>31</Tag>
          <Name>LastPx</Name>
          <Required>Y</Required>
          <Description>The price at which the trade was agreed in the currency specified in the board TradingSessionID (336).</Description>
        </Field>
        <Field>
          <Tag>75</Tag>
          <Name>TradeDate</Name>
          <Required>Y</Required>
          <Description>Date and time of when the transaction represented by the Trade Capture Report occurred.</Description>
        </Field>
        <Field>
          <Tag>60</Tag>
          <Name>TransactTime</Name>
          <Required>N</Required>
          <Description>Date and time of when the transaction represented by the Trade Capture Report occurred.</Description>
        </Field>
        <Field>
          <Tag>64</Tag>
          <Name>SettlDate</Name>
          <Required>N</Required>
          <Description>The date on which the trade is agreed to settle.</Description>
        </Field>
        <Field>
          <Tag>58</Tag>
          <Name>Text</Name>
          <Required>Y</Required>
          <Description>Populated to pass the trade source name. Only populated if being sent to the originating Market Maker.</Description>
        </Field>
        <Group>
          <Name>NoSides</Name>
          <Required>Y</Required>
        </Group>
        <Field>
          <Tag>6001</Tag>
          <Name>MMT Level 1</Name>
          <Required>N</Required>
          <Description>Market mechanism: 2 = Quote Driven Market</Description>
        </Field>
        <Field>
          <Tag>6002</Tag>
          <Name>MMT Level 2</Name>
          <Required>N</Required>
          <Description>Trading mode: 5 = Trade Reporting (On Exchange)</Description>
        </Field>
        <Field>
          <Tag>6003</Tag>
          <Name>MMT Level 3.1</Name>
          <Required>N</Required>
          <Description>This field is not applicable. Always set to "-"</Description>
        </Field>
        <Field>
          <Tag>6004</Tag>
          <Name>MMT Level 3.2</Name>
          <Required>N</Required>
          <Description>Transaction Type: Negotiation Indicator or Pre-trade Transparency Waiver</Description>
        </Field>
        <Field>
          <Tag>6005</Tag>
          <Name>MMT Level 3.3</Name>
          <Required>N</Required>
          <Description>Transaction Type: Agency Cross Trade Indicator</Description>
        </Field>
        <Field>
          <Tag>6006</Tag>
          <Name>MMT Level 3.4</Name>
          <Required>N</Required>
          <Description>Transaction Type: Modification Type</Description>
        </Field>
        <Field>
          <Tag>6007</Tag>
          <Name>MMT Level 3.5</Name>
          <Required>N</Required>
          <Description>Transaction Type: Benchmark or Reference Price Indicator</Description>
        </Field>
        <Field>
          <Tag>6008</Tag>
          <Name>MMT Level 3.6</Name>
          <Required>N</Required>
          <Description>Transaction Type: Special Dividend Indicator</Description>
        </Field>
        <Field>
          <Tag>6009</Tag>
          <Name>MMT Level 3.7</Name>
          <Required>N</Required>
          <Description>Transaction Type: Off Book Automated Indicator</Description>
        </Field>
        <Field>
          <Tag>6010</Tag>
          <Name>MMT Level 3.8</Name>
          <Required>N</Required>
          <Description>Transaction Type: Ordinary/Standard Trades Outside Price Formation/Discovery Process</Description>
        </Field>
        <Field>
          <Tag>6011</Tag>
          <Name>MMT Level 3.9</Name>
          <Required>N</Required>
          <Description>Transaction Type: Algorithmic Indicator</Description>
        </Field>
        <Field>
          <Tag>6012</Tag>
          <Name>MMT Level 4.1</Name>
          <Required>N</Required>
          <Description>Publication Mode/Post-Trade Deferral: Reason</Description>
        </Field>
        <Field>
          <Tag>6013</Tag>
          <Name>MMT Level 4.2</Name>
          <Required>N</Required>
          <Description>Post-Trade Deferral or Enrichment: Type</Description>
        </Field>
        <Field>
          <Tag>6014</Tag>
          <Name>MMT Level 5</Name>
          <Required>N</Required>
          <Description>Duplicative Indicator</Description>
        </Field>
        <!-- printed "MMT concatenated 14 flags" in the MMT table's Description column, which names the MMT tags: one token, as the loader makes of the shorter "MMT Level 1" (a four word name reads to it as a sentence) -->
        <Field>
          <Tag>6020</Tag>
          <Name>MMTConcatenated14Flags</Name>
          <Required>N</Required>
          <Description>A concatenated string of MMT flags 6001-6014</Description>
        </Field>
        <Field>
          <Tag>6050</Tag>
          <Name>Transaction MIC</Name>
          <Required>N</Required>
          <Description>Provides the Aquis Stock Exchange MIC for the execution</Description>
        </Field>
      </Fields>
    </Message>

    <!-- News (3.3). Market state messages carry Headline (148) "Market State Change" with Text (58) the market state; security suspensions and restorations carry "Suspension of Trading" or "Restoration of Trading" with the symbol in SecurityID (48); FIX participant suspensions and restorations carry the same headlines and the trader CompID -->
    <Message>
      <Name>News</Name>
      <MsgType>B</MsgType>
      <Category>app</Category>
      <Origin>Exchange</Origin>
      <Description>The News message is published to indicate market status updates, suspensions and restorations of a security and suspensions and restorations of a FIX participant.</Description>
      <Fields>
        <Field>
          <Tag>42</Tag>
          <Name>OrigTime</Name>
          <Required>N</Required>
          <Description>Time of message origination.</Description>
        </Field>
        <Field>
          <Tag>148</Tag>
          <Name>Headline</Name>
          <Required>Y</Required>
          <Description>Specifies the headline text.</Description>
        </Field>
        <Group>
          <Name>NoRelatedSymNews</Name>
          <Required>N</Required>
        </Group>
        <Group>
          <Name>NoLinesOfText</Name>
          <Required>Y</Required>
        </Group>
        <Field>
          <Tag>20311</Tag>
          <Name>NewsStatus</Name>
          <Required>N</Required>
          <Description>News broadcast status. 1 = Sent</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Groups>

    <!-- NoMDEntryTypes (267): "Number of MDEntryType fields requested repeating group"; MDEntryType (269*) is its field (3.1.1) -->
    <Group>
      <Name>NoMDEntryTypes</Name>
      <AnchorTag>267</AnchorTag>
      <Fields>
        <Field>
          <Tag>269</Tag>
          <Name>MDEntryType</Name>
          <Required>Y</Required>
          <Description>Must be the first field in this repeating group. This is a list of all the types of Market Data Entries that the firm requesting the Market Data is interested in receiving. AQSE supported values: 0 = Bid, 1 = Offer, 4 = Opening, 5 = Closing. Note: a request for Bid and Offer will always result in both being subscribed to</Description>
        </Field>
      </Fields>
    </Group>

    <!-- NoRelatedSym (146): "Number of securities requested"; TradingSessionID, Symbol, SecurityID and SecurityIDSource are printed with * under it, in this order (3.1.1) -->
    <Group>
      <Name>NoRelatedSym</Name>
      <AnchorTag>146</AnchorTag>
      <Fields>
        <Field>
          <Tag>336</Tag>
          <Name>TradingSessionID</Name>
          <Required>Y</Required>
          <Description>AQSE supported values: EUR/ISDX-exl, USD/ISDX-exl, EUR/ISDX-exn, GBX/ISDX-exl, USD/ISDX-exn, GBX/ISDX-exn, GBP/ISDX-exl, SEK/ISDX-exn, GBP/ISDX-exn, CHF/ISDX-exl, NOK/ISDX-exl. Note: if only the TradingSessionId is specified, then all instrument prices on that board will be provided in which case NoRelatedSym should be set to 1.</Description>
        </Field>
        <Field>
          <Tag>55</Tag>
          <Name>Symbol</Name>
          <Required>N</Required>
          <Description>Not validated as AQSE uses ISIN to identify the security. AQSE supported values: [N/A]</Description>
        </Field>
        <Field>
          <Tag>48</Tag>
          <Name>SecurityID</Name>
          <Required>N</Required>
          <Description>The ISIN of the security being referenced.</Description>
        </Field>
        <Field>
          <Tag>22</Tag>
          <Name>SecurityIDSource</Name>
          <Required>N</Required>
          <Description>This field must always be set to the IDSource for ISIN. AQSE supported values: 4 = ISIN</Description>
        </Field>
      </Fields>
    </Group>

    <!-- NoRelatedSymNews: the News (3.3) variant of NoRelatedSym (146), its Symbol, SecurityID and SecurityIDSource printed with * -->
    <Group>
      <Name>NoRelatedSymNews</Name>
      <AnchorTag>146</AnchorTag>
      <Underlying>NoRelatedSym</Underlying>
      <Fields>
        <Field>
          <Tag>55</Tag>
          <Name>Symbol</Name>
          <Required>N</Required>
          <Description>Will always be set to [N/A].</Description>
        </Field>
        <Field>
          <Tag>48</Tag>
          <Name>SecurityID</Name>
          <Required>N</Required>
          <Description>The ISIN of the security being referenced.</Description>
        </Field>
        <Field>
          <Tag>22</Tag>
          <Name>SecurityIDSource</Name>
          <Required>N</Required>
          <Description>This field must always be set to the IDSource for ISIN. 4 = ISIN</Description>
        </Field>
      </Fields>
    </Group>

    <!-- NoMDEntries (268): "Number of entries following"; MDEntryType, MDEntryPx, MDEntrySize and MDEntryOriginator are printed with * under it (3.1.3) -->
    <Group>
      <Name>NoMDEntries</Name>
      <AnchorTag>268</AnchorTag>
      <Fields>
        <Field>
          <Tag>269</Tag>
          <Name>MDEntryType</Name>
          <Required>N</Required>
          <Description>Type of Market Data entry. AQSE supported values: 0 = Bid, 1 = Offer, 4 = Opening, 5 = Closing</Description>
        </Field>
