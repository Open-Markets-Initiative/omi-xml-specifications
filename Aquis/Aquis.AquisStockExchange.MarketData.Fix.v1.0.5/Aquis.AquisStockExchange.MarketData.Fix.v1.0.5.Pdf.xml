    <!-- Market Data Request (3.1.1). SubscriptionRequestType (263) wraps across three lines -->
    <Message>
      <Name>Market Data Request</Name>
      <MsgType>V</MsgType>
      <Category>app</Category>
      <Origin>Client</Origin>
      <Description>To request Market Data Feed messages, Members must send a Market Data Request message.</Description>
      <Fields>
        <Field>
          <Tag>262</Tag>
          <Name>MDReqID</Name>
          <Required>Y</Required>
          <Description>Unique identifier. This value is not interpreted by the platform when unsubscribing. The list of securities/boards is used to determine which subscriptions to cancel.</Description>
        </Field>
        <Field>
          <Tag>263</Tag>
          <Name>SubscriptionRequestType</Name>
          <Required>Y</Required>
          <Description>Indicates to the other party what type of response is expected. A snapshot request only asks for current information. A subscribe request asks for updates as the status changes. Unsubscribe will cancel any future update messages from the counter party. AQSE supported values: 0 = Snapshot, 1 = Snapshot and Updates (Subscribe), 2 = Unsubscribe</Description>
        </Field>
        <Field>
          <Tag>264</Tag>
          <Name>MarketDepth</Name>
          <Required>Y</Required>
          <Description>1</Description>
        </Field>
        <Group>
          <Name>NoMDEntryTypes</Name>
          <Required>Y</Required>
        </Group>
        <Group>
          <Name>NoRelatedSym</Name>
          <Required>Y</Required>
        </Group>
      </Fields>
    </Message>

