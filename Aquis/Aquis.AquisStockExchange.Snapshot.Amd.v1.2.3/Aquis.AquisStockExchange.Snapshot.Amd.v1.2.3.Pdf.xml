<OmiAmdPdf>

  <Messages>

    <!--Snapshot Start Message-->
    <Message>
      <Name>Snapshot Start Message</Name>
      <Description>A Snapshot Start message is published as the first message in a snapshot to identify the sequence number in the continuous stream that this snapshot relates to. It also states the number of securities being reported in this snapshot. This message is only applicable to continuous trading.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>MarketData</Category>
      <Code>10</Code>
      <Fields>
        <Field>
          <Name>streamSeqNo</Name>
          <Type>u32</Type>
          <Size>4</Size>
          <Description>The sequence number of the last message in the continuous stream which relates to this snapshot</Description>
        </Field>
        <Field>
          <Name>securityCount</Name>
          <Type>u16</Type>
          <Size>2</Size>
          <Description>Number of securities reported in this snapshot</Description>
        </Field>
        <Field>
          <Name>timestamp</Name>
          <Type>u64</Type>
          <Size>8</Size>
          <Description>Timestamp of this snapshot</Description>
        </Field>
      </Fields>
    </Message>

    <!--Book Status Message-->
    <Message>
      <Name>Book Status Message</Name>
      <Description>A Book Status message is published to report the trading and market status of each security and the number of open orders on the order book for the security at the time of the snapshot. This message is only applicable to continuous trading.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>MarketData</Category>
      <Code>11</Code>
      <Fields>
        <Field>
          <Name>securityID</Name>
          <Type>u16</Type>
          <Size>2</Size>
          <Description>Numeric identifier of the relevant security</Description>
        </Field>
        <Field>
          <Name>tradingStatus</Name>
          <Type>u8</Type>
          <Size>1</Size>
          <Description>See Section 3.4.13 (Security Status message)</Description>
        </Field>
        <Field>
          <Name>marketFlags</Name>
          <Type>bitfield</Type>
          <Size>1</Size>
          <Description>See Section 3.4.13 (Security Status message)</Description>
        </Field>
        <Field>
          <Name>entries</Name>
          <Type>u16</Type>
          <Size>2</Size>
          <Description>Number of open orders in the book for this security</Description>
        </Field>
        <Field>
          <Name>closingBuyQty</Name>
          <Type>u32</Type>
          <Size>4</Size>
          <Description>Total order quantity on the buy side during the closing market, otherwise set to 0 (see note 3.4.9)</Description>
        </Field>
        <Field>
          <Name>closingSellQty</Name>
          <Type>u32</Type>
          <Size>4</Size>
          <Description>Total order quantity on the sell side during the closing market, otherwise set to 0 (see note 3.4.9)</Description>
        </Field>
        <Field>
          <Name>indicativePrice</Name>
          <Type>u64</Type>
          <Size>8</Size>
          <Description>Indicative auction price</Description>
        </Field>
      </Fields>
    </Message>

    <!--Book Entry Message-->
    <Message>
      <Name>Book Entry Message</Name>
      <Description>An appropriate number of Book Entry messages is published after each Book Status message to provide details of each order and allow the book to be built. This message is only applicable to continuous trading.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>MarketData</Category>
      <Code>12</Code>
      <Fields>
        <Field>
          <Name>securityID</Name>
          <Type>u16</Type>
          <Size>2</Size>
          <Description>Numeric identifier of the relevant security</Description>
        </Field>
        <Field>
          <Name>Side</Name>
          <Type>u8</Type>
          <Size>1</Size>
          <Description>1 = Buy Order, 2 = Sell Order</Description>
        </Field>
        <Field>
          <Name>quantity</Name>
          <Type>u32</Type>
          <Size>4</Size>
          <Description>Number of open shares</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>u64</Type>
          <Size>8</Size>
          <Description>The price of the order</Description>
        </Field>
        <Field>
          <Name>orderRef</Name>
          <Type>u32</Type>
          <Size>4</Size>
          <Description>Unique order reference number for the day</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Bitfields>

    <!--marketFlags-->
    <Bitfield>
      <Name>marketFlags</Name>
      <Description>Market status flags</Description>
      <Fields>
        <Field>
          <Name>trading</Name>
          <Bits>1</Bits>
          <Description>0 = Continuous Trading Closed (AoD unavailable), 1 = Continuous Trading Open (AoD available)</Description>
        </Field>
        <Field>
          <Name>Unused</Name>
          <Bits>2</Bits>
          <Description>Reserved</Description>
        </Field>
        <Field>
          <Name>pre-open/close</Name>
          <Bits>1</Bits>
          <Description>0 = Not a pre phase, 1 = Pre phase</Description>
        </Field>
        <Field>
          <Name>Unused</Name>
          <Bits>4</Bits>
          <Description>Reserved</Description>
        </Field>
      </Fields>
    </Bitfield>

  </Bitfields>

  <Enums>

    <!--tradingStatus-->
    <Enum>
      <Name>tradingStatus</Name>
      <Values>
        <Value>
          <Data>1</Data>
          <Name>Active</Name>
        </Value>
        <Value>
          <Data>2</Data>
          <Name>Halted</Name>
        </Value>
        <Value>
          <Data>3</Data>
          <Name>Suspended</Name>
        </Value>
      </Values>
    </Enum>

    <!--side-->
    <Enum>
      <Name>side</Name>
      <Values>
        <Value>
          <Data>1</Data>
          <Name>Buy Order</Name>
        </Value>
        <Value>
          <Data>2</Data>
          <Name>Sell Order</Name>
        </Value>
      </Values>
    </Enum>

    <!--trading-->
    <Enum>
      <Name>trading</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>Continuous Trading Closed</Name>
          <Description>Continuous Trading Closed (AoD unavailable)</Description>
        </Value>
        <Value>
          <Data>1</Data>
          <Name>Continuous Trading Open</Name>
          <Description>Continuous Trading Open (AoD available)</Description>
        </Value>
      </Values>
    </Enum>

    <!--pre-open/close-->
    <Enum>
      <Name>pre-open/close</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>Not A Pre Phase</Name>
          <Description>Not a pre phase</Description>
        </Value>
        <Value>
          <Data>1</Data>
          <Name>Pre Phase</Name>
          <Description>Pre phase</Description>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiAmdPdf>
