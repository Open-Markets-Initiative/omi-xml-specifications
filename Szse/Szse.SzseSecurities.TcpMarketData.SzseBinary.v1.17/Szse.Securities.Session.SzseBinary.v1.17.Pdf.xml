<OmiSzseBinaryPdf>

  <!--
    Szse Binary Market Data Feed v1.17, session management messages.

    Transcribed from SZSE Interface Specification of BINARY Market Data Feed (Ver 1.17),
    chapter 4.3 Message Management. These three messages exist only on a Market Data Gateway
    session; the multicast distribution protocol carries its own management packets instead.

    All three are transmitted by both sides of the session. <Origin> names the side the
    specification describes first for each, and the description records the other.

    Field types come from Table 5-2 Definition of Session Layer, with CompID resolved to
    Char[20] by Table 5-1.
  -->

  <Messages>

    <!-- Logon Message -->
    <Message>
      <Name>Logon Message</Name>
      <Dependency>msgtype</Dependency>
      <Branch>payload</Branch>
      <Code>1</Code>
      <Category>Session</Category>
      <Origin>Firm</Origin>
      <Description>Logon message is the first message sent out to Market Data GateWay by Vendor Supplied System. Vendor Supplied System sets up a connection with Market Data GateWay through a logon message, and Market Data GateWay confirms the logon success through a logon message of its own, so both sides transmit this message type.</Description>
      <Fields>
        <Field>
          <Name>SenderCompID</Name>
          <Type>CompID</Type>
          <Size>20</Size>
          <Description>ID number of the sender</Description>
        </Field>
        <Field>
          <Name>TargetCompID</Name>
          <Type>CompID</Type>
          <Size>20</Size>
          <Description>ID number of the receiver</Description>
        </Field>
        <Field>
          <Name>HeartBtInt</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Interval of heartbeats, in seconds, provided to Market Data GateWay by Vendor Supplied System upon a logon</Description>
        </Field>
        <Field>
          <Name>Password</Name>
          <Type>Char[16]</Type>
          <Size>16</Size>
          <Description>Pass word</Description>
        </Field>
        <Field>
          <Name>DefaultApplVerID</Name>
          <Type>Char[32]</Type>
          <Size>32</Size>
          <Description>Binary protocol version, in the form n.xy; the communication version of this specification is 1.02</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Logout Message -->
    <Message>
      <Name>Logout Message</Name>
      <Dependency>msgtype</Dependency>
      <Branch>payload</Branch>
      <Code>2</Code>
      <Category>Session</Category>
      <Origin>Exchange</Origin>
      <Description>When the connection request from Vendor Supplied System is not accepted, Market Data GateWay sends a logout message to refuse the logon request. Vendor Supplied System also sends a logout message voluntarily to disconnect, so both sides transmit this message type.</Description>
      <Fields>
        <Field>
          <Name>SessionStatus</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Session status at a logout</Description>
        </Field>
        <Field>
          <Name>Text</Name>
          <Type>Char[200]</Type>
          <Size>200</Size>
          <Description>Further explanations of logout reasons</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Heartbeat Message -->
    <Message>
      <Name>Heartbeat Message</Name>
      <Dependency>msgtype</Dependency>
      <Branch>payload</Branch>
      <Code>3</Code>
      <Category>Session</Category>
      <Origin>Exchange</Origin>
      <Description>Heartbeat message checks the Tcp connection status between Market Data GateWay and Vendor Supplied System. When one party is at an idle period of data sending it sends a Heartbeat regularly to check the healthiness of the connection, so both sides transmit this message type. BodyLength is 0 and the message carries no body.</Description>
    </Message>

  </Messages>

  <Enums>

    <!-- SessionStatus -->
    <Enum>
      <Name>SessionStatus</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>Active In Session</Name>
        </Value>
        <Value>
          <Data>1</Data>
          <Name>Session Password Has Been Changed</Name>
        </Value>
        <Value>
          <Data>2</Data>
          <Name>Session Password Shall Be Overdue</Name>
        </Value>
        <Value>
          <Data>3</Data>
          <Name>The New Session Password Is Not Consistent With The Instructions</Name>
        </Value>
        <Value>
          <Data>4</Data>
          <Name>Session Logout Is Complete</Name>
        </Value>
        <Value>
          <Data>5</Data>
          <Name>Illegal User Name Or Password</Name>
        </Value>
        <Value>
          <Data>6</Data>
          <Name>User Name Is Locked</Name>
        </Value>
        <Value>
          <Data>7</Data>
          <Name>Logon Is Prohibited At The Current Time</Name>
        </Value>
        <Value>
          <Data>8</Data>
          <Name>Password Is Overdue</Name>
        </Value>
        <Value>
          <Data>9</Data>
          <Name>MsgSeqNum Received Is Too Small</Name>
          <Description>MsgSeqNum(34) received is too small</Description>
        </Value>
        <Value>
          <Data>10</Data>
          <Name>NextExpectedMsgSeqNum Received Is Too Large</Name>
          <Description>NextExpectedMsgSeqNum(789) received is too large</Description>
        </Value>
        <Value>
          <Data>101</Data>
          <Name>Others</Name>
        </Value>
        <Value>
          <Data>102</Data>
          <Name>Invalid Message</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiSzseBinaryPdf>
