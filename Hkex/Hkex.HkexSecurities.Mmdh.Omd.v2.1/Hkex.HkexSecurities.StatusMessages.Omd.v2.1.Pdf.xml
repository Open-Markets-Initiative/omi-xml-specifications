<OmiOmdPdf>

  <Messages>

    <!-- Trading Session Status Message -->
    <Message>
      <Name>Trading Session Status Message</Name>
      <Description>The Trading Session Status provides information on the status of a market segment. It is sent whenever there is change of trading session. This message may be sent on a separate multicast channel from order and trade data and therefore may not be synchronized.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>Status</Category>
      <Code>20</Code>
      <Fields>
        <Field>
          <Name>MarketCode</Name>
          <Type>String</Type>
          <Size>4</Size>
          <Description>Market segment identifier.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Padding.</Description>
        </Field>
        <Field>
          <Name>TradingSessionSubID</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Trading session sub-identifier.</Description>
        </Field>
        <Field>
          <Name>TradingSesStatus</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Status of the current trading session.</Description>
        </Field>
        <Field>
          <Name>TradingSesControlFlag</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Indicates how control of trading session and sub-session transitions are performed.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>4</Size>
          <Description>Padding.</Description>
        </Field>
        <Field>
          <Name>StartDateTime</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Start time of the trading status. Nanoseconds since Unix epoch UTC, precision to the nearest second. 0 if no time is available.</Description>
        </Field>
        <Field>
          <Name>EndDateTime</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>End time of the trading status. Nanoseconds since Unix epoch UTC, precision to the nearest second. 0 if no time is available.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Security Status Message -->
    <Message>
      <Name>Security Status Message</Name>
      <Description>The Security Status message is generated at the start of the business day if the security is not available for trading, and whenever a security state changes.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>Status</Category>
      <Code>21</Code>
      <Fields>
        <Field>
          <Name>SecurityCode</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Uniquely identifies a security available for trading. 5 digit security codes with possible values 1 to 99999.</Description>
        </Field>
        <Field>
          <Name>SuspensionIndicator</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Indicate whether the security is currently halted/suspended for trading. 'Resume' means the security is now available for trading.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>3</Size>
          <Description>Padding.</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- TradingSessionSubID -->
    <Enum>
      <Name>TradingSessionSubID</Name>
      <Values>
        <Value><Data>100</Data><Name>Not Yet Open (NO)</Name></Value>
        <Value><Data>1</Data><Name>POS Order Input (OI)</Name></Value>
        <Value><Data>101</Data><Name>POS No Cancellation (NW)</Name></Value>
        <Value><Data>108</Data><Name>POS Random Matching (RM)</Name></Value>
        <Value><Data>2</Data><Name>POS Order Matching (MA)</Name></Value>
        <Value><Data>7</Data><Name>Blocking (BL)</Name></Value>
        <Value><Data>3</Data><Name>Continuous trading (CT)</Name></Value>
        <Value><Data>105</Data><Name>CAS Reference Price Fixing (RP)</Name></Value>
        <Value><Data>5</Data><Name>CAS Order Input (OI)</Name></Value>
        <Value><Data>106</Data><Name>CAS No Cancellation (NW)</Name></Value>
        <Value><Data>107</Data><Name>CAS Random Close (RC)</Name></Value>
        <Value><Data>4</Data><Name>CAS Order Matching (MA)</Name></Value>
        <Value><Data>102</Data><Name>Exchange Intervention (EI)</Name></Value>
        <Value><Data>103</Data><Name>Close (CL)</Name></Value>
        <Value><Data>104</Data><Name>Order Cancel (OC)</Name></Value>
        <Value><Data>0</Data><Name>Day Close (DC)</Name></Value>
      </Values>
    </Enum>

    <!-- TradingSesStatus -->
    <Enum>
      <Name>TradingSesStatus</Name>
      <Values>
        <Value><Data>0</Data><Name>Unknown (for NO)</Name></Value>
        <Value><Data>10</Data><Name>Halted (for EI)</Name></Value>
        <Value><Data>20</Data><Name>Pre-Open (for POS OI, NW, RM, MA, BL)</Name></Value>
        <Value><Data>30</Data><Name>Open (for CT and OC)</Name></Value>
        <Value><Data>40</Data><Name>Pre-Close (for CAS RP, OI, NW, RC, MA)</Name></Value>
        <Value><Data>50</Data><Name>Closed (for CL)</Name></Value>
        <Value><Data>100</Data><Name>Day Closed (for DC)</Name></Value>
      </Values>
    </Enum>

    <!-- TradingSesControlFlag -->
    <Enum>
      <Name>TradingSesControlFlag</Name>
      <Values>
        <Value><Data>0</Data><Name>Automatic Default</Name></Value>
        <Value><Data>1</Data><Name>Manual (invalidates the normal schedule for the day)</Name></Value>
      </Values>
    </Enum>

    <!-- SuspensionIndicator -->
    <Enum>
      <Name>SuspensionIndicator</Name>
      <Values>
        <Value><Data>2</Data><Name>Trading Halt or Suspend</Name></Value>
        <Value><Data>3</Data><Name>Resume</Name></Value>
      </Values>
    </Enum>

  </Enums>

</OmiOmdPdf>
