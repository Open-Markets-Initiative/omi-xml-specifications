<OmiOmdPdf>

  <Messages>

    <!--TradeStatistics-->
    <Message>
      <Name>Trade Statistics Message</Name>
      <Description>Trade information for completed deals</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>Statistics</Category>
      <Code>360</Code>
      <Fields>
        <Field>
          <Name>OrderbookID</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Uniquely identifies an instrument available for trading</Description>
        </Field>
        <Field>
          <Name>LastPrice</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Last Traded Price</Description>
        </Field>
        <Field>
          <Name>Session</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Session indicator used to distinguish between the T and T+1 sessions</Description>
        </Field>
				<Field>
					<Name>OpenPrice</Name>
					<Type>Int64</Type>
					<Size>8</Size>
					<Description>Price of the first committed</Description>
				</Field>
				<Field>
					<Name>HighPrice</Name>
					<Type>Int64</Type>
					<Size>8</Size>
					<Description>Highest price of normal trades in</Description>
				</Field>
				<Field>
					<Name>LowPrice</Name>
					<Type>Int64</Type>
					<Size>8</Size>
					<Description>Lowest price of normal trades in</Description>
				</Field>
        <Field>
          <Name>TradeReportVolume</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Total volume of reported trades for the respective Session</Description>
        </Field>
        <Field>
          <Name>Turnover</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Cumulative volume for the respective Session</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>3</Size>
          <Description>Padding</Description>
        </Field>
      </Fields>
    </Message>
    

  </Messages>

  <Enums>

    <!-- Session -->
    <Enum>
      <Name>Session</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>T Session</Name>
        </Value>
        <Value>
          <Data>1</Data>
          <Name>T Plus One Session</Name>
        </Value>
      </Values>
    </Enum>
  </Enums>
  
</OmiOmdPdf>