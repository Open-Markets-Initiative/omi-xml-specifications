        </Field>
        <Field>
          <Name>InstrumentGroup</Name>
          <Type>Uint16</Type>
          <Size>2</Size>
          <Description>Instrument Group</Description>
        </Field>
        <Field>
          <Name>Modifier</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
