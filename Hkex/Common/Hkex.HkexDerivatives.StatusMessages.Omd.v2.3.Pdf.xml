    <Message>
      <Name>Market Status</Name>
      <Description>Indicates the state of the Market, Instrument Type, or Class.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>Status Data</Category>
      <Code>320</Code>
      <Fields>
        <Field>
          <Name>StateLevel</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Indicates the level which a state applies to</Description>
        </Field>
        <Field>
          <Name>InstrumentClassKey</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Instrument Class Key in Msg302</Description>
        </Field>
        <Field>
          <Name>Market</Name>
          <Type>Uint16</Type>
          <Size>2</Size>
          <Description>Market Code</Description>
        </Field>
        <Field>
          <Name>InstrumentGroup</Name>
          <Type>Uint16</Type>
          <Size>2</Size>
          <Description>Instrument Group</Description>
        </Field>
        <Field>
          <Name>CommodityCode</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Numerical identifier of the Underlying</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>8</Size>
          <Description>Padding</Description>
        </Field>
        <Field>
          <Name>ActualStartDate</Name>
          <Type>String</Type>
          <Size>8</Size>
          <Description>UTC Start Date</Description>
        </Field>
        <Field>
          <Name>ActualStartTime</Name>
          <Type>String</Type>
          <Size>6</Size>
          <Format>UTC timestamp</Format>
          <Description>Actual start time</Description>
        </Field>
        <Field>
          <Name>PlannedStartDate</Name>
          <Type>String</Type>
          <Size>8</Size>
          <Description>UTC next planned Date</Description>
        </Field>
        <Field>
          <Name>PlannedStartTime</Name>
          <Type>String</Type>
          <Size>6</Size>
          <Format>UTC timestamp</Format>
          <Description>Next planned time</Description>
        </Field>
        <Field>
          <Name>TradingSession</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Business Trading State</Description>
        </Field>
        <Field>
          <Name>State</Name>
          <Type>Uint16</Type>
          <Size>2</Size>
          <Description>Numeric identification of the State Type</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>2</Size>
          <Description>Padding</Description>
        </Field>
      </Fields>
    </Message>

    <Message>
      <Name>Instrument Status</Name>
      <Description>Generated whenever there is a change to suspension indicator or instrument status.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>Status Data</Category>
      <Code>321</Code>
      <Fields>
        <Field>
          <Name>OrderbookID</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Uniquely identifies an instrument available for trading</Description>
        </Field>
        <Field>
          <Name>SuspensionIndicator</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Indicates if the instrument is suspended or not</Description>
        </Field>
        <Field>
          <Name>InstrumentStatus</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>The actual status of the instrument</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>2</Size>
          <Description>Padding</Description>
        </Field>
      </Fields>
    </Message>

    <Message>
      <Name>Commodity And Class Status</Name>
      <Description>Generated whenever a commodity and / or instrument class status changes.</Description>
      <Branch>Payload</Branch>
