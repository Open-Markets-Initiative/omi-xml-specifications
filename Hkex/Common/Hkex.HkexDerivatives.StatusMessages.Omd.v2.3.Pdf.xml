        </Field>
        <Field>
          <Name>InstrumentClassKey</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Instrument Class Key in Msg302</Description>
        </Field>
        <Field>
          <Name>Suspended</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Defines if the commodity or instrument class is suspended or not</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Padding</Description>
        </Field>
      </Fields>
    </Message>

    <Message>
      <Name>VCM Trigger</Name>
      <Description>Generated when VCM is triggered on a particular instrument.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>Status Data</Category>
      <Code>324</Code>
      <Fields>
        <Field>
          <Name>OrderbookID</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Uniquely identifies an instrument available for trading</Description>
        </Field>
        <Field>
          <Name>CoolingOffStartTime</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Time when the cooling off period starts (UTC timestamp)</Description>
        </Field>
        <Field>
          <Name>CoolingOffEndTime</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Time when the cooling off period ends (UTC timestamp)</Description>
        </Field>
        <Field>
          <Name>VCMReferencePrice</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Reference Price</Description>
        </Field>
        <Field>
          <Name>VCMLowerPrice</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Lower price in the price band allowed during the cooling off period</Description>
        </Field>
        <Field>
          <Name>VCMUpperPrice</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Upper price in the price band allowed during the cooling off period</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>2</Size>
          <Description>Padding</Description>
        </Field>
      </Fields>
    </Message>

    <Message>
      <Name>THM Trigger</Name>
