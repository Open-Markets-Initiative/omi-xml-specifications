<OmiOmdPdf>

  <Messages>

    <!-- Delete Order Message -->
    <Message>
      <Name>Delete Order Message</Name>
      <Description>The Delete Order message is generated when an existing order identified by the OrderId is deleted.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>OrderBook</Category>
      <Code>32</Code>
      <Fields>
        <Field>
          <Name>SecurityCode</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Uniquely identifies a security available for trading.</Description>
        </Field>
        <Field>
          <Name>OrderId</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Unique identifier for each order performed within the trading day.</Description>
        </Field>
        <Field>
          <Name>Side</Name>
          <Type>Uint16</Type>
          <Size>2</Size>
          <Description>Side of the order.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>2</Size>
          <Description>Padding.</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- Side -->
    <Enum>
      <Name>Side</Name>
      <Values>
        <Value><Data>0</Data><Name>Bid</Name></Value>
        <Value><Data>1</Data><Name>Offer</Name></Value>
      </Values>
    </Enum>

  </Enums>

</OmiOmdPdf>
