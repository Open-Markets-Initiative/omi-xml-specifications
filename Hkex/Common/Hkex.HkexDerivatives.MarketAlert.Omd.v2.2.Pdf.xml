<OmiOmdPdf>

  <Messages>

    <!--MarketAlert-->
    <Message>
      <Name>Market Alert Message</Name>
      <Description>The Market Alert message is generated periodically to relay market announcements and alerts.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>Alert</Category>
      <Code>323</Code>
      <Fields>
        <Field>
          <Name>AlertID</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>The reference ID for this alert, unique for any given day</Description>
        </Field>
        <Field>
          <Name>Source</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Source ID for this alert message</Description>
        </Field>
        <Field>
          <Name>Header</Name>
          <Type>Binary</Type>
          <Size>320</Size>
          <Description>Header. In the case of multiple fragments, this field is only populated in the first fragment.</Description>
        </Field>
        <Field>
          <Name>LastFragment</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Indicates whether this message is the last in a sequence of messages.</Description>
        </Field>
        <Field>
          <Name>InfoType</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Information Type</Description>
        </Field>
        <Field>
          <Name>Priority</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Priority</Description>
        </Field>
        <Field>
          <Name>NoofLines</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Maximum 3 lines</Description>
        </Field>
        <Field>
          <Name>Content</Name>
          <Type>Binary</Type>
          <Size>320</Size>
          <Description>Market Alert Content</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Groups>

    <Group>
      <Name>Content</Name>
      <Description>Content repeating field</Description>
      <Dependency>NoofLines</Dependency>
    </Group>

  </Groups>

  <Enums>

    <!-- Source -->
    <Enum>
      <Name>Source</Name>
      <Values>
        <Value>
          <Data>N</Data>
          <Name>News</Name>
        </Value>
        <Value>
          <Data>M</Data>
          <Name>Other Market Alerts</Name>
        </Value>
      </Values>
    </Enum>

    <!-- LastFragment -->
    <Enum>
      <Name>LastFragment</Name>
      <Values>
        <Value>
          <Data>Y</Data>
          <Name>Complete</Name>
        </Value>
        <Value>
          <Data>N</Data>
          <Name>Not complete</Name>
        </Value>
      </Values>
    </Enum>

    <!-- InfoType -->
    <Enum>
      <Name>InfoType</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>Not Specified</Name>
        </Value>
        <Value>
          <Data>1</Data>
          <Name>Company Announcement</Name>
        </Value>
        <Value>
          <Data>2</Data>
          <Name>Market Message</Name>
        </Value>
        <Value>
          <Data>3</Data>
          <Name>Static Line</Name>
        </Value>
        <Value>
          <Data>4</Data>
          <Name>Notice Received</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Priority -->
    <Enum>
      <Name>Priority</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>Critical</Name>
        </Value>
        <Value>
          <Data>1</Data>
          <Name>Important</Name>
        </Value>
        <Value>
          <Data>2</Data>
          <Name>Normal</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiOmdPdf>
