    <Message>
      <Name>Add Order Message</Name>
      <Description>The Add Order message is generated when a new order is inserted into the order book</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>Order Book</Category>
      <Code>330</Code>
      <Fields>
        <Field>
          <Name>OrderbookID</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Uniquely identifies a series</Description>
        </Field>
        <Field>
          <Name>OrderID</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Unique identifier per series</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Price</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Number of contracts</Description>
        </Field>
        <Field>
          <Name>Side</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Side of the order</Description>
        </Field>
        <Field>
          <Name>LotType</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Lot Type</Description>
        </Field>
        <Field>
          <Name>OrderType</Name>
          <Type>bitmap</Type>
          <Size>2</Size>
          <Description>Order Type Bitmap</Description>
        </Field>
        <Field>
          <Name>OrderBookPosition</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Order rank information for the</Description>
        </Field>
      </Fields>
    </Message>

