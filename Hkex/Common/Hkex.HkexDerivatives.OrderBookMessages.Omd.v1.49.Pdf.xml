      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>Order Book</Category>
      <Code>332</Code>
      <Fields>
        <Field>
          <Name>OrderbookID</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Uniquely identifies a series</Description>
        </Field>
        <Field>
          <Name>OrderID</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Unique identifier per series and</Description>
