<OmiOmdPdf>

  <Messages>

    <!-- Sequence Reset Message -->
    <Message>
      <Name>Sequence Reset Message</Name>
      <Description>The Sequence Reset message is sent on each multicast channel at start of day. It may also be sent when there is a need for the rectification of stock reference data before market open.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>Control</Category>
      <Code>100</Code>
      <Fields>
        <Field>
          <Name>NewSeqNo</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>New sequence number. Always set to 1.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Disaster Recovery Signal Message -->
    <Message>
      <Name>Disaster Recovery Signal Message</Name>
      <Description>The Disaster Recovery (DR) Signal message is sent on a dedicated multicast channel whenever a site failover scenario is triggered.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>Control</Category>
      <Code>105</Code>
      <Fields>
        <Field>
          <Name>DRStatus</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Status during site failover.</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- DRStatus -->
    <Enum>
      <Name>DRStatus</Name>
      <Values>
        <Value>
          <Data>1</Data>
          <Name>DR in progress</Name>
        </Value>
        <Value>
          <Data>2</Data>
          <Name>DR completed</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiOmdPdf>
