<OmiOmdPdf>

  <Messages>

    <!-- Trade Message -->
    <Message>
      <Name>Trade Message</Name>
      <Description>The Trade message is generated each time a trade has been performed.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>Trade</Category>
      <Code>50</Code>
      <Fields>
        <Field>
          <Name>SecurityCode</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Uniquely identifies a security available for trading.</Description>
        </Field>
        <Field>
          <Name>TradeID</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Unique identifier per security for each trade performed within the trading system. Starting from 1, incrementing by 1. Reset for each trading day.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Price. 3 implied decimal places.</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Number of shares.</Description>
        </Field>
        <Field>
          <Name>TrdType</Name>
          <Type>Int16</Type>
          <Size>2</Size>
          <Description>Public trade type.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>2</Size>
          <Description>Padding.</Description>
        </Field>
        <Field>
          <Name>TradeTime</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Time of trade. Nanoseconds since Unix epoch UTC. Precision to microsecond.</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- TrdType -->
    <Enum>
      <Name>TrdType</Name>
      <Values>
        <Value><Data>0</Data><Name>Automatch normal (Public Trade Type space)</Name></Value>
        <Value><Data>4</Data><Name>Late Trade Off-exchange previous day (Public Trade Type P)</Name></Value>
        <Value><Data>22</Data><Name>Non-direct Off-Exchange Trade (Public Trade Type M)</Name></Value>
        <Value><Data>100</Data><Name>Automatch internalized (Public Trade Type Y)</Name></Value>
        <Value><Data>101</Data><Name>Direct off-exchange Trade (Public Trade Type X)</Name></Value>
        <Value><Data>102</Data><Name>Odd-Lot Trade (Public Trade Type D)</Name></Value>
        <Value><Data>103</Data><Name>Auction Trade (Public Trade Type U)</Name></Value>
        <Value><Data>104</Data><Name>Overseas Trade</Name></Value>
      </Values>
    </Enum>

  </Enums>

</OmiOmdPdf>
