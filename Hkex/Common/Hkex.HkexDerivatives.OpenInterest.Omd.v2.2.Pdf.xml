<OmiOmdPdf>

  <Messages>

    <!--OpenInterest-->
    <Message>
      <Name>Open Interest Message</Name>
      <Description>Issued to show the Previous Day settlement price and open interest</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>Clearing</Category>
      <Code>366</Code>
      <Fields>
        <Field>
          <Name>DayIndicator</Name>
          <Type>Uint16</Type>
          <Size>2</Size>
          <Description>Session indicator used to</Description>
        </Field>
				<Field>
					<Name>Filler</Name>
					<Type>String</Type>
					<Size>6</Size>
					<Description>Padding</Description>
				</Field>
        <Field>
          <Name>OrderbookID</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Uniquely identifies the series</Description>
        </Field>
        <Field>
          <Name>SettlementPrice</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>‘DecimalInPremium’</Description>
					<Format>Null means N/A</Format>
        </Field>
        <Field>
          <Name>GrossOI</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>If DayIndicator = 1,</Description>
					<Format>Null means N/A</Format>
        </Field>
        <Field>
          <Name>NetOI</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>If DayIndicator =1,</Description>
					<Format>Null means N/A</Format>
        </Field>
      </Fields>
    </Message>

  </Messages>
  
  <Enums>
    
    <!-- DayIndicator -->
    <Enum>
      <Name>DayIndicator</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>Current Trading Day</Name>
        </Value>
        <Value>
          <Data>1</Data>
          <Name> Previous Trading Day</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>
  
