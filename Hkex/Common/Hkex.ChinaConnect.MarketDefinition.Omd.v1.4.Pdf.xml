<OmiOmdPdf>

  <Messages>

    <!-- Market Definition Message -->
    <Message>
      <Name>Market Definition Message</Name>
      <Description>The Market Definition message is generated at the start of the business day for each market (SSE or SZSE). Market Definition messages for different markets are sent via different channels.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>Reference</Category>
      <Code>610</Code>
      <Fields>
        <Field>
          <Name>MarketCode</Name>
          <Type>String</Type>
          <Size>4</Size>
          <Description>Market code.</Description>
        </Field>
        <Field>
          <Name>MarketName</Name>
          <Type>String</Type>
          <Size>25</Size>
          <Description>Market Name.</Description>
        </Field>
        <Field>
          <Name>CurrencyCode</Name>
          <Type>String</Type>
          <Size>3</Size>
          <Description>Base currency code of the market.</Description>
        </Field>
        <Field>
          <Name>NumberOfSecurities</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Number of securities within the market.</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- MarketCode -->
    <Enum>
      <Name>MarketCode</Name>
      <Values>
        <Value><Data>ASHR</Data><Name>SSE A-Share</Name></Value>
        <Value><Data>ASZR</Data><Name>SZSE A-Share</Name></Value>
      </Values>
    </Enum>

  </Enums>

</OmiOmdPdf>
