    <!--MarketStatus-->
    <Message>
      <Name>Market Status Message</Name>
      <Description>The Market Status message can be used to derive the active state of a series</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category></Category>
      <Code>320</Code>
      <Fields>
        <Field>
          <Name>StateLevel</Name>
          <Type>Uint16</Type>
          <Size>2</Size>
          <Description>Indicates the level which a state applies</Description>
        </Field>
        <Field>
          <Name>Market</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Market Code</Description>
        </Field>
        <Field>
          <Name>InstrumentGroup</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Instrument Group</Description>
        </Field>
        <Field>
          <Name>OrderbookID</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Orderbook ID</Description>
        </Field>
        <Field>
          <Name>CommodityCode</Name>
          <Type>Uint16</Type>
          <Size>2</Size>
          <Description>Commodity</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>2</Size>
          <Description>Padding</Description>
        </Field>
        <Field>
          <Name>ActualStartDate</Name>
          <Type>String</Type>
          <Size>8</Size>
          <Description>UTC Start Date </Description>
          <Format>YYYYMMDD</Format>
        </Field>
        <Field>
          <Name>ActualStartTime</Name>
          <Type>String</Type>
          <Size>6</Size>
          <Description>UTC Start Time  If specified it is a</Description>
          <Format>HHMMSS</Format>
        </Field>
        <Field>
          <Name>PlannedStartDate</Name>
          <Type>String</Type>
          <Size>8</Size>
          <Description>UTC next planned Date</Description>
          <Format>YYYYMMDD</Format>
        </Field>
        <Field>
          <Name>PlannedStartTime</Name>
          <Type>String</Type>
          <Size>6</Size>
          <Description>UTC next planned time</Description>
          <Format>HHMMSS</Format>
        </Field>
        <Field>
          <Name>SecondsToStateChange</Name>
          <Type>Uint16</Type>
          <Size>2</Size>
          <Description>Number of seconds to the next</Description>
        </Field>
        <Field>
          <Name>State</Name>
          <Type>Uint16</Type>
          <Size>2</Size>
          <Description>Numeric identification of the State Type</Description>
        </Field>
        <Field>
          <Name>Priority</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>The priority of the State, either the</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>3</Size>
          <Description>Padding</Description>
        </Field>
      </Fields>
    </Message>
    
    <!--SeriesStatus-->
    <Message>
      <Name>Series Status Message</Name>
      <Description>The Series Status message is generated whenever there is a change to suspension indicator or series status, or when the date/time of last trading is changed</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>Status</Category>
      <Code>321</Code>
      <Fields>
        <Field>
          <Name>OrderbookID</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Numerical identifier of the order</Description>
        </Field>
        <Field>
          <Name>SuspensionIndicator</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Indicates if the series is suspended</Description>
        </Field>
        <Field>
          <Name>SeriesStatus</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>The actual status of the series</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>2</Size>
          <Description>Padding</Description>
        </Field>
      </Fields>
    </Message>
    
    <!--CommodityStatus-->
    <Message>
      <Name>Commodity Status Message</Name>
      <Description>The Commodity Status message is generated whenever a commodity status changes</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>Status</Category>
      <Code>322</Code>
      <Fields>
        <Field>
          <Name>CommodityCode</Name>
          <Type>Uint16</Type>
          <Size>2</Size>
          <Description>Underlying definitions are defined</Description>
        </Field>
        <Field>
          <Name>Suspended</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Defines if the commodity is</Description>
        </Field>
        <Field>
          <Name>Locked</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Specifics if the underlying is locked</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

