<OmiOmdPdf>

  <Messages>

    <!-- Add Order Message -->
    <Message>
      <Name>Add Order Message</Name>
      <Description>The Add Order message is generated when a new order is inserted into the order book. The OrderId is unique per security but will not increment consecutively. Note for Securities instruments the OrderBookPosition is always set to zero.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>OrderBook</Category>
      <Code>30</Code>
      <Fields>
        <Field>
          <Name>SecurityCode</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Uniquely identifies a security available for trading. 5 digit security codes with possible values 1 to 99999.</Description>
        </Field>
        <Field>
          <Name>OrderId</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Unique identifier for each order performed within the trading day. Values may not be consecutive.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Price. 3 implied decimal places.</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Number of shares.</Description>
        </Field>
        <Field>
          <Name>Side</Name>
          <Type>Uint16</Type>
          <Size>2</Size>
          <Description>Side of the order.</Description>
        </Field>
        <Field>
          <Name>OrderType</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Order type.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Padding.</Description>
        </Field>
        <Field>
          <Name>OrderBookPosition</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Order rank information for the order position within the order book for each security.</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- Side -->
    <Enum>
      <Name>Side</Name>
      <Values>
        <Value><Data>0</Data><Name>Bid</Name></Value>
        <Value><Data>1</Data><Name>Offer</Name></Value>
      </Values>
    </Enum>

    <!-- OrderType -->
    <Enum>
      <Name>OrderType</Name>
      <Values>
        <Value><Data>1</Data><Name>Market</Name></Value>
        <Value><Data>2</Data><Name>Limit</Name></Value>
      </Values>
    </Enum>

  </Enums>

</OmiOmdPdf>
