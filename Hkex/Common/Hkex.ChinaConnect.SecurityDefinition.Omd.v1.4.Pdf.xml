<OmiOmdPdf>

  <Messages>

    <!-- Security Definition Message -->
    <Message>
      <Name>Security Definition Message</Name>
      <Description>The Security Definition message contains all the reference data for a security. Security Definition messages for different markets (SSE and SZSE) are sent via different channels.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>Reference</Category>
      <Code>611</Code>
      <Fields>
        <Field>
          <Name>SecurityCode</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Uniquely identifies a security available for trading. 6 digit security codes with possible values 1 to 999999.</Description>
        </Field>
        <Field>
          <Name>MarketCode</Name>
          <Type>String</Type>
          <Size>4</Size>
          <Description>Market code.</Description>
        </Field>
        <Field>
          <Name>ISINCode</Name>
          <Type>String</Type>
          <Size>12</Size>
          <Description>ISIN code of the security.</Description>
        </Field>
        <Field>
          <Name>InstrumentType</Name>
          <Type>String</Type>
          <Size>4</Size>
          <Description>Instrument type of the security.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>2</Size>
          <Description>Padding.</Description>
        </Field>
        <Field>
          <Name>SecurityShortName</Name>
          <Type>String</Type>
          <Size>40</Size>
          <Description>Security short name.</Description>
        </Field>
        <Field>
          <Name>CurrencyCode</Name>
          <Type>String</Type>
          <Size>3</Size>
          <Description>Security currency code of the market.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>Binary</Type>
          <Size>60</Size>
          <Description>Padding.</Description>
        </Field>
        <Field>
          <Name>SecurityNameGB</Name>
          <Type>Binary</Type>
          <Size>60</Size>
          <Description>Security name in Simplified Chinese using Unicode UTF-16LE encoding.</Description>
        </Field>
        <Field>
          <Name>LotSize</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Board lot size for the security.</Description>
        </Field>
        <Field>
          <Name>PreviousClosingPrice</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Previous closing price of the security. 3 implied decimal places. May be 0 on first day of listing.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Padding.</Description>
        </Field>
        <Field>
          <Name>ShortsellFlag</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Indicator for short-sell authorization.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>6</Size>
          <Description>Padding.</Description>
        </Field>
        <Field>
          <Name>ListingDate</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Date of security listing. YYYYMMDD. Value is 19000101 for unknown listing date.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>7</Size>
          <Description>Padding.</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- MarketCode -->
    <Enum>
      <Name>MarketCode</Name>
      <Values>
        <Value><Data>ASHR</Data><Name>SSE A-Share</Name></Value>
        <Value><Data>ASZR</Data><Name>SZSE A-Share</Name></Value>
      </Values>
    </Enum>

    <!-- InstrumentType -->
    <Enum>
      <Name>InstrumentType</Name>
      <Values>
        <Value><Data>EQTY</Data><Name>Equities</Name></Value>
        <Value><Data>TRST</Data><Name>Trusts</Name></Value>
      </Values>
    </Enum>

    <!-- ShortsellFlag -->
    <Enum>
      <Name>ShortsellFlag</Name>
      <Values>
        <Value><Data>Y</Data><Name>Short-sell allowed</Name></Value>
        <Value><Data>N</Data><Name>Short-sell not allowed</Name></Value>
      </Values>
    </Enum>

  </Enums>

</OmiOmdPdf>
