      <Name>SequenceReset</Name>
      <Description>The Sequence Reset message is sent on each multicast channel at start of day</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>Control</Category>
      <Code>100</Code>
      <Fields>
        <Field>
          <Name>NewSeqNo</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>New sequence number</Description>
        </Field>
      </Fields>
    </Message>

    <!--Disaster Recovery Signal-->
    <Message>
      <Name>Disaster Recovery Signal Message</Name>
      <Description>The Disaster Recovery Signal message is sent on a dedicated multicast channel whenever a site failover scenario is triggered</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>Control</Category>
      <Code>105</Code>
      <Fields>
        <Field>
          <Name>DRStatus</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Status during site failover</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>
  
  <Enums>
    
    <!-- Disaster Recovery Status -->
    <Enum>
      <Name>DRStatus</Name>
      <Values>
        <Value>
          <Data>1</Data>
          <Name>DR in progress</Name>
        </Value>
        <Value>
          <Data>2</Data>
          <Name>DR completed</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>
  
