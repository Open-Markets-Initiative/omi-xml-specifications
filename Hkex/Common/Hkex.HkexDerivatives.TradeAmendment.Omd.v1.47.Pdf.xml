      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>Trade</Category>
      <Code>356</Code>
      <Fields>
        <Field>
          <Name>TradeID</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Match ID</Description>
        </Field>
        <Field>
          <Name>ComboGroupID</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Used to group combo and leg</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Traded Price</Description>
        </Field>
        <Field>
          <Name>TradeQuantity</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Defines number of contracts in a</Description>
        </Field>
        <Field>
          <Name>TradeTime</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Date and time of the last trade</Description>
          <Format>UTC Timestamp</Format>
        </Field>
        <Field>
          <Name>TradeState</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Trade State</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>3</Size>
          <Description>Padding</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>
    
    <!--TradeState-->
    <Enum>
      <Name>TradeState</Name>
      <Values>
        <Value>
          <Data>1</Data>
          <Name>Given up trade</Name>
          <Description>The trade has been deleted</Description>
        </Value>
        <Value>
          <Data>2</Data>
          <Name>Rectified</Name>
          <Description>The trade has been rectified</Description>
        </Value>
        <Value>
          <Data>3</Data>
          <Name>Deleted</Name>
          <Description>Normal</Description>
        </Value>
      </Values>
    </Enum>

  </Enums>
  
