      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>Alert</Category>
      <Code>323</Code>
      <Fields>
        <Field>
          <Name>AlertID</Name>
          <Type>Uint16</Type>
          <Size>2</Size>
          <Description>The reference ID for this alert,</Description>
        </Field>
        <Field>
          <Name>Source</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Source ID for this alert message</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Padding</Description>
        </Field>
        <Field>
          <Name>Header</Name>
          <Type>Binary</Type>
          <Size>320</Size>
          <Description>Header</Description>
        </Field>
        <Field>
          <Name>LastFragment</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Indicates whether this message is</Description>
        </Field>
        <Field>
          <Name>InfoType</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Information Type</Description>
        </Field>
        <Field>
          <Name>Priority</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Priority</Description>
        </Field>
        <Field>
          <Name>NoLines</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Maximum 3 lines</Description>
        </Field>
        <Field>
          <Name>Content</Name>
          <Type>Binary</Type>
          <Size>320</Size>
          <Description>Market Alert Content</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

