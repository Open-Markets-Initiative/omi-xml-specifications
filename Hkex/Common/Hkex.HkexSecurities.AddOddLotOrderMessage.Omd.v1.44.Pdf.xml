<OmiOmdPdf>

  <Messages>

    <!-- Add Odd Lot Order Message -->
    <Message>
      <Name>Add Odd Lot Order Message</Name>
      <Description>The Add Odd Lot Order message is generated when a new odd lot order is inserted into the order book.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>OrderBook</Category>
      <Code>33</Code>
      <Fields>
        <Field>
          <Name>SecurityCode</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Uniquely identifies a security available for trading.</Description>
        </Field>
        <Field>
          <Name>OrderId</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Unique identifier for each order performed within the trading day.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Price. 3 implied decimal places.</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Number of shares.</Description>
        </Field>
        <Field>
          <Name>BrokerID</Name>
          <Type>Uint16</Type>
          <Size>2</Size>
          <Description>Integer identifier uniquely identifying the Broker.</Description>
        </Field>
        <Field>
          <Name>Side</Name>
          <Type>Uint16</Type>
          <Size>2</Size>
          <Description>Side of the order.</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- Side -->
    <Enum>
      <Name>Side</Name>
      <Values>
        <Value><Data>0</Data><Name>Bid</Name></Value>
        <Value><Data>1</Data><Name>Offer</Name></Value>
      </Values>
    </Enum>

  </Enums>

</OmiOmdPdf>
