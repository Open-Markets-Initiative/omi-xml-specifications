<OmiOmdPdf>

  <Messages>

    <!--Trade-->
    <Message>
      <Name>Trade</Name>
      <Description>The trade message is generated each time a trade has been performed.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>Trade</Category>
      <Code>350</Code>
      <Fields>
        <Field>
          <Name>OrderbookID</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Uniquely identifies an instrument available for trading</Description>
        </Field>
        <Field>
          <Name>OrderID</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Order ID. 0 if not available.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Traded Price. Decimal places determined from Class Definition field DecimalInPrice. Null means N/A.</Description>
        </Field>
        <Field>
          <Name>TradeID</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Unique trade identification.</Description>
        </Field>
        <Field>
          <Name>MatchID</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>An identifier that links all trade which are executed as part of a single execution operation involving an aggressing order.</Description>
        </Field>
        <Field>
          <Name>StatisticsUpdate</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Statistics update indicator.</Description>
        </Field>
        <Field>
          <Name>MatchType</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Match Type</Description>
        </Field>
        <Field>
          <Name>TradeType</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Trade Type</Description>
        </Field>
        <Field>
          <Name>TradeSubtype</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>The condition in which a trade was executed.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>4</Size>
          <Description>Padding</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>The quantity being matched in this execution.</Description>
        </Field>
        <Field>
          <Name>TradeTime</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Date and time of the trade. UTC nanoseconds since 1970-01-01 00:00:00 GMT, precision to nearest microsecond.</Description>
          <Format>UTC Timestamp</Format>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- StatisticsUpdate -->
    <Enum>
      <Name>StatisticsUpdate</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>No update</Name>
        </Value>
        <Value>
          <Data>1</Data>
          <Name>Open/High/Low/Last Price and Turnover update</Name>
        </Value>
        <Value>
          <Data>2</Data>
          <Name>Turnover update only</Name>
        </Value>
      </Values>
    </Enum>

    <!-- MatchType -->
    <Enum>
      <Name>MatchType</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>Continuous Match</Name>
        </Value>
        <Value>
          <Data>1</Data>
          <Name>Opening Uncross</Name>
        </Value>
        <Value>
          <Data>2</Data>
          <Name>Block Trade</Name>
        </Value>
      </Values>
    </Enum>

    <!-- TradeType -->
    <Enum>
      <Name>TradeType</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>T Session Trade</Name>
        </Value>
        <Value>
          <Data>1</Data>
          <Name>T+1 (AHT) Session Trade</Name>
        </Value>
      </Values>
    </Enum>

    <!-- TradeSubtype -->
    <Enum>
      <Name>TradeSubtype</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>Not Available</Name>
        </Value>
        <Value>
          <Data>1</Data>
          <Name>Explicit Order vs Explicit Order</Name>
        </Value>
        <Value>
          <Data>2</Data>
          <Name>Explicit Order vs Implied Order</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiOmdPdf>
