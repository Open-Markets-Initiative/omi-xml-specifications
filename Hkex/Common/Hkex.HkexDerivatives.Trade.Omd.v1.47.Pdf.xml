<OmiOmdPdf>

  <Messages>

    <!--Trade-->
    <Message>
      <Name>Trade Message</Name>
      <Description>The trade message is generated each time a trade has been performed</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>Trade</Category>
      <Code>350</Code>
      <Fields>
        <Field>
          <Name>OrderbookID</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Orderbook ID</Description>
        </Field>
        <Field>
          <Name>OrderID</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Order ID</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Traded Price</Description>
        </Field>
        <Field>
          <Name>TradeID</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Unique trade identification</Description>
        </Field>
        <Field>
          <Name>ComboGroupID</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Used to group combo and</Description>
        </Field>
        <Field>
          <Name>Trade Side</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Side of Orderbook ID</Description>
        </Field>
        <Field>
          <Name>DealType</Name>
          <Type>bitmap</Type>
          <Size>1</Size>
          <Description>Deal Type Bitmap</Description>
        </Field>
        <Field>
          <Name>TradeCondition</Name>
          <Type>bitmap</Type>
          <Size>2</Size>
          <Description>The condition in which a trade was executed</Description>
        </Field>
        <Field>
          <Name>DealInfo</Name>
          <Type>Uint16</Type>
          <Size>2</Size>
          <Description>Information flags</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>2</Size>
          <Description>Padding</Description>
        </Field>
        <Field>
          <Name>TradeQuantity</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>The quantity being matched</Description>
        </Field>
        <Field>
          <Name>TradeTime</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Date and time of the last</Description>
          <Format>UTC Timestamp</Format>
        </Field>
      </Fields>
    </Message>
   
  </Messages>

  <Bitmaps>

    <!-- DealType -->
    <Bitmap>
      <Name>DealType</Name>
      <Description>Deal type bitmap</Description>
      <Fields>
        <Field>
          <Name>Printable</Name>
          <Bits>1</Bits>
          <Description>Printable</Description>
        </Field>
        <Field>
          <Name>Occurred at Cross</Name>
          <Bits>1</Bits>
          <Description>Occurred at Cross</Description>
        </Field>
        <Field>
          <Name>Reported Trade</Name>
          <Bits>1</Bits>
          <Description>Reported Trade</Description>
        </Field>
        <Field>
          <Name>Unused 5</Name>
          <Bits>5</Bits>
          <Description>Reserved</Description>
        </Field>
      </Fields>
    </Bitmap>

    <!-- TradeCondition -->
    <Bitmap>
      <Name>TradeCondition</Name>
      <Description>Trade condition bitmap</Description>
      <Fields>
        <Field>
          <Name>Late Trade</Name>
          <Bits>1</Bits>
          <Description>Late Trade</Description>
        </Field>
        <Field>
          <Name>Internal Trade Or Cross </Name>
          <Bits>1</Bits>
          <Description> Internal Trade / Crossing </Description>
        </Field>
        <Field>
          <Name>Buy Write</Name>
          <Bits>1</Bits>
          <Description>Buy Write </Description>
        </Field>
        <Field>
          <Name>Off Market </Name>
          <Bits>1</Bits>
          <Description>Off Market </Description>
        </Field>
        <Field>
          <Name>Unused 12</Name>
          <Bits>12</Bits>
          <Description>Reserved</Description>
        </Field>
      </Fields>
    </Bitmap>

    <!-- DealInfo -->
    <Bitmap>
      <Name>DealInfo</Name>
      <Description>Trade condition bitmap</Description>
      <Fields>
        <Field>
          <Name>Reported Trade</Name>
          <Bits>1</Bits>
          <Description>Reported Trade</Description>
        </Field>
        <Field>
          <Name>Unused 15</Name>
          <Bits>15</Bits>
          <Description>Reserved</Description>
        </Field>
      </Fields>
    </Bitmap>
    
  </Bitmaps>

  <Enums>
    
    <!-- (Trade) Side -->
    <Enum>
      <Name>Trade Side</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>Not Available</Name>
        </Value>
        <Value>
          <Data>1</Data>
          <Name>Not defined</Name>
        </Value>
        <Value>
          <Data>2</Data>
          <Name>Buy Order</Name>
        </Value>
        <Value>
          <Data>3</Data>
          <Name>Sell Order</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>
  
</OmiOmdPdf>