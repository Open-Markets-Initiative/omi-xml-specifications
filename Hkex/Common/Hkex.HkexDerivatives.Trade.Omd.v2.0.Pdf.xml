				</Field>
				<Field>
					<Name>TradeCondition</Name>
					<Type>Uint8</Type>
					<Size>1</Size>
					<Description>The condition in which a trade was executed</Description>
				</Field>
				<Field>
					<Name>Filler</Name>
					<Type>String</Type>
					<Size>3</Size>
					<Description>Padding</Description>
				</Field>
				<Field>
					<Name>Quantity</Name>
					<Type>Uint32</Type>
					<Size>4</Size>
					<Description>The quantity being matched in this execution.</Description>
				</Field>
        <Field>
          <Name>TradeTime</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Date and time of the last</Description>
