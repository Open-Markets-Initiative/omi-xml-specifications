          <Description>Order ID</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Traded Price</Description>
		      <Format>Null means N/A</Format>
        </Field>
        <Field>
          <Name>TradeID</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
