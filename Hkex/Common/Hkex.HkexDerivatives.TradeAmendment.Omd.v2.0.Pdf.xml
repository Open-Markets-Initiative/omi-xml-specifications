      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>Trade</Category>
      <Code>356</Code>
      <Fields>
				<Field>
					<Name>OrderbookID</Name>
					<Type>Uint32</Type>
					<Size>4</Size>
					<Description>Uniquely identifies an instrument available for trading</Description>
				</Field>
        <Field>
          <Name>TradeID</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Unique trade identification.</Description>
        </Field>
				<Field>
					<Name>Price</Name>
					<Type>Int64</Type>
					<Size>8</Size>
					<Description>Traded Price</Description>
				</Field>
				<Field>
					<Name>Quantity</Name>
					<Type>Uint32</Type>
					<Size>4</Size>
					<Description>Defines number of contracts in a trade</Description>
				</Field>
				<Field>
					<Name>AmendmentExecutionTime</Name>
					<Type>Uint64</Type>
					<Size>8</Size>
					<Description>Date and time of the trade amendment execution</Description>
					<Format>UTC Timestamp</Format>
				</Field>
        <Field>
          <Name>TradeState</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Trade State</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>3</Size>
          <Description>Padding</Description>
        </Field>
      </Fields>
