<OmiOmdPdf>

  <Messages>

    <!-- Aggregate Order Book Update Message -->
    <Message>
      <Name>Aggregate Order Book Update Message</Name>
      <Description>The Aggregate Order Book Update message is sent whenever there is an orderbook change. Applies to Board Lots only.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>OrderBook</Category>
      <Code>53</Code>
      <Fields>
        <Field>
          <Name>SecurityCode</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Uniquely identifies a security available for trading.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>3</Size>
          <Description>Padding.</Description>
        </Field>
        <Field>
          <Name>NoEntries</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Number of book entries within the message.</Description>
        </Field>
        <Field>
          <Name>BookEntry</Name>
          <Type>group</Type>
          <Description>Book entry repeating group.</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Groups>

    <!-- BookEntry -->
    <Group>
      <Name>BookEntry</Name>
      <Description>Aggregate order book entry repeating group.</Description>
      <Dependency>NoEntries</Dependency>
      <Fields>
        <Field>
          <Name>AggregateQuantity</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Aggregated number of shares.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Price. 3 implied decimal places.</Description>
        </Field>
        <Field>
          <Name>NumberOfOrders</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Number of orders.</Description>
        </Field>
        <Field>
          <Name>Side</Name>
          <Type>Uint16</Type>
          <Size>2</Size>
          <Description>Side of the order.</Description>
        </Field>
        <Field>
          <Name>PriceLevel</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Price level.</Description>
        </Field>
        <Field>
          <Name>UpdateAction</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Type of market data update action.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>4</Size>
          <Description>Padding.</Description>
        </Field>
      </Fields>
    </Group>

  </Groups>

  <Enums>

    <!-- Side -->
    <Enum>
      <Name>Side</Name>
      <Values>
        <Value><Data>0</Data><Name>Bid</Name></Value>
        <Value><Data>1</Data><Name>Offer</Name></Value>
      </Values>
    </Enum>

    <!-- UpdateAction -->
    <Enum>
      <Name>UpdateAction</Name>
      <Values>
        <Value><Data>0</Data><Name>New</Name></Value>
        <Value><Data>1</Data><Name>Change</Name></Value>
        <Value><Data>2</Data><Name>Delete</Name></Value>
        <Value><Data>74</Data><Name>Orderbook Clear</Name></Value>
      </Values>
    </Enum>

  </Enums>

</OmiOmdPdf>
