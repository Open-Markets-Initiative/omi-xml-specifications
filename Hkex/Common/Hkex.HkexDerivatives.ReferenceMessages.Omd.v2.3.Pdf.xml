          <Size>4</Size>
          <Description>Numerical identifier of the Underlying</Description>
        </Field>
        <Field>
          <Name>CommodityName</Name>
          <Type>String</Type>
          <Size>40</Size>
          <Description>Descriptive Name of the underlying</Description>
        </Field>
        <Field>
          <Name>CommodityID</Name>
          <Type>String</Type>
          <Size>6</Size>
          <Description>Commodity ID of the underlying</Description>
        </Field>
