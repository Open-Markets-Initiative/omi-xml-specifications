          <Name>UnderlyingCode</Name>
          <Type>String</Type>
          <Size>20</Size>
          <Description>Underlying Code of the Commodity</Description>
        </Field>
        <Field>
          <Name>UnderlyingType</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Type of the underlying</Description>
        </Field>
        <Field>
          <Name>DecimalInUnderlyingPrice</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Number of implicit decimals in the underlying price</Description>
        </Field>
        <Field>
          <Name>BaseCurrency</Name>
          <Type>String</Type>
          <Size>3</Size>
          <Description>Defines the trading currency</Description>
        </Field>
        <Field>
          <Name>UnderlyingSource</Name>
          <Type>String</Type>
          <Size>6</Size>
          <Description>Underlying Code Reference source</Description>
        </Field>
