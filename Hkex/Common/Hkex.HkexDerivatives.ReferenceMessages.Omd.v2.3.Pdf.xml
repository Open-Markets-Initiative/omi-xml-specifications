          <Name>EffectiveTomorrow</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Declaration for instrument to be traded the next day</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>6</Size>
          <Description>Padding</Description>
        </Field>
