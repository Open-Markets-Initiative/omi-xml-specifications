<OmiOmdPdf>

  <Messages>

    <!-- Logon Message -->
    <Message>
      <Name>Logon Message</Name>
      <Description>The Logon message enables client authentication. Not required for multicast channels; only used for retransmission requests.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Firm</Origin>
      <Category>Retransmission</Category>
      <Code>101</Code>
      <Fields>
        <Field>
          <Name>Username</Name>
          <Type>String</Type>
          <Size>12</Size>
          <Description>Username to log on, padded with binary null characters.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Logon Response Message -->
    <Message>
      <Name>Logon Response Message</Name>
      <Description>Response to a Logon request indicating session status.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>Retransmission</Category>
      <Code>102</Code>
      <Fields>
        <Field>
          <Name>SessionStatus</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Status of the session.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>3</Size>
          <Description>Padding.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Retransmission Request Message -->
    <Message>
      <Name>Retransmission Request Message</Name>
      <Description>Client-initiated request to retransmit a range of messages from a specific multicast channel.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Firm</Origin>
      <Category>Retransmission</Category>
      <Code>201</Code>
      <Fields>
        <Field>
          <Name>ChannelID</Name>
          <Type>Uint16</Type>
          <Size>2</Size>
          <Description>Multicast Channel ID with which the retransmission relates.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>2</Size>
          <Description>Padding.</Description>
        </Field>
        <Field>
          <Name>BeginSeqNum</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Beginning of sequence.</Description>
        </Field>
        <Field>
          <Name>EndSeqNum</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Message sequence number of last message in range to be resent.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Retransmission Response Message -->
    <Message>
      <Name>Retransmission Response Message</Name>
      <Description>Server response to a Retransmission Request indicating whether the range can be resent.</Description>
      <Branch>Payload</Branch>
      <Dependency>Msg Type</Dependency>
      <Origin>Exchange</Origin>
      <Category>Retransmission</Category>
      <Code>202</Code>
      <Fields>
        <Field>
          <Name>ChannelID</Name>
          <Type>Uint16</Type>
          <Size>2</Size>
          <Description>Multicast Channel ID with which the retransmission relates.</Description>
        </Field>
        <Field>
          <Name>RetransStatus</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Status of the Retransmission response.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Padding.</Description>
        </Field>
        <Field>
          <Name>BeginSeqNum</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Beginning of sequence.</Description>
        </Field>
        <Field>
          <Name>EndSeqNum</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Message sequence number of last message in range to be resent.</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- SessionStatus -->
    <Enum>
      <Name>SessionStatus</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>Session Active</Name>
        </Value>
        <Value>
          <Data>5</Data>
          <Name>Invalid username or IP Address</Name>
        </Value>
        <Value>
          <Data>100</Data>
          <Name>User already connected</Name>
        </Value>
      </Values>
    </Enum>

    <!-- RetransStatus -->
    <Enum>
      <Name>RetransStatus</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>Request accepted</Name>
        </Value>
        <Value>
          <Data>1</Data>
          <Name>Unknown or Unauthorized channel ID</Name>
        </Value>
        <Value>
          <Data>2</Data>
          <Name>Messages not available</Name>
        </Value>
        <Value>
          <Data>100</Data>
          <Name>Exceeds maximum sequence range</Name>
        </Value>
        <Value>
          <Data>101</Data>
          <Name>Exceeds maximum requests in a day</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiOmdPdf>
