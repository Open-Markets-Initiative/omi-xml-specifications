<OmiLmeSourcePdf>

<!--
  Groups and enums shared by every channel
-->

  <Groups>

    <!-- Entries -->
    <Group>
      <Name>Entries</Name>
      <Description>One aggregate order book entry, giving the aggregated state of one price level on one side</Description>
      <Type>REPEATING</Type>
      <Dependency>NoEntries</Dependency>
      <Fields>
        <Field>
          <Name>AggregateVolume</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Total quantity of orders in this price level and side.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Price, in implicit six decimal place format.</Description>
        </Field>
        <Field>
          <Name>NumberOfExplicitOrders</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Number of explicit orders in this price level and side.</Description>
        </Field>
        <Field>
          <Name>TotalQtyOfExplicitOrders</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Total quantity of explicit orders in this price level and side.</Description>
        </Field>
        <Field>
          <Name>NumberOfImpliedOrders</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Number of implied orders in this price level and side.</Description>
        </Field>
        <Field>
          <Name>TotalQtyOfImpliedOrders</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Total quantity of implied orders in this price level and side.</Description>
        </Field>
        <Field>
          <Name>BuySell</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Side of the order.</Description>
        </Field>
        <Field>
          <Name>PriceLevel</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Indicates the price level, within the top fifteen, of the information carried in the message.</Description>
        </Field>
        <Field>
          <Name>UpdateAction</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Type of market data update action.</Description>
        </Field>
      </Fields>
    </Group>

    <!-- Strategy Legs -->
    <Group>
      <Name>Strategy Legs</Name>
      <Description>One leg of a strategy tradable instrument definition</Description>
      <Type>REPEATING</Type>
      <Dependency>StrategyLegCount</Dependency>
      <Fields>
        <Field>
          <Name>LegNumber</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>An identifier for each leg in the strategy, starting from one and incrementing by one for each leg.</Description>
        </Field>
        <Field>
          <Name>LegBuySell</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Leg direction.</Description>
        </Field>
        <Field>
          <Name>LegRatio</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Leg ratio of the strategy leg, in implicit three decimal place format. Where the strategy type code is nine it represents the delta value for each delta hedge leg.</Description>
        </Field>
        <Field>
          <Name>LegDeltaHedgePrice</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Underlying price for a futures leg in a delta hedge custom strategy, null otherwise. Implicit six decimal place format.</Description>
        </Field>
        <Field>
          <Name>LegTradableInstrumentID</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>TradableInstrumentID of the strategy leg.</Description>
        </Field>
      </Fields>
    </Group>

    <!-- Definition Legs -->
    <Group>
      <Name>Definition Legs</Name>
      <Description>One strategy leg record of a tradable instrument definition, counted by RecordCount rather than by StrategyLegCount: the specification's length formula gives the repeat as the value of Record Count, StrategyLegCount being the number of legs the whole strategy has</Description>
      <Type>REPEATING</Type>
      <Dependency>RecordCount</Dependency>
      <Fields>
        <Field>
          <Name>LegNumber</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Leg number.</Description>
        </Field>
        <Field>
          <Name>LegBuySell</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Buy or sell indicator for the strategy leg.</Description>
        </Field>
        <Field>
          <Name>LegRatio</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Leg ratio of the strategy leg, in implicit three decimal place format. Where the strategy type code is nine it represents the delta value for each delta hedge leg.</Description>
        </Field>
        <Field>
          <Name>LegDeltaHedgePrice</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>The requested price for the delta hedge leg of the strategy, in implicit six decimal place format. Only non null for the delta hedge leg of a strategy.</Description>
        </Field>
        <Field>
          <Name>LegTradableInstrumentID</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Tradable Instrument Id of the strategy leg.</Description>
        </Field>
      </Fields>
    </Group>

    <!-- Order Legs -->
    <Group>
      <Name>Order Legs</Name>
      <Description>One strategy leg record of a market data order, counted by RecordCount rather than by StrategyLegCount: the specification's length formula gives the repeat as the value of RecordCount, StrategyLegCount being the number of legs present in the strategy</Description>
      <Type>REPEATING</Type>
      <Dependency>RecordCount</Dependency>
      <Fields>
        <Field>
          <Name>LegBuySell</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Buy or sell for the strategy leg.</Description>
        </Field>
        <Field>
          <Name>LegPrice</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Price allocated to this leg of the strategy, in implicit six decimal place format.</Description>
        </Field>
        <Field>
          <Name>LegVolume</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Quantity allocated to this leg of the strategy.</Description>
        </Field>
      </Fields>
    </Group>

    <!-- Curve Prices -->
    <Group>
      <Name>Curve Prices</Name>
      <Description>One forward curve reference price and the prompt date or dates it relates to. The specification's length formula names the repeat NumPrices, a field no table of this message declares; RecordCount is the count it gives, as the number of reference prices in this message</Description>
      <Type>REPEATING</Type>
      <Dependency>RecordCount</Dependency>
      <Fields>
        <Field>
          <Name>Price</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>The price for the given dates, in implicit six decimal place format.</Description>
        </Field>
        <Field>
          <Name>PromptDate1</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>The date to which the price relates, as YYYYMMDD. For a spread this is the first leg.</Description>
        </Field>
        <Field>
          <Name>PromptDateLabel1</Name>
          <Type>String</Type>
          <Size>6</Size>
          <Description>The label representing date1. Not applicable for all dates.</Description>
        </Field>
        <Field>
          <Name>PromptDate2</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>The date to which the price relates, as YYYYMMDD. For a spread this is the second leg. Null if not applicable.</Description>
        </Field>
        <Field>
          <Name>PromptDateLabel2</Name>
          <Type>String</Type>
          <Size>6</Size>
          <Description>The label representing date2. For a spread the date label associated with the second leg, if there is one. Not applicable for all dates.</Description>
        </Field>
      </Fields>
    </Group>

    <!-- Volatility Points -->
    <Group>
      <Name>Volatility Points</Name>
      <Description>One point of the reference volatility curve. The specification's length formula names the repeat NumVolatilityRecords, a field no table of this message declares; RecordCount is the count it gives, as the number of reference volatility points in this message</Description>
      <Type>REPEATING</Type>
      <Dependency>RecordCount</Dependency>
      <Fields>
        <Field>
          <Name>SurfaceDomain</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Indicates whether the reference volatility was created in Delta or Strike space.</Description>
        </Field>
        <Field>
          <Name>Delta</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Option delta for the volatility point, in implicit six decimal place format.</Description>
        </Field>
        <Field>
          <Name>StrikePrice</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Strike price for the volatility point, in implicit six decimal place format.</Description>
        </Field>
        <Field>
          <Name>ATM</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Identifies the ATM strike, one, or delta point, zero.</Description>
        </Field>
        <Field>
          <Name>CallVolatility</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Call volatility, in implicit six decimal place format.</Description>
        </Field>
        <Field>
          <Name>PutVolatility</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Put volatility, in implicit six decimal place format.</Description>
        </Field>
        <Field>
          <Name>CallPremium</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Call premium, in implicit six decimal place format.</Description>
        </Field>
        <Field>
          <Name>PutPremium</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Put premium, in implicit six decimal place format.</Description>
        </Field>
      </Fields>
    </Group>

    <!-- Date Bands -->
    <Group>
      <Name>Date Bands</Name>
      <Description>One open interest date band, giving the open interest volume for the period between two dates</Description>
      <Type>REPEATING</Type>
      <Dependency>DateBandCount</Dependency>
      <Fields>
        <Field>
          <Name>FromDate</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>The date from which open interest volume for the period is calculated, inclusive, as YYYYMMDD.</Description>
        </Field>
        <Field>
          <Name>ToDate</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>The date to which open interest volume for the period is calculated, inclusive, as YYYYMMDD.</Description>
        </Field>
        <Field>
          <Name>Volume</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Number of open positions expressed in lots between the given dates.</Description>
        </Field>
      </Fields>
    </Group>

    <!-- Long Position Bands -->
    <Group>
      <Name>Long Position Bands</Name>
      <Description>One long position band, giving the percentage range of Market Open Interest and the prompt dates participants hold long positions in</Description>
      <Type>REPEATING</Type>
      <Dependency>LongPositionBandCount</Dependency>
      <Fields>
        <Field>
          <Name>LongPositionLowerValue</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Long position lower band percentage value, in implicit six decimal place format.</Description>
        </Field>
        <Field>
          <Name>LongPositionUpperValue</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Long position upper band percentage value, in implicit six decimal place format.</Description>
        </Field>
        <Field>
          <Name>LongPositionPromptDateCount</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Number of prompt dates.</Description>
        </Field>
        <Field>
          <Name>Long Prompt Dates</Name>
          <Type>group</Type>
          <Size>0</Size>
          <Description>The prompt dates of this long position band, counted by LongPositionPromptDateCount.</Description>
        </Field>
      </Fields>
    </Group>

    <!-- Long Prompt Dates -->
    <Group>
      <Name>Long Prompt Dates</Name>
      <Description>One prompt date of a long position band and the number of participants holding long positions in it</Description>
      <Type>REPEATING</Type>
      <Dependency>LongPositionPromptDateCount</Dependency>
      <Fields>
        <Field>
          <Name>PromptDateLabel</Name>
          <Type>String</Type>
          <Size>6</Size>
          <Description>Prompt date label.</Description>
        </Field>
        <Field>
          <Name>ExpiryDate</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Expiry date, as YYYYMMDD.</Description>
        </Field>
        <Field>
          <Name>ParticipantCount</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Number of market participants holding long positions in the given band and prompt.</Description>
        </Field>
      </Fields>
    </Group>

    <!-- Short Position Bands -->
    <Group>
      <Name>Short Position Bands</Name>
      <Description>One short position band, giving the percentage range of Market Open Interest and the prompt dates participants hold short positions in</Description>
      <Type>REPEATING</Type>
      <Dependency>ShortPositionBandCount</Dependency>
      <Fields>
        <Field>
          <Name>ShortPositionLowerValue</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Short position lower band percentage value, in implicit six decimal place format.</Description>
        </Field>
        <Field>
          <Name>ShortPositionUpperValue</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Short position upper band percentage value, in implicit six decimal place format. The specification describes this field as the long position upper band percentage value, repeating the wording of the long band; the field is the short band's upper value.</Description>
        </Field>
        <Field>
          <Name>ShortPositionPromptDateCount</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Number of prompt dates.</Description>
        </Field>
        <Field>
          <Name>Short Prompt Dates</Name>
          <Type>group</Type>
          <Size>0</Size>
          <Description>The prompt dates of this short position band, counted by ShortPositionPromptDateCount.</Description>
        </Field>
      </Fields>
    </Group>

    <!-- Short Prompt Dates -->
    <Group>
      <Name>Short Prompt Dates</Name>
      <Description>One prompt date of a short position band and the number of participants holding short positions in it</Description>
      <Type>REPEATING</Type>
      <Dependency>ShortPositionPromptDateCount</Dependency>
      <Fields>
        <Field>
          <Name>PromptDateLabel</Name>
          <Type>String</Type>
          <Size>6</Size>
          <Description>Prompt date label.</Description>
        </Field>
        <Field>
          <Name>ExpiryDate</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Expiry date, as YYYYMMDD.</Description>
        </Field>
        <Field>
          <Name>ParticipantCount</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Number of market participants holding short positions in the given band and prompt.</Description>
        </Field>
      </Fields>
    </Group>

    <!-- Warrant Bands -->
    <Group>
      <Name>Warrant Bands</Name>
      <Description>One warrant band, giving the percentage range and the number of participants whose warrant concentration falls within it</Description>
      <Type>REPEATING</Type>
      <Dependency>BandCount</Dependency>
      <Fields>
        <Field>
          <Name>LowerValue</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Lower band percentage value, in implicit six decimal place format.</Description>
        </Field>
        <Field>
          <Name>UpperValue</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Upper band percentage value, in implicit six decimal place format. Null for Type WC or WT if one hundred.</Description>
        </Field>
        <Field>
          <Name>ParticipantCount</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Number of market participants with LME warrant concentrations falling within the given percentage band.</Description>
        </Field>
      </Fields>
    </Group>

    <!-- Stock Records -->
    <Group>
      <Name>Stock Records</Name>
      <Description>One warehouse stock movement record. The specification's length formula names the repeat NoOfRecords, a field no table of this message declares; RecordCount is the count it gives, as the number of repeating records in this message</Description>
      <Type>REPEATING</Type>
      <Dependency>RecordCount</Dependency>
      <Fields>
        <Field>
          <Name>ProductCode</Name>
          <Type>String</Type>
          <Size>2</Size>
          <Description>Product code. This identifies the commodity.</Description>
        </Field>
        <Field>
          <Name>Location</Name>
          <Type>String</Type>
          <Size>4</Size>
          <Description>Location where the commodity exists, as a four character code. Space if ReportLevel is Summary or Grade.</Description>
        </Field>
        <Field>
          <Name>GradeCode</Name>
          <Type>String</Type>
          <Size>4</Size>
          <Description>Grade of the commodity. Space if ReportLevel is Summary or Location.</Description>
        </Field>
        <Field>
          <Name>StockStatus</Name>
          <Type>String</Type>
          <Size>3</Size>
          <Description>Stock status.</Description>
        </Field>
        <Field>
          <Name>StockQuantity</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Stock quantity.</Description>
        </Field>
      </Fields>
    </Group>

    <!-- Executed Legs -->
    <Group>
      <Name>Executed Legs</Name>
      <Description>One leg of an executed strategy trade</Description>
      <Type>REPEATING</Type>
      <Dependency>StrategyLegCount</Dependency>
      <Fields>
        <Field>
          <Name>LegTradableInstrumentID</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Leg Tradable Instrument ID.</Description>
        </Field>
        <Field>
          <Name>LegBuySell</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Leg side, as applicable depending on the trade side.</Description>
        </Field>
        <Field>
          <Name>LegPrice</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Price allocated to this leg of the strategy, in implicit six decimal place format.</Description>
        </Field>
        <Field>
          <Name>LegVolume</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Quantity allocated to this leg of the strategy.</Description>
        </Field>
        <Field>
          <Name>LegMatchID</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Leg Match ID.</Description>
        </Field>
      </Fields>
    </Group>

    <!-- Trade Legs -->
    <Group>
      <Name>Trade Legs</Name>
      <Description>One leg record of a strategy trade, counted by RecordCount rather than by StrategyLegCount, which states the total legs of the strategy</Description>
      <Type>REPEATING</Type>
      <Dependency>RecordCount</Dependency>
      <Fields>
        <Field>
          <Name>LegPrice</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Price allocated to this leg of the strategy, in implicit six decimal place format.</Description>
        </Field>
        <Field>
          <Name>LegVolume</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Quantity allocated to this leg of the strategy.</Description>
        </Field>
        <Field>
          <Name>LegMatchID</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Trade match identifier for this leg.</Description>
        </Field>
        <Field>
          <Name>LegTradeAtReferencePrice</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Indicates whether the leg price is differential or substituted.</Description>
        </Field>
      </Fields>
    </Group>

  </Groups>

