  <Messages>

    <!-- Contract Definition Message -->
    <Message>
      <Name>Contract Definition Message</Name>
      <Dependency>msgtype</Dependency>
      <Branch>payload</Branch>
      <Code>300</Code>
      <Category>Reference Data</Category>
      <Origin>Exchange</Origin>
      <Description>Published for a new contract prior to its first trading date, to enable participants to configure risk management parameters before the contract becomes tradable.</Description>
      <Fields>
        <Field>
          <Name>TradingVenue</Name>
          <Type>String</Type>
          <Size>2</Size>
          <Description>Trading venue.</Description>
        </Field>
        <Field>
          <Name>ContractCode</Name>
          <Type>String</Type>
          <Size>12</Size>
          <Description>A unique code to identify the contract.</Description>
        </Field>
        <Field>
          <Name>Name</Name>
          <Type>String</Type>
          <Size>64</Size>
          <Description>Name of the contract.</Description>
        </Field>
        <Field>
          <Name>ContractType</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Constant contract type.</Description>
        </Field>
        <Field>
          <Name>ProductCode</Name>
          <Type>String</Type>
          <Size>2</Size>
          <Description>Product code.</Description>
        </Field>
        <Field>
          <Name>UnderlyingType</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Underlying Type.</Description>
        </Field>
        <Field>
          <Name>UnderlyingContractCode</Name>
          <Type>String</Type>
          <Size>12</Size>
          <Description>Reference to the underlying contract.</Description>
        </Field>
        <Field>
          <Name>TradingCurrency</Name>
          <Type>String</Type>
          <Size>3</Size>
          <Description>The currency code according to ISO 4217.</Description>
        </Field>
        <Field>
          <Name>SettlementType</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Settlement Type.</Description>
        </Field>
        <Field>
          <Name>SettlementPricingMethod</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Settlement Pricing Method.</Description>
        </Field>
        <Field>
          <Name>ExerciseStyle</Name>
          <Type>Int8</Type>
          <Size>1</Size>
          <Description>Exercise Style. Null for futures.</Description>
        </Field>
        <Field>
          <Name>LotUnit</Name>
          <Type>String</Type>
          <Size>20</Size>
          <Description>Lot Unit.</Description>
        </Field>
        <Field>
          <Name>LotSize</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>The lot size for this tradable instrument.</Description>
        </Field>
        <Field>
          <Name>LotSizeType</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Lot Size Type.</Description>
        </Field>
        <Field>
          <Name>ContractPriceType</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Price for futures, premium or volatility for options. The specification names this field PriceType; it is qualified here because the Reference Price message gives a PriceType of its own carrying a different set of values.</Description>
        </Field>
        <Field>
          <Name>FirstTradingDate</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>First Trading Date, as YYYYMMDD.</Description>
        </Field>
      </Fields>
    </Message>

