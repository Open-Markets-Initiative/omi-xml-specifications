    <!-- Price Limits Message -->
    <Message>
      <Name>Price Limits Message</Name>
      <Dependency>msgtype</Dependency>
      <Branch>payload</Branch>
      <Code>305</Code>
      <Category>Reference Data</Category>
      <Origin>Exchange</Origin>
      <Description>Describes the upper and lower price limits for an outright tradable instrument. Where Daily Price Limits are enabled for a contract they are published for electronic tradable instruments, and the same limits also apply to non-electronic tradable instruments.</Description>
      <Fields>
        <Field>
          <Name>TradableInstrumentID</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Tradable instrument ID.</Description>
        </Field>
        <Field>
          <Name>UpperPriceLimit</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Upper price limit for the outright tradable instrument for the current trading day, in implicit six decimal place format.</Description>
        </Field>
        <Field>
          <Name>LowerPriceLimit</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Lower price limit for the outright tradable instrument for the current trading day, in implicit six decimal place format.</Description>
        </Field>
        <Field>
          <Name>TransactionTime</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>The time at which the price limits were created.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trade Statistics - End of Day Message -->
    <Message>
      <Name>Trade Statistics - End of Day Message</Name>
      <Dependency>msgtype</Dependency>
      <Branch>payload</Branch>
      <Code>351</Code>
      <Category>Trade Statistics</Category>
      <Origin>Exchange</Origin>
      <Description>Generated when the market moves to the Post-Trade session for instruments that have traded. LMEsource publishes the LMEselect Opening and Closing Prices, LMEselect Trading High and LMEselect Trading Low for all contracts that have traded during the day. Off book trades resulting from Cross Order execution are not used in the calculation.</Description>
      <Fields>
        <Field>
          <Name>TradingVenue</Name>
          <Type>String</Type>
          <Size>2</Size>
          <Description>Trading venue.</Description>
        </Field>
        <Field>
          <Name>TimeOfEvent</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>The time LMEselect computed or derived the designated price.</Description>
        </Field>
        <Field>
          <Name>TradableInstrumentID</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Tradable Instrument ID.</Description>
        </Field>
        <Field>
          <Name>OpenPrice</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Opening trade price for the current day, in implicit six decimal place format.</Description>
        </Field>
        <Field>
          <Name>TradeHigh</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Highest trade price for the current day, in implicit six decimal place format.</Description>
        </Field>
        <Field>
          <Name>TradeLow</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Lowest trade price for the current day, in implicit six decimal place format.</Description>
        </Field>
        <Field>
          <Name>ClosingPrice</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Closing, final, trade price for the current day, in implicit six decimal place format.</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

