          <Size>4</Size>
          <Description>Amended delta quantity.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>2</Size>
          <Description></Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

