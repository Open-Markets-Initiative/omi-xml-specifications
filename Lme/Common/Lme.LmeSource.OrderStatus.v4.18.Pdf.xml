<!--
  Status, indicative opening price and quote request, on all three order channels. Section 9.1 omits Quote Request (329); section 6.4.1 gives it in each order refresh sequence and section 1.3.1 marks it for all three levels
-->

  <Messages>

    <!-- Market State - Contract Message -->
    <Message>
      <Name>Market State - Contract Message</Name>
      <Dependency>msgtype</Dependency>
      <Branch>payload</Branch>
      <Code>311</Code>
      <Category>Status Data</Category>
      <Origin>Exchange</Origin>
      <Description>Indicates the trading state of instruments at the contract level, for example Copper Futures or Aluminium Options. The ContractCode field is common across the Market State - Contract, Outright Definition and Strategy Definition messages and links the contract state to individual tradable instruments.</Description>
      <Fields>
        <Field>
          <Name>TradingVenue</Name>
          <Type>String</Type>
          <Size>2</Size>
          <Description>Trading venue.</Description>
        </Field>
        <Field>
          <Name>TimeOfEvent</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Time of event.</Description>
        </Field>
        <Field>
          <Name>ContractCode</Name>
          <Type>String</Type>
          <Size>12</Size>
          <Description>A string that combines the contract symbol, contract type and currency.</Description>
        </Field>
        <Field>
          <Name>TradingState</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Trading State.</Description>
        </Field>
        <Field>
          <Name>StartTime</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Trading State Start Time. Zero, meaning not applicable, for Technical Halt.</Description>
        </Field>
        <Field>
          <Name>EndTime</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Trading State End Time. Zero, meaning not applicable, for Technical Halt.</Description>
        </Field>
        <Field>
          <Name>TradingStateCondition</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Current trading state condition.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>2</Size>
          <Description>Filler.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Market State - Instrument Message -->
