      <Branch>payload</Branch>
      <Code>312</Code>
      <Category>Status Data</Category>
      <Origin>Exchange</Origin>
      <Description>Indicates the trading state of an individual tradable instrument. Sent when the instrument state differs from that at contract level, for example when TOM goes into Post Trade before the contract.</Description>
      <Fields>
        <Field>
          <Name>TradingVenue</Name>
          <Type>String</Type>
          <Size>2</Size>
          <Description>Trading venue.</Description>
        </Field>
        <Field>
          <Name>TimeOfEvent</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Time of event.</Description>
        </Field>
        <Field>
          <Name>TradableInstrumentID</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Tradable Instrument ID.</Description>
        </Field>
        <Field>
          <Name>TimetableControlType</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Timetable Control Type.</Description>
        </Field>
        <Field>
          <Name>TradingState</Name>
          <Type>Uint8</Type>
          <Size>1</Size>
          <Description>Trading State.</Description>
        </Field>
        <Field>
          <Name>StartTime</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Trading State Start Time. Zero, meaning not applicable, for Technical Halt.</Description>
        </Field>
        <Field>
          <Name>EndTime</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Trading State End Time. Zero, meaning not applicable, for Technical Halt.</Description>
        </Field>
        <Field>
          <Name>TradingStateCondition</Name>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Current trading state condition.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>3</Size>
          <Description>Filler.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Indicative Opening Price Message -->
    <Message>
      <Name>Indicative Opening Price Message</Name>
      <Dependency>msgtype</Dependency>
      <Branch>payload</Branch>
      <Code>320</Code>
      <Category>Order Book Data</Category>
      <Origin>Exchange</Origin>
      <Description>Carries the price at which a tradable instrument would open, computed by the uncrossing algorithm during Pre-Open. If there are no crossed prices no IOP is calculated or disseminated; where the book is not crossed but has both a bid and an offer, a mid price is calculated and published instead. At the transition from Pre-Open to Open an IOP message is published for every tradable instrument with both prices null and the volume zero, to indicate the prices are no longer valid.</Description>
      <Fields>
        <Field>
          <Name>TradingVenue</Name>
          <Type>String</Type>
          <Size>2</Size>
          <Description>Trading venue.</Description>
        </Field>
        <Field>
          <Name>TimeOfEvent</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>The time LMEselect computed or derived the IOP or IOMP.</Description>
        </Field>
        <Field>
          <Name>TradableInstrumentID</Name>
          <Type>Uint64</Type>
          <Size>8</Size>
          <Description>Tradable Instrument ID.</Description>
        </Field>
        <Field>
          <Name>IndicativeOpeningPrice</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Indicative Opening Price, in implicit six decimal place format. Defaults to null.</Description>
        </Field>
        <Field>
          <Name>IndicativeOpeningVolume</Name>
          <Type>Uint32</Type>
          <Size>4</Size>
          <Description>Indicative Opening Volume. Defaults to zero.</Description>
        </Field>
        <Field>
          <Name>IndicativeOpeningMidPrice</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Indicative Opening Mid Price, in implicit six decimal place format. Defaults to null.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>String</Type>
          <Size>2</Size>
          <Description>Filler.</Description>
        </Field>
      </Fields>
    </Message>

