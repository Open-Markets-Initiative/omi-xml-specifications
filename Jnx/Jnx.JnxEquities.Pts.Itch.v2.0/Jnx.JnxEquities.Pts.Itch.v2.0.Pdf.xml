<OmiItchJnxEquitiesPdf>

  <Messages>

    <!-- Timestamp – Seconds Message -->
    <Message>
      <Name>Timestamp – Seconds Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>T</Code>
      <Category>Technical</Category>
      <Description>A Timestamp – Seconds Message is sent for every second in which at least one other message type is sent.</Description>
      <Fields>
        <Field>
          <Name>Timestamp – Seconds</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of seconds past midnight of the day that the trading session started.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- System Event Message -->
    <Message>
      <Name>System Event Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>S</Code>
      <Category>Technical</Category>
      <Description>System Event Messages denote data feed, system, and market events.</Description>
      <Fields>
        <Field>
          <Name>Timestamp – Nanoseconds</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of nanoseconds since last Timestamp – Seconds Message.</Description>
        </Field>
        <Field>
          <Name>Group</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Order book group identifier. Blank if system-wide event.</Description>
        </Field>
        <Field>
          <Name>System Event</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Refer to Table 1 below.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Price Tick Size Message -->
    <Message>
      <Name>Price Tick Size Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>L</Code>
      <Category>Technical</Category>
      <Description>Price Tick Size Messages define a set of price tick size tables.</Description>
      <Fields>
        <Field>
          <Name>Timestamp – Nanoseconds</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of nanoseconds since last Timestamp – Seconds Message.</Description>
        </Field>
        <Field>
          <Name>Price Tick Size Table Id</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Price tick size table identifier.</Description>
        </Field>
        <Field>
          <Name>Price Tick Size</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Price tick size.</Description>
        </Field>
        <Field>
          <Name>Price Start</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Start of price range for this price tick size.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Orderbook Directory Message -->
    <Message>
      <Name>Orderbook Directory Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>R</Code>
      <Category>Technical</Category>
      <Description>Orderbook Directory Messages provide information about order books available in the Japannext PTS execution system.</Description>
      <Fields>
        <Field>
          <Name>Timestamp – Nanoseconds</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of nanoseconds since last Timestamp – Seconds Message.</Description>
        </Field>
        <Field>
          <Name>Orderbook Id</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Securities Identification Code Committee (SICC) code.</Description>
        </Field>
        <Field>
          <Name>Orderbook Code</Name>
          <Type>Alpha</Type>
          <Size>12</Size>
          <Description>International Securities Identification Number (ISIN).</Description>
        </Field>
        <Field>
          <Name>Group</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Order book group identifier.</Description>
        </Field>
        <Field>
          <Name>Round Lot Size</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of shares that represent a round lot.</Description>
        </Field>
        <Field>
          <Name>Price Tick Size Table Id</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Price tick size table identifier.</Description>
        </Field>
        <Field>
          <Name>Price Decimals</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of decimal places in price fields. Value is 1.</Description>
        </Field>
        <Field>
          <Name>Upper Price Limit</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Maximum tradable price.</Description>
        </Field>
        <Field>
          <Name>Lower Price Limit</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Minimum tradable price.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trading State Message -->
    <Message>
      <Name>Trading State Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>H</Code>
      <Category>Technical</Category>
      <Description>A Trading State Message indicates the current trading state of an order book.</Description>
      <Fields>
        <Field>
          <Name>Timestamp – Nanoseconds</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of nanoseconds since last Timestamp – Seconds Message.</Description>
        </Field>
        <Field>
          <Name>Orderbook Id</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Securities Identification Code Committee (SICC) code.</Description>
        </Field>
        <Field>
          <Name>Group</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Order book group identifier.</Description>
        </Field>
        <Field>
          <Name>Trading State</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Current trading state.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Short Selling Price Restriction State Message -->
    <Message>
      <Name>Short Selling Price Restriction State Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>Y</Code>
      <Category>Technical</Category>
      <Description>A Short Selling Price Restriction State Message indicates the current short selling price restriction state of an order book.</Description>
      <Fields>
        <Field>
          <Name>Timestamp – Nanoseconds</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of nanoseconds since last Timestamp – Seconds Message.</Description>
        </Field>
        <Field>
          <Name>Orderbook Id</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Securities Identification Code Committee (SICC) code.</Description>
        </Field>
        <Field>
          <Name>Group</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Order book group identifier.</Description>
        </Field>
        <Field>
          <Name>Short Selling State</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Current short selling price restriction state.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Added Message – No Attributes -->
    <Message>
      <Name>Order Added Message – No Attributes</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>A</Code>
      <Category>Order</Category>
      <Description>An Order Added Message is generated for normal orders accepted by the system.</Description>
      <Fields>
        <Field>
          <Name>Timestamp – Nanoseconds</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of nanoseconds since last Timestamp – Seconds Message.</Description>
        </Field>
        <Field>
          <Name>Order Number</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Reference number of accepted order. Zero indicates a reference price message.</Description>
        </Field>
        <Field>
          <Name>Buy/Sell Indicator</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Side of order.</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Total number of shares added to order book. Ignore if reference price message.</Description>
        </Field>
        <Field>
          <Name>Orderbook Id</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Securities Identification Code Committee (SICC) code.</Description>
        </Field>
        <Field>
          <Name>Group</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Order book group identifier.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Order price. For a reference price message, a value of 214,748,364.7 (7FFFFFFF hex) denotes no reference price available.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Added with Attributes Message -->
    <Message>
      <Name>Order Added with Attributes Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>F</Code>
      <Category>Order</Category>
      <Description>An Order Added with Attributes Message is generated for orders with market-specific attributes accepted by the system.</Description>
      <Fields>
        <Field>
          <Name>Timestamp – Nanoseconds</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of nanoseconds since last Timestamp – Seconds Message.</Description>
        </Field>
        <Field>
          <Name>Order Number</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Reference number of accepted order.</Description>
        </Field>
        <Field>
          <Name>Buy/Sell Indicator</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Side of order.</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Total number of shares added to order book.</Description>
        </Field>
        <Field>
          <Name>Orderbook Id</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Securities Identification Code Committee (SICC) code.</Description>
        </Field>
        <Field>
          <Name>Group</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Order book group identifier.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Order price.</Description>
        </Field>
        <Field>
          <Name>Attribution</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Reserved. Always blank.</Description>
        </Field>
        <Field>
          <Name>Order Type</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Type of order.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Executed Message -->
    <Message>
      <Name>Order Executed Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>E</Code>
      <Category>Order</Category>
      <Description>An Order Executed Message is sent whenever an order in the order book is fully or partially executed.</Description>
      <Fields>
        <Field>
          <Name>Timestamp – Nanoseconds</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of nanoseconds since last Timestamp – Seconds Message.</Description>
        </Field>
        <Field>
          <Name>Order Number</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Reference number of executed order.</Description>
        </Field>
        <Field>
          <Name>Executed Quantity</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of shares executed.</Description>
        </Field>
        <Field>
          <Name>Match Number</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Reference number of match.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Deleted Message -->
    <Message>
      <Name>Order Deleted Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>D</Code>
      <Category>Order</Category>
      <Description>An Order Deleted Message is sent whenever an order in the order book has been canceled.</Description>
      <Fields>
        <Field>
          <Name>Timestamp – Nanoseconds</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of nanoseconds since last Timestamp – Seconds Message.</Description>
        </Field>
        <Field>
          <Name>Order Number</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Reference number of canceled order.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Replaced Message -->
    <Message>
      <Name>Order Replaced Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>U</Code>
      <Category>Order</Category>
      <Description>An Order Replaced Message is sent whenever an order in the order book has been replaced.</Description>
      <Fields>
        <Field>
          <Name>Timestamp – Nanoseconds</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of nanoseconds since last Timestamp – Seconds Message.</Description>
        </Field>
        <Field>
          <Name>Original Order Number</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Reference number of original order.</Description>
        </Field>
        <Field>
          <Name>New Order Number</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Reference number of replaced order.</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>New total number of shares displayed in order book.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>New price of order.</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- System Event -->
    <Enum>
      <Name>System Event</Name>
      <Values>
        <Value>
          <Data>O</Data>
          <Name>Start of Messages</Name>
          <Description>Always the first message (except for Timestamp – Seconds Messages) sent on any trading day.</Description>
        </Value>
        <Value>
          <Data>S</Data>
          <Name>Start of System Hours</Name>
          <Description>Market is open and ready to start accepting orders.</Description>
        </Value>
        <Value>
          <Data>Q</Data>
          <Name>Start of Market Hours</Name>
          <Description>Start of trading session.</Description>
        </Value>
        <Value>
          <Data>M</Data>
          <Name>End of Market Hours</Name>
          <Description>End of trading session.</Description>
        </Value>
        <Value>
          <Data>E</Data>
          <Name>End of System Hours</Name>
          <Description>Market is closed and will not accept any new orders.</Description>
        </Value>
        <Value>
          <Data>C</Data>
          <Name>End of Messages</Name>
          <Description>Always the last message sent on any trading day.</Description>
        </Value>
      </Values>
    </Enum>

