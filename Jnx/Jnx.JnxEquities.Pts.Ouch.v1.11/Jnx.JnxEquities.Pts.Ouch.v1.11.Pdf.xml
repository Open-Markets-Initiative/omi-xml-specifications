        <Field>
          <Name>Quantity</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Total number of shares for the entire order chain</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Order price</Description>
        </Field>
        <Field>
          <Name>Time in Force</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>How long the order remains in effect</Description>
        </Field>
        <Field>
          <Name>Display</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Order handling instructions</Description>
        </Field>
        <Field>
          <Name>Minimum Quantity</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Minimum acceptable quantity to execute</Description>
        </Field>
      </Fields>
    </Message>

