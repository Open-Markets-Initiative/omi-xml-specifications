  <Messages>

    <!-- Enter Order Message -->
    <Message>
      <Name>Enter Order Message</Name>
      <Dependency>Unsequenced Message Type</Dependency>
      <Branch>Unsequenced Message</Branch>
      <Code>O</Code>
      <Category>Order</Category>
      <Origin>Firm</Origin>
      <Description>An Enter Order Message is used to enter a new order into the Japannext PTS execution system</Description>
      <Fields>
        <Field>
          <Name>Order Token</Name>
          <Type>Token</Type>
          <Size>4</Size>
          <Description>Must be unique per Ouch account within a trading day and increase on each subsequent transaction</Description>
        </Field>
        <Field>
          <Name>Client Reference</Name>
          <Type>Alpha</Type>
          <Size>10</Size>
          <Description>Assigned by client Not validated</Description>
        </Field>
        <Field>
          <Name>Buy/Sell Indicator</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Side of order</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of shares</Description>
        </Field>
        <Field>
          <Name>Orderbook Id</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>4 digit Quick code</Description>
        </Field>
        <Field>
          <Name>Group</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Order book group identifier</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Order price</Description>
        </Field>
        <Field>
          <Name>Time in Force</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>How long the order remains in effect</Description>
        </Field>
        <Field>
          <Name>Firm Id</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Order entry firm identifier</Description>
        </Field>
        <Field>
          <Name>Display</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Order handling instruction</Description>
        </Field>
        <Field>
          <Name>Capacity</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Capacity of firm placing order</Description>
        </Field>
        <Field>
          <Name>Minimum Quantity</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Minimum acceptable quantity to execute</Description>
        </Field>
        <Field>
          <Name>Order Classification</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>High-frequency trading order classification</Description>
        </Field>
        <Field>
          <Name>Cash Margin Type</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Cash margin type of order</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Replace Order Message -->
    <Message>
      <Name>Replace Order Message</Name>
      <Dependency>Unsequenced Message Type</Dependency>
      <Branch>Unsequenced Message</Branch>
