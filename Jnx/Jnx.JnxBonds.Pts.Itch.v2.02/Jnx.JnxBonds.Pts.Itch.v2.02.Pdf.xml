<OmiJnxItchPdf>

  <Messages>

    <!-- Timestamp – Seconds Message -->
    <Message>
      <Name>Timestamp – Seconds Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>T</Code>
      <Category>Technical</Category>
      <Origin>Exchange</Origin>
      <Description>A Timestamp – Seconds Message is sent for every second in which at least one other message type is sent.</Description>
      <Fields>
        <Field>
          <Name>Timestamp – Seconds</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of seconds past midnight of the day that the trading session started.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- System Event Message -->
    <Message>
      <Name>System Event Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>S</Code>
      <Category>Technical</Category>
      <Origin>Exchange</Origin>
      <Description>System Event Messages denote data feed, system, and market events.</Description>
      <Fields>
        <Field>
          <Name>Timestamp – Nanoseconds</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of nanoseconds since last Timestamp – Seconds Message.</Description>
        </Field>
        <Field>
          <Name>Group</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Order book group identifier. Blank if system-wide event.</Description>
        </Field>
        <Field>
          <Name>System Event</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Refer to Table 1 below.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Price Tick Size Message -->
    <Message>
      <Name>Price Tick Size Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>L</Code>
      <Category>Technical</Category>
      <Origin>Exchange</Origin>
      <Description>Price Tick Size Messages define a set of price tick size tables.</Description>
      <Fields>
        <Field>
          <Name>Timestamp – Nanoseconds</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of nanoseconds since last Timestamp – Seconds Message.</Description>
        </Field>
        <Field>
          <Name>Price Tick Size Table Id</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Price tick size table identifier.</Description>
        </Field>
        <Field>
          <Name>Price Tick Size</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Format>Implied:3</Format>
          <Description>Yield tick size.</Description>
        </Field>
        <Field>
          <Name>Price Start</Name>
          <Type>Signed Integer</Type>
          <Size>4</Size>
          <Format>Implied:3</Format>
          <Description>Start of yield range for this yield tick size.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Orderbook Directory Message -->
    <Message>
      <Name>Orderbook Directory Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>R</Code>
      <Category>Technical</Category>
      <Origin>Exchange</Origin>
      <Description>Orderbook Directory Messages provide information about order books available in the Japannext PTS execution system.</Description>
      <Fields>
        <Field>
          <Name>Timestamp – Nanoseconds</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of nanoseconds since last Timestamp – Seconds Message.</Description>
        </Field>
        <Field>
          <Name>Orderbook Id</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Bond code per SICC definition.</Description>
        </Field>
        <Field>
          <Name>Orderbook Code</Name>
          <Type>Alpha</Type>
          <Size>12</Size>
          <Description>International Securities Identification Number (ISIN).</Description>
        </Field>
        <Field>
          <Name>Group</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Order book group identifier.</Description>
        </Field>
        <Field>
          <Name>Round Lot Size</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of shares that represent a round lot.</Description>
        </Field>
        <Field>
          <Name>Price Tick Size Table Id</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Price tick size table identifier.</Description>
        </Field>
        <Field>
          <Name>Price Decimals</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of decimal places in price fields. Value is 3.</Description>
        </Field>
        <Field>
          <Name>Upper Price Limit</Name>
          <Type>Signed Integer</Type>
          <Size>4</Size>
          <Format>Implied:3</Format>
          <Description>Maximum tradable yield.</Description>
        </Field>
        <Field>
          <Name>Lower Price Limit</Name>
          <Type>Signed Integer</Type>
          <Size>4</Size>
          <Format>Implied:3</Format>
          <Description>Minimum tradable yield.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trading State Message -->
    <Message>
      <Name>Trading State Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>H</Code>
      <Category>Technical</Category>
      <Origin>Exchange</Origin>
      <Description>A Trading State Message indicates the current trading state of an order book.</Description>
      <Fields>
        <Field>
          <Name>Timestamp – Nanoseconds</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of nanoseconds since last Timestamp – Seconds Message.</Description>
        </Field>
        <Field>
          <Name>Orderbook Id</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Bond code per SICC definition.</Description>
        </Field>
        <Field>
          <Name>Group</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Order book group identifier.</Description>
        </Field>
        <Field>
          <Name>Trading State</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Current trading state.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Added Message -->
    <Message>
      <Name>Order Added Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>A</Code>
      <Category>Technical</Category>
      <Origin>Exchange</Origin>
      <Description>An Order Added Message indicates that a new order has been accepted by the Japannext PTS execution system and has been added to the displayable order book.</Description>
      <Fields>
        <Field>
          <Name>Timestamp – Nanoseconds</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of nanoseconds since last Timestamp – Seconds Message.</Description>
        </Field>
        <Field>
          <Name>Order Number</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Reference number of accepted order.</Description>
        </Field>
        <Field>
          <Name>Buy/Sell Indicator</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Side of order.</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Total number of shares added to order book.</Description>
        </Field>
        <Field>
          <Name>Orderbook Id</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Bond code per SICC definition.</Description>
        </Field>
        <Field>
          <Name>Group</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Order book group identifier.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Signed Integer</Type>
          <Size>4</Size>
          <Format>Implied:3</Format>
          <Description>Order yield.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Executed Message -->
    <Message>
      <Name>Order Executed Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>E</Code>
      <Category>Technical</Category>
      <Origin>Exchange</Origin>
      <Description>An Order Executed Message is sent whenever an order in the order book is fully or partially executed.</Description>
      <Fields>
        <Field>
          <Name>Timestamp – Nanoseconds</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of nanoseconds since last Timestamp – Seconds Message.</Description>
        </Field>
        <Field>
          <Name>Order Number</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Reference number of executed order.</Description>
        </Field>
        <Field>
          <Name>Executed Quantity</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of shares executed.</Description>
        </Field>
        <Field>
          <Name>Match Number</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Reference number of match.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Deleted Message -->
    <Message>
      <Name>Order Deleted Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>D</Code>
      <Category>Technical</Category>
      <Origin>Exchange</Origin>
      <Description>An Order Deleted Message is sent whenever an order in the order book has been canceled.</Description>
      <Fields>
        <Field>
          <Name>Timestamp – Nanoseconds</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of nanoseconds since last Timestamp – Seconds Message.</Description>
        </Field>
        <Field>
          <Name>Order Number</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Reference number of canceled order.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Replaced Message -->
    <Message>
      <Name>Order Replaced Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>U</Code>
      <Category>Technical</Category>
      <Origin>Exchange</Origin>
      <Description>An Order Replaced Message is sent whenever an order in the order book has been replaced.</Description>
      <Fields>
        <Field>
          <Name>Timestamp – Nanoseconds</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of nanoseconds since last Timestamp – Seconds Message.</Description>
        </Field>
        <Field>
          <Name>Original Order Number</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Reference number of original order.</Description>
        </Field>
        <Field>
          <Name>New Order Number</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Reference number of replaced order.</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>New total number of shares displayed in order book.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Signed Integer</Type>
          <Size>4</Size>
          <Format>Implied:3</Format>
          <Description>New yield of order.</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- Group -->
    <Enum>
      <Name>Group</Name>
      <Values>
        <Value>
          <Data>DJGB</Data>
          <Name>JGB Market</Name>
          <Description>JGB Market</Description>
        </Value>
      </Values>
    </Enum>

    <!-- System Event -->
    <Enum>
      <Name>System Event</Name>
      <Values>
        <Value>
          <Data>O</Data>
          <Name>Start of Messages</Name>
          <Description>Always the first message (except for Timestamp – Seconds Messages) sent on any trading day.</Description>
        </Value>
        <Value>
          <Data>S</Data>
          <Name>Start of System Hours</Name>
          <Description>Market is open and ready to start accepting orders.</Description>
        </Value>
        <Value>
          <Data>Q</Data>
          <Name>Start of Market Hours</Name>
          <Description>Start of trading session.</Description>
        </Value>
        <Value>
          <Data>M</Data>
          <Name>End of Market Hours</Name>
          <Description>End of trading session.</Description>
        </Value>
        <Value>
          <Data>E</Data>
          <Name>End of System Hours</Name>
          <Description>Market is closed and will not accept any new orders.</Description>
        </Value>
        <Value>
          <Data>C</Data>
          <Name>End of Messages</Name>
          <Description>Always the last message sent on any trading day.</Description>
        </Value>
      </Values>
    </Enum>

    <!-- Trading State -->
    <Enum>
      <Name>Trading State</Name>
      <Values>
        <Value>
          <Data>T</Data>
          <Name>Trading</Name>
          <Description>Trading</Description>
        </Value>
        <Value>
          <Data>V</Data>
          <Name>Suspended</Name>
          <Description>Suspended</Description>
        </Value>
      </Values>
    </Enum>

    <!-- Buy/Sell Indicator -->
    <Enum>
      <Name>Buy/Sell Indicator</Name>
      <Values>
        <Value>
          <Data>B</Data>
          <Name>Buy</Name>
          <Description>Buy</Description>
        </Value>
        <Value>
          <Data>S</Data>
          <Name>Sell</Name>
          <Description>Sell</Description>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiJnxItchPdf>
