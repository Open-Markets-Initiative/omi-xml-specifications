<OmiMtbtPdf>

<!--
  Nse IX Mtbt recovery v1.4: section 7 of the NSE IFSC MTBT API Technical Specification,
  Version 1.4, 28 January 2026 (pages 14-15). The request and the status reply only; the replayed
  ticks are the multicast messages of section 6 and come from the Udp feed's own Pdf.xml.

  Start and End Sequence Number are printed INT here, where the Nse India documents print UINT.
-->

  <Messages>

    <!-- Tick Data Recovery Request Message -->
    <Message>
      <Name>Tick Data Recovery Request Message</Name>
      <Branch>clientpayload</Branch>
      <Dependency>clientmessagetype</Dependency>
      <Code>R</Code>
      <Category>Administrative</Category>
      <Origin>Firm</Origin>
      <Description>Sent to the Recovery Server on Tcp whenever tick data is missed, with no header; when only one tick is missed Start and End Sequence Number are the same.</Description>
      <Fields>
        <Field>
          <Name>Stream ID</Name>
          <Type>SHORT</Type>
          <Size>2</Size>
          <Description>Unique Stream Reference</Description>
        </Field>
        <Field>
          <Name>Start Sequence Number</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Requested Message Sequence Number</Description>
        </Field>
        <Field>
          <Name>End Sequence Number</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Requested Message Sequence Number</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Tick Data Recovery Response Message -->
    <Message>
      <Name>Tick Data Recovery Response Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>Y</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>First message sent by the Recovery Server, indicating whether the request was processed successfully; the Stream Header's sequence number is zero.</Description>
      <Fields>
        <Field>
          <Name>Request Status</Name>
          <Type>CHAR</Type>
          <Size>1</Size>
          <Description>Request Status</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- Request Status -->
    <Enum>
      <Name>Request Status</Name>
      <Values>
        <Value>
          <Data>S</Data>
          <Name>Success</Name>
        </Value>
        <Value>
          <Data>E</Data>
          <Name>Error</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiMtbtPdf>
