<OmiMtbtPdf>

<!--
  Nse IX Mtbt order book snapshot v1.4: section 8 of the NSE IFSC MTBT API Technical
  Specification, Version 1.4, 28 January 2026 (pages 16-18), new in this version.

  The request prints Start and End Sequence Number as "INT (For Equity derivative, data type
  shall be 'UINT')" (page 17), a note carried over from the Nse India document. The printed INT is
  transcribed.

  Price is printed "Price of the order (In cents)" and, in the same remark, "This should be
  divided by 10000 for converting into USD" (page 18). Ten thousand is not a cents divisor; the
  reference scales by the stated divisor.
-->

  <Messages>

    <!-- New Order Message -->
    <Message>
      <Name>New Order Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>N</Code>
      <Category>Market Data</Category>
      <Origin>Exchange</Origin>
      <Description>Outstanding normal order in the order book at the last snapshot refresh.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>LONG</Type>
          <Size>8</Size>
          <Description>Time in nanoseconds from 01-Jan-1980 00:00:00</Description>
        </Field>
        <Field>
          <Name>Order ID</Name>
          <Type>DOUBLE</Type>
          <Size>8</Size>
          <Description>Day Unique Order Reference Number</Description>
        </Field>
        <Field>
          <Name>Token</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Unique Contract Identifier</Description>
        </Field>
        <Field>
          <Name>Order Type</Name>
          <Type>CHAR</Type>
          <Size>1</Size>
          <Description>Order Type Values</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Price of the order (In cents), at which the order is placed, in multiples of the tick size; divided by 10000 for converting into USD</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Quantity of the order</Description>
        </Field>
      </Fields>
    </Message>

    <!-- New Spread Order Message -->
    <Message>
      <Name>New Spread Order Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>G</Code>
      <Category>Market Data</Category>
      <Origin>Exchange</Origin>
      <Description>Outstanding spread order in the order book at the last snapshot refresh.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>LONG</Type>
          <Size>8</Size>
          <Description>Time in nanoseconds from 01-Jan-1980 00:00:00</Description>
        </Field>
        <Field>
          <Name>Order ID</Name>
          <Type>DOUBLE</Type>
          <Size>8</Size>
          <Description>Day Unique Order Reference Number</Description>
        </Field>
        <Field>
          <Name>Token</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Unique Contract Identifier</Description>
        </Field>
        <Field>
          <Name>Order Type</Name>
          <Type>CHAR</Type>
          <Size>1</Size>
          <Description>Order Type Values</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Price of the order (In cents), at which the order is placed, in multiples of the tick size; divided by 10000 for converting into USD</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Quantity of the order</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Book Snapshot Recovery Request Message -->
    <Message>
      <Name>Order Book Snapshot Recovery Request Message</Name>
      <Branch>clientpayload</Branch>
      <Dependency>clientmessagetype</Dependency>
      <Code>O</Code>
      <Category>Administrative</Category>
      <Origin>Firm</Origin>
      <Description>Sent to the Orderbook Snapshot Recovery Server to request the order book snapshot.</Description>
      <Fields>
        <Field>
          <Name>Stream ID</Name>
          <Type>SHORT</Type>
          <Size>2</Size>
          <Description>Unique Stream Reference</Description>
        </Field>
        <Field>
          <Name>Start Sequence Number</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>The value of this field should be zero</Description>
        </Field>
        <Field>
          <Name>End Sequence Number</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>The value of this field should be zero</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Book Snapshot Recovery Response Message -->
    <Message>
      <Name>Order Book Snapshot Recovery Response Message</Name>
      <Branch>responsepayload</Branch>
      <Dependency>responsemessagetype</Dependency>
      <Code>B</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>Sent by the Orderbook Snapshot Recovery Server to indicate whether the request was processed successfully; the Stream Header's sequence number is zero.</Description>
      <Fields>
        <Field>
          <Name>Request Status</Name>
          <Type>CHAR</Type>
          <Size>1</Size>
          <Description>Request Status</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- Order Type -->
    <Enum>
      <Name>Order Type</Name>
      <Values>
        <Value>
          <Data>B</Data>
          <Name>Buy Order</Name>
        </Value>
        <Value>
          <Data>S</Data>
          <Name>Sell Order</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Request Status -->
    <Enum>
      <Name>Request Status</Name>
      <Values>
        <Value>
          <Data>S</Data>
          <Name>Success</Name>
        </Value>
        <Value>
          <Data>E</Data>
          <Name>Error</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiMtbtPdf>
