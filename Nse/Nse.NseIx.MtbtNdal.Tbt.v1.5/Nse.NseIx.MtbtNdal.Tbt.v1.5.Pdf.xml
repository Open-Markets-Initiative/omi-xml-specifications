          <Name>Token 1</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Token No. of First Spread Contract</Description>
        </Field>
        <Field>
          <Name>Token 2</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Token No. of Second Spread Contract</Description>
        </Field>
        <Field>
          <Name>Day Low Price Diff Range</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Day low price difference range for the combination, which may be changed intraday; divided by 10000 to get the actual price</Description>
        </Field>
        <Field>
          <Name>Day High Price Diff Range</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Day high price difference range for the combination, which may be changed intraday; divided by 10000 to get the actual price</Description>
        </Field>
        <Field>
          <Name>Operating Range: Low Price Diff Range</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Minimum price difference at which the spread order could be placed without being rejected by the system, which may be changed intraday and flexed; divided by 10000 to get the actual price</Description>
        </Field>
        <Field>
          <Name>Operating Range: High Price Diff Range</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Maximum price difference at which the spread order could be placed without being rejected by the system, which may be changed intraday and flexed; divided by 10000 to get the actual price</Description>
        </Field>
      </Fields>
    </Message>

