<!--
  NDAL NSE IX MTBT API Technical Specification, Version 1.5, 13 October 2025, published by NSE
  Data and Analytics for NSE IX. The NDAL redistribution of the NSE IX tick by tick feed: the
  order and trade messages of sections 6.1 to 6.4, the market status and indicative equilibrium
  messages of sections 6.5 and 6.6, and the Stream Id no. 99 messages for Infofeed vendors
  (contract and spread contract masters of section 5.1, market statistics and open interest of
  sections 6.7 and 6.8), behind the eight byte Stream Header of section 4.

  Message types are case sensitive (FAQ 26, page 29): upper case belongs to Streams 1 and 2,
  lower case to Stream 99. There is no Trade Cancel message ('C') in this document.

  Not transcribed: the Tick Data Recovery Request and Response of section 7 (page 21), which run
  on Tcp; a request carries no header, so they are not messages of this Udp feed.

  Price: Price, Trade Price, Strike Price and Indicative price are each "divided by 10000 for
  converting into USD", and FAQ 23 (page 28) says the same of all price fields. Low Price Range and
  High Price Range are divided by 10000 except for INRUSD, divided by 100 (page 11). The spread
  contract ranges are divided by 10000 "to get actual price in rupees" (page 12); rupees is a slip
  for USD, as FAQ 23 has it, and the descriptions drop the currency.

  Section 5.1.2 prints Operating Range: Low Price Diff Range and Operating Range: High Price Diff
  Range with the colon, and it is kept in the name.
-->

  <Messages>

    <!-- Contract Information Message -->
    <Message>
      <Name>Contract Information Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>c</Code>
      <Category>Reference Data</Category>
      <Origin>Exchange</Origin>
      <Description>Beginning of day contract master information, sent before the market opens on Stream Id no. 99, for contracts valid in the NSE IX market.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>LONG</Type>
          <Size>8</Size>
          <Description>Time in nanoseconds from 01-Jan-1980 00:00:00</Description>
        </Field>
        <Field>
          <Name>Stream ID</Name>
          <Type>SHORT</Type>
          <Size>2</Size>
          <Description>Availability of this contract on a particular stream</Description>
        </Field>
        <Field>
          <Name>Token Number</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Unique identifier for contract</Description>
        </Field>
        <Field>
          <Name>Instrument</Name>
          <Type>CHAR</Type>
          <Size>6</Size>
          <Description>Security instrument, e.g. FUTIDX, FUTSTK; commodity instrument, e.g. FUTCOM</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>CHAR</Type>
          <Size>10</Size>
          <Description>Contract Symbol</Description>
        </Field>
        <Field>
          <Name>Expiry Date</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Expiry date of contract in seconds from 01-Jan-1980 00:00:00</Description>
        </Field>
        <Field>
          <Name>Strike Price</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Strike Price of Contract (In Cents), divided by 10000 for converting into USD; zero for a futures contract</Description>
        </Field>
        <Field>
          <Name>Option Type</Name>
          <Type>CHAR</Type>
          <Size>2</Size>
          <Description>Option Type for the contract</Description>
        </Field>
        <Field>
          <Name>Low Price Range</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Minimum price at which an order can be placed without causing a price freeze; divided by 10000 for all contracts except INRUSD, which is divided by 100</Description>
        </Field>
        <Field>
          <Name>High Price Range</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Maximum price at which an order can be placed without causing a price freeze; divided by 10000 for all contracts except INRUSD, which is divided by 100</Description>
        </Field>
        <Field>
          <Name>Daily Contract Indicator</Name>
          <Type>CHAR</Type>
          <Size>1</Size>
          <Description>Indicates whether the contract is categorized as a Daily contract</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Spread Contract Information Message -->
    <Message>
      <Name>Spread Contract Information Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>d</Code>
      <Category>Reference Data</Category>
      <Origin>Exchange</Origin>
