<OmiMtbtPdf>

  <Messages>

    <!-- Tick Data Recovery Request Message -->
    <Message>
      <Name>Tick Data Recovery Request Message</Name>
      <Branch>clientpayload</Branch>
      <Dependency>clientmessagetype</Dependency>
      <Code>R</Code>
      <Category>Administrative</Category>
      <Origin>Firm</Origin>
      <Description>Sent to the Recovery Server whenever tick data is missed.</Description>
      <Fields>
        <Field>
          <Name>Stream ID</Name>
          <Type>SHORT</Type>
          <Size>2</Size>
          <Description>Unique Stream Reference</Description>
        </Field>
        <Field>
          <Name>Start Sequence Number</Name>
          <Type>UINT</Type>
          <Size>4</Size>
          <Description>Requested Message Sequence Number</Description>
        </Field>
        <Field>
          <Name>End Sequence Number</Name>
          <Type>UINT</Type>
          <Size>4</Size>
          <Description>Requested Message Sequence Number</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Tick Data Recovery Response Message -->
    <Message>
      <Name>Tick Data Recovery Response Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>Y</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>First message sent by the Recovery Server, indicating whether the request was processed successfully.</Description>
      <Fields>
        <Field>
          <Name>Request Status</Name>
          <Type>CHAR</Type>
          <Size>1</Size>
          <Description>Request Status</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- Request Status -->
    <Enum>
      <Name>Request Status</Name>
      <Values>
        <Value>
          <Data>S</Data>
          <Name>Success</Name>
        </Value>
        <Value>
          <Data>E</Data>
          <Name>Error</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiMtbtPdf>
