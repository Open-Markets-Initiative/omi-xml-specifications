<OmiMtbtPdf>

  <Messages>

    <!-- New Order Message -->
    <Message>
      <Name>New Order Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>N</Code>
      <Origin>Exchange</Origin>
      <Description>For every new order request, this message is sent.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>LONG</Type>
          <Size>8</Size>
          <Description>Time in nanoseconds from 01-Jan-1980 00:00:00</Description>
        </Field>
        <Field>
          <Name>Order ID</Name>
          <Type>DOUBLE</Type>
          <Size>8</Size>
          <Description>Day Unique Order Reference Number</Description>
        </Field>
        <Field>
          <Name>Token</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Unique Contract Identifier</Description>
        </Field>
        <Field>
          <Name>Order Type</Name>
          <Type>CHAR</Type>
          <Size>1</Size>
          <Description>Order Type Values</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Price of the order (In Paise)</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Quantity of the order</Description>
        </Field>
      </Fields>
    </Message>

