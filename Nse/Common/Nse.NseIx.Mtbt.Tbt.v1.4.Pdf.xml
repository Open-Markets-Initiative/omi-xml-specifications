      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>X</Code>
      <Category>Market Data</Category>
      <Origin>Exchange</Origin>
      <Description>Sent for every order cancellation request (section 6.1). When the original Order Id is not found, the message is ignored.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>LONG</Type>
          <Size>8</Size>
          <Description>Time in nanoseconds from 01-Jan-1980 00:00:00</Description>
        </Field>
        <Field>
          <Name>Order ID</Name>
          <Type>DOUBLE</Type>
          <Size>8</Size>
          <Description>Day Unique Order Reference Number</Description>
        </Field>
        <Field>
          <Name>Token</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Unique Contract Identifier</Description>
        </Field>
        <Field>
          <Name>Order Type</Name>
          <Type>CHAR</Type>
          <Size>1</Size>
          <Description>Order side: 'B' - Buy Order, 'S' - Sell Order</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Price of the order (In cents), in multiples of the tick size; divided by 10000 for converting into USD</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Quantity of the order</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trade Message -->
    <Message>
      <Name>Trade Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>T</Code>
      <Category>Market Data</Category>
      <Origin>Exchange</Origin>
      <Description>Sent whenever an order in the order book gets executed fully or partially (section 6.2). Either Buy Order ID or Sell Order ID can be zero, in which case that Order ID should be ignored; both are never zero at the same time.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>LONG</Type>
          <Size>8</Size>
          <Description>Time in nanoseconds from 01-Jan-1980 00:00:00</Description>
        </Field>
        <Field>
          <Name>Buy Order ID</Name>
          <Type>DOUBLE</Type>
          <Size>8</Size>
          <Description>Day Unique Order Reference Number for Buy-Side Order</Description>
        </Field>
        <Field>
          <Name>Sell Order ID</Name>
          <Type>DOUBLE</Type>
          <Size>8</Size>
          <Description>Day Unique Order Reference Number for Sell-Side Order</Description>
        </Field>
        <Field>
          <Name>Token</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Unique Contract Identifier</Description>
        </Field>
        <Field>
          <Name>Trade Price</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Trade Price (In cents), at which the trade took place, in multiples of the tick size; divided by 10000 for converting into USD</Description>
        </Field>
        <Field>
          <Name>Trade Quantity</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Trade Quantity</Description>
        </Field>
      </Fields>
    </Message>

    <!-- New Spread Order Message -->
    <Message>
      <Name>New Spread Order Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>G</Code>
      <Category>Market Data</Category>
      <Origin>Exchange</Origin>
      <Description>Sent for every new spread order request, including the active orders (section 6.3).</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>LONG</Type>
          <Size>8</Size>
          <Description>Time in nanoseconds from 01-Jan-1980 00:00:00</Description>
        </Field>
        <Field>
          <Name>Order ID</Name>
          <Type>DOUBLE</Type>
          <Size>8</Size>
          <Description>Day Unique Order Reference Number</Description>
        </Field>
        <Field>
          <Name>Token</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Unique Contract Identifier</Description>
        </Field>
        <Field>
          <Name>Order Type</Name>
          <Type>CHAR</Type>
          <Size>1</Size>
          <Description>Order side: 'B' - Buy Order, 'S' - Sell Order</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Price difference for this spread (In cents), in multiples of the tick size; divided by 10000 for converting into USD</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Quantity of the spread order</Description>
        </Field>
      </Fields>
    </Message>

