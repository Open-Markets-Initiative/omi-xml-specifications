    <!-- Spread Trade Message -->
    <Message>
      <Name>Spread Trade Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>K</Code>
      <Category>Market Data</Category>
      <Origin>Exchange</Origin>
      <Description>Sent whenever a spread order in the order book gets executed fully or partially (section 6.4). Buy Order ID or Sell Order ID can be zero, in which case that Order ID should be ignored.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>LONG</Type>
          <Size>8</Size>
          <Description>Time in nanoseconds from 01-Jan-1980 00:00:00</Description>
        </Field>
        <Field>
          <Name>Buy Order ID</Name>
          <Type>DOUBLE</Type>
          <Size>8</Size>
          <Description>Day Unique Order Reference Number for Buy-Side Order</Description>
        </Field>
        <Field>
          <Name>Sell Order ID</Name>
          <Type>DOUBLE</Type>
          <Size>8</Size>
          <Description>Day Unique Order Reference Number for Sell-Side Order</Description>
        </Field>
        <Field>
          <Name>Token</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Unique Contract Identifier</Description>
        </Field>
        <Field>
          <Name>Trade Price</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Trade Price (In cents), at which the trade took place, in multiples of the tick size; divided by 10000 for converting into USD</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Quantity of the spread trade</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Market Status Message -->
    <Message>
      <Name>Market Status Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>S</Code>
      <Category>Market Data</Category>
      <Origin>Exchange</Origin>
      <Description>Sent whenever the status of the market is changed to preopen, preopen-end, open, closed, preclose and preclose-end, for both T and T+1 sessions (section 6.5).</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>LONG</Type>
          <Size>8</Size>
          <Description>Time in nanoseconds from 01-Jan-1980 00:00:00</Description>
        </Field>
        <Field>
          <Name>Instrument</Name>
          <Type>CHAR</Type>
          <Size>6</Size>
          <Description>Name of the instrument for which the status change message is being sent, e.g. FUTIDX, OPTIDX</Description>
        </Field>
        <Field>
          <Name>Status</Name>
          <Type>SHORT</Type>
          <Size>2</Size>
          <Description>'0' Preopen, '1' Open, '2' Closed, '3' Preopen-end, '4' PreClose, '5' PreClose-end</Description>
        </Field>
        <Field>
          <Name>Session Indc</Name>
          <Type>SHORT</Type>
          <Size>2</Size>
          <Description>'1' T Session, '2' T+1 Session</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Indicative Price And Quantity Message -->
    <Message>
      <Name>Indicative Price And Quantity Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>P</Code>
      <Category>Market Data</Category>
      <Origin>Exchange</Origin>
      <Description>Indicative equilibrium price and quantity, sent for contracts with pre-open and pre-close sessions, only between the preopen or preclose and the preopen end or preclose end statuses, when the indicative price and quantity are determined or updated during order collection (section 6.6).</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>LONG</Type>
          <Size>8</Size>
          <Description>Time in nanoseconds from 01-Jan-1980 00:00:00</Description>
        </Field>
        <Field>
          <Name>Token</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Unique Contract Identifier</Description>
        </Field>
        <Field>
          <Name>Identifier</Name>
          <Type>CHAR</Type>
          <Size>1</Size>
          <Description>Whether the open price or the close price is being determined: 'O' Indicative open price, 'C' Indicative close price</Description>
        </Field>
        <Field>
          <Name>Indicative price</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Indicative open or close price, in multiples of the tick size; divided by 10000 for converting into USD</Description>
        </Field>
        <Field>
          <Name>Indicative quantity</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Indicative equilibrium quantity which shall be traded at the indicative open or close price</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Heartbeat Message -->
    <Message>
      <Name>Heartbeat Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>Z</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>Sent when there is no data available for a few seconds; the sequence number field in the Stream Header will have the value 0 (zero) (section 9).</Description>
      <Fields>
        <Field>
          <Name>Last Sequence No</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Last sent data sequence no. of the Stream</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

