<OmiMtbtPdf>

  <!-- NSE IFSC MTBT API Technical Specification, Version 1.4, 28 January 2026: sections 6.1 to 6.6
       (pages 8 to 13) and 9 (page 19). Little endian, pragma pack 1 (section 3, page 3). -->

  <Messages>

    <!-- New Order Message -->
    <Message>
      <Name>New Order Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>N</Code>
      <Category>Market Data</Category>
      <Origin>Exchange</Origin>
      <Description>Sent for every new order request, including the active orders (section 6.1).</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>LONG</Type>
          <Size>8</Size>
          <Description>Time in nanoseconds from 01-Jan-1980 00:00:00</Description>
        </Field>
        <Field>
          <Name>Order ID</Name>
          <Type>DOUBLE</Type>
          <Size>8</Size>
          <Description>Day Unique Order Reference Number</Description>
        </Field>
        <Field>
          <Name>Token</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Unique Contract Identifier</Description>
        </Field>
        <Field>
          <Name>Order Type</Name>
          <Type>CHAR</Type>
          <Size>1</Size>
          <Description>Order side: 'B' - Buy Order, 'S' - Sell Order</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Price of the order (In cents), in multiples of the tick size; divided by 10000 for converting into USD</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Quantity of the order</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Modification Message -->
    <Message>
      <Name>Order Modification Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>M</Code>
      <Category>Market Data</Category>
      <Origin>Exchange</Origin>
      <Description>Sent for every order modification request (section 6.1). When the original Order Id is not found, the message is treated as a new order.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>LONG</Type>
          <Size>8</Size>
          <Description>Time in nanoseconds from 01-Jan-1980 00:00:00</Description>
        </Field>
        <Field>
          <Name>Order ID</Name>
          <Type>DOUBLE</Type>
          <Size>8</Size>
          <Description>Day Unique Order Reference Number</Description>
        </Field>
        <Field>
          <Name>Token</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Unique Contract Identifier</Description>
        </Field>
        <Field>
          <Name>Order Type</Name>
          <Type>CHAR</Type>
          <Size>1</Size>
          <Description>Order side: 'B' - Buy Order, 'S' - Sell Order</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Price of the order (In cents), in multiples of the tick size; divided by 10000 for converting into USD</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Quantity of the order</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Cancellation Message -->
    <Message>
