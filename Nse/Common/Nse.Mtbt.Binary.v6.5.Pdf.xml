<OmiMtbtPdf>

  <Messages>

    <!-- Order Message -->
    <Message>
      <Name>Order Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>N,M,X</Code>
      <Origin>Exchange</Origin>
      <Description>Sent for every new order request, modification request, and cancellation request. All new order requests are sent, including the active orders. Modifications and cancellations must be handled at the client end on the basis of Order ID and not on Price.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>LONG</Type>
          <Size>8</Size>
          <Description>Time in nanoseconds from 01-Jan-1980 00:00:00</Description>
        </Field>
        <Field>
          <Name>Order ID</Name>
          <Type>DOUBLE</Type>
          <Size>8</Size>
          <Description>Day Unique Order Reference Number</Description>
        </Field>
        <Field>
          <Name>Token</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Unique Contract Identifier</Description>
        </Field>
        <Field>
          <Name>Order Type</Name>
          <Type>CHAR</Type>
          <Size>1</Size>
          <Description>Order Type Values</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Price of the order (In Paise)</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Quantity of the order</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trade Message -->
    <Message>
      <Name>Trade Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>T</Code>
      <Origin>Exchange</Origin>
      <Description>Sent whenever an order in the order book gets executed fully or partially. Either Buy Order ID or Sell Order ID can be zero, in which case that Order ID should be ignored.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>LONG</Type>
          <Size>8</Size>
          <Description>Time in nanoseconds from 01-Jan-1980 00:00:00</Description>
        </Field>
        <Field>
          <Name>Buy Order ID</Name>
          <Type>DOUBLE</Type>
          <Size>8</Size>
          <Description>Day Unique Order Reference Number for Buy-Side Order</Description>
        </Field>
        <Field>
          <Name>Sell Order ID</Name>
          <Type>DOUBLE</Type>
          <Size>8</Size>
          <Description>Day Unique Order Reference Number for Sell-Side Order</Description>
        </Field>
        <Field>
          <Name>Token</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Unique Contract Identifier</Description>
        </Field>
        <Field>
          <Name>Trade Price</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Trade Price (In Paise)</Description>
        </Field>
        <Field>
          <Name>Trade Quantity</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Trade Quantity</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Spread Order Message -->
    <Message>
      <Name>Spread Order Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>G,H,J</Code>
      <Origin>Exchange</Origin>
      <Description>CD segment only. Sent for every new spread order request, modification request, and cancellation request. All new spread order requests are sent including the active orders.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>LONG</Type>
          <Size>8</Size>
          <Description>Time in nanoseconds from 01-Jan-1980 00:00:00</Description>
        </Field>
        <Field>
          <Name>Order ID</Name>
          <Type>DOUBLE</Type>
          <Size>8</Size>
          <Description>Day Unique Order Reference Number</Description>
        </Field>
        <Field>
          <Name>Token</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Unique Contract Identifier</Description>
        </Field>
        <Field>
          <Name>Order Type</Name>
          <Type>CHAR</Type>
          <Size>1</Size>
          <Description>Order Type Values</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Price of the order (In Paise)</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Quantity of the spread order</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Spread Trade Message -->
    <Message>
      <Name>Spread Trade Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>K</Code>
      <Origin>Exchange</Origin>
      <Description>CD segment only. Sent whenever a spread order in the order book gets executed fully or partially. Either Buy Order ID or Sell Order ID can be zero, in which case that Order ID should be ignored.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>LONG</Type>
          <Size>8</Size>
          <Description>Time in nanoseconds from 01-Jan-1980 00:00:00</Description>
        </Field>
        <Field>
          <Name>Buy Order ID</Name>
          <Type>DOUBLE</Type>
          <Size>8</Size>
          <Description>Day Unique Order Reference Number for Buy-Side Order</Description>
        </Field>
        <Field>
          <Name>Sell Order ID</Name>
          <Type>DOUBLE</Type>
          <Size>8</Size>
          <Description>Day Unique Order Reference Number for Sell-Side Order</Description>
        </Field>
        <Field>
          <Name>Token</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Unique Contract Identifier</Description>
        </Field>
        <Field>
          <Name>Trade Price</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Trade Price (In Paise)</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Quantity of the spread trade</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trade Cancel Message -->
    <Message>
      <Name>Trade Cancel Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>C</Code>
      <Origin>Exchange</Origin>
      <Description>CM segment only. Sent whenever a Trade gets cancelled. Both the Order IDs will have value as zero in this message.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>LONG</Type>
          <Size>8</Size>
          <Description>Time in nanoseconds from 01-Jan-1980 00:00:00</Description>
        </Field>
        <Field>
          <Name>Buy Order ID</Name>
          <Type>DOUBLE</Type>
          <Size>8</Size>
          <Description>This will be zero for trade cancel message.</Description>
        </Field>
        <Field>
          <Name>Sell Order ID</Name>
          <Type>DOUBLE</Type>
          <Size>8</Size>
          <Description>This will be zero for trade cancel message.</Description>
        </Field>
        <Field>
          <Name>Token</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Unique Contract Identifier</Description>
        </Field>
        <Field>
          <Name>Trade Price</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Trade Price (In Paise)</Description>
        </Field>
        <Field>
          <Name>Trade Quantity</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Trade Quantity</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Heartbeat Message -->
    <Message>
      <Name>Heartbeat Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>Z</Code>
      <Origin>Exchange</Origin>
      <Description>Sent when there is no data available for a few seconds, on all Streams. The sequence number field in the Stream Header will have the value 0 (zero) for this message.</Description>
      <Fields>
        <Field>
          <Name>Last Sequence No</Name>
          <Type>INT</Type>
          <Size>4</Size>
          <Description>Last sent data sequence no. of the Stream</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>
  
  <Enums>

    <!-- Order Type -->
    <Enum>
      <Name>Order Type</Name>
      <Values>
        <Value>
          <Data>B</Data>
          <Name>Buy Order</Name>
        </Value>
        <Value>
          <Data>S</Data>
          <Name>Sell Order</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiMtbtPdf>
