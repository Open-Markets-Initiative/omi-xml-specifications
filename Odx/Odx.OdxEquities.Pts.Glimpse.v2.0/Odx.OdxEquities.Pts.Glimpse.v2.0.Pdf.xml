<OmiItchOdxPtsPdf>

  <Messages>

    <!-- Timestamp Seconds Message -->
    <Message>
      <Name>Timestamp Seconds Message</Name>
      <Dependency>Sequenced Message Type</Dependency>
      <Branch>Sequenced Message</Branch>
      <Code>T</Code>
      <Category>Technical</Category>
      <Origin>Exchange</Origin>
      <Description>Reflects the number of seconds past midnight</Description>
      <Fields>
        <Field>
          <Name>Timestamp Seconds</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of seconds since midnight</Description>
        </Field>
      </Fields>
    </Message>

    <!-- System Event Message -->
    <Message>
      <Name>System Event Message</Name>
      <Dependency>Sequenced Message Type</Dependency>
      <Branch>Sequenced Message</Branch>
      <Code>S</Code>
      <Category>Technical</Category>
      <Origin>Exchange</Origin>
      <Description>System Event Messages signal data feed, system and market events</Description>
      <Fields>
        <Field>
          <Name>Timestamp Nanoseconds</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of nanoseconds since last Timestamp Seconds Message</Description>
        </Field>
        <Field>
          <Name>Group</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Orderbook group identifier Blank if system wide event</Description>
        </Field>
        <Field>
          <Name>System Event</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>System event code</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Price Tick Size Message -->
    <Message>
      <Name>Price Tick Size Message</Name>
      <Dependency>Sequenced Message Type</Dependency>
      <Branch>Sequenced Message</Branch>
      <Code>L</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>Price Tick Size Messages define a set of price tick size tables</Description>
      <Fields>
        <Field>
          <Name>Timestamp Nanoseconds</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of nanoseconds since last Timestamp Seconds Message</Description>
        </Field>
        <Field>
          <Name>Price Tick Size Table Id</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Price tick size table identifier</Description>
        </Field>
        <Field>
          <Name>Price Tick Size</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Price tick size</Description>
        </Field>
        <Field>
          <Name>Price Start</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Start of price range for this price tick size</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Orderbook Directory Message -->
    <Message>
      <Name>Orderbook Directory Message</Name>
      <Dependency>Sequenced Message Type</Dependency>
      <Branch>Sequenced Message</Branch>
      <Code>R</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>Orderbook Directory Messages provide information about orderbooks available in the ODX PTS execution system</Description>
      <Fields>
        <Field>
          <Name>Timestamp Nanoseconds</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of nanoseconds since last Timestamp Seconds Message</Description>
        </Field>
        <Field>
          <Name>Orderbook Id</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>4 digit Quick code</Description>
        </Field>
        <Field>
          <Name>Orderbook Code</Name>
          <Type>Alpha</Type>
          <Size>12</Size>
          <Description>International Securities Identification Number (ISIN)</Description>
        </Field>
        <Field>
          <Name>Group</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Orderbook group identifier</Description>
        </Field>
        <Field>
          <Name>Round Lot Size</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of shares that represent a round lot</Description>
        </Field>
        <Field>
          <Name>Price Tick Size Table Id</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Price tick size table identifier</Description>
        </Field>
        <Field>
          <Name>Price Decimals</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of decimal places in price fields Value is 1</Description>
        </Field>
        <Field>
          <Name>Upper Price Limit</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Maximum tradable price</Description>
        </Field>
        <Field>
          <Name>Lower Price Limit</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Minimum tradable price</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trading State Message -->
    <Message>
      <Name>Trading State Message</Name>
      <Dependency>Sequenced Message Type</Dependency>
      <Branch>Sequenced Message</Branch>
      <Code>H</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>A Trading State Message indicates the current trading status of an orderbook</Description>
      <Fields>
        <Field>
          <Name>Timestamp Nanoseconds</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of nanoseconds since last Timestamp Seconds Message</Description>
        </Field>
        <Field>
          <Name>Orderbook Id</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>4 digit Quick code</Description>
        </Field>
        <Field>
          <Name>Group</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Orderbook group identifier</Description>
        </Field>
        <Field>
          <Name>Trading State</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Current trading status</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Short Selling Price Restriction State Message -->
    <Message>
      <Name>Short Selling Price Restriction State Message</Name>
      <Dependency>Sequenced Message Type</Dependency>
      <Branch>Sequenced Message</Branch>
      <Code>Y</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>A Short Selling Price Restriction State Message indicates the current short selling price restriction status of an orderbook</Description>
      <Fields>
        <Field>
          <Name>Timestamp Nanoseconds</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of nanoseconds since last Timestamp Seconds Message</Description>
        </Field>
        <Field>
          <Name>Orderbook Id</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>4 digit Quick code</Description>
        </Field>
        <Field>
          <Name>Group</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Orderbook group identifier</Description>
        </Field>
        <Field>
          <Name>Short Selling State</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Current short selling price restriction status</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Added Message -->
    <Message>
      <Name>Order Added Message</Name>
      <Dependency>Sequenced Message Type</Dependency>
      <Branch>Sequenced Message</Branch>
      <Code>A</Code>
      <Category>Add</Category>
      <Origin>Exchange</Origin>
      <Description>An Order Added Message indicates that an order exists in the ODX PTS execution system displayable book</Description>
      <Fields>
        <Field>
          <Name>Timestamp Nanoseconds</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of nanoseconds since last Timestamp Seconds Message</Description>
        </Field>
        <Field>
          <Name>Order Number</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Reference number of the accepted order Zero indicates a reference price update</Description>
        </Field>
        <Field>
          <Name>Buy/Sell Indicator</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Side of the order Ignore if reference price update</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Total number of shares added to the book Ignore if reference price update</Description>
        </Field>
        <Field>
          <Name>Orderbook Id</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>4 digit Quick code</Description>
        </Field>
        <Field>
          <Name>Group</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Orderbook group identifier</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Price of the order For a reference price update, a value of 214,748,364.7 (7FFFFFFF hex) denotes no reference price available</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Added with Attributes Message -->
    <Message>
      <Name>Order Added with Attributes Message</Name>
      <Dependency>Sequenced Message Type</Dependency>
      <Branch>Sequenced Message</Branch>
      <Code>F</Code>
      <Category>Add</Category>
      <Origin>Exchange</Origin>
      <Description>An Order Added with Attributes Message is generated for orders with market specific attributes present in the system</Description>
      <Fields>
        <Field>
          <Name>Timestamp Nanoseconds</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Number of nanoseconds since last Timestamp Seconds Message</Description>
        </Field>
        <Field>
          <Name>Order Number</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Reference number of the accepted order</Description>
        </Field>
        <Field>
          <Name>Buy/Sell Indicator</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Side of the order</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Total number of shares added to the book</Description>
        </Field>
        <Field>
          <Name>Orderbook Id</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>4 digit Quick code</Description>
        </Field>
        <Field>
          <Name>Group</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Orderbook group identifier</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Price of the order</Description>
        </Field>
        <Field>
          <Name>Attribution</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Reserved Always blank</Description>
        </Field>
        <Field>
          <Name>Order Type</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Type of the order</Description>
        </Field>
      </Fields>
    </Message>

    <!-- End of Snapshot Message -->
    <Message>
      <Name>End of Snapshot Message</Name>
      <Dependency>Sequenced Message Type</Dependency>
      <Branch>Sequenced Message</Branch>
      <Code>G</Code>
      <Category>Technical</Category>
      <Origin>Exchange</Origin>
      <Description>The End of Snapshot Message provides the next sequence number of the real-time Itch market data feed at the time the snapshot was taken</Description>
      <Fields>
        <Field>
          <Name>Sequence Number</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Itch market data feed sequence number</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <Enum>
      <Name>System Event</Name>
      <Values>
        <Value>
          <Data>O</Data>
          <Name>Start of Messages</Name>
        </Value>
        <Value>
          <Data>C</Data>
          <Name>End of Messages</Name>
        </Value>
      </Values>
    </Enum>

    <Enum>
      <Name>Trading State</Name>
      <Values>
        <Value>
          <Data>T</Data>
          <Name>Trading</Name>
        </Value>
        <Value>
          <Data>V</Data>
          <Name>Suspended</Name>
        </Value>
      </Values>
    </Enum>

    <Enum>
      <Name>Short Selling State</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>No Price Restriction</Name>
        </Value>
        <Value>
          <Data>1</Data>
          <Name>Price Restriction in Effect</Name>
        </Value>
      </Values>
    </Enum>

    <Enum>
      <Name>Buy/Sell Indicator</Name>
      <Values>
        <Value>
          <Data>B</Data>
          <Name>Buy</Name>
        </Value>
        <Value>
          <Data>S</Data>
          <Name>Sell</Name>
        </Value>
      </Values>
    </Enum>

    <Enum>
      <Name>Order Type</Name>
      <Values>
        <Value>
          <Data>Q</Data>
          <Name>DLP Order</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiItchOdxPtsPdf>
