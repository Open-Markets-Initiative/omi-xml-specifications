    <!-- 7.4.5 Reject -->
    <Message>
      <Name>Reject</Name>
      <MsgType>3</MsgType>
      <Category>admin</Category>
      <Origin>Client,Exchange</Origin>
      <Fields>
        <Field>
          <Tag>45</Tag>
          <Name>RefSeqNum</Name>
          <Required>Y</Required>
          <Type>int</Type>
          <Description>MsgSeqNum (34) of rejected message</Description>
        </Field>
        <Field>
          <Tag>58</Tag>
          <Name>Text</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Message explaining reject reason.</Description>
        </Field>
        <Field>
          <Tag>371</Tag>
          <Name>RefTagID</Name>
          <Required>N</Required>
          <Type>int</Type>
          <Description>The tag number of the FIX field being referenced.</Description>
        </Field>
        <Field>
          <Tag>372</Tag>
          <Name>RefMsgType</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>The MsgType (35) of the FIX message being referenced.</Description>
        </Field>
        <Field>
          <Tag>373</Tag>
          <Name>SessionRejectReason</Name>
          <Required>N</Required>
          <Type>int</Type>
          <Description>Code to identify reason for a session-level Reject message. Values: 0 = Invalid tag number, 1 = Required tag missing, 2 = Tag not defined for this message type, 4 = Tag specified without a value, 5 = Value is incorrect (out of range) for this tag, 6 = Incorrect data format for value, 9 = CompID problem, 10 = SendingTime(52) accuracy problem, 11 = Invalid MsgType(35), 13 = Tag appears more than once, 99 = Other</Description>
        </Field>
      </Fields>
    </Message>

    <!-- 7.4.6 Sequence Reset -->
    <Message>
      <Name>Sequence Reset</Name>
      <MsgType>4</MsgType>
      <Category>admin</Category>
      <Origin>Client,Exchange</Origin>
      <Fields>
        <Field>
          <Tag>36</Tag>
          <Name>NewSeqNo</Name>
          <Required>Y</Required>
          <Type>int</Type>
          <Description>New sequence number.</Description>
        </Field>
        <Field>
          <Tag>123</Tag>
          <Name>GapFillFlag</Name>
          <Required>N</Required>
          <Type>Boolean</Type>
          <Description>Indicates replacing administrative or application messages which will not be resent. Values: Y = Gap Fill message, MsgSeqNum (34) field valid, N = Sequence Reset, ignore MsgSeqNum (34)</Description>
        </Field>
      </Fields>
    </Message>

    <!-- 7.4.7 Logout -->
    <Message>
      <Name>Logout</Name>
      <MsgType>5</MsgType>
      <Category>admin</Category>
      <Origin>Client,Exchange</Origin>
      <Fields>
        <Field>
          <Tag>58</Tag>
          <Name>Text</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Message explaining logout reason.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- 7.5.1 New Order Single (Standard header - Incoming) -->
    <Message>
      <Name>New Order Single</Name>
      <MsgType>D</MsgType>
      <Category>app</Category>
      <Origin>Client</Origin>
      <Fields>
        <Field>
          <Tag>1</Tag>
          <Name>Account</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Account mnemonic as assigned by the institution.</Description>
        </Field>
        <Field>
          <Tag>11</Tag>
          <Name>ClOrdID</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>Unique identifier for the order as assigned by the institution.</Description>
        </Field>
        <Field>
          <Tag>21</Tag>
          <Name>HandlInst</Name>
          <Required>N</Required>
          <Type>Char</Type>
          <Description>Instructions for order handling on Broker trading floor. Values: 1 = Automated execution order, private, no Broker intervention</Description>
        </Field>
        <Field>
          <Tag>22</Tag>
          <Name>IDSource</Name>
          <Required>N</Required>
          <Type>Char</Type>
          <Description>Values: 8 = Exchange Symbol</Description>
        </Field>
        <Field>
          <Tag>38</Tag>
          <Name>OrderQty</Name>
          <Required>Y</Required>
          <Type>Qty</Type>
          <Description>Quantity ordered.</Description>
        </Field>
        <Field>
          <Tag>40</Tag>
          <Name>OrdType</Name>
          <Required>Y</Required>
          <Type>Char</Type>
          <Description>Order type. Values: 1 = Market, 2 = Limit, 5 = Market on Close, B = Limit on Close</Description>
        </Field>
        <Field>
          <Tag>44</Tag>
          <Name>Price</Name>
          <Required>N</Required>
          <Type>Price</Type>
          <Description>Required for limit orders only, i.e. OrdType (40) = 2 (Limit) or B (Limit on Close). Must be absent for market orders, i.e. OrdType(40) = 1 (Market) or 5 (Market on Close)</Description>
        </Field>
        <Field>
          <Tag>47</Tag>
          <Name>Rule80A</Name>
          <Required>N</Required>
          <Type>Char</Type>
