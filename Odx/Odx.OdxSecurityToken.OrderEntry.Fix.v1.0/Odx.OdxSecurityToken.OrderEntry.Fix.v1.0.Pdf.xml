    <!-- Order Cancel Reject (Standard header - Outgoing). One FIX message (MsgType 9) documented in two sections, merged here:
         7.5.5 Order Cancel Reject (CxlRejResponseTo (434) = 1) and 7.5.8 Order Cancel Replace Reject (CxlRejResponseTo (434) = 2).
         Both sections list the same tags with the same Req'd flags. They differ in the values listed: CxlRejResponseTo (434) is 1 in 7.5.5 and 2 in 7.5.8;
         CxlRejReason (102) 8 = Price exceeds current price band appears in 7.5.8 only, and 6 reads "Duplicate ClOrdID (11) received" in 7.5.5 but "Duplicate Order (e.g. duplicate ClOrdID (11))" in 7.5.8;
         OrdStatus (39) 4 is spelled "Canceled" in 7.5.5 and "Cancelled" in 7.5.8. -->    <Message>
      <Name>Order Cancel Reject</Name>
      <MsgType>9</MsgType>
      <Category>app</Category>
      <Origin>Exchange</Origin>
      <Fields>
        <Field>
          <Tag>11</Tag>
          <Name>ClOrdID</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>Unique identifier for the order as assigned by the institution.</Description>
        </Field>
        <Field>
          <Tag>37</Tag>
          <Name>OrderID</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>Unique identifier for order as assigned by ODX PTS. Value is NONE if CxlRejReason (102) = 1 (Unknown order).</Description>
        </Field>
        <Field>
          <Tag>39</Tag>
          <Name>OrdStatus</Name>
          <Required>Y</Required>
          <Type>Char</Type>
          <Description>Identifies current status of this order. Values: 0 = New, 1 = Partially filled, 2 = Filled, 4 = Canceled, 5 = Replaced, 8 = Rejected</Description>
        </Field>
        <Field>
          <Tag>41</Tag>
          <Name>OrigClOrdID</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>ClOrdID (11) of the previous order (not the initial order) as assigned by the institution.</Description>
        </Field>
        <Field>
          <Tag>58</Tag>
          <Name>Text</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Message explaining reject reason.</Description>
        </Field>
        <Field>
          <Tag>102</Tag>
          <Name>CxlRejReason</Name>
          <Required>Y</Required>
          <Type>int</Type>
          <Description>Code to identify reason for cancel rejection. Values: 0 = Too late to cancel, 1 = Unknown order, 6 = Duplicate ClOrdID (11) received, 8 = Price exceeds current price band, 99 = Other</Description>
        </Field>
        <Field>
          <Tag>434</Tag>
          <Name>CxlRejResponseTo</Name>
          <Required>Y</Required>
          <Type>Char</Type>
          <Description>Identifies the type of request that a Cancel Reject is in response to. Values: 1 = Order Cancel Request, 2 = Order Cancel/Replace Request</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Execution Report (Standard header - Outgoing). One FIX message (MsgType 8) documented in five sections, merged here:
         7.5.2 Order Rejected (ExecType (150) = 8), 7.5.3 Order Accepted (ExecType = 0), 7.5.6 Order Canceled (ExecType = 4),
         7.5.9 Order Replaced (ExecType = 5), 7.5.10 Trade (ExecType = 1 or 2).
         A field is Required Y here only when every section lists it as Y or R. Fields required in some sections only:
           LastPx (31), LastShares (32): R in Trade only.
           OrigClOrdID (41): blank in Order Canceled, R in Order Replaced, absent elsewhere.
           Price (44): R in Trade, blank elsewhere.
           TransactTime (60): R in Order Accepted, Order Canceled, Order Replaced and Trade; absent from Order Rejected.
           OrdRejReason (103): R in Order Rejected only.
           TrdMatchID (880): R in Trade only.
         Present in one section only: Text (58) in Order Rejected, ExecRestatementReason (378) in Order Canceled, NoContraBrokers (382) in Trade.
         Section-specific comment text: AvgPx (6) and CumQty (14) "Value is 0." in Order Accepted; OrderID (37) "Value is NONE if Order is not accepted before." in Order Rejected;
           OrderQty (38) "Quantity ordered." in Order Rejected, "Quantity accepted." elsewhere; Price (44) "Price per share entered." in Order Rejected, "Price per share accepted." elsewhere;
           TransactTime (60) adds "This field is ignored" in Order Replaced; LeavesQty (151) "Value is the same as that of OrderQty (38)." in Order Accepted, "Value is 0." in Order Canceled.
         Section-specific values: OrdStatus (39) lists 8 in Order Rejected, 0 in Order Accepted, 4 in Order Canceled, 1, 2 and 5 in Order Replaced, 1 and 2 in Trade.
         ExecType (150) value 4 is spelled "Cancelled" while OrdStatus (39) value 4 is "Canceled" in Order Canceled. -->
    <!-- Execution Report - Trade lists NoContraBrokers (382, Int) and ContraBroker (375, String) as flat rows, both with a blank Req'd column; transcribed as the NoContraBrokers group. -->
    <Message>
      <Name>Execution Report</Name>
      <MsgType>8</MsgType>
      <Category>app</Category>
      <Origin>Exchange</Origin>
      <Fields>
        <Field>
          <Tag>1</Tag>
          <Name>Account</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Account mnemonic as assigned by the institution.</Description>
        </Field>
        <Field>
