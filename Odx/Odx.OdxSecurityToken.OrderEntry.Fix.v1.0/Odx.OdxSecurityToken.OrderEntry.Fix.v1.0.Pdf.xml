<OmiFixPdf>

  <!-- Osaka Digital Exchange (ODX) PTS FIX Trading Specification for Security Token v1.0 (2023-11-15, initial version). FIX 4.2 order entry for the ODX security token market, identifying instruments by ISIN in Symbol or by exchange symbol in SecurityID, with contra broker reporting on trades. -->

  <!-- Req'd column (section 5.1): Y = required by the standard, blank = not required (transcribed N), R = additional required field of this specification over the standard (transcribed Y, since the loader reads only Y as required). -->

  <!-- Field length limitations (section 5.1) are not transcribed as Size or Decimals: Account 60 characters; AvgPx 8 whole digits and 4 decimals; ClOrdID 32; CumQty 9 digits; ExecID 20; LastPx 8 whole digits and 2 decimals; LastShares 9 digits; OrderID 20 digits; OrderQty 9 digits; OrigClOrdID 32; Price 8 whole digits and 2 decimals, maximum 21,474,836.46; Symbol 12; LeavesQty 9 digits; TradingSessionID 20; TrdMatchID 20 digits; SecurityID 12. -->

  <!-- 7.1 Standard Header - Incoming Messages -->
  <Header Name="Client">
    <Fields>
      <Field>
        <Tag>8</Tag>
        <Name>BeginString</Name>
        <Required>Y</Required>
        <Type>String</Type>
        <Fixed>Y</Fixed>
        <Description>Identifies beginning of new message and protocol version. Always first field in message. Value is FIX.4.2.</Description>
      </Field>
      <Field>
        <Tag>9</Tag>
        <Name>BodyLength</Name>
        <Required>Y</Required>
        <Type>int</Type>
        <Fixed>Y</Fixed>
        <Description>Message length, in bytes, forward to the CheckSum (10) field. Always second field in message.</Description>
      </Field>
      <Field>
        <Tag>35</Tag>
        <Name>MsgType</Name>
        <Required>Y</Required>
        <Type>String</Type>
        <Fixed>Y</Fixed>
        <Description>Defines message type. Always third field in message.</Description>
      </Field>
      <Field>
        <Tag>34</Tag>
        <Name>MsgSeqNum</Name>
        <Required>Y</Required>
        <Type>int</Type>
        <Description>Integer message sequence number.</Description>
      </Field>
      <Field>
        <Tag>43</Tag>
        <Name>PossDupFlag</Name>
        <Required>N</Required>
        <Type>Boolean</Type>
        <Description>Indicates possible retransmission of message with this sequence number. Values: Y = Possible duplicate, N = Original transmission</Description>
      </Field>
      <Field>
        <Tag>49</Tag>
        <Name>SenderCompID</Name>
        <Required>Y</Required>
        <Type>String</Type>
        <Description>Used to identify firm sending message. As assigned by ODX PTS.</Description>
      </Field>
      <Field>
        <Tag>52</Tag>
        <Name>SendingTime</Name>
        <Required>Y</Required>
        <Type>UTCTimestamp</Type>
        <Description>Time of message transmission (always expressed in UTC).</Description>
      </Field>
      <Field>
        <Tag>56</Tag>
        <Name>TargetCompID</Name>
        <Required>Y</Required>
        <Type>String</Type>
        <Description>Used to identify receiving firm. As assigned by ODX PTS.</Description>
      </Field>
      <Field>
        <Tag>97</Tag>
        <Name>PossResend</Name>
        <Required>N</Required>
        <Type>Boolean</Type>
        <Description>Indicates that message may contain information that has been sent under another sequence number. Values: Y = Possible resend, N = Original transmission</Description>
      </Field>
      <Field>
        <Tag>122</Tag>
        <Name>OrigSendingTime</Name>
        <Required>N</Required>
        <Type>UTCTimestamp</Type>
        <Description>Original time of message transmission (always expressed in UTC).</Description>
      </Field>
    </Fields>
  </Header>

  <!-- 7.2 Standard Header - Outgoing Messages (no PossDupFlag (43) or PossResend (97)) -->
  <Header Name="Exchange">
    <Fields>
      <Field>
        <Tag>8</Tag>
        <Name>BeginString</Name>
        <Required>Y</Required>
        <Type>String</Type>
        <Fixed>Y</Fixed>
        <Description>Identifies beginning of new message and protocol version. Always first field in message. Value is FIX.4.2.</Description>
      </Field>
      <Field>
        <Tag>9</Tag>
        <Name>BodyLength</Name>
        <Required>Y</Required>
        <Type>int</Type>
        <Fixed>Y</Fixed>
        <Description>Message length, in bytes, forward to the CheckSum (10) field. Always second field in message.</Description>
      </Field>
      <Field>
        <Tag>35</Tag>
        <Name>MsgType</Name>
        <Required>Y</Required>
        <Type>String</Type>
        <Fixed>Y</Fixed>
        <Description>Defines message type. Always third field in message.</Description>
      </Field>
      <Field>
        <Tag>34</Tag>
        <Name>MsgSeqNum</Name>
        <Required>Y</Required>
        <Type>int</Type>
        <Description>Integer message sequence number.</Description>
      </Field>
      <Field>
        <Tag>49</Tag>
        <Name>SenderCompID</Name>
        <Required>Y</Required>
        <Type>String</Type>
        <Description>Used to identify firm sending message. As assigned by ODX PTS.</Description>
      </Field>
      <Field>
        <Tag>52</Tag>
        <Name>SendingTime</Name>
        <Required>Y</Required>
        <Type>UTCTimestamp</Type>
        <Description>Time of message transmission (always expressed in UTC).</Description>
      </Field>
      <Field>
        <Tag>56</Tag>
        <Name>TargetCompID</Name>
        <Required>Y</Required>
        <Type>String</Type>
        <Description>Used to identify receiving firm. As assigned by ODX PTS.</Description>
      </Field>
      <Field>
        <Tag>122</Tag>
        <Name>OrigSendingTime</Name>
        <Required>N</Required>
        <Type>UTCTimestamp</Type>
        <Description>Original time of message transmission (always expressed in UTC).</Description>
      </Field>
    </Fields>
  </Header>

  <!-- 7.3 Standard Trailer -->
  <Trailer>
    <Fields>
      <Field>
        <Tag>10</Tag>
        <Name>CheckSum</Name>
        <Required>Y</Required>
        <Type>String</Type>
        <Fixed>Y</Fixed>
        <Description>Three bytes, simple checksum. Always defined as three characters. Always last field in message.</Description>
      </Field>
    </Fields>
  </Trailer>

  <Messages>

    <!-- 7.4.1 Logon -->
    <Message>
      <Name>Logon</Name>
      <MsgType>A</MsgType>
      <Category>admin</Category>
      <Origin>Client,Exchange</Origin>
      <Fields>
        <Field>
          <Tag>98</Tag>
          <Name>EncryptMethod</Name>
          <Required>Y</Required>
          <Type>int</Type>
          <Description>Method of encryption. Not supported. Values: 0 = None / other</Description>
        </Field>
        <Field>
          <Tag>108</Tag>
          <Name>HeartBtInt</Name>
          <Required>Y</Required>
          <Type>int</Type>
          <Description>Heartbeat interval (seconds). Recommended value is 30 seconds.</Description>
        </Field>
        <Field>
          <Tag>141</Tag>
          <Name>ResetSeqNumFlag</Name>
          <Required>N</Required>
          <Type>Boolean</Type>
          <Description>Indicates that both sides of the FIX session should reset sequence numbers. Values: Y = Yes, reset sequence numbers, N = No</Description>
        </Field>
      </Fields>
    </Message>

    <!-- 7.4.2 Heartbeat -->
    <Message>
      <Name>Heartbeat</Name>
      <MsgType>0</MsgType>
      <Category>admin</Category>
      <Origin>Client,Exchange</Origin>
      <Fields>
        <Field>
          <Tag>112</Tag>
          <Name>TestReqID</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Required when the heartbeat is the result of a Test Request message.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- 7.4.3 Test Request -->
    <Message>
      <Name>Test Request</Name>
      <MsgType>1</MsgType>
      <Category>admin</Category>
      <Origin>Client,Exchange</Origin>
      <Fields>
        <Field>
          <Tag>112</Tag>
          <Name>TestReqID</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>Identifier to be returned in resulting Heartbeat.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- 7.4.4 Resend Request -->
    <Message>
      <Name>Resend Request</Name>
      <MsgType>2</MsgType>
      <Category>admin</Category>
      <Origin>Client,Exchange</Origin>
      <Fields>
        <Field>
          <Tag>7</Tag>
          <Name>BeginSeqNo</Name>
          <Required>Y</Required>
          <Type>int</Type>
          <Description>Message sequence number of first message in range to be resent.</Description>
        </Field>
        <Field>
          <Tag>16</Tag>
          <Name>EndSeqNo</Name>
          <Required>Y</Required>
