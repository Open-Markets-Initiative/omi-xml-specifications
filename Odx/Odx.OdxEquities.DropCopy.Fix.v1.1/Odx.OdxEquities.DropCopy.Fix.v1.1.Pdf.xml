<OmiFixPdf>

  <!-- Osaka Digital Exchange (ODX) PTS FIX Drop Copy Specification for Equities v1.1 (2024-11-18). Version 1.1 changes only section 7.4.1 (Logon): Username (553) and Password (554) are marked "R". FIX 4.2 drop copy of order and trade activity on the ODX PTS equities market, delivered as Execution Reports (Order Accepted, Order Replaced, Order Canceled, Trade) marked by CopyMsgIndicator (797). -->

  <!-- Req'd column (section 4.1): Y = required by the standard, blank = not required (transcribed N), R = additional required field of this specification over the standard (transcribed Y, since the loader reads only Y as required). -->

  <!-- Field length limitations (section 4.2) are not transcribed as Size or Decimals: Account 10 characters; AvgPx 8 whole number digits and 4 decimal places; ClOrdID 32 characters; CumQty 9 whole number digits; ExecID 20 characters; LastPx 8 whole number digits and 1 decimal place; LastShares 9 whole number digits; OrderID 20 characters; OrderQty 9 whole number digits; OrigClOrdID 32 characters; Price 8 whole number digits and 1 decimal place; SenderSubID 4 characters for outgoing messages; Symbol 9 characters; ClientID 20 characters; MinQty 9 whole number digits; LeavesQty 9 whole number digits; TrdMatchID 20 characters. -->

  <!-- 7.1 Standard Header - Incoming Messages (no SenderSubID (50)) -->
  <Header Name="Client">
    <Fields>
      <Field>
        <Tag>8</Tag>
        <Name>BeginString</Name>
        <Required>Y</Required>
        <Type>String</Type>
        <Fixed>Y</Fixed>
        <Description>Identifies beginning of new message and protocol version. Always first field in message. Value is FIX.4.2.</Description>
      </Field>
      <Field>
        <Tag>9</Tag>
        <Name>BodyLength</Name>
        <Required>Y</Required>
        <Type>int</Type>
        <Fixed>Y</Fixed>
        <Description>Message length, in bytes, forward to the CheckSum (10) field. Always second field in message.</Description>
      </Field>
      <Field>
        <Tag>35</Tag>
        <Name>MsgType</Name>
        <Required>Y</Required>
        <Type>String</Type>
        <Fixed>Y</Fixed>
        <Description>Defines message type. Always third field in message.</Description>
      </Field>
      <Field>
        <Tag>34</Tag>
        <Name>MsgSeqNum</Name>
        <Required>Y</Required>
        <Type>int</Type>
        <Description>Integer message sequence number.</Description>
      </Field>
      <Field>
        <Tag>43</Tag>
        <Name>PossDupFlag</Name>
        <Required>N</Required>
        <Type>Boolean</Type>
        <Description>Indicates possible re transmission of message with this sequence number. Values: Y = Possible duplicate, N = Original transmission</Description>
      </Field>
      <Field>
        <Tag>49</Tag>
        <Name>SenderCompID</Name>
        <Required>Y</Required>
        <Type>String</Type>
        <Description>Used to identify firm sending message. As assigned by ODX PTS.</Description>
      </Field>
      <Field>
        <Tag>52</Tag>
        <Name>SendingTime</Name>
        <Required>Y</Required>
        <Type>UTCTimestamp</Type>
        <Description>Time of message transmission (always expressed in UTC).</Description>
      </Field>
      <Field>
        <Tag>56</Tag>
        <Name>TargetCompID</Name>
        <Required>Y</Required>
        <Type>String</Type>
        <Description>Used to identify receiving firm. As assigned by ODX PTS.</Description>
      </Field>
      <Field>
        <Tag>122</Tag>
        <Name>OrigSendingTime</Name>
        <Required>N</Required>
        <Type>UTCTimestamp</Type>
        <Description>Original time of message transmission (always expressed in UTC).</Description>
      </Field>
    </Fields>
  </Header>

  <!-- 7.2 Standard Header - Outgoing Messages (no PossDupFlag (43); adds SenderSubID (50)) -->
  <Header Name="Exchange">
    <Fields>
      <Field>
        <Tag>8</Tag>
        <Name>BeginString</Name>
        <Required>Y</Required>
        <Type>String</Type>
        <Fixed>Y</Fixed>
        <Description>Identifies beginning of new message and protocol version. Always first field in message. Value is FIX.4.2.</Description>
      </Field>
      <Field>
        <Tag>9</Tag>
        <Name>BodyLength</Name>
        <Required>Y</Required>
        <Type>int</Type>
        <Fixed>Y</Fixed>
        <Description>Message length, in bytes, forward to the CheckSum (10) field. Always second field in message.</Description>
      </Field>
      <Field>
        <Tag>35</Tag>
        <Name>MsgType</Name>
        <Required>Y</Required>
        <Type>String</Type>
        <Fixed>Y</Fixed>
        <Description>Defines message type. Always third field in message.</Description>
      </Field>
      <Field>
        <Tag>34</Tag>
        <Name>MsgSeqNum</Name>
        <Required>Y</Required>
        <Type>int</Type>
        <Description>Integer message sequence number.</Description>
      </Field>
      <Field>
        <Tag>49</Tag>
        <Name>SenderCompID</Name>
        <Required>Y</Required>
        <Type>String</Type>
        <Description>Used to identify firm sending message. As assigned by ODX PTS.</Description>
      </Field>
      <Field>
        <Tag>50</Tag>
        <Name>SenderSubID</Name>
        <Required>N</Required>
        <Type>String</Type>
        <Description>Assigned value used to identify specific message originator. Values: DAY = Daytime</Description>
      </Field>
      <Field>
        <Tag>52</Tag>
        <Name>SendingTime</Name>
        <Required>Y</Required>
        <Type>UTCTimestamp</Type>
        <Description>Time of message transmission (always expressed in UTC).</Description>
      </Field>
      <Field>
        <Tag>56</Tag>
        <Name>TargetCompID</Name>
        <Required>Y</Required>
        <Type>String</Type>
        <Description>Used to identify receiving firm. As assigned by ODX PTS.</Description>
      </Field>
      <Field>
        <Tag>122</Tag>
        <Name>OrigSendingTime</Name>
        <Required>N</Required>
        <Type>UTCTimestamp</Type>
        <Description>Original time of message transmission (always expressed in UTC).</Description>
      </Field>
    </Fields>
  </Header>

  <!-- 7.3 Standard Trailer -->
  <Trailer>
    <Fields>
      <Field>
        <Tag>10</Tag>
        <Name>CheckSum</Name>
        <Required>Y</Required>
        <Type>String</Type>
        <Fixed>Y</Fixed>
        <Description>Three byte, simple checksum. Always defined as three characters. Always last field in message.</Description>
      </Field>
    </Fields>
  </Trailer>

  <Messages>

    <!-- 7.4.1 Logon -->
    <Message>
      <Name>Logon</Name>
      <MsgType>A</MsgType>
      <Category>admin</Category>
      <Origin>Client,Exchange</Origin>
      <Fields>
        <Field>
          <Tag>98</Tag>
          <Name>EncryptMethod</Name>
          <Required>Y</Required>
          <Type>int</Type>
          <Description>Method of encryption. Not supported. Values: 0 = None / other</Description>
        </Field>
        <Field>
          <Tag>108</Tag>
          <Name>HeartBtInt</Name>
          <Required>Y</Required>
          <Type>int</Type>
          <Description>Heartbeat interval (seconds). Recommended value is 30 seconds.</Description>
        </Field>
        <Field>
          <Tag>141</Tag>
          <Name>ResetSeqNumFlag</Name>
          <Required>N</Required>
          <Type>Boolean</Type>
          <Description>Indicates that both sides of the FIX session should reset sequence numbers. Values: Y = Yes, reset sequence numbers, N = No</Description>
        </Field>
        <Field>
          <Tag>553</Tag>
          <Name>Username</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>Userid. As assigned by ODX PTS.</Description>
        </Field>
        <Field>
          <Tag>554</Tag>
          <Name>Password</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>Password or passphrase. As assigned by ODX PTS.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- 7.4.2 Heartbeat -->
    <Message>
      <Name>Heartbeat</Name>
      <MsgType>0</MsgType>
      <Category>admin</Category>
      <Origin>Client,Exchange</Origin>
      <Fields>
        <Field>
          <Tag>112</Tag>
          <Name>TestReqID</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Required when the heartbeat is the result of a Test Request message.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- 7.4.3 Test Request -->
    <Message>
      <Name>Test Request</Name>
      <MsgType>1</MsgType>
      <Category>admin</Category>
      <Origin>Client,Exchange</Origin>
      <Fields>
        <Field>
          <Tag>112</Tag>
          <Name>TestReqID</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>Identifier to be returned in resulting Heartbeat.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- 7.4.4 Resend Request -->
    <Message>
      <Name>Resend Request</Name>
      <MsgType>2</MsgType>
      <Category>admin</Category>
      <Origin>Client,Exchange</Origin>
      <Fields>
        <Field>
          <Tag>7</Tag>
          <Name>BeginSeqNo</Name>
          <Required>Y</Required>
          <Type>int</Type>
          <Description>Message sequence number of first message in range to be resent.</Description>
        </Field>
        <Field>
          <Tag>16</Tag>
          <Name>EndSeqNo</Name>
          <Required>Y</Required>
          <Type>int</Type>
          <Description>Message sequence number of last message in range to be resent.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- 7.4.5 Reject -->
    <Message>
      <Name>Reject</Name>
      <MsgType>3</MsgType>
      <Category>admin</Category>
      <Origin>Client,Exchange</Origin>
      <Fields>
        <Field>
          <Tag>45</Tag>
          <Name>RefSeqNum</Name>
          <Required>Y</Required>
          <Type>int</Type>
          <Description>MsgSeqNum (34) of rejected message</Description>
        </Field>
        <Field>
          <Tag>58</Tag>
          <Name>Text</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Message explaining reject reason.</Description>
        </Field>
        <Field>
          <Tag>371</Tag>
          <Name>RefTagID</Name>
          <Required>N</Required>
          <Type>int</Type>
          <Description>The tag number of the FIX field being referenced.</Description>
        </Field>
        <Field>
          <Tag>372</Tag>
          <Name>RefMsgType</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>The MsgType (35) of the FIX message being referenced.</Description>
        </Field>
        <Field>
          <Tag>373</Tag>
          <Name>SessionRejectReason</Name>
          <Required>N</Required>
          <Type>int</Type>
          <Description>Code to identify reason for a session-level Reject message. Values: 0 = Invalid tag number, 1 = Required tag missing, 2 = Tag not defined for this message type, 3 = Undefined tag, 4 = Tag specified without a value, 5 = Value is incorrect (out of range) for this tag, 6 = Incorrect data format for value, 9 = CompID problem, 10 = SendingTime (52) accuracy problem, 11 = Invalid MsgType (35)</Description>
        </Field>
      </Fields>
    </Message>

    <!-- 7.4.6 Sequence Reset -->
    <Message>
      <Name>Sequence Reset</Name>
      <MsgType>4</MsgType>
      <Category>admin</Category>
      <Origin>Client,Exchange</Origin>
      <Fields>
        <Field>
          <Tag>36</Tag>
          <Name>NewSeqNo</Name>
          <Required>Y</Required>
          <Type>int</Type>
          <Description>New sequence number.</Description>
        </Field>
        <Field>
          <Tag>123</Tag>
          <Name>GapFillFlag</Name>
          <Required>N</Required>
          <Type>Boolean</Type>
          <Description>Indicates replacing administrative or application messages which will not be resent. Values: Y = Gap Fill message, MsgSeqNum (34) field valid, N = Sequence Reset, ignore MsgSeqNum (34)</Description>
        </Field>
      </Fields>
    </Message>

    <!-- 7.4.7 Logout -->
    <Message>
      <Name>Logout</Name>
      <MsgType>5</MsgType>
      <Category>admin</Category>
      <Origin>Client,Exchange</Origin>
      <Fields>
        <Field>
          <Tag>58</Tag>
          <Name>Text</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Message explaining logout reason.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Execution Report (Standard header - Outgoing). One FIX message (MsgType 8) documented in four sections, merged here:
         7.5.1 Order Accepted (ExecType (150) = 0), 7.5.2 Order Replaced (ExecType = 5), 7.5.3 Order Canceled (ExecType = 4),
         7.5.4 Trade (ExecType = 1 or 2).
         A field is Required Y here only when every section lists it as Y or R. Fields required in some sections only:
           LastPx (31), LastShares (32): R in Trade only, absent elsewhere.
           OrigClOrdID (41): R in Order Replaced, blank in Order Canceled, absent from Order Accepted and Trade.
           Price (44): R in Order Accepted, Order Canceled and Trade; blank in Order Replaced.
           ExecRestatementReason (378): Y in Order Replaced, blank in Order Canceled, absent from Order Accepted and Trade.
           LastLiquidityInd (851), TrdMatchID (880): R in Trade only, absent elsewhere.
         Account (1), ClOrdID (11), ClientID (109), MinQty (110) and MarginTransactionType (8214) are blank in every section.
         Section-specific comment text: AvgPx (6) and CumQty (14) add "Value is 0." in Order Accepted;
           Price (44) "Price per share accepted." in Trade, "Price per share." elsewhere;
           LeavesQty (151) adds "Value is the same as that of OrderQty (38)." in Order Accepted and "Value is 0." in Order Canceled;
           CopyMsgIndicator (797) reads "Value is Y = Yes" in Order Accepted and Order Replaced, "Value is Y = Yes." in Order Canceled and Trade.
         Section-specific values: OrdStatus (39) lists 0 in Order Accepted; 1, 2 and 5 in Order Replaced; 4 in Order Canceled; 1 and 2 in Trade.
           ExecType (150) lists 0 in Order Accepted, 5 in Order Replaced, 4 in Order Canceled, 1 and 2 in Trade.
           ExecRestatementReason (378) lists only 100 in Order Replaced; 2, 7, 12, 99, 100 and 102 in Order Canceled.
         ExecTransType (20) Data Type is "Char" in Trade, "char" in the other three sections.
         Order Canceled lists CopyMsgIndicator (797) before CashMargin (544); the other three sections list 544 before 797, which is the order kept here. -->
    <Message>
      <Name>Execution Report</Name>
      <MsgType>8</MsgType>
      <Category>app</Category>
      <Origin>Exchange</Origin>
      <Fields>
        <Field>
          <Tag>1</Tag>
          <Name>Account</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Account mnemonic as assigned by the institution.</Description>
        </Field>
        <Field>
          <Tag>6</Tag>
          <Name>AvgPx</Name>
          <Required>Y</Required>
          <Type>Price</Type>
          <Description>Calculated average price of all fills on this order.</Description>
        </Field>
        <Field>
          <Tag>11</Tag>
          <Name>ClOrdID</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Unique identifier for the order as assigned by the institution.</Description>
        </Field>
        <Field>
          <Tag>14</Tag>
          <Name>CumQty</Name>
          <Required>Y</Required>
          <Type>Qty</Type>
          <Description>Total number of shares filled.</Description>
        </Field>
        <Field>
          <Tag>17</Tag>
          <Name>ExecID</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>Unique identifier of execution message as assigned by ODX PTS.</Description>
        </Field>
        <Field>
          <Tag>20</Tag>
          <Name>ExecTransType</Name>
          <Required>Y</Required>
          <Type>char</Type>
          <Description>Identifies transaction type. Values: 0 = New</Description>
        </Field>
        <Field>
          <Tag>31</Tag>
          <Name>LastPx</Name>
          <Required>N</Required>
          <Type>Price</Type>
          <Description>Price of this (last) fill.</Description>
        </Field>
        <Field>
          <Tag>32</Tag>
          <Name>LastShares</Name>
          <Required>N</Required>
          <Type>Qty</Type>
          <Description>Quantity bought/sold on this (last) fill.</Description>
        </Field>
        <Field>
          <Tag>37</Tag>
          <Name>OrderID</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>Unique identifier for order as assigned by ODX PTS.</Description>
        </Field>
        <Field>
          <Tag>38</Tag>
          <Name>OrderQty</Name>
          <Required>Y</Required>
          <Type>Qty</Type>
          <Description>Quantity accepted.</Description>
        </Field>
        <Field>
          <Tag>39</Tag>
          <Name>OrdStatus</Name>
          <Required>Y</Required>
          <Type>char</Type>
          <Description>Identifies current status of this order. Values: 0 = New, 1 = Partially filled, 2 = Filled, 4 = Canceled, 5 = Replaced</Description>
        </Field>
        <Field>
          <Tag>40</Tag>
          <Name>OrdType</Name>
          <Required>Y</Required>
          <Type>char</Type>
          <Description>Order type. Values: 2 = Limit</Description>
        </Field>
        <Field>
          <Tag>41</Tag>
          <Name>OrigClOrdID</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>ClOrdID (11) of the previous order (not the initial order) as assigned by the institution.</Description>
        </Field>
        <Field>
          <Tag>44</Tag>
          <Name>Price</Name>
          <Required>N</Required>
          <Type>Price</Type>
          <Description>Price per share.</Description>
        </Field>
        <Field>
          <Tag>47</Tag>
          <Name>Rule80A</Name>
          <Required>Y</Required>
          <Type>char</Type>
          <Description>Designates the capacity of the firm placing the order. Values: A = Agency, P = Principal</Description>
        </Field>
        <Field>
          <Tag>54</Tag>
          <Name>Side</Name>
          <Required>Y</Required>
          <Type>char</Type>
          <Description>Side of order. Values: 1 = Buy, 2 = Sell, 5 = Sell short, 6 = Sell short exempt</Description>
        </Field>
        <Field>
          <Tag>55</Tag>
          <Name>Symbol</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>Ticker symbol. Value is the 4 digit Quick code.</Description>
        </Field>
        <Field>
          <Tag>59</Tag>
          <Name>TimeInForce</Name>
          <Required>Y</Required>
          <Type>char</Type>
          <Description>Specifies how long the order remains in effect. Values: 0 = Day, 3 = Immediate or Cancel (IOC)</Description>
        </Field>
        <Field>
          <Tag>60</Tag>
          <Name>TransactTime</Name>
          <Required>Y</Required>
          <Type>UTCTimestamp</Type>
          <Description>Time the transaction represented by this message occurred.</Description>
        </Field>
        <Field>
          <Tag>109</Tag>
          <Name>ClientID</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Order entry port and/or trade group identifiers as assigned by ODX PTS.</Description>
        </Field>
        <Field>
          <Tag>110</Tag>
          <Name>MinQty</Name>
          <Required>N</Required>
          <Type>Qty</Type>
          <Description>Minimum quantity of an order to be executed.</Description>
        </Field>
        <Field>
          <Tag>150</Tag>
          <Name>ExecType</Name>
          <Required>Y</Required>
          <Type>char</Type>
          <Description>Describes the specific Execution Report. Values: 0 = New, 1 = Partial fill, 2 = Fill, 4 = Canceled, 5 = Replaced</Description>
        </Field>
        <Field>
          <Tag>151</Tag>
          <Name>LeavesQty</Name>
          <Required>Y</Required>
          <Type>Qty</Type>
          <Description>Amount of shares open for further execution.</Description>
        </Field>
        <Field>
          <Tag>378</Tag>
          <Name>ExecRestatementReason</Name>
          <Required>N</Required>
          <Type>int</Type>
          <Description>Code to identify reason for unsolicited cancel. Values: 2 = Verbal change, 7 = Cancel on System Failure, 12 = Cancel on connection loss, 99 = Other, 100 = Trade prevention, 102 = Cancel on margin restriction</Description>
        </Field>
        <Field>
          <Tag>544</Tag>
          <Name>CashMargin</Name>
          <Required>Y</Required>
          <Type>char</Type>
          <Description>Identifies whether an order is a margin order or a non-margin order. Values: 1 = Cash, 2 = Margin Open, 3 = Margin Close</Description>
        </Field>
        <Field>
          <Tag>797</Tag>
          <Name>CopyMsgIndicator</Name>
          <Required>Y</Required>
          <Type>Boolean</Type>
          <Description>Indicates whether or not this message is a drop copy of another message. Value is Y = Yes</Description>
        </Field>
        <Field>
          <Tag>851</Tag>
          <Name>LastLiquidityInd</Name>
          <Required>N</Required>
          <Type>int</Type>
          <Description>Indicator to identify whether this fill was a result of a liquidity provider providing or liquidity taker taking the liquidity. Values: 1 = Added liquidity, 2 = Removed liquidity</Description>
        </Field>
        <Field>
          <Tag>880</Tag>
          <Name>TrdMatchID</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Identifier assigned to a trade by a matching system.</Description>
        </Field>
        <Field>
          <Tag>8060</Tag>
          <Name>OrderClassification</Name>
          <Required>Y</Required>
          <Type>char</Type>
          <Description>High Frequency Trading (HFT) order classification. Values: 1 = Non HFT, 3 = HFT market making strategy, 4 = HFT arbitrage strategy, 5 = HFT directional strategy, 6 = HFT other strategy</Description>
        </Field>
        <Field>
          <Tag>8214</Tag>
          <Name>MarginTransactionType</Name>
          <Required>N</Required>
          <Type>char</Type>
          <Description>Margin transaction type of the margin order. Values: 1 = Negotiable, 2 = Standardized</Description>
        </Field>
      </Fields>
    </Message>

    <!-- 7.5.5 Business Message Reject (Standard header - Outgoing) -->
    <Message>
      <Name>Business Message Reject</Name>
      <MsgType>j</MsgType>
      <Category>app</Category>
      <Origin>Exchange</Origin>
      <Fields>
        <Field>
          <Tag>45</Tag>
          <Name>RefSeqNum</Name>
          <Required>N</Required>
          <Type>int</Type>
          <Description>MsgSeqNum (34) of rejected message</Description>
        </Field>
        <Field>
          <Tag>58</Tag>
          <Name>Text</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Message explaining reject reason.</Description>
        </Field>
        <Field>
          <Tag>372</Tag>
          <Name>RefMsgType</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>The MsgType (35) of the FIX message being referenced.</Description>
        </Field>
        <Field>
          <Tag>380</Tag>
          <Name>BusinessRejectReason</Name>
          <Required>Y</Required>
          <Type>int</Type>
          <Description>Code to identify reason for a Business Message Reject message. Values: 0 = Other, 3 = Unsupported Message Type</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Values>
    <!-- BeginString (8) static. Source: "Identifies beginning of new message and protocol version. Always first field in message. Value is FIX.4.2." -->
    <Value>
      <Type>BeginString</Type>
      <Enum>FIX.4.2</Enum>
      <Kind>Static</Kind>
      <Description>FIX 4.2</Description>
    </Value>

    <!-- PossDupFlag (43), incoming header only -->
    <Value>
      <Type>PossDupFlag</Type>
      <Enum>Y</Enum>
      <Description>Possible duplicate</Description>
    </Value>
    <Value>
      <Type>PossDupFlag</Type>
      <Enum>N</Enum>
      <Description>Original transmission</Description>
    </Value>

    <!-- SenderSubID (50), outgoing header only -->
    <Value>
      <Type>SenderSubID</Type>
      <Enum>DAY</Enum>
      <Description>Daytime</Description>
    </Value>

    <!-- EncryptMethod (98) -->
    <Value>
      <Type>EncryptMethod</Type>
      <Enum>0</Enum>
      <Description>None / other</Description>
    </Value>

    <!-- ResetSeqNumFlag (141) -->
    <Value>
      <Type>ResetSeqNumFlag</Type>
      <Enum>Y</Enum>
      <Description>Yes, reset sequence numbers</Description>
    </Value>
    <Value>
      <Type>ResetSeqNumFlag</Type>
      <Enum>N</Enum>
      <Description>No</Description>
    </Value>

    <!-- SessionRejectReason (373) -->
    <Value>
      <Type>SessionRejectReason</Type>
      <Enum>0</Enum>
      <Description>Invalid tag number</Description>
    </Value>
    <Value>
      <Type>SessionRejectReason</Type>
      <Enum>1</Enum>
      <Description>Required tag missing</Description>
    </Value>
    <Value>
      <Type>SessionRejectReason</Type>
      <Enum>2</Enum>
      <Description>Tag not defined for this message type</Description>
    </Value>
    <Value>
      <Type>SessionRejectReason</Type>
      <Enum>3</Enum>
      <Description>Undefined tag</Description>
    </Value>
    <Value>
      <Type>SessionRejectReason</Type>
      <Enum>4</Enum>
      <Description>Tag specified without a value</Description>
    </Value>
