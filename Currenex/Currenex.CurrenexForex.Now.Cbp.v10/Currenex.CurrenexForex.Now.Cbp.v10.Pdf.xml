          <Size>4</Size>
          <Type>Scale5_Rate</Type>
          <Description>bid price</Description>
        </Field>
        <Field>
          <Name>OfferPrice</Name>
          <Size>4</Size>
          <Type>Scale5_Rate</Type>
          <Description>offer price</Description>
        </Field>
      </Fields>
    </Struct>

    <!-- 25_ConfFactor -->
    <Struct>
      <Name>ConfFactor25</Name>
      <Description>25th percentile confidence factor</Description>
      <Fields>
        <Field>
          <Name>BidPrice</Name>
          <Size>4</Size>
          <Type>Scale5_Rate</Type>
          <Description>bid price</Description>
        </Field>
        <Field>
          <Name>OfferPrice</Name>
          <Size>4</Size>
          <Type>Scale5_Rate</Type>
          <Description>offer price</Description>
        </Field>
