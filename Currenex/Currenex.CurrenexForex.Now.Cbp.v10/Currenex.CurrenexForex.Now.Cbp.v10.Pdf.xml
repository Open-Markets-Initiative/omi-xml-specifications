          <Name>Bid</Name>
          <Size>0</Size>
          <Type>struct</Type>
          <Description>level bid</Description>
        </Field>
        <Field>
          <Name>Offer</Name>
          <Size>0</Size>
          <Type>struct</Type>
          <Description>level offer</Description>
        </Field>
      </Fields>
    </Struct>

    <!-- Level Bid -->
    <Struct>
