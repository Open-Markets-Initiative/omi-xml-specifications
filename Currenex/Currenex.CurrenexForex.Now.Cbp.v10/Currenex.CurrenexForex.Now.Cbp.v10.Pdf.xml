          <Description>bid price</Description>
        </Field>
        <Field>
          <Name>OfferPrice</Name>
          <Size>4</Size>
          <Type>Scale5_Rate</Type>
          <Description>offer price</Description>
        </Field>
      </Fields>
    </Struct>

    <!-- 50_ConfFactor -->
    <Struct>
      <Name>ConfFactor50</Name>
      <Description>50th percentile confidence factor</Description>
      <Fields>
