<OmiCbpPdf>

  <Messages>

    <!-- Logon: page 14 -->
    <Message>
      <Name>Logon Message</Name>
      <Description>Client initiates a session by submitting a Logon message to Currenex_NOW</Description>
      <Branch>MessageBody</Branch>
      <Dependency>MessageType</Dependency>
      <Category>Session</Category>
      <Code>A</Code>
      <Fields>
        <Field>
          <Name>UserID</Name>
          <Size>20</Size>
          <Type>Alpha</Type>
          <Description>User session login id</Description>
        </Field>
        <Field>
          <Name>Password</Name>
          <Size>20</Size>
          <Type>Alpha</Type>
          <Description>User password</Description>
        </Field>
        <Field>
          <Name>SessionID</Name>
          <Size>4</Size>
          <Type>Integer</Type>
          <Description>Unique session ID</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Logout: page 14 -->
    <Message>
      <Name>Logout Message</Name>
      <Description>Terminate a session by sending or receiving a Logout message</Description>
      <Branch>MessageBody</Branch>
      <Dependency>MessageType</Dependency>
      <Category>Session</Category>
      <Code>B</Code>
      <Fields>
        <Field>
          <Name>UserID</Name>
          <Size>20</Size>
          <Type>Alpha</Type>
          <Description>User session login id</Description>
        </Field>
        <Field>
          <Name>SessionID</Name>
          <Size>4</Size>
          <Type>Integer</Type>
          <Description>Unique session ID</Description>
        </Field>
        <Field>
          <Name>Reason</Name>
          <Size>3</Size>
          <Type>Alpha</Type>
          <Description>Logout reason code</Description>
        </Field>
      </Fields>
    </Message>

    <!-- HeartBeat: page 14 -->
    <Message>
      <Name>HeartBeat Message</Name>
      <Description>Keep-alive ping sent every 15 seconds; client must respond</Description>
      <Branch>MessageBody</Branch>
      <Dependency>MessageType</Dependency>
      <Category>Session</Category>
      <Code>C</Code>
      <Fields>
        <Field>
          <Name>SessionID</Name>
          <Size>4</Size>
          <Type>Integer</Type>
          <Description>Unique session ID provided by Currenex</Description>
        </Field>
      </Fields>
    </Message>

    <!-- InstrumentInfo: page 15 -->
    <Message>
      <Name>InstrumentInfo</Name>
      <Description>Definition of a currency or metal instrument</Description>
      <Branch>MessageBody</Branch>
      <Dependency>MessageType</Dependency>
      <Category>Application</Category>
      <Code>D</Code>
      <Fields>
        <Field>
          <Name>SessionID</Name>
          <Size>4</Size>
          <Type>Integer</Type>
          <Description>Session identifier</Description>
        </Field>
        <Field>
          <Name>InstrumentIndex</Name>
          <Size>2</Size>
          <Type>Short</Type>
          <Description>Instrument numeric index</Description>
        </Field>
        <Field>
          <Name>InstrumentType</Name>
          <Size>1</Size>
          <Type>Alpha</Type>
          <Description>1=Foreign Exchange,2=Cash Metals</Description>
        </Field>
        <Field>
          <Name>InstrumentID</Name>
          <Size>20</Size>
          <Type>Alpha</Type>
          <Description>Currency pair or metal code</Description>
        </Field>
        <Field>
          <Name>SettlementDate</Name>
          <Size>8</Size>
          <Type>Long</Type>
          <Description>Epoch ms for settlement date</Description>
        </Field>
      </Fields>
    </Message>

    <!-- InstrumentInfoAck: page 15 -->
    <Message>
      <Name>InstrumentInfoAck Message</Name>
      <Description>Acknowledge receipt of InstrumentInfo</Description>
      <Branch>MessageBody</Branch>
      <Dependency>MessageType</Dependency>
      <Category>Application</Category>
      <Code>E</Code>
      <Fields>
        <Field>
          <Name>SessionID</Name>
          <Size>4</Size>
          <Type>Integer</Type>
          <Description>Session identifier</Description>
        </Field>
        <Field>
          <Name>InstrumentIndex</Name>
          <Size>2</Size>
          <Type>Short</Type>
          <Description>Instrument numeric index</Description>
        </Field>
      </Fields>
    </Message>

    <!-- SubscriptionRequest: page 16 -->
    <Message>
      <Name>SubscriptionRequest Message</Name>
      <Description>Request market data for a specific instrument</Description>
      <Branch>MessageBody</Branch>
      <Dependency>MessageType</Dependency>
      <Category>Application</Category>
      <Code>X</Code>
      <Fields>
        <Field>
          <Name>SessionID</Name>
          <Size>4</Size>
          <Type>Integer</Type>
          <Description>Session identifier</Description>
        </Field>
        <Field>
          <Name>SubscriptionType</Name>
          <Size>1</Size>
          <Type>Alpha</Type>
          <Description>SubscriptionType</Description>
        </Field>
        <Field>
          <Name>InstrumentIndex</Name>
          <Size>2</Size>
          <Type>Short</Type>
          <Description>Instrument numeric index</Description>
        </Field>
        <Field>
          <Name>SubscribeToNOW_DepthOfBook</Name>
          <Size>1</Size>
          <Type>Alpha</Type>
          <Description>Subscribe to price updates with full depth of the book</Description>
        </Field>
        <Field>
          <Name>SubscribeToNOW_Paid/Given with Bucketed Size</Name>
          <Type>Alpha</Type>
          <Description>Subscribe to now paid/given with bucketed size</Description>
        </Field>
        <Field>
          <Name>SubscribeToNOW_WAMR with Confidence Factor</Name>
          <Size>1</Size>
          <Type>Alpha</Type>
          <Description>Subscribe to WAMR updates with confidence factor</Description>
        </Field>
        <Field>
          <Name>SubscribeToNOW_Mid Activity Indicator</Name>
          <Size>1</Size>
          <Type>Alpha</Type>
          <Description>Subscribe to Mid Activity Indicator updates</Description>
        </Field>
      </Fields>
    </Message>

    <!-- MassSubscriptionRequest: page 17 -->
    <Message>
      <Name>MassSubscriptionRequest Message</Name>
      <Description>Subscribe or unsubscribe all instruments at once</Description>
      <Branch>MessageBody</Branch>
      <Dependency>MessageType</Dependency>
      <Category>Application</Category>
      <Code>Y</Code>
      <Fields>
        <Field>
          <Name>SessionID</Name>
          <Size>4</Size>
          <Type>Integer</Type>
          <Description>Session identifier</Description>
        </Field>
        <Field>
          <Name>SubscriptionType</Name>
          <Size>1</Size>
          <Type>Alpha</Type>
          <Description>0=SubscribeAll,1=UnsubscribeAll</Description>
        </Field>
        <Field>
          <Name>SubscribeToNOW_DepthOfBook</Name>
          <Size>1</Size>
          <Type>Alpha</Type>
          <Description>Subscribe to price updates with full depth of the book</Description>
        </Field>
        <Field>
          <Name>SubscribeToNOW_Paid/Given with Bucketed Size</Name>
          <Type>Alpha</Type>
          <Description>Subscribe to now paid/given with bucketed size</Description>
        </Field>
        <Field>
          <Name>SubscribeToNOW_WAMR with Confidence Factor</Name>
          <Size>1</Size>
          <Type>Alpha</Type>
          <Description>Subscribe to WAMR updates with confidence factor</Description>
        </Field>
        <Field>
          <Name>SubscribeToNOW_Mid Activity Indicator</Name>
          <Size>1</Size>
          <Type>Alpha</Type>
          <Description>Subscribe to Mid Activity Indicator updates</Description>
        </Field>
      </Fields>
    </Message>

    <!-- SubscriptionReply: page 18 -->
    <Message>
      <Name>SubscriptionReply Message</Name>
      <Description>Response to SubscriptionRequest</Description>
      <Branch>MessageBody</Branch>
      <Dependency>MessageType</Dependency>
      <Category>Application</Category>
      <Code>G</Code>
      <Fields>
        <Field>
          <Name>SessionID</Name>
          <Size>4</Size>
          <Type>Integer</Type>
          <Description>Session identifier</Description>
        </Field>
        <Field>
          <Name>InstrumentIndex</Name>
          <Size>2</Size>
          <Type>Short</Type>
          <Description>Instrument numeric index</Description>
        </Field>
        <Field>
          <Name>Type</Name>
          <Size>1</Size>
          <Type>Alpha</Type>
          <Description>1=Accepted,2=Rejected</Description>
        </Field>
        <Field>
          <Name>Reason</Name>
          <Size>50</Size>
          <Type>Alpha</Type>
          <Description>Rejection reason text</Description>
        </Field>
      </Fields>
    </Message>

    <!-- MassSubscriptionReply: page 18 -->
    <Message>
      <Name>MassSubscriptionReply Message</Name>
      <Description>Response to MassSubscriptionRequest</Description>
      <Branch>MessageBody</Branch>
      <Dependency>MessageType</Dependency>
      <Category>Application</Category>
      <Code>Z</Code>
      <Fields>
        <Field>
          <Name>SessionID</Name>
          <Size>4</Size>
          <Type>Integer</Type>
          <Description>Session identifier</Description>
        </Field>
        <Field>
          <Name>Type</Name>
          <Size>1</Size>
          <Type>Alpha</Type>
          <Description>1=Accepted,2=Rejected</Description>
        </Field>
        <Field>
          <Name>Reason</Name>
          <Size>50</Size>
          <Type>Alpha</Type>
          <Description>Rejection reason text</Description>
        </Field>
      </Fields>
    </Message>

    <!-- NOW_DepthOfBook: page 18 -->
    <Message>
      <Name>DepthOfBook Message</Name>
      <Description>Depth of book updates up to 20 levels</Description>
      <Branch>MessageBody</Branch>
      <Dependency>MessageType</Dependency>
      <Category>MarketData</Category>
      <Code>d</Code>
      <Fields>
        <Field>
          <Name>InstrumentIndex</Name>
          <Size>2</Size>
          <Type>Short</Type>
          <Description>Instrument numeric index</Description>
        </Field>
        <Field>
          <Name>Level</Name>
          <Size>0</Size>
          <Type>struct</Type>
          <Description>Market level</Description>
        </Field>
      </Fields>
    </Message>

    <!-- NOW_Paid_Given: page 25 -->
    <Message>
      <Name>Paid Given Message</Name>
      <Description>Latest trade versus liquidity</Description>
      <Branch>MessageBody</Branch>
      <Dependency>MessageType</Dependency>
      <Category>MarketData</Category>
      <Code>k</Code>
      <Fields>
        <Field>
          <Name>InstrumentIndex</Name>
          <Size>2</Size>
          <Type>Short</Type>
          <Description>Instrument numeric index</Description>
        </Field>
        <Field>
          <Name>Rate</Name>
          <Size>4</Size>
          <Type>Scale5_Rate</Type>
          <Description>Trade rate</Description>
        </Field>
        <Field>
          <Name>SizeIndicator</Name>
          <Size>1</Size>
          <Type>Alpha</Type>
          <Description>2M</Description>
        </Field>
        <Field>
          <Name>PaidGivenIndicator</Name>
          <Size>1</Size>
          <Type>Alpha</Type>
          <Description>Paid or given</Description>
        </Field>
        <Field>
          <Name>TransactTime</Name>
          <Size>8</Size>
          <Type>Long</Type>
          <Description>Epoch ms of trade</Description>
        </Field>
      </Fields>
    </Message>

    <!-- NOW_WAMR with Confidence Factor: page 25 -->
    <Message>
      <Name>WAMR with Confidence Factor Message</Name>
      <Description>Weighted average mid-rate with confidence factors</Description>
      <Branch>MessageBody</Branch>
      <Dependency>MessageType</Dependency>
      <Category>MarketData</Category>
      <Code>r</Code>
      <Fields>
        <Field>
          <Name>InstrumentIndex</Name>
          <Size>2</Size>
          <Type>Short</Type>
          <Description>Instrument numeric index</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Size>4</Size>
          <Type>Scale6_Rate</Type>
          <Description>WAMR scaled six decimals</Description>
        </Field>
        <Field>
          <Name>ConfFactor75</Name>
          <Size>0</Size>
          <Type>struct</Type>
          <Description>75th percentile</Description>
        </Field>
        <Field>
          <Name>ConfFactor50</Name>
          <Size>0</Size>
          <Type>struct</Type>
          <Description>50th percentile</Description>
        </Field>
        <Field>
          <Name>ConfFactor25</Name>
          <Size>0</Size>
          <Type>struct</Type>
          <Description>w5th percentile</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Size>8</Size>
          <Type>Long</Type>
          <Description>Epoch microseconds of WAMR calc</Description>
        </Field>
      </Fields>
    </Message>

    <!-- NOW_MidActivityIndicator: page 26 -->
    <Message>
      <Name>MidActivityIndicator Message</Name>
      <Description>Indicator of mid-rate activity windows</Description>
      <Branch>MessageBody</Branch>
      <Dependency>MessageType</Dependency>
      <Category>MarketData</Category>
      <Code>x</Code>
      <Fields>
        <Field>
          <Name>InstrumentIndex</Name>
          <Size>2</Size>
          <Type>Short</Type>
          <Description>Instrument numeric index</Description>
        </Field>
        <Field>
          <Name>ActivityIndicator</Name>
          <Size>1</Size>
          <Type>Alpha</Type>
          <Description>45s</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Reject: page 27 -->
    <Message>
      <Name>Reject Message</Name>
      <Description>Reject incorrectly formatted or invalid messages</Description>
      <Branch>MessageBody</Branch>
      <Dependency>MessageType</Dependency>
      <Category>Application</Category>
      <Code>K</Code>
      <Fields>
        <Field>
          <Name>SessionID</Name>
          <Size>4</Size>
          <Type>Integer</Type>
          <Description>Session identifier</Description>
        </Field>
        <Field>
          <Name>RejectMsgType</Name>
          <Size>1</Size>
          <Type>Alpha</Type>
          <Description>Message type rejected</Description>
        </Field>
        <Field>
          <Name>Reason</Name>
          <Size>50</Size>
          <Type>Alpha</Type>
          <Description>Rationale text</Description>
        </Field>
      </Fields>
    </Message>
  </Messages>

  <Structs>

    <!-- Level -->
    <Struct>
