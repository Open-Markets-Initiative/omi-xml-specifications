          <Description>bid or offer rate</Description>
        </Field>
        <Field>
          <Name>Amount</Name>
          <Size>8</Size>
          <Type>Amount</Type>
          <Description>Aggregated amount at this level</Description>
        </Field>
      </Fields>
    </Struct>

