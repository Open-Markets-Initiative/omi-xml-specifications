          <Description>Customer order capacity (CTI code).</Description>
        </Field>
        <Field>
          <Tag>1028</Tag>
          <Name>ManualOrderIndicator</Name>
          <Required>Y</Required>
          <Type>Boolean</Type>
          <Description>Whether the order was originated manually.</Description>
        </Field>
        <Field>
          <Tag>19</Tag>
          <Name>ExecRefID</Name>
          <Required>N</Required>
          <Type>String</Type>
