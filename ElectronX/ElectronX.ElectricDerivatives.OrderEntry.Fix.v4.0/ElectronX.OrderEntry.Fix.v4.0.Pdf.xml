<OmiFixPdf>
  <Messages>
    <!-- Logon (A) -->
    <Message>
      <Name>Logon</Name>
      <MsgType>A</MsgType>
      <Category>admin</Category>
      <Description>Initiates a FIX session with the ElectronX order entry gateway. SenderSubID (50) must not be present in the header.</Description>
      <Fields>
        <Field>
          <Tag>98</Tag>
          <Name>EncryptMethod</Name>
          <Required>Y</Required>
          <Type>Int</Type>
          <Description>Encryption method. Always 0 (None).</Description>
        </Field>
        <Field>
          <Tag>108</Tag>
          <Name>HeartBtInt</Name>
          <Required>Y</Required>
          <Type>Int</Type>
          <Description>Heartbeat interval in seconds. 30 seconds recommended.</Description>
        </Field>
        <Field>
          <Tag>141</Tag>
          <Name>ResetSeqNumFlag</Name>
          <Required>Y</Required>
          <Type>Boolean</Type>
          <Description>Indicates both sides should reset sequence numbers to 1.</Description>
        </Field>
        <Field>
          <Tag>554</Tag>
          <Name>Password</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Session password when configured.</Description>
        </Field>
        <Field>
          <Tag>1137</Tag>
          <Name>DefaultApplVerID</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>Default application version. Only valid value is 9 (FIX50SP2).</Description>
        </Field>
      </Fields>
    </Message>
    <!-- Logout (5) -->
    <Message>
      <Name>Logout</Name>
      <MsgType>5</MsgType>
      <Category>admin</Category>
      <Description>Initiates or confirms the termination of a FIX session.</Description>
      <Fields>
        <Field>
          <Tag>58</Tag>
          <Name>Text</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Free format text string.</Description>
        </Field>
      </Fields>
    </Message>
    <!-- Heartbeat (0) -->
    <Message>
      <Name>Heartbeat</Name>
      <MsgType>0</MsgType>
      <Category>admin</Category>
      <Description>Keep-alive message to maintain FIX session connectivity.</Description>
      <Fields>
        <Field>
          <Tag>112</Tag>
          <Name>TestReqID</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Required when heartbeat is the result of a TestRequest.</Description>
        </Field>
      </Fields>
    </Message>
    <!-- TestRequest (1) -->
    <Message>
      <Name>TestRequest</Name>
      <MsgType>1</MsgType>
      <Category>admin</Category>
      <Description>Forces a Heartbeat response from the opposing FIX engine.</Description>
      <Fields>
        <Field>
          <Tag>112</Tag>
          <Name>TestReqID</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>ID to be echoed in the resulting Heartbeat response.</Description>
        </Field>
      </Fields>
    </Message>
    <!-- ResendRequest (2) -->
    <Message>
      <Name>ResendRequest</Name>
      <MsgType>2</MsgType>
      <Category>admin</Category>
      <Description>Requests retransmission of messages in a sequence number range.</Description>
      <Fields>
        <Field>
          <Tag>7</Tag>
          <Name>BeginSeqNo</Name>
          <Required>Y</Required>
          <Type>SeqNum</Type>
          <Description>First MsgSeqNum in range to resend (inclusive).</Description>
        </Field>
        <Field>
          <Tag>16</Tag>
          <Name>EndSeqNo</Name>
          <Required>Y</Required>
          <Type>SeqNum</Type>
          <Description>Last MsgSeqNum in range to resend, or 0 for all subsequent.</Description>
        </Field>
      </Fields>
    </Message>
    <!-- SequenceReset (4) -->
    <Message>
      <Name>SequenceReset</Name>
      <MsgType>4</MsgType>
      <Category>admin</Category>
      <Description>Resets the receiving side's expected MsgSeqNum, or replaces messages that will not be resent.</Description>
      <Fields>
        <Field>
          <Tag>123</Tag>
          <Name>GapFillFlag</Name>
          <Required>N</Required>
          <Type>Boolean</Type>
          <Description>Y indicates gap fill replacing admin or app messages that will not be resent.</Description>
        </Field>
        <Field>
          <Tag>36</Tag>
          <Name>NewSeqNo</Name>
          <Required>Y</Required>
          <Type>SeqNum</Type>
          <Description>New expected message sequence number.</Description>
        </Field>
      </Fields>
    </Message>
    <!-- Reject (3) -->
    <Message>
      <Name>Reject</Name>
      <MsgType>3</MsgType>
      <Category>admin</Category>
      <Description>Session-level reject for messages that fail syntactic validation.</Description>
      <Fields>
        <Field>
          <Tag>45</Tag>
          <Name>RefSeqNum</Name>
          <Required>Y</Required>
          <Type>SeqNum</Type>
          <Description>MsgSeqNum of rejected message.</Description>
        </Field>
        <Field>
          <Tag>58</Tag>
          <Name>Text</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Optional description of the error.</Description>
        </Field>
        <Field>
          <Tag>371</Tag>
          <Name>RefTagID</Name>
          <Required>N</Required>
          <Type>Int</Type>
          <Description>Tag number being rejected.</Description>
        </Field>
        <Field>
          <Tag>372</Tag>
          <Name>RefMsgType</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>MsgType being rejected.</Description>
        </Field>
        <Field>
          <Tag>373</Tag>
          <Name>SessionRejectReason</Name>
          <Required>N</Required>
          <Type>Int</Type>
          <Description>Reason for the rejection.</Description>
        </Field>
      </Fields>
    </Message>
    <!-- BusinessMessageReject (j) -->
    <Message>
      <Name>BusinessMessageReject</Name>
      <MsgType>j</MsgType>
      <Category>admin</Category>
      <Description>Business-level rejection for unsupported message type, malformed messages, or rate violations.</Description>
      <Fields>
        <Field>
          <Tag>45</Tag>
          <Name>RefSeqNum</Name>
          <Required>N</Required>
          <Type>SeqNum</Type>
          <Description>MsgSeqNum of rejected message.</Description>
        </Field>
        <Field>
          <Tag>58</Tag>
          <Name>Text</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Text describing the error.</Description>
        </Field>
        <Field>
          <Tag>372</Tag>
          <Name>RefMsgType</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>MsgType being rejected.</Description>
        </Field>
        <Field>
          <Tag>379</Tag>
          <Name>BusinessRejectRefID</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>ClOrdID of the rejected message.</Description>
        </Field>
        <Field>
          <Tag>380</Tag>
          <Name>BusinessRejectReason</Name>
          <Required>Y</Required>
          <Type>Int</Type>
          <Description>Reason for rejection.</Description>
        </Field>
      </Fields>
    </Message>
    <!-- NewOrderSingle (D) -->
    <Message>
      <Name>NewOrderSingle</Name>
      <MsgType>D</MsgType>
      <Category>app</Category>
      <Description>Submits a new order for matching on the ElectronX central limit order book.</Description>
      <Fields>
        <Field>
          <Tag>1</Tag>
          <Name>Account</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>Account reference as registered with the exchange.</Description>
        </Field>
        <Field>
          <Tag>11</Tag>
          <Name>ClOrdID</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>Participant-created unique identifier for this order, unique across the session.</Description>
        </Field>
        <Field>
          <Tag>18</Tag>
          <Name>ExecInst</Name>
          <Required>N</Required>
          <Type>MultipleCharValue</Type>
          <Description>Execution instructions.</Description>
        </Field>
        <Field>
          <Tag>38</Tag>
          <Name>OrderQty</Name>
          <Required>Y</Required>
          <Type>Qty</Type>
          <Description>Order quantity. Must be a positive integer.</Description>
        </Field>
        <Field>
          <Tag>40</Tag>
          <Name>OrdType</Name>
          <Required>Y</Required>
          <Type>Char</Type>
          <Description>Order type. Always LIMIT (2).</Description>
        </Field>
        <Field>
          <Tag>44</Tag>
          <Name>Price</Name>
          <Required>N</Required>
          <Type>Price</Type>
          <Description>Limit price per unit.</Description>
        </Field>
        <Field>
          <Tag>54</Tag>
          <Name>Side</Name>
          <Required>Y</Required>
          <Type>Char</Type>
          <Description>Order side (Buy or Sell).</Description>
        </Field>
        <Field>
          <Tag>55</Tag>
          <Name>Symbol</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>Instrument symbol.</Description>
        </Field>
        <Field>
          <Tag>59</Tag>
          <Name>TimeInForce</Name>
          <Required>Y</Required>
          <Type>Char</Type>
          <Description>Time-in-force condition.</Description>
        </Field>
        <Field>
          <Tag>110</Tag>
          <Name>MinQty</Name>
          <Required>N</Required>
          <Type>Qty</Type>
          <Description>Minimum execution quantity on entry or order expires.</Description>
        </Field>
        <Field>
          <Tag>126</Tag>
          <Name>ExpireTime</Name>
          <Required>N</Required>
          <Type>UTCTimestamp</Type>
          <Description>Expiry date/time for Good Till Date orders.</Description>
        </Field>
        <Field>
          <Tag>582</Tag>
          <Name>CustOrderCapacity</Name>
          <Required>Y</Required>
          <Type>Int</Type>
          <Description>Customer order capacity (CTI code).</Description>
        </Field>
        <Field>
          <Tag>583</Tag>
          <Name>ClOrdLinkID</Name>
          <Required>N</Required>
          <Type>String</Type>
          <Description>Permits originators to link related orders together.</Description>
        </Field>
        <Field>
          <Tag>1028</Tag>
          <Name>ManualOrderIndicator</Name>
          <Required>Y</Required>
          <Type>Boolean</Type>
          <Description>Y if the order was originated manually, N if algorithmically.</Description>
        </Field>
      </Fields>
    </Message>
