    <!-- New Order Single and Cancel/Replace Request Message: pg 26 -->
    <Message>
      <Name>New Order Single and Cancel Replace Request Message</Name>
      <Dependency>Seq Msg Type</Dependency>
      <Branch>Sequenced Message</Branch>
      <Code>0x0240</Code>
      <Category>Order</Category>
      <Origin>Member Firm</Origin>
      <Size>Seq Msg Length</Size>
      <Sequenced>Yes</Sequenced>
      <Description>This message type is used as both a New Order message or a Cancel/Replacement message</Description>
      <Fields>
        <Field>
          <Name>SymbolID</Name>
          <Type>u32</Type>
          <Size>4</Size>
          <Description>Identification number assigned to the security</Description>
        </Field>
        <Field>
          <Name>MPID</Name>
          <Type>zchar(4)</Type>
          <Size>4</Size>
          <Description>Firm Identifier – MPID.</Description>
        </Field>
        <Field>
          <Name>MMID</Name>
          <Type>u32</Type>
          <Size>4</Size>
          <Description>This value represents the integer representation of a Market Maker, LMM, SLP, SLMM or DMM, agreed upon between the firm and the Exchange. These firms must provide their MMID along with its associated MPID on all orders intended to receive credit for satisfying their marking making/liquidity obligations.</Description>
        </Field>
        <Field>
          <Name>MPSubID</Name>
          <Type>char</Type>
          <Size>1</Size>
          <Description>Customer defined – identifies specific entity/trading desk of customer firm.</Description>
        </Field>
        <Field>
          <Name>ClOrdID</Name>
          <Type>u64</Type>
          <Size>8</Size>
          <Description>Unique ID of the new Order, Cancel/Replace, Cancel, Modify, or Bulk Cancel request as assigned by the firm.</Description>
        </Field>
        <Field>
          <Name>OrigClOrdID</Name>
          <Type>u64</Type>
          <Size>8</Size>
          <Description>Refers to the ClOrdID of a previously entered order.</Description>
        </Field>
        <Field>
          <Name>BitfieldOrderInstructions</Name>
          <Type>u128</Type>
          <Size>16</Size>
          <Description>Bitfield containing various order attributes and modifiers.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>0.000001-999999.999999</Description>
        </Field>
        <Field>
          <Name>OrderQty</Name>
          <Type>u32</Type>
          <Size>4</Size>
          <Description>1 - 999,999,999</Description>
        </Field>
        <Field>
          <Name>MinQty</Name>
          <Type>u32</Type>
          <Size>4</Size>
          <Description>0 = no MinQty Otherwise, Must be ≥ Round Lot and ≤ OrderQty</Description>
        </Field>
        <Field>
          <Name>UserData</Name>
          <Type>zchar(8)</Type>
          <Size>8</Size>
          <Description>Customer defined up to 8 characters; only printable ASCII characters allowed, excluding comma, semicolon, pipe delimiter, “at” symbol, greater than/less than, ampersand (&amp;) and single/double quotation mark..</Description>
        </Field>
        <Field>
          <Name>OptionalOrderAddOn</Name>
          <Type>struct</Type>
          <Size>4</Size>
          <Description>Data structure - one of two optional add-on structures may be appended to the Order message to make use of additional functionality. If present, add-on always</Description>
        </Field>
      </Fields>
    </Message>
  </Messages>

