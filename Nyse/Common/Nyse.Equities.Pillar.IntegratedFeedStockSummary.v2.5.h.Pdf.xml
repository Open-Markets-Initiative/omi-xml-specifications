        </Value>
      </Values>
    </Enum>

    <!-- CrossType -->
    <Enum>
      <Name>CrossType</Name>
      <Values>
        <Value>
          <Data>E</Data>
          <Name>Market Center Early Opening Auction</Name>
        </Value>
        <Value>
          <Data>O</Data>
          <Name>Market Center Opening Auction</Name>
        </Value>
        <Value>
          <Data>5</Data>
          <Name>Market Center Reopening Auction</Name>
        </Value>
        <Value>
          <Data>6</Data>
          <Name>Market Center Closing Auction</Name>
        </Value>
      </Values>
    </Enum>

    <!-- RPIIndicator -->
    <Enum>
      <Name>RPIIndicator</Name>
      <Values>
        <Value>
          <Data>" "</Data>
          <Name>No Retail Interest (Default)</Name>
        </Value>
        <Value>
          <Data>A</Data>
          <Name>Retail interest on the bid side</Name>
        </Value>
        <Value>
          <Data>B</Data>
          <Name>Retail interest on the offer side</Name>
        </Value>
        <Value>
          <Data>C</Data>
          <Name>Retail interest on the bid and offer sides</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Unpaired Side -->
    <Enum>
      <Name>Unpaired Side</Name>
      <Values>
        <Value>
          <Data>B</Data>
          <Name>buy side</Name>
        </Value>
        <Value>
          <Data>S</Data>
          <Name>sell side</Name>
        </Value>
        <Value>
          <Data>" "</Data>
          <Name>not applicable</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiNysePillarPdf>
