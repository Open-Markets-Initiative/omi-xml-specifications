<OmiNysePillarPdf>

  <!-- Nyse Equities IntegratedFeedStockSummary Pillar Version 2.5.h -->

  <!--
  Nyse Equities Integrated Feed Stock Summary message, published once per symbol every
  60 seconds on its own dedicated channel per sections 1.1 and 14.
  -->

  <Messages>

    <!-- Stock Summary Message -->
    <Message>
      <Name>Stock Summary Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Type>Administrative</Type>
      <Category>Application</Category>
      <Code>223</Code>
      <Description>A Stock Summary message per symbol is sent every 60 seconds, on a separate Stock Summary channel from
        the main feed.
      </Description>
      <Fields>
        <Field>
          <Name>SourceTime</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The time when this msg was generated in the order book, in seconds since Jan 1, 1970 00:00:00
            UTC.
          </Description>
        </Field>
        <Field>
          <Name>SourceTimeNS</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The nanosecond offset from the SourceTime</Description>
        </Field>
        <Field>
          <Name>SymbolIndex</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The ID of the symbol in the Symbol Index msg</Description>
        </Field>
        <Field>
          <Name>HighPrice</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The exchange high price of this stock for the day. Use the Price Scale in the symbol index msg.
          </Description>
        </Field>
        <Field>
          <Name>LowPrice</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The exchange Low price of this stock for the day. Use the Price Scale in the symbol index msg.
          </Description>
        </Field>
        <Field>
          <Name>Open</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The exchange Opening price of this stock for the day. Use the Price Scale in the symbol index
            msg.
          </Description>
        </Field>
        <Field>
          <Name>Close</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The exchange Closing price of this stock for the day. Use the Price Scale in the symbol index
            msg.
          </Description>
        </Field>
        <Field>
          <Name>TotalVolume</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The exchange cumulative volume for the stock throughout the day.</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- Side -->
    <Enum>
      <Name>Side</Name>
      <Values>
        <Value>
          <Data>B</Data>
          <Name>Buy</Name>
        </Value>
        <Value>
          <Data>S</Data>
          <Name>Sell</Name>
        </Value>
      </Values>
    </Enum>

    <!-- PrintableFlag -->
    <Enum>
      <Name>PrintableFlag</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>Not Printed to the SIP</Name>
        </Value>
        <Value>
          <Data>1</Data>
          <Name>Printed to the SIP</Name>
        </Value>
      </Values>
    </Enum>

    <!-- TradeCond1 -->
    <Enum>
      <Name>TradeCond1</Name>
      <Values>
        <Value>
          <Data>@</Data>
          <Name>Regular Sale</Name>
        </Value>
        <Value>
          <Data>C</Data>
          <Name>Cash (Texas only)</Name>
        </Value>
      </Values>
    </Enum>

    <!-- TradeCond2 -->
    <Enum>
      <Name>TradeCond2</Name>
      <Values>
        <Value>
          <Data>" "</Data>
          <Name>N/A</Name>
        </Value>
        <Value>
          <Data>F</Data>
          <Name>Intermarket Sweep Order</Name>
        </Value>
        <Value>
          <Data>O</Data>
          <Name>Market Center Opening Trade (Arca, American and NYSE only)</Name>
        </Value>
        <Value>
          <Data>5</Data>
          <Name>Reopening Trade (Arca, American and NYSE only)</Name>
        </Value>
        <Value>
          <Data>6</Data>
          <Name>Market Center Closing Trade (Arca, American and NYSE only)</Name>
        </Value>
        <Value>
          <Data>7</Data>
          <Name>Qualified Contingent Trade (Texas only)</Name>
        </Value>
      </Values>
    </Enum>

    <!-- TradeCond3 -->
    <Enum>
      <Name>TradeCond3</Name>
      <Values>
        <Value>
          <Data>" "</Data>
          <Name>N/A</Name>
        </Value>
        <Value>
          <Data>T</Data>
          <Name>Extended Hours Trade</Name>
        </Value>
        <Value>
          <Data>U</Data>
          <Name>Extended Hours Sold (Out of Sequence)</Name>
        </Value>
        <Value>
          <Data>Z</Data>
          <Name>Sold</Name>
        </Value>
      </Values>
    </Enum>

    <!-- TradeCond4 -->
    <Enum>
      <Name>TradeCond4</Name>
      <Values>
        <Value>
          <Data>" "</Data>
          <Name>N/A</Name>
        </Value>
        <Value>
          <Data>I</Data>
          <Name>Odd Lot Trade</Name>
        </Value>
        <Value>
          <Data>V</Data>
          <Name>Contingent Trade (Texas only)</Name>
        </Value>
      </Values>
    </Enum>

    <!-- AuctionType -->
    <Enum>
      <Name>AuctionType</Name>
      <Values>
        <Value>
          <Data>O</Data>
          <Name>Early Opening Auction</Name>
        </Value>
        <Value>
          <Data>M</Data>
          <Name>Core Opening Auction</Name>
        </Value>
        <Value>
          <Data>H</Data>
          <Name>Reopening Auction (Halt resume)</Name>
        </Value>
        <Value>
          <Data>C</Data>
          <Name>Closing Auction</Name>
        </Value>
        <Value>
          <Data>P</Data>
          <Name>Extreme Closing Imbalance</Name>
        </Value>
        <Value>
          <Data>R</Data>
          <Name>Significant Closing Imbalance</Name>
        </Value>
      </Values>
    </Enum>

    <!-- ImbalanceSide -->
    <Enum>
      <Name>ImbalanceSide</Name>
      <Values>
        <Value>
          <Data>B</Data>
          <Name>Buy side</Name>
        </Value>
        <Value>
          <Data>S</Data>
          <Name>Sell side</Name>
        </Value>
        <Value>
          <Data>" "</Data>
          <Name>No imbalance</Name>
        </Value>
      </Values>
    </Enum>

    <!-- AuctionStatus -->
    <Enum>
      <Name>AuctionStatus</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>Will run as always for Open and Close</Name>
        </Value>
        <Value>
          <Data>1</Data>
          <Name>Will run, interest exists inside or at the collars or is fully paired off</Name>
        </Value>
        <Value>
          <Data>2</Data>
          <Name>Will not run because there is an imbalance through the collars</Name>
        </Value>
        <Value>
          <Data>3</Data>
          <Name>Will not run, will transition to the Closing Auction instead</Name>
        </Value>
      </Values>
    </Enum>

    <!-- FreezeStatus -->
    <Enum>
      <Name>FreezeStatus</Name>
      <Values>
        <Value>
