    <!-- Complex Symbol Definition Message -->
    <Message>
      <Name>Complex Symbol Definition Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>439</Code>
      <Description>The Complex Symbol Definition message provides a description of the legs in a Complex symbol, and specifies its Complex symbol ID, which is unique for its stream. If the same symbol ID appears in a different stream, it represents a different Complex symbol.</Description>
      <Fields>
        <Field>
          <Name>ComplexIndex</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The unique ID of this complex symbol in this stream. This ID cannot be used to cross reference a security between streams or between markets.</Description>
        </Field>
        <Field>
          <Name>ComplexSymbol</Name>
          <Type>ASCII</Type>
          <Size>21</Size>
          <Description>Complex Symbol. This is an alpha numeric symbol which can be used for a unique strategy until one of the legs expire.</Description>
        </Field>
        <Field>
          <Name>ChannelID</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Multicast channel ID of the symbols being provided.</Description>
        </Field>
        <Field>
          <Name>Market ID</Name>
          <Type>Binary</Type>
          <Size>2</Size>
          <Description>Identifies originating market</Description>
        </Field>
        <Field>
          <Name>SystemID</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Identifies Trading unit (TU)</Description>
        </Field>
        <Field>
          <Name>Reserved 1</Name>
          <Type>reserved</Type>
          <Size>1</Size>
          <Description>Filler</Description>
        </Field>
        <Field>
          <Name>StreamID</Name>
          <Type>Binary</Type>
          <Size>2</Size>
          <Description>Identifies Stream on which this symbol will be updated</Description>
        </Field>
        <Field>
          <Name>NoOfLegs</Name>
          <Type>Binary</Type>
          <Size>2</Size>
          <Description>Number of legs in complex symbol: 1 – 5</Description>
        </Field>
        <Field>
          <Name>Reserved 2</Name>
          <Type>reserved</Type>
          <Size>2</Size>
          <Description>Filler</Description>
        </Field>
        <Field>
          <Name>Leg definition</Name>
          <Type>Group</Type>
          <Size>0</Size>
          <Description>Leg definition</Description>
        </Field>
      </Fields>
    </Message>

