<OmiXdpPdf>

  <Messages>

    <!-- Complex Quote Message -->
    <Message>
      <Name>Complex Quote Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>423</Code>
      <Description>The Complex Quote message is a two-sided message providing best bid and offer limits of orders on complex symbols with aggregated volumes at each limit.</Description>
      <Fields>
        <Field>
          <Name>SourceTime</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The time when this msg was generated in the order book, in seconds since Jan 1, 1970 00:00:00 UTC.</Description>
        </Field>
        <Field>
          <Name>SourceTimeNS</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The nanosecond offset from the SourceTime.</Description>
        </Field>
        <Field>
          <Name>ComplexIndex</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The unique ID of the symbol in the Complex Index msg</Description>
        </Field>
        <Field>
          <Name>SymbolSeqNum</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Sequence number of messages for the complex symbol.</Description>
        </Field>
        <Field>
          <Name>AskPrice</Name>
          <Type>Signed Binary</Type>
          <Size>4</Size>
          <Description>Best Ask price*. Should be used with the Price Scale Code from the Underlying Index Mapping message.</Description>
        </Field>
        <Field>
          <Name>BidPrice</Name>
          <Type>Signed Binary</Type>
          <Size>4</Size>
          <Description>Best Bid price*. Should be used with the Price Scale Code from the Underlying Index Mapping message.</Description>
        </Field>
        <Field>
          <Name>AskVolume</Name>
          <Type>Binary</Type>
          <Size>2</Size>
          <Description>Total quantity available at the above Ask price.</Description>
        </Field>
        <Field>
          <Name>BidVolume</Name>
          <Type>Binary</Type>
          <Size>2</Size>
          <Description>Total quantity available at the above Bid price.</Description>
        </Field>
        <Field>
          <Name>AskCustomerVolume</Name>
          <Type>Binary</Type>
          <Size>2</Size>
          <Description>Total quantity of ‘Customer’ orders available at the above Ask price.</Description>
        </Field>
        <Field>
          <Name>BidCustomerVolume</Name>
          <Type>Binary</Type>
          <Size>2</Size>
          <Description>Total quantity of ‘Customer’ orders available at the above Bid price.</Description>
        </Field>
        <Field>
          <Name>QuoteCondition</Name>
          <Type>ASCII</Type>
          <Size>1</Size>
          <Description>QuoteCondition value</Description>
        </Field>
        <Field>
          <Name>Reserved 1</Name>
          <Type>reserved</Type>
          <Size>1</Size>
          <Description>Filler</Description>
        </Field>
        <Field>
          <Name>Reserved 2</Name>
          <Type>reserved</Type>
          <Size>2</Size>
          <Description>Filler</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Complex Trade Message -->
    <Message>
      <Name>Complex Trade Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>425</Code>
      <Description>The Complex Trade message is used to publish all complex Last Sales.</Description>
      <Fields>
        <Field>
          <Name>SourceTime</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The time when this msg was generated in the order book, in seconds since Jan 1, 1970 00:00:00 UTC.</Description>
        </Field>
        <Field>
          <Name>SourceTimeNS</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The nanosecond offset from the SourceTime.</Description>
        </Field>
        <Field>
          <Name>ComplexIndex</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The unique ID of the symbol in the Complex Index msg</Description>
        </Field>
        <Field>
          <Name>SymbolSeqNum</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Sequence number of messages for the complex symbol.</Description>
        </Field>
        <Field>
          <Name>TradeID</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>n/a for complex symbols</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Signed Binary</Type>
          <Size>4</Size>
          <Description>The net amount of money made by the Seller* (the price of the Sell legs minus the price of the Buy legs).</Description>
        </Field>
        <Field>
          <Name>Volume4</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Volume of the trade in actual number of contracts</Description>
        </Field>
        <Field>
          <Name>TradeCond1</Name>
          <Type>ASCII</Type>
          <Size>1</Size>
          <Description>TradeCond1 value</Description>
        </Field>
        <Field>
          <Name>TradeCond2</Name>
          <Type>ASCII</Type>
          <Size>1</Size>
          <Description>(blank) n/a for complex symbols</Description>
        </Field>
        <Field>
          <Name>Reserved 2</Name>
          <Type>reserved</Type>
          <Size>2</Size>
          <Description>Filler</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Complex Crossing RFQ Message -->
    <Message>
      <Name>Complex Crossing RFQ Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>429</Code>
      <Description>The Complex Crossing RFQ (Request for Quote) message is sent out in the event of a COA auction on a complex order.</Description>
      <Fields>
        <Field>
          <Name>SourceTime</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The time when this msg was generated in the order book, in seconds since Jan 1, 1970 00:00:00 UTC.</Description>
        </Field>
        <Field>
          <Name>SourceNS</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The nanosecond offset from the SourceTime.</Description>
        </Field>
        <Field>
          <Name>ComplexIndex</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The unique ID of the symbol in the Complex Index msg</Description>
        </Field>
        <Field>
          <Name>SymbolSeqNum</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Sequence number of messages for the complex symbol.</Description>
        </Field>
        <Field>
          <Name>Side</Name>
          <Type>ASCII</Type>
          <Size>1</Size>
          <Description>Side of the RFQ</Description>
        </Field>
        <Field>
          <Name>Reserved 1</Name>
          <Type>reserved</Type>
          <Size>1</Size>
          <Description>Filler</Description>
        </Field>
        <Field>
          <Name>Volume2</Name>
          <Type>Binary</Type>
          <Size>2</Size>
          <Description>Total quantity</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Signed Binary</Type>
          <Size>4</Size>
          <Description>Price of crossing transaction. Use the Price Scale Code from the Underlying Index Mapping message. 999999999 = The price is not displayed.</Description>
        </Field>
      </Fields>
    </Message>

