<OmiPillarStreamlinedPdf>

  <Messages>

    <!-- Quote Message -->
    <Message>
      <Name>Quote Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>140</Code>
      <Type>Quote</Type>
      <Category>Application</Category>
      <Description>A quote message is sent when any event results in a new top of book value on either side of the market.</Description>
      <Fields>
        <Field>
          <Name>SourceTimeNS</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The nanosecond offset (UTC Time) from the Time Reference message.</Description>
        </Field>
        <Field>
          <Name>SymbolIndex</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The ID of the symbol in the Symbol Index message.</Description>
        </Field>
        <Field>
          <Name>SymbolSeqNum</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The symbol sequence number.</Description>
        </Field>
        <Field>
          <Name>Ask Price</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The Ask price. Use the Price scale from the Symbol Index message.</Description>
        </Field>
        <Field>
          <Name>Ask Volume</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The aggregate round lot size at the ask price, in shares.</Description>
        </Field>
        <Field>
          <Name>Bid Price</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The Bid price. Use the Price scale from the Symbol Index message.</Description>
        </Field>
        <Field>
          <Name>Bid Volume</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The aggregate round lot size at the bid price, in shares.</Description>
        </Field>
        <Field>
          <Name>Quote Condition</Name>
          <Type>ASCII</Type>
          <Size>1</Size>
          <Description>Quote Condition</Description>
        </Field>
        <Field>
          <Name>RPI Indicator</Name>
          <Type>ASCII</Type>
          <Size>1</Size>
          <Description>The side(s) where Retail Price Indication orders (RPI orders) exist. Values correspond to CQS values.</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- Quote Condition -->
    <Enum>
      <Name>Quote Condition</Name>
      <Values>
        <Value>
          <Data>R</Data>
          <Name>Regular Quote</Name>
        </Value>
        <Value>
          <Data>O</Data>
          <Name>Opening Quote</Name>
        </Value>
      </Values>
    </Enum>

    <!-- RPI Indicator -->
    <Enum>
      <Name>RPI Indicator</Name>
      <Values>
        <Value>
          <Data>" "</Data>
          <Name>No Retail Interest (Default)</Name>
        </Value>
        <Value>
          <Data>A</Data>
          <Name>Retail Interest on Bid side</Name>
        </Value>
        <Value>
          <Data>B</Data>
          <Name>Retail Interest on Offer side</Name>
        </Value>
        <Value>
          <Data>C</Data>
          <Name>Retail Interest on the Bid and Offer side</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiPillarStreamlinedPdf>
