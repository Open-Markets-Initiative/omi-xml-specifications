<OmiPillarStreamlinedPdf>
  
  <Messages>
    
    <!-- Sequence Number Reset Message -->
    <Message>
      <Name>Sequence Number Reset Message</Name>
      <Category>Control</Category>
      <Origin>Exchange</Origin>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>1</Code>
      <Description>This message is sent to reset the Message Sequence Number at start of day, or in response to
        failures.
      </Description>
      <Fields>
        <Field>
          <Name>SourceTime</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The time when this msg was generated in the order book, in seconds since Jan 1, 1970 00:00:00
            UTC.
          </Description>
        </Field>
        <Field>
          <Name>SourceTimeNS</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The nanosecond offset from the SourceTime.</Description>
        </Field>
        <Field>
          <Name>ProductID</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>The unique ID for this NYSE feed listed in the feed's client specification.</Description>
        </Field>
        <Field>
          <Name>ChannelID</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>The ID of the multicast channel over which the packet was sent.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Source Time Reference Message -->
    <Message>
      <Name>Source Time Reference Message</Name>
      <Category>Control</Category>
      <Origin>Exchange</Origin>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>2</Code>
      <Description>For high-volume feeds, this message is sent at the start of every second during periods of active
        data publication. The client can concatenate the SourceTime field with the SourceTimeNS field in subsequent
        market data messages to get full 8-byte Matching Engine event timestamps.
      </Description>
      <Fields>
        <Field>
          <Name>ID</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>ID of the originating Matching Engine partition to which this message applies.</Description>
        </Field>
        <Field>
          <Name>SymbolSeqNum</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Reserved for future use. Ignore any content.</Description>
        </Field>
        <Field>
          <Name>SourceTime</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The time when this msg was generated in the order book, in seconds since Jan 1, 1970 00:00:00
            UTC.
          </Description>
        </Field>
      </Fields>
    </Message>

    <!-- Symbol Index Mapping Message -->
    <Message>
      <Name>Symbol Index Mapping Message</Name>
      <Category>Control</Category>
      <Origin>Exchange</Origin>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>3</Code>
      <Description>This message is published over the real-time data channels at system startup or in the context of a
        refresh sequence after a Matching Engine or Pillar Publisher failover. It provides referential data for a single
        specified symbol.
      </Description>
      <Fields>
        <Field>
          <Name>SymbolIndex</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The unique ID of this symbol for all products within this market. This ID cannot be used to cross
            reference a security between markets.
          </Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>ASCII</Type>
          <Size>11</Size>
          <Description>Null-terminated ASCII symbol in NYSE Symbology.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>This field is reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Market ID</Name>
          <Type>Binary</Type>
          <Size>2</Size>
          <Description>ID of the Originating Market.</Description>
        </Field>
        <Field>
          <Name>System ID</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>ID of the Originating matching engine server.</Description>
        </Field>
        <Field>
          <Name>Exchange Code</Name>
          <Type>ASCII</Type>
          <Size>1</Size>
          <Description>For listed equity markets, the market where this symbol is listed.</Description>
        </Field>
        <Field>
          <Name>PriceScaleCode</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Specifies placement of the decimal point in price fields for this security.</Description>
        </Field>
        <Field>
          <Name>Security Type</Name>
          <Type>ASCII</Type>
          <Size>1</Size>
          <Description>Type of Security used by Pillar-powered markets.</Description>
        </Field>
        <Field>
          <Name>Lot Size</Name>
          <Type>Binary</Type>
          <Size>2</Size>
          <Description>Round lot size in shares.</Description>
        </Field>
        <Field>
          <Name>PrevClosePrice</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The previous day's closing price for this security.</Description>
        </Field>
        <Field>
          <Name>PrevCloseVolume</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The previous day's closing volume for the security.</Description>
        </Field>
        <Field>
          <Name>Price Resolution</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Minimum price increment: 0 - All Penny, 1 - Penny/Nickel, 5 - Nickel/Dime.</Description>
        </Field>
        <Field>
          <Name>Round Lot</Name>
          <Type>ASCII</Type>
          <Size>1</Size>
          <Description>Round Lots Accepted: Y - Yes, N - No.</Description>
        </Field>
        <Field>
          <Name>MPV</Name>
          <Type>Binary</Type>
          <Size>2</Size>
          <Description>The minimum increment for a trade price, in 100ths of a cent. Typically 1, or $0.0001, but for
            some Tick Pilot stocks, can be 500, or $0.05.
          </Description>
        </Field>
        <Field>
          <Name>Unit of Trade</Name>
          <Type>Binary</Type>
          <Size>2</Size>
          <Description>This field specifies the security Unit of Trade in shares. Valid values are 1, 10, 50 and 100.
          </Description>
        </Field>
        <Field>
          <Name>Late Close Eligible</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>The Outright series for the underlying symbol is eligible for a later Core session close.</Description>
        </Field>
        <Field>
          <Name>ETH Eligible</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>The Outright series for the underlying symbol is eligible for Extended Trading Sessions.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Symbol Clear Message -->
    <Message>
      <Name>Symbol Clear Message</Name>
      <Category>Control</Category>
      <Origin>Exchange</Origin>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>32</Code>
      <Description>In case of a failure and recovery of a Matching Engine or an Pillar Publisher, the publisher may send
        a full state refresh for every symbol affected. This unrequested refresh is preceded by a Symbol Clear message.
        The client should react to receipt of a Symbol Clear message by clearing all state information for the specified
        symbol in anticipation of receiving a full state refresh.
      </Description>
      <Fields>
        <Field>
          <Name>SourceTime</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The time when this msg was generated in the order book, in seconds since Jan 1, 1970 00:00:00
            UTC.
          </Description>
        </Field>
        <Field>
          <Name>SourceTimeNS</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The nanosecond offset from the SourceTime.</Description>
        </Field>
        <Field>
          <Name>SymbolIndex</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The unique ID of the symbol in the Symbol Index msg.</Description>
        </Field>
        <Field>
          <Name>NextSourceSeqNum</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The sequence number in the next message for this symbol.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Security Status Message -->
    <Message>
      <Name>Security Status Message</Name>
      <Category>Control</Category>
      <Origin>Exchange</Origin>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>34</Code>
      <Description>This message informs clients of changes in the status of a specific security, such as Trading Halts,
        Short Sale Restriction state changes, etc.
      </Description>
      <Fields>
        <Field>
          <Name>SourceTime</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The time when this msg was generated in the order book, in seconds since Jan 1, 1970 00:00:00
            UTC.
          </Description>
        </Field>
        <Field>
          <Name>SourceTimeNS</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The nanosecond offset from the SourceTime.</Description>
        </Field>
        <Field>
          <Name>SymbolIndex</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The unique ID of the symbol in the Symbol Index msg.</Description>
        </Field>
        <Field>
          <Name>SymbolSeqNum</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The unique ID of this message in the sequence of messages published for this specific symbol.
          </Description>
        </Field>
        <Field>
          <Name>Security Status</Name>
          <Type>ASCII</Type>
          <Size>1</Size>
          <Description>The new status that this security is transitioning to.</Description>
        </Field>
        <Field>
          <Name>Halt Condition</Name>
          <Type>ASCII</Type>
          <Size>1</Size>
          <Description>The halt or other condition associated with the security status change.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Future use. Any field content should be ignored.</Description>
        </Field>
        <Field>
          <Name>Price 1</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Default value is 0. If securityStatus = A and this security is listed on this exchange, then this
            field is the SSR Triggering Trade Price. If securityStatus = G or I, then this field is the Indication Low
            Price.
          </Description>
        </Field>
        <Field>
          <Name>Price 2</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Default value is 0. If securityStatus = G or I, then this field is the Indication High Price.
          </Description>
        </Field>
        <Field>
          <Name>SSR Triggering Exchange ID</Name>
          <Type>ASCII</Type>
          <Size>1</Size>
          <Description>This field is only populated when securityStatus = A and this security is listed on this
            exchange. Otherwise it is defaulted to 0x20.
          </Description>
        </Field>
        <Field>
          <Name>SSR Triggering Volume</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Default value is 0. This field is only populated when securityStatus = A and this security is
            listed on this exchange.
          </Description>
        </Field>
        <Field>
          <Name>Time</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Default value is 0. Format: HHMMSSmmm (mmm = milliseconds). If securityStatus = A and this
            security is listed on this exchange, then this field is the SSR Trigger Time.
          </Description>
        </Field>
        <Field>
          <Name>SSRState</Name>
          <Type>ASCII</Type>
          <Size>1</Size>
          <Description>The current SSR state, which this msg updates if the Security Status field contains an SSR
            Code.
          </Description>
        </Field>
        <Field>
          <Name>MarketState</Name>
          <Type>ASCII</Type>
          <Size>1</Size>
          <Description>The current Market State, which this msg updates if the Security Status field contains a Market
            State Code.
          </Description>
        </Field>
        <Field>
          <Name>SessionState</Name>
          <Type>ASCII</Type>
          <Size>1</Size>
          <Description>Unused. Defaulted to 0x00.</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

