<OmiPillarPdf>

  <!-- Nyse multi-market control messages carried on the request channel, transcribed from the
       NYSE Multiple Markets Common Client Specification v2.3c (July 21, 2026), which covers the
       NYSE Best Quote and Trades and NYSE Pillar Depth data feeds. -->

  <Messages>


    <!-- Retransmission Request Message -->
    <Message>
      <Name>Retransmission Request Message</Name>
      <Type>Request</Type>
      <Category>Control</Category>
      <Origin>Firm</Origin>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>10</Code>
      <Description>Clients who have experienced a sequence number gap and need a retransmission of the missed messages
        should send a Retransmission Request message via TCP to the Request Controller.
      </Description>
      <Fields>
        <Field>
          <Name>BeginSeqNum</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The beginning sequence number of the range of messages to be retransmitted.</Description>
        </Field>
        <Field>
          <Name>EndSeqNum</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The end sequence number of the range of messages to be retransmitted.</Description>
        </Field>
        <Field>
          <Name>SourceID</Name>
          <Type>ASCII</Type>
          <Size>10</Size>
          <Description>The ID of the client requesting this retransmission. All trailing characters should be NULL.
          </Description>
        </Field>
        <Field>
          <Name>ProductID</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>The unique ID of the feed for which a retransmission is requested (listed in the feed's client
            specification).
          </Description>
        </Field>
        <Field>
          <Name>ChannelID</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>The ID of the multicast channel on which the gap occurred.</Description>
        </Field>
      </Fields>
    </Message>


    <!-- Request Response Message -->
    <Message>
      <Name>Request Response Message</Name>
      <Type>Response</Type>
      <Category>Control</Category>
      <Origin>Exchange</Origin>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>11</Code>
      <Description>This message will be sent immediately via TCP/IP in response to the client's request for
        retransmission, refresh or Symbol Mapping messages.
      </Description>
      <Fields>
        <Field>
          <Name>RequestSeqNum</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The sequence number of the request message sent by the client. This can be used by the client to
            couple this response with the original request message.
          </Description>
        </Field>
        <Field>
          <Name>BeginSeqNum</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>For Retrans Request responses, the beginning sequence number of the requested retransmission
            range. For responses to Refresh or Symbol Mapping Requests, 0.
          </Description>
        </Field>
        <Field>
          <Name>EndSeqNum</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>For Retrans Request responses, the ending sequence number of the requested retransmission range.
            For responses to Refresh or Symbol Mapping Requests, 0.
          </Description>
        </Field>
        <Field>
          <Name>SourceID</Name>
          <Type>ASCII</Type>
          <Size>10</Size>
          <Description>The ID of the client requesting this retransmission. All trailing characters should be NULL.
          </Description>
        </Field>
        <Field>
          <Name>ProductID</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>The unique ID of the feed for which the request was made (listed in the feed's client
            specification).
          </Description>
        </Field>
        <Field>
          <Name>ChannelID</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>The ID of the multicast channel for which the request was made.</Description>
        </Field>
        <Field>
          <Name>Status</Name>
          <Type>ASCII</Type>
          <Size>1</Size>
          <Description>The reason why the request was rejected.</Description>
        </Field>
      </Fields>
    </Message>


    <!-- Heartbeat Response Message -->
    <Message>
      <Name>Heartbeat Response Message</Name>
      <Type>Response</Type>
      <Category>Control</Category>
      <Origin>Firm</Origin>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>12</Code>
      <Description>Clients who remain connected to the Retransmission Server intraday must respond to a Heartbeat with a
        Heartbeat Response message within 5 seconds. If no timely client response is received, the connection will be
        closed.
      </Description>
      <Fields>
        <Field>
          <Name>SourceID</Name>
          <Type>ASCII</Type>
          <Size>10</Size>
          <Description>The ID of the client requesting this retransmission. All trailing characters should be NULL.
          </Description>
        </Field>
      </Fields>
    </Message>


    <!-- Symbol Index Mapping Request Message -->
    <Message>
      <Name>Symbol Index Mapping Request Message</Name>
      <Type>Request</Type>
      <Category>Control</Category>
      <Origin>Firm</Origin>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>13</Code>
      <Description>This message is sent by clients via TCP/IP requesting the Symbol Index Mapping messages for one or
        all symbols in a specified channel.
      </Description>
      <Fields>
        <Field>
          <Name>SymbolIndex</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The ID (from the Symbol Index msg) of the symbol for which a refresh is requested. To request a
            refresh for all symbols in the specified channel, set this field to 0.
          </Description>
        </Field>
        <Field>
          <Name>SourceID</Name>
          <Type>ASCII</Type>
          <Size>10</Size>
          <Description>The ID of the client requesting this retransmission. All trailing characters should be NULL.
          </Description>
        </Field>
        <Field>
          <Name>ProductID</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>The unique ID of the feed for which the refresh is requested (listed in the feed's client
            specification).
          </Description>
        </Field>
        <Field>
          <Name>ChannelID</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>The ID of the multicast channel for which the refresh is requested.</Description>
        </Field>
        <Field>
          <Name>RetransmitMethod</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>The delivery method for the requested symbol index mapping information. Valid values: 0 - deliver
            via UDP.
          </Description>
        </Field>
      </Fields>
    </Message>


    <!-- Refresh Request Message -->
    <Message>
      <Name>Refresh Request Message</Name>
      <Type>Request</Type>
      <Category>Control</Category>
      <Origin>Firm</Origin>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>15</Code>
      <Description>Clients who have experienced a failure and need a refresh of the state of one or all symbols in a
        specific channel should send a Refresh Request message via TCP to the Request Controller.
      </Description>
      <Fields>
        <Field>
          <Name>SymbolIndex</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>The ID (from the Symbol Index msg) of the symbol for which a refresh is requested. To request a
            refresh for all symbols in the channel, set this field to 0.
          </Description>
        </Field>
        <Field>
          <Name>SourceID</Name>
          <Type>ASCII</Type>
          <Size>10</Size>
          <Description>The ID of the client requesting this retransmission. All trailing characters should be NULL.
          </Description>
        </Field>
        <Field>
          <Name>ProductID</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>The unique ID of the feed for which the refresh is requested (listed in the feed's client
            specification).
          </Description>
        </Field>
        <Field>
          <Name>ChannelID</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>The ID of the multicast channel for which the refresh is requested.</Description>
        </Field>
      </Fields>
    </Message>


  </Messages>

