      <Name>System Event Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Message Data</Branch>
      <Code>S</Code>
      <Description>The System Event Message is used to indicate events that apply to the market or the data feed.</Description>
      <Fields>
        <Field>
          <Name>System Event</Name>
          <Size>1</Size>
          <Type>Byte</Type>
          <Description>System event identifier</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Size>8</Size>
          <Type>Timestamp</Type>
          <Description>Time stamp of the system event</Description>
        </Field>
      </Fields>
    </Message>
    <!-- Security Directory Message -->
