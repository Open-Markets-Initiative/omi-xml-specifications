<OmiIexTpPdf>

  <Messages>

    <!-- Snapshot Request Message -->
    <Message>
      <Name>Snapshot Request Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Message Data</Branch>
      <Code>r</Code>
      <Origin>Client</Origin>
      <Description>The Snapshot Request message is sent from the client to the Deep Plus Snap server to authenticate and request a Snapshot Response</Description>
      <Fields>
        <Field>
          <Name>Authentication Token</Name>
          <Size>40</Size>
          <Type>String</Type>
          <Description>Token supplied by Iex Market Ops, left justified and space padded on the right</Description>
        </Field>
        <Field>
          <Name>Channel Id</Name>
          <Size>4</Size>
          <Type>Integer</Type>
          <Description>Channel identifier from the Deep Plus feed IexTp header</Description>
        </Field>
        <Field>
          <Name>Session Id</Name>
          <Size>4</Size>
          <Type>Integer</Type>
          <Description>Session identifier from the Deep Plus feed IexTp header</Description>
        </Field>
        <Field>
          <Name>Minimum Sequence Number</Name>
          <Size>8</Size>
          <Type>Long</Type>
          <Description>Minimum sequence number useable by the client, zero returns the latest snapshot available</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Error Response Message -->
    <Message>
      <Name>Error Response Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Message Data</Branch>
      <Code>e</Code>
      <Description>Sent by the Deep Plus Snap server to the client when a Snapshot Request is rejected</Description>
      <Fields>
        <Field>
          <Name>Reject Reason Code</Name>
          <Size>1</Size>
          <Type>Byte</Type>
          <Description>Reason the Snapshot Request was rejected</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Snapshot Start Message -->
    <Message>
      <Name>Snapshot Start Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Message Data</Branch>
      <Code>s</Code>
      <Description>First message of a Snapshot Response sent from the Deep Plus Snap server when a Snapshot Request is successful</Description>
      <Fields>
        <Field>
          <Name>Snapshot Length</Name>
          <Size>8</Size>
          <Type>Long</Type>
          <Description>Length in bytes of the complete Snapshot Response including the Snapshot Start message, all Snapshot Data messages, and the Snapshot End message</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Snapshot Data Message -->
    <Message>
      <Name>Snapshot Data Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Message Data</Branch>
      <Code>d</Code>
      <Description>Carries one complete Deep Plus feed message wrapped with an IexTp header providing Deep Plus feed sequencing and timing information</Description>
      <Fields>
        <Field>
          <Name>IexTp Header</Name>
          <Size>40</Size>
          <Type>Byte</Type>
          <Description>IexTp header for the wrapped Deep Plus feed message, see the Iex Transport specification</Description>
        </Field>
        <Field>
          <Name>IexTp Message Block Length</Name>
          <Size>2</Size>
          <Type>Integer</Type>
          <Description>Length of the IexTp message block, see the Iex Transport specification</Description>
        </Field>
        <Field>
          <Name>IexTp Message Length</Name>
          <Size>2</Size>
          <Type>Integer</Type>
          <Description>Length of the wrapped Deep Plus message in bytes not including this field</Description>
        </Field>
        <Field>
          <Name>IexTp Message Type</Name>
          <Size>1</Size>
          <Type>Byte</Type>
          <Description>Code identifying the wrapped Deep Plus message type</Description>
        </Field>
        <Field>
          <Name>IexTp Message Data</Name>
          <Size>0</Size>
          <Type>Byte</Type>
          <Description>One complete Iex Deep Plus formatted message, may be any Deep Plus message type, see the Iex Transport specification</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Snapshot End Message -->
    <Message>
      <Name>Snapshot End Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Message Data</Branch>
      <Code>x</Code>
      <Description>Final message of a Snapshot Response, carries the sequence number at which the snapshot was created</Description>
      <Fields>
        <Field>
          <Name>Snapshot Sequence Number</Name>
          <Size>8</Size>
          <Type>Long</Type>
          <Description>Sequence at which the snapshot was created</Description>
        </Field>
      </Fields>
    </Message>


