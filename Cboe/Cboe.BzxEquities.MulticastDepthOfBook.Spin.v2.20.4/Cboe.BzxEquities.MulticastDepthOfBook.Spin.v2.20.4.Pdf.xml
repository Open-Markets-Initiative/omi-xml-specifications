<OmiCboeEquitiesPitchPdf>

  <!-- Bats Spin Server messages, carried over the Spin Server's own Tcp connection. A spin replays
       the unit's book as Add Order messages, so the whole Pitch message set reads here too -->

  <Messages>

    <!-- Login Message -->
    <Message>
      <Name>Login Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Origin>Firm</Origin>
      <Category>Session</Category>
      <Code>0x01</Code>
      <Description>The Login message is the first message sent to the Spin Server by a user's process after the connection to the Spin Server is established. Failure to login before sending any other message type will result in the connection being dropped by the Spin Server. The format of the Login message for the Spin Server is identical to that of the Grp.</Description>
      <Fields>
        <Field>
          <Name>SessionSubId</Name>
          <Type>Alphanumeric</Type>
          <Size>4</Size>
          <Description>SessionSubId supplied by Bats</Description>
        </Field>
        <Field>
          <Name>Username</Name>
          <Type>Alphanumeric</Type>
          <Size>4</Size>
          <Description>Username supplied by Bats</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>Alphanumeric</Type>
          <Size>2</Size>
          <Description>(space filled)</Description>
        </Field>
        <Field>
          <Name>Password</Name>
          <Type>Alphanumeric</Type>
          <Size>10</Size>
          <Description>Password supplied by Bats</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Login Response Message. The document names this field Status, as it does the one on Spin
         Response, so each reads under the name of the message that carries it -->

    <Message>
      <Name>Login Response Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Origin>Exchange</Origin>
      <Category>Session</Category>
      <Code>0x02</Code>
      <Description>The Login Response message is sent by the Spin Server to a user's process in response to a Login message. The status field is used to reflect an accepted login or the reason the session was not accepted. If login fails, the connection will be dropped after the Login Response message is sent.</Description>
      <Fields>
        <Field>
          <Name>Login Response Status</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Accepted or reason for reject</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Spin Image Available Message -->
    <Message>
      <Name>Spin Image Available Message</Name>
