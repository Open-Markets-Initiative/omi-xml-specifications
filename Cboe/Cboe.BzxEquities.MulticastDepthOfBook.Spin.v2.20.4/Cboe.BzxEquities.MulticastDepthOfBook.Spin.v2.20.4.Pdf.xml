          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>"B" = Buy Order "S" = Sell Order</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Number of shares/contracts being added to the book (may be less than the number entered)</Description>
