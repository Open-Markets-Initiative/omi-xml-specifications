<OmiPitchCxaEquitiesPdf>

  <Messages>

    <!-- Unit Clear Message -->
    <Message>
      <Name>Unit Clear Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x97</Code>
      <Description>Instructs feed recipients to clear all data for the CXA book in the unit specified in the Sequenced Unit Header. Distributed in rare recovery events such as a datacentre fail-over.</Description>
      <Fields>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Reserved (undefined).</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trading Status Message -->
    <Message>
      <Name>Trading Status Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x3B</Code>
      <Description>Indicates the current trading status of a security. A Trading Status message will be sent whenever trading status changes for a security.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary UTC Timestamp</Type>
          <Size>8</Size>
          <Description>Nanoseconds since epoch.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Printable ASCII</Type>
          <Size>6</Size>
          <Description>Symbol (right padded with spaces).</Description>
        </Field>
        <Field>
          <Name>Trading Status</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Trading status of the session for the symbol.</Description>
        </Field>
        <Field>
          <Name>Market Id Code</Name>
          <Type>Alphanumeric</Type>
          <Size>4</Size>
          <Description>Market Identifier Code (right padded with spaces).</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Reserved (undefined).</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Single Side Update Message -->
    <Message>
      <Name>Single Side Update Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0xE4</Code>
      <Description>Provides an updated price and size for a single side of a Symbol. The side is denoted by the Side field. One Single Side Update message may reflect one or more updates to the inside book that were processed at the same time but will only be done so in a way that can be arbitrated between A/B feeds.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary UTC Timestamp</Type>
          <Size>8</Size>
          <Description>Nanoseconds since epoch.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Printable ASCII</Type>
          <Size>6</Size>
          <Description>Symbol (right padded with spaces).</Description>
        </Field>
        <Field>
          <Name>Side</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Side of the update.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary Price</Type>
          <Size>8</Size>
          <Description>Price of the update.</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Number of shares on the inside book. May be zero if only undisclosed orders exist on the inside book.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Reserved (undefined).</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Two Side Update Message -->
    <Message>
      <Name>Two Side Update Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0xE5</Code>
      <Description>Provides an updated price and size for both sides of a Symbol. One Two Side Update message may reflect one or more updates to the inside book that were processed at the same time but will only be done so in a way that can be arbitrated between A/B feeds.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary UTC Timestamp</Type>
          <Size>8</Size>
          <Description>Nanoseconds since epoch.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Printable ASCII</Type>
          <Size>6</Size>
          <Description>Symbol (right padded with spaces).</Description>
        </Field>
        <Field>
          <Name>Bid Price</Name>
          <Type>Binary Price</Type>
          <Size>8</Size>
          <Description>Bid price.</Description>
        </Field>
        <Field>
          <Name>Bid Quantity</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Number of shares on the bid side of the inside book. May be zero if only undisclosed orders exist on the inside book.</Description>
        </Field>
        <Field>
          <Name>Reserved 1</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Reserved (undefined).</Description>
        </Field>
        <Field>
          <Name>Ask Price</Name>
          <Type>Binary Price</Type>
          <Size>8</Size>
          <Description>Ask price.</Description>
        </Field>
        <Field>
          <Name>Ask Quantity</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Number of shares on the ask side of the inside book. May be zero if only undisclosed orders exist on the inside book.</Description>
        </Field>
        <Field>
          <Name>Reserved 2</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Reserved (undefined).</Description>
        </Field>
      </Fields>
    </Message>

    <!-- TOP Trade Message -->
    <Message>
      <Name>TOP Trade Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0xE6</Code>
      <Description>Provides information about executions of orders on the CXA book or executions that occur off-exchange and reported to CXA. TOP Trade messages for on-exchange electronic executions are necessary to calculate CXA execution-based data. TOP Trade messages do not alter the book. A TOP Trade message is also sent whenever an execution or trade report is broken with the Flags field value indicating trade break.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary UTC Timestamp</Type>
          <Size>8</Size>
          <Description>Nanoseconds since epoch.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Printable ASCII</Type>
          <Size>6</Size>
          <Description>Symbol (right padded with spaces).</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Incremental number of shares executed, reported, or corrected (see Flags).</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary Price</Type>
          <Size>8</Size>
          <Description>The price of the trade.</Description>
        </Field>
        <Field>
          <Name>Execution Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>CXA generated day-unique execution identifier of this trade. Execution Id is also referenced in trade breaks.</Description>
        </Field>
        <Field>
          <Name>Total Volume</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Total number of shares executed on the CXA book, or off-exchange reported trades, for the symbol on the current business day (may decrease if the Flags field indicates a trade break).</Description>
        </Field>
        <Field>
          <Name>PID</Name>
          <Type>Alphanumeric</Type>
          <Size>4</Size>
          <Description>Participant ID (right padded with spaces). Blank (spaces) if not attributed.</Description>
        </Field>
        <Field>
          <Name>Contra PID</Name>
          <Type>Alphanumeric</Type>
          <Size>4</Size>
          <Description>Contra Participant ID (right padded with spaces). Blank (spaces) if not attributed.</Description>
        </Field>
        <Field>
          <Name>Trade Type</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Trade type.</Description>
        </Field>
        <Field>
          <Name>Trade Designation</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Trade designation. Valid only for on-exchange executions, space otherwise.</Description>
        </Field>
        <Field>
          <Name>Trade Report Type</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Trade report type. Valid only for off-exchange trade reports, space otherwise.</Description>
        </Field>
        <Field>
          <Name>Trade Transaction Time</Name>
          <Type>Binary UTC Timestamp</Type>
          <Size>8</Size>
          <Description>Nanosecond timestamp of the off-exchange trade as specified in the Trade Report submitted by the trading participant. Valid only for off-exchange trade reports, zero otherwise.</Description>
        </Field>
        <Field>
          <Name>Flags</Name>
          <Type>Bit Field</Type>
          <Size>1</Size>
          <Description>Trade flags bit field.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Calculated Value Message -->
    <Message>
      <Name>Calculated Value Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0xE3</Code>
      <Description>Sent when CXA calculates market values for a specified symbol or when a calculated market value is reported to CXA. The specified symbol may not trade on CXA, but instead could represent index or iNAV values reported to CXA from third parties as indicated by the Value Category field. The index values will be reported on each of the unitised CXA TOP feeds and are not specific to an individual unit. Calculated Value messages will be included in a spin response.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary UTC Timestamp</Type>
          <Size>8</Size>
          <Description>Nanoseconds since epoch.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Printable ASCII</Type>
          <Size>6</Size>
          <Description>Symbol of the calculated value (right padded with spaces).</Description>
        </Field>
        <Field>
          <Name>Value Category</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Category of the calculated value.</Description>
        </Field>
        <Field>
          <Name>Value</Name>
          <Type>Binary Price</Type>
          <Size>8</Size>
          <Description>The calculated value.</Description>
        </Field>
        <Field>
          <Name>Value Timestamp</Name>
          <Type>Binary UTC Timestamp</Type>
          <Size>8</Size>
          <Description>Timestamp when the calculated value was generated in nanoseconds since epoch.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- End of Session Message -->
    <Message>
      <Name>End of Session Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x2D</Code>
      <Description>Sent for each unit when the unit shuts down. No more sequenced messages will be delivered for this unit, but heartbeats from the unit may be received.</Description>
      <Fields>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Reserved (undefined).</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Auction Update Message -->
    <Message>
      <Name>Auction Update Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x95</Code>
      <Description>Sent during Pre-Open and Pre-Close trading states when a symbol has an order update which relates to an overlapping order book (where the best bid price is greater than or equal to the best ask price). Includes the potential number of shares and the indicative auction price if the symbol were to undergo an auction now. Only sent if there are updates to the Buy Shares, Sell Shares, or Indicative Price fields.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary UTC Timestamp</Type>
          <Size>8</Size>
          <Description>Nanoseconds since epoch.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Printable ASCII</Type>
          <Size>6</Size>
          <Description>Symbol (right padded with spaces).</Description>
        </Field>
        <Field>
          <Name>Auction Type</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Auction type.</Description>
        </Field>
        <Field>
          <Name>Buy Shares</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Number of shares on buy side eligible to trade at the auction indicative price.</Description>
        </Field>
        <Field>
          <Name>Sell Shares</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Number of shares on sell side eligible to trade at the auction indicative price.</Description>
        </Field>
        <Field>
          <Name>Indicative Price</Name>
          <Type>Binary Price</Type>
          <Size>8</Size>
          <Description>Indicative Auction Price at which the continuous book would match.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Reserved (undefined).</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Auction Summary Message -->
    <Message>
      <Name>Auction Summary Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x96</Code>
      <Description>Sent at the completion of the Auction per symbol and includes the Auction Price and Shares traded. If there is no overlapping order book at the time of the auction, no auction trades will result, however the Auction Summary message will still be disseminated and contain zeroes in the Price and Shares fields.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary UTC Timestamp</Type>
          <Size>8</Size>
          <Description>Nanoseconds since epoch.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Printable ASCII</Type>
          <Size>6</Size>
          <Description>Symbol (right padded with spaces).</Description>
        </Field>
        <Field>
          <Name>Auction Type</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Auction type.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary Price</Type>
          <Size>8</Size>
          <Description>Auction price.</Description>
        </Field>
        <Field>
          <Name>Shares</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Cumulative number of shares executed during the auction.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Reserved (undefined).</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- Trading Status -->
    <Enum>
      <Name>Trading Status</Name>
      <Values>
        <Value><Data>C</Data><Name>Closed</Name></Value>
        <Value><Data>A</Data><Name>Pre-market</Name></Value>
        <Value><Data>T</Data><Name>Trading</Name></Value>
        <Value><Data>M</Data><Name>MOC Trading</Name></Value>
        <Value><Data>P</Data><Name>Post-market</Name></Value>
        <Value><Data>H</Data><Name>Halted</Name></Value>
        <Value><Data>S</Data><Name>Trading suspended</Name></Value>
        <Value><Data>O</Data><Name>Pre-Open</Name></Value>
        <Value><Data>E</Data><Name>Pre-Close</Name></Value>
      </Values>
    </Enum>

    <!-- Market Id Code -->
    <Enum>
      <Name>Market Id Code</Name>
      <Values>
        <Value><Data>XASX</Data><Name>Australian Stock Market</Name></Value>
        <Value><Data>CXAW</Data><Name>CXA Warrants</Name></Value>
        <Value><Data>CXAE</Data><Name>CXA ETF</Name></Value>
        <Value><Data>CXAQ</Data><Name>CXA QMF</Name></Value>
        <Value><Data>CXAL</Data><Name>CXA Listed</Name></Value>
      </Values>
    </Enum>

    <!-- Side -->
    <Enum>
      <Name>Side</Name>
      <Values>
        <Value><Data>B</Data><Name>Bid side</Name></Value>
        <Value><Data>S</Data><Name>Ask side</Name></Value>
      </Values>
    </Enum>

    <!-- Trade Type -->
    <Enum>
      <Name>Trade Type</Name>
      <Values>
        <Value><Data>B</Data><Name>Broker Preferred Trade</Name></Value>
        <Value><Data>N</Data><Name>Trade resulting from normal matching logic</Name></Value>
        <Value><Data>O</Data><Name>Opening Auction Trade or Intra-day Auction Trade</Name></Value>
        <Value><Data>C</Data><Name>Closing Auction Trade</Name></Value>
        <Value><Data>H</Data><Name>Halt Auction (Re-Opening)</Name></Value>
        <Value><Data>" "</Data><Name>Off-exchange trade report</Name></Value>
      </Values>
    </Enum>

    <!-- Trade Designation -->
    <Enum>
      <Name>Trade Designation</Name>
      <Values>
        <Value><Data>C</Data><Name>CXAC (Limit)</Name></Value>
        <Value><Data>P</Data><Name>CXAP (Mid Point)</Name></Value>
        <Value><Data>N</Data><Name>CXAN (Near Point)</Name></Value>
        <Value><Data>F</Data><Name>CXAF (Far Point)</Name></Value>
        <Value><Data>M</Data><Name>CXAM (MOC)</Name></Value>
        <Value><Data>" "</Data><Name>Not applicable (off-exchange)</Name></Value>
      </Values>
    </Enum>

    <!-- Trade Report Type -->
    <Enum>
      <Name>Trade Report Type</Name>
      <Values>
        <Value><Data>B</Data><Name>Block Trade</Name></Value>
        <Value><Data>P</Data><Name>Large Portfolio Trade</Name></Value>
        <Value><Data>T</Data><Name>Large Principal Transaction</Name></Value>
        <Value><Data>S</Data><Name>Trades with Price Improvement</Name></Value>
        <Value><Data>L</Data><Name>Permitted Trade During Post Trading Hours Period</Name></Value>
        <Value><Data>M</Data><Name>Permitted Trade During Pre Trading Hours Period</Name></Value>
        <Value><Data>E</Data><Name>Out of Hours Trade</Name></Value>
        <Value><Data>F</Data><Name>ETF Trade Report for unit creations or redemptions</Name></Value>
        <Value><Data>" "</Data><Name>Not applicable (on-exchange)</Name></Value>
      </Values>
    </Enum>

    <!-- Value Category -->
    <Enum>
      <Name>Value Category</Name>
      <Values>
        <Value><Data>1</Data><Name>Closing price</Name></Value>
        <Value><Data>2</Data><Name>iNAV values (ETF)</Name></Value>
        <Value><Data>3</Data><Name>Index values</Name></Value>
        <Value><Data>4</Data><Name>EOD NAV from issuer</Name></Value>
      </Values>
    </Enum>

    <!-- Auction Type -->
    <Enum>
      <Name>Auction Type</Name>
      <Values>
        <Value><Data>O</Data><Name>Opening / Intra-day Auction</Name></Value>
        <Value><Data>C</Data><Name>Closing Auction</Name></Value>
        <Value><Data>H</Data><Name>Halt Auction (Re-Opening)</Name></Value>
      </Values>
    </Enum>

  </Enums>

  <Bitfields>

    <!-- Flags -->
    <Bitfield>
      <Name>Flags</Name>
      <Description>Trade flags.</Description>
      <Fields>
        <Field>
          <Name>Trade break</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>0 = Normal trade, 1 = Trade break.</Description>
        </Field>
        <Field>
          <Name>Trade from converted order</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>0 = Normal trade, 1 = Trade from converted order.</Description>
        </Field>
        <Field>
          <Name>Reserved 2-7</Name>
          <Bits>6</Bits>
          <Type>bit</Type>
          <Description>Reserved.</Description>
        </Field>
      </Fields>
    </Bitfield>

  </Bitfields>

</OmiPitchCxaEquitiesPdf>
