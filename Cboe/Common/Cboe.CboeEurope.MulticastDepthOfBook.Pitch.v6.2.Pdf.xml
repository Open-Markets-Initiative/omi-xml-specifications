<OmiCboeEquitiesPitchPdf>

  <!-- Cboe Europe Multicast Depth Of Book Pitch v6.2 -->

  <Messages>

    <!-- Time Message -->
    <Message>
      <Name>Time Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x20</Code>
      <Description>Time</Description>
      <Fields>
        <Field>
          <Name>Time</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Number of whole seconds from midnight London time</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Unit Clear Message -->
    <Message>
      <Name>Unit Clear Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x97</Code>
      <Description>Unit Clear</Description>
      <Fields>
        <Field>
          <Name>Time Offset</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Nanosecond offset from last unit timestamp</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Add Order Long Message -->
    <Message>
      <Name>Add Order Long Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x40</Code>
      <Description>Add Order — Long</Description>
      <Fields>
        <Field>
          <Name>Time Offset</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Nanosecond offset from last unit timestamp</Description>
        </Field>
        <Field>
          <Name>Order Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Day-specific identifier assigned to this order</Description>
        </Field>
        <Field>
          <Name>Side Indicator</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>B = Buy Order S = Sell Order</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Number of shares being added to the book (may be less than the number entered)</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary Long Price</Type>
          <Size>8</Size>
          <Description>The limit order price</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Add Order Short Message -->
    <Message>
      <Name>Add Order Short Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x22</Code>
      <Description>Add Order — Short</Description>
      <Fields>
        <Field>
          <Name>Time Offset</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Nanosecond offset from last unit timestamp</Description>
        </Field>
        <Field>
          <Name>Order Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Day-specific identifier assigned to this order</Description>
        </Field>
        <Field>
          <Name>Side Indicator</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>B = Buy Order S = Sell Order</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Binary</Type>
          <Size>2</Size>
          <Description>Number of shares being added to the book (may be less than the number entered)</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>6</Size>
          <Description>Symbol right padded with spaces</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary Short Price</Type>
          <Size>2</Size>
          <Description>The limit order price</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Add Order Expanded Message -->
    <Message>
      <Name>Add Order Expanded Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x2f</Code>
      <Description>Add Order — Expanded</Description>
      <Fields>
        <Field>
          <Name>Time Offset</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Nanosecond offset from last unit timestamp</Description>
        </Field>
        <Field>
          <Name>Order Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Day-specific identifier assigned to this order</Description>
        </Field>
        <Field>
          <Name>Side Indicator</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Valid values: B = Buy Order S = Sell Order</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Number of shares applicable to this quote.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol, right padded with spaces</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary Long Price</Type>
          <Size>8</Size>
          <Description>The quote price</Description>
        </Field>
        <Field>
          <Name>Add Flags</Name>
          <Type>Bit Field</Type>
          <Size>1</Size>
          <Description>Bit 1 - ‘SI Quote’ indicator. If set, indicates this Add represents an ”SI Quote”. Bits 0, 2-7 - Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>ParticipantID</Name>
          <Type>Alphanumeric</Type>
          <Size>4</Size>
          <Description>Attributes this quote to a particular participant.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Executed Message -->
    <Message>
      <Name>Order Executed Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x23</Code>
      <Description>Order Executed</Description>
      <Fields>
        <Field>
          <Name>Time Offset</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Nanosecond offset from last unit timestamp</Description>
        </Field>
        <Field>
          <Name>Order Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Order Id of a previously send Add Order Message</Description>
        </Field>
        <Field>
          <Name>Executed Shares</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Number of shares executed</Description>
        </Field>
        <Field>
          <Name>Execution Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>BATS Chi-X Europe generated day-unique execution identifier of this execution. Execution Id is also referenced in the Trade Break Message.</Description>
        </Field>
        <Field>
          <Name>Execution Flags</Name>
          <Type>struct</Type>
          <Size>3</Size>
          <Description>Type flags based on MMT v2.0 standard</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Executed at Price/Size Message -->
    <Message>
      <Name>Order Executed at Price/Size Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x24</Code>
      <Description>Order Executed at Price/Size</Description>
      <Fields>
        <Field>
          <Name>Time Offset</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Nanosecond offset from last unit timestamp</Description>
        </Field>
        <Field>
          <Name>Order Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Order Id of a previously send Add Order Message</Description>
        </Field>
        <Field>
          <Name>Executed Shares</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Number of shares executed</Description>
        </Field>
        <Field>
          <Name>Remaining Shares</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Number of shares remaining after the execution</Description>
        </Field>
        <Field>
          <Name>Execution Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>BATS Chi-X Europe generated day-unique execution identifier of this execution. Execution Id is also referenced in the Trade Break Message.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary Long Price</Type>
          <Size>8</Size>
          <Description>The execution price of the order</Description>
        </Field>
        <Field>
          <Name>Execution Flags</Name>
          <Type>struct</Type>
          <Size>3</Size>
          <Description>Type flags based on MMT v2.0 standard</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Reduce Size Long Message -->
    <Message>
      <Name>Reduce Size Long Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x25</Code>
      <Description>Reduce Size — Long</Description>
      <Fields>
        <Field>
          <Name>Time Offset</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Nanosecond offset from last unit timestamp</Description>
        </Field>
        <Field>
          <Name>Order Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Order Id of a previously send Add Order Message</Description>
        </Field>
        <Field>
          <Name>Cancelled Shares</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Number of shares cancelled</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Reduce Size Short Message -->
    <Message>
      <Name>Reduce Size Short Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x26</Code>
      <Description>Reduce Size — Short</Description>
      <Fields>
        <Field>
          <Name>Time Offset</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Nanosecond offset from last unit timestamp</Description>
        </Field>
        <Field>
          <Name>Order Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Order Id of a previously send Add Order Message</Description>
        </Field>
        <Field>
          <Name>Cancelled Shares</Name>
          <Type>Binary</Type>
          <Size>2</Size>
          <Description>Number of shares cancelled</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Modify Order Long Message -->
    <Message>
      <Name>Modify Order Long Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x27</Code>
      <Description>Modify Order — Long</Description>
      <Fields>
        <Field>
          <Name>Time Offset</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Nanosecond offset from last unit timestamp</Description>
        </Field>
        <Field>
          <Name>Order Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Order Id of a previously send Add Order Message</Description>
        </Field>
        <Field>
          <Name>Shares</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Number of shares associated with this order after this modify (may be less than the number of shares entered)</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary Long Price</Type>
          <Size>8</Size>
          <Description>The limit order price after this modify</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Modify Order Short Message -->
    <Message>
      <Name>Modify Order Short Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x28</Code>
      <Description>Modify Order — Short</Description>
      <Fields>
        <Field>
          <Name>Time Offset</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Nanosecond offset from last unit timestamp</Description>
        </Field>
        <Field>
          <Name>Order Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Order Id of a previously send Add Order Message</Description>
        </Field>
        <Field>
          <Name>Shares</Name>
          <Type>Binary</Type>
          <Size>2</Size>
          <Description>Number of shares associated with this order after this modify (may be less than the number of shares entered)</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary Short Price</Type>
          <Size>2</Size>
          <Description>The limit order price after this modify</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Delete Order Message -->
    <Message>
      <Name>Delete Order Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x29</Code>
      <Description>Delete Order</Description>
      <Fields>
        <Field>
          <Name>Time Offset</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Nanosecond offset from last unit timestamp</Description>
        </Field>
        <Field>
          <Name>Order Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Order Id of a previously send Add Order Message</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trade Long Message -->
    <Message>
      <Name>Trade Long Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x41</Code>
      <Description>Trade — Long</Description>
      <Fields>
        <Field>
          <Name>Time Offset</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Nanosecond offset from last unit timestamp</Description>
        </Field>
        <Field>
          <Name>Order Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Obfuscated Order ID or Order ID of the nondisplayed executed order</Description>
        </Field>
        <Field>
          <Name>Side Indicator</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Always B for hidden trades.</Description>
        </Field>
        <Field>
          <Name>Shares</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Incremental number of shares executed</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary Long Price</Type>
          <Size>8</Size>
          <Description>The execution price</Description>
        </Field>
        <Field>
          <Name>Execution Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>BATS Chi-X Europe generated day-unique execution identifier of this trade. Execution Id is also references in the Trade Break Message.</Description>
        </Field>
        <Field>
          <Name>Trade Flags</Name>
          <Type>struct</Type>
          <Size>4</Size>
          <Description>Type flags based on MMT v2.0 standard</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trade Short Message -->
    <Message>
      <Name>Trade Short Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x2B</Code>
      <Description>Trade — Short</Description>
      <Fields>
        <Field>
          <Name>Time Offset</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Nanosecond offset from last unit timestamp</Description>
        </Field>
        <Field>
          <Name>Order Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Obfuscated Order ID or Order ID of the nondisplayed executed order</Description>
        </Field>
        <Field>
          <Name>Side Indicator</Name>
          <Type>Alphanumeric</Type>
