          <Description>Always B for hidden trades.</Description>
        </Field>
        <Field>
          <Name>Shares</Name>
          <Type>Binary</Type>
          <Size>2</Size>
          <Description>Incremental number of shares executed</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>6</Size>
          <Description>Symbol right padded with spaces</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary Short Price</Type>
          <Size>2</Size>
          <Description>The execution price</Description>
        </Field>
        <Field>
          <Name>Execution Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>BATS Chi-X Europe generated day-unique execution identifier of this trade. Execution Id is also references in the Trade Break Message.</Description>
        </Field>
        <Field>
          <Name>Trade Flags</Name>
          <Type>struct</Type>
          <Size>4</Size>
          <Description>Type flags based on MMT v2.0 standard</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trade Break Message -->
    <Message>
      <Name>Trade Break Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x2C</Code>
      <Description>Trade Break</Description>
      <Fields>
        <Field>
          <Name>Time Offset</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Nanosecond offset from last unit timestamp</Description>
        </Field>
        <Field>
          <Name>Execution Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>BATS Chi-X Europe execution identifier of the execution that was broken. Execution Id refers to a previously sent Order Execution or Trade Message.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trade Report Message -->
    <Message>
      <Name>Trade Report Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x32</Code>
      <Description>Trade Report Message</Description>
      <Fields>
        <Field>
          <Name>Time Offset</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Nanosecond offset from last unit timestamp</Description>
        </Field>
        <Field>
          <Name>Shares</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Number of shares executed</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary Long Price</Type>
          <Size>8</Size>
          <Description>The execution price</Description>
        </Field>
        <Field>
          <Name>Trade ID</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>BATS Chi-X Europe generated identifier of this trade. This identifier is guaranteed to be unique for at least 7 calendar days.</Description>
        </Field>
        <Field>
          <Name>Trade timestamp</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Date/Time on which the trade occurred, encoded as the number of nanoseconds since the January 1st 1970 UTC (also known as the Unix epoch).</Description>
        </Field>
        <Field>
          <Name>Execution Venue</Name>
          <Type>Alphanumeric</Type>
          <Size>4</Size>
          <Description>The venue on which the trade executed, when applicable. This will contain the MIC representing the venue on which the trade occurred, where applicable. e.g. for BATS Chi-X Europe NT trades, this shall be BATE or CHIX as applicable. Where no MIC is applicable, this field will be blank. A special value of AUT can be used to identify OTC trades executed in an automated manner.</Description>
        </Field>
        <Field>
          <Name>Currency</Name>
          <Type>Alphanumeric</Type>
          <Size>3</Size>
          <Description>Traded currency.</Description>
        </Field>
        <Field>
          <Name>Trade Report Flags</Name>
          <Type>struct</Type>
          <Size>11</Size>
          <Description>Type flags based on the MMT v2.0 standard.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- End of Session Message -->
    <Message>
      <Name>End of Session Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x2D</Code>
      <Description>End of Session</Description>
