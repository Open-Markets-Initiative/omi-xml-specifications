<OmiPitchEquitiesPdf>

  <Messages>

    <!-- Symbol Clear Message -->
    <Message>
      <Name>Symbol Clear Message</Name>
      <Branch>sequencedmessage</Branch>
      <Dependency>sequencedmessagetype</Dependency>
      <Code>h</Code>
      <Description>Instructs feed recipients to clear all orders for the Cboe book in the specified symbol; sent in recovery events such as a data centre fail-over.</Description>
      <Fields>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Add Order Message -->
    <Message>
      <Name>Add Order Message</Name>
      <Branch>sequencedmessage</Branch>
      <Dependency>sequencedmessagetype</Dependency>
      <Code>K</Code>
      <Description>Represents a newly accepted visible order on the Cboe book with a day-specific Order ID.</Description>
      <Fields>
        <Field>
          <Name>Order ID</Name>
          <Type>Base 36 Numeric</Type>
          <Size>12</Size>
          <Description>Day-specific identifier assigned to this order.</Description>
        </Field>
        <Field>
          <Name>Side Indicator</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>B = Buy, S = Sell</Description>
        </Field>
        <Field>
          <Name>Shares</Name>
          <Type>Numeric</Type>
          <Size>6</Size>
          <Description>Number of shares being added to the book.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>6</Size>
          <Description>Symbol right padded with spaces. Common Symbology Format.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Price</Type>
          <Size>10</Size>
          <Description>Order price.</Description>
        </Field>
        <Field>
          <Name>Display</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Always Y. Maintained for compatibility reasons.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Add Order Message Long Form -->
    <Message>
      <Name>Add Order Message Long Form</Name>
      <Branch>sequencedmessage</Branch>
      <Dependency>sequencedmessagetype</Dependency>
      <Code>M</Code>
      <Description>Cboe European platform only. As Add Order Message but with longer Shares, Symbol and Price fields.</Description>
      <Fields>
        <Field>
          <Name>Order ID</Name>
          <Type>Base 36 Numeric</Type>
          <Size>12</Size>
          <Description>Day-specific identifier assigned to this order.</Description>
        </Field>
        <Field>
          <Name>Side Indicator</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>B = Buy, S = Sell</Description>
        </Field>
        <Field>
          <Name>Shares</Name>
          <Type>Numeric</Type>
          <Size>10</Size>
          <Description>Number of shares being added to the book.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces. Common Symbology Format.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Long Price</Type>
          <Size>19</Size>
          <Description>Order price (long format).</Description>
        </Field>
        <Field>
          <Name>Display</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Always Y. Maintained for compatibility reasons.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Executed Message -->
    <Message>
      <Name>Order Executed Message</Name>
      <Branch>sequencedmessage</Branch>
      <Dependency>sequencedmessagetype</Dependency>
      <Code>N</Code>
      <Description>Sent when a visible order on the Cboe book is executed in whole or in part at the original Add Order price.</Description>
      <Fields>
        <Field>
          <Name>Order ID</Name>
          <Type>Base 36 Numeric</Type>
          <Size>12</Size>
          <Description>Order ID of a previously sent Add Order Message.</Description>
        </Field>
        <Field>
          <Name>Executed Shares</Name>
          <Type>Numeric</Type>
          <Size>6</Size>
          <Description>Number of shares executed.</Description>
        </Field>
        <Field>
          <Name>Execution ID</Name>
          <Type>Base 36 Numeric</Type>
          <Size>12</Size>
          <Description>Cboe generated day-unique execution identifier.</Description>
        </Field>
        <Field>
          <Name>Execution Flag</Name>
          <Type>Alphanumeric</Type>
          <Size>4</Size>
          <Description>Type flags based on MMT standard.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Executed Message Long Form -->
    <Message>
      <Name>Order Executed Message Long Form</Name>
      <Branch>sequencedmessage</Branch>
      <Dependency>sequencedmessagetype</Dependency>
      <Code>g</Code>
      <Description>Cboe European platform only. As Order Executed Message but with a longer Executed Shares field.</Description>
      <Fields>
        <Field>
          <Name>Order ID</Name>
          <Type>Base 36 Numeric</Type>
          <Size>12</Size>
          <Description>Order ID of a previously sent Add Order Message.</Description>
        </Field>
        <Field>
          <Name>Executed Shares</Name>
          <Type>Numeric</Type>
          <Size>10</Size>
          <Description>Number of shares executed.</Description>
        </Field>
        <Field>
          <Name>Execution ID</Name>
          <Type>Base 36 Numeric</Type>
          <Size>12</Size>
          <Description>Cboe generated day-unique execution identifier.</Description>
        </Field>
        <Field>
          <Name>Execution Flags</Name>
          <Type>Alphanumeric</Type>
          <Size>4</Size>
          <Description>Type flags based on MMT standard.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Cancel Message -->
    <Message>
      <Name>Order Cancel Message</Name>
      <Branch>sequencedmessage</Branch>
      <Dependency>sequencedmessagetype</Dependency>
      <Code>F</Code>
      <Description>Sent when a visible order on the Cboe book is cancelled in whole or in part.</Description>
      <Fields>
        <Field>
          <Name>Order ID</Name>
          <Type>Base 36 Numeric</Type>
          <Size>12</Size>
          <Description>Order ID of a previously sent Add Order Message.</Description>
        </Field>
        <Field>
          <Name>Cancelled Shares</Name>
          <Type>Numeric</Type>
          <Size>6</Size>
          <Description>Number of shares cancelled.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Cancel Message Long Form -->
    <Message>
      <Name>Order Cancel Message Long Form</Name>
      <Branch>sequencedmessage</Branch>
      <Dependency>sequencedmessagetype</Dependency>
      <Code>G</Code>
      <Description>Cboe European platform only. As Order Cancel Message but with a longer Cancelled Shares field.</Description>
      <Fields>
        <Field>
          <Name>Order ID</Name>
          <Type>Base 36 Numeric</Type>
          <Size>12</Size>
          <Description>Order ID of a previously sent Add Order Message.</Description>
        </Field>
        <Field>
          <Name>Cancelled Shares</Name>
          <Type>Numeric</Type>
          <Size>10</Size>
          <Description>Number of shares cancelled.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trade Message -->
    <Message>
      <Name>Trade Message</Name>
      <Branch>sequencedmessage</Branch>
      <Dependency>sequencedmessagetype</Dependency>
      <Code>V</Code>
      <Description>Provides information about executions of non-displayed orders/shares and negotiated trades. Does not alter the book.</Description>
      <Fields>
        <Field>
          <Name>Order ID</Name>
          <Type>Base 36 Numeric</Type>
          <Size>12</Size>
          <Description>Obfuscated Order ID or Order ID of the invisible order or negotiated trade.</Description>
        </Field>
        <Field>
          <Name>Side Indicator</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Always B.</Description>
        </Field>
        <Field>
          <Name>Shares</Name>
          <Type>Numeric</Type>
          <Size>6</Size>
          <Description>Incremental number of shares executed.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alpha</Type>
          <Size>6</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Price</Type>
          <Size>10</Size>
          <Description>Execution price of the fill.</Description>
        </Field>
        <Field>
          <Name>Execution ID</Name>
          <Type>Base 36 Numeric</Type>
          <Size>12</Size>
          <Description>Cboe generated day-unique execution identifier.</Description>
        </Field>
        <Field>
          <Name>Trade Flags</Name>
          <Type>Alphanumeric</Type>
          <Size>5</Size>
          <Description>Type flags based on MMT standard.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trade Message Long Form -->
    <Message>
      <Name>Trade Message Long Form</Name>
      <Branch>sequencedmessage</Branch>
      <Dependency>sequencedmessagetype</Dependency>
      <Code>W</Code>
      <Description>Cboe European platform only. As Trade Message but with longer Shares and Price fields.</Description>
      <Fields>
        <Field>
          <Name>Order ID</Name>
          <Type>Base 36 Numeric</Type>
          <Size>12</Size>
          <Description>Obfuscated Order ID or Order ID of the invisible order or negotiated trade.</Description>
        </Field>
        <Field>
          <Name>Side Indicator</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Always B.</Description>
        </Field>
        <Field>
          <Name>Shares</Name>
          <Type>Numeric</Type>
          <Size>10</Size>
          <Description>Incremental number of shares executed.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alpha</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Long Price</Type>
          <Size>19</Size>
          <Description>Execution price (long format) of the fill.</Description>
        </Field>
        <Field>
          <Name>Execution ID</Name>
          <Type>Base 36 Numeric</Type>
          <Size>12</Size>
          <Description>Cboe generated day-unique execution identifier.</Description>
        </Field>
        <Field>
          <Name>Trade Flags</Name>
          <Type>Alphanumeric</Type>
          <Size>5</Size>
          <Description>Type flags based on MMT standard.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trade Message Extended Form -->
    <Message>
      <Name>Trade Message Extended Form</Name>
      <Branch>sequencedmessage</Branch>
      <Dependency>sequencedmessagetype</Dependency>
      <Code>v</Code>
      <Description>Cboe European platform only. Extended details of trades reported to or executed by Cboe (e.g. privately negotiated trades brought on-exchange).</Description>
      <Fields>
        <Field>
          <Name>Shares</Name>
          <Type>Numeric</Type>
          <Size>12</Size>
          <Description>Number of shares executed.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Long Price</Type>
          <Size>19</Size>
          <Description>Execution price of the fill; may be zero if pending.</Description>
        </Field>
        <Field>
          <Name>Trade ID</Name>
          <Type>Base 36 Numeric</Type>
          <Size>12</Size>
          <Description>Cboe generated identifier, unique for at least 7 calendar days.</Description>
        </Field>
        <Field>
          <Name>Trade Date</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Date the trade occurred, YYYYMMDD.</Description>
        </Field>
        <Field>
          <Name>Trade Time</Name>
          <Type>Timestamp</Type>
          <Size>8</Size>
          <Description>Milliseconds since midnight London time on Trade Date.</Description>
        </Field>
        <Field>
          <Name>Execution Venue</Name>
          <Type>Alphanumeric</Type>
          <Size>4</Size>
          <Description>MIC of the venue on which the trade executed (LISX/LISZ/XWAP/VWAP/SINT/XOFF...).</Description>
        </Field>
        <Field>
          <Name>Currency</Name>
          <Type>Alphanumeric</Type>
          <Size>3</Size>
          <Description>Traded currency.</Description>
        </Field>
        <Field>
          <Name>Cboe Trade Flags</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Cboe trade timing / regulated entity flags.</Description>
        </Field>
        <Field>
          <Name>Extended Trade Flags</Name>
          <Type>Alphanumeric</Type>
          <Size>14</Size>
          <Description>Type flags based on the MMT standard.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trade Message Unknown Symbol -->
    <Message>
      <Name>Trade Message Unknown Symbol</Name>
      <Branch>sequencedmessage</Branch>
      <Dependency>sequencedmessagetype</Dependency>
      <Code>w</Code>
      <Description>Cboe European Trade Reporting Facility only. Trades reported to Cboe on a symbol not currently known, identified by ISIN and currency.</Description>
      <Fields>
        <Field>
          <Name>Shares</Name>
          <Type>Numeric</Type>
          <Size>12</Size>
          <Description>Number of shares traded.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>12</Size>
          <Description>Symbol in ISIN.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Long Price</Type>
          <Size>19</Size>
          <Description>Reported price of the trade; may be zero if pending.</Description>
        </Field>
        <Field>
          <Name>Trade ID</Name>
          <Type>Base 36 Numeric</Type>
          <Size>12</Size>
          <Description>Cboe generated identifier, unique for at least 7 calendar days.</Description>
        </Field>
        <Field>
          <Name>Trade Date</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Date the trade occurred, YYYYMMDD.</Description>
        </Field>
        <Field>
          <Name>Trade Time</Name>
          <Type>Timestamp</Type>
          <Size>8</Size>
          <Description>Milliseconds since midnight London time on Trade Date.</Description>
        </Field>
        <Field>
          <Name>Execution Venue</Name>
          <Type>Alphanumeric</Type>
          <Size>4</Size>
          <Description>MIC of the execution venue (SINT/XOFF/third-country).</Description>
        </Field>
        <Field>
          <Name>Currency</Name>
          <Type>Alphanumeric</Type>
          <Size>3</Size>
          <Description>Reported currency.</Description>
        </Field>
        <Field>
          <Name>Cboe Trade Flags</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Cboe trade timing / regulated entity flags.</Description>
        </Field>
        <Field>
          <Name>Extended Trade Flags</Name>
          <Type>Alphanumeric</Type>
          <Size>14</Size>
          <Description>Type flags based on the MMT standard.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trading Status Message -->
    <Message>
      <Name>Trading Status Message</Name>
      <Branch>sequencedmessage</Branch>
      <Dependency>sequencedmessagetype</Dependency>
      <Code>a</Code>
      <Description>Indicates the current trading status of a security; sent whenever the status changes and for all Suspended securities before trading hours.</Description>
      <Fields>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Status</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>T=Trading R=Off-Book Reporting C=Closed S=Suspended N=No Reference Price V=Volatility(Static Collar) I=Volatility Auction O=Opening Auction E=Closing Auction H=Halt M=Market Order Imbalance P=Price Monitoring Extension U=Cboe Closing Cross Y=Halt Auction</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Alpha</Type>
          <Size>3</Size>
          <Description>Reserved</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Statistics Message -->
    <Message>
      <Name>Statistics Message</Name>
      <Branch>sequencedmessage</Branch>
      <Dependency>sequencedmessagetype</Dependency>
      <Code>Y</Code>
      <Description>Cboe European platform only. Disseminates statistics prices: opening, closing, high, low, previous close.</Description>
      <Fields>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Long Price</Type>
          <Size>19</Size>
          <Description>Price.</Description>
        </Field>
        <Field>
          <Name>Statistic Type</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>C=Closing H=High L=Low O=Opening P=Previous Closing Price</Description>
        </Field>
        <Field>
          <Name>Price Determination</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>0=Normal 1=Manual (price override by Market Supervision)</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Auction Update Message -->
    <Message>
      <Name>Auction Update Message</Name>
      <Branch>sequencedmessage</Branch>
      <Dependency>sequencedmessagetype</Dependency>
      <Code>b</Code>
      <Description>Disseminates indicative price and size information during auctions for Cboe auction-eligible securities.</Description>
      <Fields>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Auction Type</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>O=Opening C=Closing H=Halt V=Volatility P=Periodic U=Cboe Closing Cross</Description>
        </Field>
        <Field>
          <Name>Reference Price</Name>
          <Type>Long Price</Type>
          <Size>19</Size>
          <Description>Reference price used in tie-breaker situations.</Description>
        </Field>
        <Field>
          <Name>Indicative Price</Name>
          <Type>Long Price</Type>
          <Size>19</Size>
          <Description>Price at which the auction would match if executed now.</Description>
        </Field>
        <Field>
          <Name>Indicative Shares</Name>
          <Type>Numeric</Type>
          <Size>10</Size>
          <Description>Number of shares at the Indicative Price.</Description>
        </Field>
        <Field>
          <Name>Outside Tolerance</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>O=Outside tolerance I=Inside tolerance -=Not specified</Description>
        </Field>
        <Field>
          <Name>Includes Primary</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>P=Includes Primary N=Excludes Primary -=Not specified</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Auction Summary Message -->
    <Message>
      <Name>Auction Summary Message</Name>
      <Branch>sequencedmessage</Branch>
      <Dependency>sequencedmessagetype</Dependency>
      <Code>f</Code>
      <Description>Disseminates the results of an auction in a Cboe auction-eligible security.</Description>
      <Fields>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Auction Type</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>O=Opening C=Closing H=Halt V=Volatility P=Periodic U=Cboe Closing Cross</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Long Price</Type>
          <Size>19</Size>
          <Description>Auction price.</Description>
        </Field>
        <Field>
          <Name>Shares</Name>
          <Type>Numeric</Type>
          <Size>10</Size>
          <Description>Cumulative number of shares executed during the auction.</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

</OmiPitchEquitiesPdf>
