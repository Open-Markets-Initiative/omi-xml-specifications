<OmiPitchEquitiesPdf>

  <!-- Cboe Europe Last Sale Ascii Pitch v1.3 -->

  <Messages>

    <Message>
      <Name>Last Sale Europe Message</Name>
      <Branch>sequencedmessage</Branch>
      <Dependency>sequencedmessagetype</Dependency>
      <Code>u</Code>
      <Description>Last Sale Europe Messages are sent when an order on a Cboe order book is executed in whole or in part, or when a reported trade is submitted to Cboe</Description>
      <Fields>
        <Field>
          <Name>Trading Date Time</Name>
          <Type>ISO DateTime</Type>
          <Size>27</Size>
          <Description>Date and time the trade occurred</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>12</Size>
          <Description>ISIN Code that identifies the financial instrument</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Numeric Price</Type>
          <Size>18</Size>
          <Description>Price of the trade. This may be zero if the price is pending, as denoted by the “Price Discovery Process” field</Description>
        </Field>
        <Field>
          <Name>Price Currency</Name>
          <Type>Alpha</Type>
          <Size>3</Size>
          <Description>ISO 3-letter Currency code</Description>
        </Field>
        <Field>
          <Name>Executed Shares</Name>
          <Type>Numeric</Type>
          <Size>12</Size>
          <Description>Number of shares executed</Description>
        </Field>
        <Field>
          <Name>Execution Venue</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>ISO 10383 segment MIC, and SINT for Systematic internalisers, XOFF for OTC trades</Description>
        </Field>
        <Field>
          <Name>Publication Date Time</Name>
          <Type>ISO DateTime</Type>
          <Size>27</Size>
          <Description>Date and time the trade was published</Description>
        </Field>
        <Field>
          <Name>Trade ID</Name>
          <Type>Base 36 Numeric</Type>
          <Size>12</Size>
          <Description>Cboe generated day-unique execution/trade identifier</Description>
        </Field>
        <Field>
          <Name>Transaction Category</Name>
          <Type>Alpha Flag</Type>
          <Size>4</Size>
          <Description>Corresponds to MMT v3 Level 3.1</Description>
        </Field>
        <Field>
          <Name>Negotiation Flag</Name>
          <Type>Alpha Flag</Type>
          <Size>4</Size>
          <Description>Corresponds to MMT v3 Level 3.2</Description>
        </Field>
        <Field>
          <Name>Agency Cross Trade</Name>
          <Type>Alpha Flag</Type>
          <Size>4</Size>
          <Description>Corresponds to MMT v3 Level 3.3</Description>
        </Field>
        <Field>
          <Name>Modification Indicator</Name>
          <Type>Alpha Flag</Type>
          <Size>4</Size>
          <Description>Corresponds to MMT v3 Level 3.4</Description>
        </Field>
        <Field>
          <Name>Benchmark/Reference Indicator</Name>
          <Type>Alpha Flag</Type>
          <Size>4</Size>
          <Description>Corresponds to MMT v3 Level 3.5</Description>
        </Field>
        <Field>
          <Name>Special Dividend</Name>
          <Type>Alpha Flag</Type>
          <Size>4</Size>
          <Description>Corresponds to MMT v3 Level 3.6</Description>
        </Field>
        <Field>
          <Name>Price Discovery Process</Name>
          <Type>Alpha Flag</Type>
          <Size>4</Size>
          <Description>Corresponds to MMT v3 Level 3.8</Description>
        </Field>
        <Field>
          <Name>Algorithmic Indicator</Name>
          <Type>Alpha Flag</Type>
          <Size>4</Size>
          <Description>Corresponds to MMT v3 Level 3.9</Description>
        </Field>
        <Field>
          <Name>Post-Trade Deferral Reason</Name>
          <Type>Alpha Flag</Type>
          <Size>4</Size>
          <Description>Corresponds to MMT v3 Level 4.1</Description>
        </Field>
        <Field>
          <Name>Duplicative Indicator</Name>
          <Type>Alpha Flag</Type>
          <Size>4</Size>
          <Description>Corresponds to MMT v3 Level 5</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Structs>

    <Struct>
      <Name>Sequenced Message Header</Name>
      <Description>Sequenced Message Header</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Timestamp</Type>
          <Size>8</Size>
          <Description>Timestamp</Description>
        </Field>
        <Field>
          <Name>Sequenced Message Type</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Alphanumeric</Description>
        </Field>
      </Fields>
    <Characteristic>
      <Category>Header</Category>
      <Value>Message</Value>
    </Characteristic>
    </Struct>

  </Structs>

</OmiPitchEquitiesPdf>
