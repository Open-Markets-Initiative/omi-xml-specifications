<OmiPitchOptionsPdf>

  <Messages>

    <!-- Short Symbol Summary Message -->
    <Message>
      <Name>Short Symbol Summary Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Origin>Exchange</Origin>
      <Code>0xA4</Code>
      <Description>The Short Symbol Summary message delivers the Cboe consolidated best bid/offer and total executed volume across all applicable Cboe One Options books.</Description>
      <Fields>
        <Field>
          <Name>Last Update Timestamp</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Timestamp of the last matching engine message that updated the quote information for this symbol in the Cboe One Options server's cache. Encoded as the number of nanoseconds since midnight.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Cboe Cumulative Executed Volume</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Cumulative number of shares traded today across all applicable Cboe books.</Description>
        </Field>
        <Field>
          <Name>Consolidated Best Bid Price</Name>
          <Type>Binary 4.4 Price</Type>
          <Size>4</Size>
          <Description>Titanium Options best bid price.</Description>
        </Field>
        <Field>
          <Name>Consolidated Best Bid Quantity</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Titanium Options number of buy-side shares available for this symbol.</Description>
        </Field>
        <Field>
          <Name>Consolidated Best Ask Price</Name>
          <Type>Binary 4.4 Price</Type>
          <Size>4</Size>
          <Description>Titanium Options best ask price.</Description>
        </Field>
        <Field>
          <Name>Consolidated Best Ask Quantity</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Titanium Options number of sell-side shares available for this symbol.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary</Type>
          <Size>5</Size>
          <Description>Reserved.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Long Symbol Summary Message -->
    <Message>
      <Name>Long Symbol Summary Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Origin>Exchange</Origin>
      <Code>0xA3</Code>
      <Description>The Long Symbol Summary message delivers the Cboe consolidated best bid/offer and total executed volume across all applicable Cboe One Options books.</Description>
      <Fields>
        <Field>
          <Name>Last Update Timestamp</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Timestamp of the last matching engine message that updated the quote information for this symbol in the Cboe One Options server's cache. Encoded as the number of nanoseconds since midnight.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Cboe Cumulative Executed Volume</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Cumulative number of shares traded today across all applicable Cboe books.</Description>
        </Field>
        <Field>
          <Name>Consolidated Best Bid Price</Name>
          <Type>Binary 8.4 Price</Type>
          <Size>8</Size>
          <Description>Titanium Options best bid price.</Description>
        </Field>
        <Field>
          <Name>Consolidated Best Bid Quantity</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Titanium Options number of buy-side shares available for this symbol.</Description>
        </Field>
        <Field>
          <Name>Consolidated Best Ask Price</Name>
          <Type>Binary 8.4 Price</Type>
          <Size>8</Size>
          <Description>Titanium Options best ask price.</Description>
        </Field>
        <Field>
          <Name>Consolidated Best Ask Quantity</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Titanium Options number of sell-side shares available for this symbol.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary</Type>
          <Size>9</Size>
          <Description>Reserved.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Best Quote Update Message -->
    <Message>
      <Name>Best Quote Update Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Origin>Exchange</Origin>
      <Code>0xA5</Code>
      <Description>The Best Quote Update message is used to update one side of the Cboe consolidated quote information for a symbol. Since the message only updates one side of the quote, the previous value for the other side of the quote remains in effect. This message does not affect the executed volume of the symbol.</Description>
      <Fields>
        <Field>
          <Name>Last Update Timestamp</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Timestamp of the last matching engine message that updated the quote information for this symbol in the Cboe One Options server's cache. Encoded as the number of nanoseconds since midnight.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Side Indicator</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Side indicator.</Description>
        </Field>
        <Field>
          <Name>Consolidated Best Quote Price</Name>
          <Type>Binary 8.4 Price</Type>
          <Size>8</Size>
          <Description>Titanium Options best price.</Description>
        </Field>
        <Field>
          <Name>Consolidated Quote Quantity</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Titanium Options number of shares available for this symbol.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Cboe Market Status Message -->
    <Message>
      <Name>Cboe Market Status Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Origin>Exchange</Origin>
      <Code>0xA6</Code>
      <Description>The Cboe Market Status message is disseminated to reflect a change in the status of a market. All markets should be assumed to be Normal unless otherwise indicated by a Cboe Market Status message.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Timestamp of when the Market Status changed for the specified Market Center. Encoded as the number of nanoseconds since midnight.</Description>
        </Field>
        <Field>
          <Name>Market Center</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Market Center identifier.</Description>
        </Field>
        <Field>
          <Name>Market Status</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Market status indicator.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Reserved.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trade Message -->
    <Message>
      <Name>Trade Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Origin>Exchange</Origin>
      <Code>0xA9</Code>
      <Description>Trade messages are sent when an order is executed in whole or in part on a Cboe exchange.</Description>
      <Fields>
        <Field>
          <Name>Transaction Time</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>The time the trade occurred on the specified Market Center. Encoded as the number of nanoseconds since midnight.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Market Center</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Market Center on which the last trade was executed.</Description>
        </Field>
        <Field>
          <Name>Market Center Execution ID</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Market center specific execution identifier of this Execution. Execution ID is also referenced in the Trade Break message.</Description>
        </Field>
        <Field>
          <Name>Last Price</Name>
          <Type>Binary 8.4 Price</Type>
          <Size>8</Size>
          <Description>Last trade price.</Description>
        </Field>
        <Field>
          <Name>Last Quantity</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Last trade quantity.</Description>
        </Field>
        <Field>
          <Name>Cboe Cumulative Executed Volume</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Cumulative number of shares traded today across all applicable books.</Description>
        </Field>
        <Field>
          <Name>Trade Condition</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Options trade condition code.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Reserved.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trade Break Message -->
    <Message>
      <Name>Trade Break Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Origin>Exchange</Origin>
      <Code>0xAA</Code>
      <Description>The Trade Break message is sent whenever an execution on a Cboe exchange is broken. Trade breaks are rare and only affect applications that rely upon Cboe execution based data.</Description>
      <Fields>
        <Field>
          <Name>Transaction Time</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>The time the trade break occurred on the specified Market Center. Encoded as the number of nanoseconds since midnight.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Market Center</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Market Center on which the last trade was executed.</Description>
        </Field>
        <Field>
          <Name>Market Center Execution ID</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Market center specific execution identifier of trade to be broken.</Description>
        </Field>
        <Field>
          <Name>Cboe Cumulative Executed Volume</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Cumulative number of shares traded today across all applicable Cboe books.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary</Type>
          <Size>9</Size>
          <Description>Reserved.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trading Status Message -->
    <Message>
      <Name>Trading Status Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Origin>Exchange</Origin>
      <Code>0xAB</Code>
      <Description>The Trading Status message is used to indicate the current trading status of an options contract on a Cboe exchange.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Timestamp of the matching engine trading status message emitted by the specified Market Center. Encoded as the number of nanoseconds since midnight.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Market Center</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Market Center identifier.</Description>
        </Field>
        <Field>
          <Name>Halt Status</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Trading halt status indicator.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Reserved.</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- Market Center -->
    <Enum>
      <Name>Market Center</Name>
      <Values>
        <Value><Data>B</Data><Name>C1</Name></Value>
        <Value><Data>W</Data><Name>C2</Name></Value>
        <Value><Data>X</Data><Name>EDGX</Name></Value>
        <Value><Data>Z</Data><Name>BZX</Name></Value>
      </Values>
    </Enum>

    <!-- Side Indicator -->
    <Enum>
      <Name>Side Indicator</Name>
      <Values>
        <Value><Data>B</Data><Name>Buy Side</Name></Value>
        <Value><Data>S</Data><Name>Sell Side</Name></Value>
      </Values>
    </Enum>

    <!-- Market Status -->
    <Enum>
      <Name>Market Status</Name>
      <Values>
        <Value><Data>N</Data><Name>Normal</Name></Value>
        <Value><Data>E</Data><Name>Excluded from Symbol Summary updates</Name></Value>
        <Value><Data>I</Data><Name>Incomplete</Name></Value>
