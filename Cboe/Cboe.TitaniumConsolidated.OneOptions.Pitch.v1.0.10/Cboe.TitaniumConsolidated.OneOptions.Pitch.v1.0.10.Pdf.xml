        <Value><Data>p</Data><Name>Complex with Stock Floor Trade</Name></Value>
        <Value><Data>t</Data><Name>Complex Floor Trade of Proprietary Products Marked as Combo Order</Name></Value>
        <Value><Data>u</Data><Name>Multilateral Compression Trade of Proprietary Products</Name></Value>
        <Value><Data>v</Data><Name>Extended Hours Trade</Name></Value>
        <Value><Data>l</Data><Name>Electronic Trade</Name></Value>
        <Value><Data>K</Data><Name>Cabinet Order</Name></Value>
