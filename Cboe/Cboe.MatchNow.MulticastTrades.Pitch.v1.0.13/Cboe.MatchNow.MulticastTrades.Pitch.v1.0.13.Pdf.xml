<OmiPitchEquitiesPdf>

  <Messages>

    <!-- Unit Clear Message -->
    <Message>
      <Name>Unit Clear Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x97</Code>
      <Description>Instructs feed recipients to clear all orders for the Cboe Canada order book in the unit specified in the Sequenced Unit Header. Distributed in rare recovery events such as a data center fail-over.</Description>
      <Fields>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Reserved (undefined).</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trading Status Message -->
    <Message>
      <Name>Trading Status Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x43</Code>
      <Description>Indicates the current trading status of a security in the MATCHNow system (9:30 a.m. - 4:00 p.m. ET). Sequenced Trading Status messages are sent upon system startup for all active securities with Trading Status = S (suspended).</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary Time</Type>
          <Size>8</Size>
          <Description>Time the message was generated.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>14</Size>
          <Description>Symbol (right padded with spaces).</Description>
        </Field>
        <Field>
          <Name>Listing Exchange</Name>
          <Type>Alphanumeric</Type>
          <Size>4</Size>
          <Description>Exchange codes of the listing exchange.</Description>
        </Field>
        <Field>
          <Name>Trading Status</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Current trading status code.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary</Type>
          <Size>3</Size>
          <Description>Reserved (undefined).</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trade Message -->
    <Message>
      <Name>Trade Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x42</Code>
      <Description>Sends the trade price, trade quantity, execution id, and trade condition of a trade as well as the cumulative volume for the trading session. A Trade message will be sent for each execution, but not every Trade message indicates a trade. Trade Condition = X (Trade Break) is sent whenever an execution is broken.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary Time</Type>
          <Size>8</Size>
          <Description>Time the message was generated.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>14</Size>
          <Description>Symbol (right padded with spaces).</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Incremental number of shares executed or reported (see Trade Condition).</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary Price</Type>
          <Size>8</Size>
          <Description>The price of the trade.</Description>
        </Field>
        <Field>
          <Name>Execution Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>MATCHNow generated day-unique execution identifier of this execution. Execution Id is also referenced in the Trade Break message (Trade Condition 'X').</Description>
        </Field>
        <Field>
          <Name>Buy Broker Number</Name>
          <Type>Binary</Type>
          <Size>2</Size>
          <Description>Broker number of the buyer of the trade (or 1 for anonymous).</Description>
        </Field>
        <Field>
          <Name>Sell Broker Number</Name>
          <Type>Binary</Type>
          <Size>2</Size>
          <Description>Broker number of the seller of the trade (or 1 for anonymous).</Description>
        </Field>
        <Field>
          <Name>Total Volume</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Total number of shares traded in this symbol during the current trading session (may decrease if the Trade Condition field indicates a trade break).</Description>
        </Field>
        <Field>
          <Name>Trade Condition</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Trade condition code.</Description>
        </Field>
        <Field>
          <Name>Trade Flags</Name>
          <Type>Bit Field</Type>
          <Size>1</Size>
          <Description>Trade flags bit field.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary</Type>
          <Size>2</Size>
          <Description>Reserved (undefined).</Description>
        </Field>
      </Fields>
    </Message>

    <!-- End of Session Message -->
    <Message>
      <Name>End of Session Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x2D</Code>
      <Description>Sent for each unit when the unit shuts down. No additional sequenced messages will be delivered for this unit, but heartbeats from the unit may be received.</Description>
      <Fields>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Reserved (undefined).</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- Listing Exchange -->
    <Enum>
      <Name>Listing Exchange</Name>
      <Values>
        <Value><Data>TSX</Data><Name>Toronto Stock Exchange</Name></Value>
        <Value><Data>TSXV</Data><Name>TSX Venture Exchange</Name></Value>
        <Value><Data>CSE</Data><Name>Canadian Securities Exchange</Name></Value>
        <Value><Data>NEOL</Data><Name>Cboe Canada NEO-L</Name></Value>
      </Values>
    </Enum>

    <!-- Trading Status -->
    <Enum>
      <Name>Trading Status</Name>
      <Values>
        <Value><Data>A</Data><Name>Accepting</Name></Value>
        <Value><Data>H</Data><Name>Halted</Name></Value>
        <Value><Data>S</Data><Name>Trading Suspended</Name></Value>
        <Value><Data>T</Data><Name>Trading</Name></Value>
      </Values>
    </Enum>

    <!-- Trade Condition -->
    <Enum>
      <Name>Trade Condition</Name>
      <Values>
        <Value><Data>" "</Data><Name>Regular Trade</Name></Value>
        <Value><Data>X</Data><Name>Trade Break</Name></Value>
      </Values>
    </Enum>

  </Enums>

  <Bitfields>

    <!-- Trade Flags -->
    <Bitfield>
      <Name>Trade Flags</Name>
      <Description>Trade flags.</Description>
      <Fields>
        <Field>
          <Name>Conditional</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>0 = Regular Trade, 1 = Conditional Trade.</Description>
        </Field>
        <Field>
          <Name>Odd Lot</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>0 = Regular Trade, 1 = Odd Lot Trade.</Description>
        </Field>
        <Field>
          <Name>Reserved 2-7</Name>
          <Bits>6</Bits>
          <Type>bit</Type>
          <Description>Reserved.</Description>
        </Field>
      </Fields>
    </Bitfield>

  </Bitfields>

</OmiPitchEquitiesPdf>
