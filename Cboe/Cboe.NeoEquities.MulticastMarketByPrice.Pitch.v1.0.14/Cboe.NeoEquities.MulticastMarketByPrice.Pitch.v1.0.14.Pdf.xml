<OmiPitchEquitiesPdf>

  <Messages>

    <!-- Unit Clear Message -->
    <Message>
      <Name>Unit Clear Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x97</Code>
      <Description>Instructs feed recipients to clear all orders for the Cboe Canada order book in the unit specified in the Sequenced Unit Header. Distributed in rare recovery events such as a data center fail-over.</Description>
      <Fields>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Reserved (undefined).</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Instrument Directory Message -->
    <Message>
      <Name>Instrument Directory Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x60</Code>
      <Description>Disseminates information for each symbol. A separate Trading Status message indicates the status of each symbol. If no Trading Status message is received for a symbol, it is assumed to be Suspended.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary Time</Type>
          <Size>8</Size>
          <Description>Time the message was generated.</Description>
        </Field>
        <Field>
          <Name>Allowed Book Types</Name>
          <Type>Bit Field</Type>
          <Size>1</Size>
          <Description>Defines the order book types allowed for the symbol. Each designated bit represents a book type. 0 means not allowed and 1 means allowed.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>14</Size>
          <Description>Symbol (right padded with spaces).</Description>
        </Field>
        <Field>
          <Name>Segment</Name>
          <Type>Alphanumeric</Type>
          <Size>6</Size>
          <Description>Segment the symbol is assigned to (right padded with spaces).</Description>
        </Field>
        <Field>
          <Name>Currency</Name>
          <Type>Alphanumeric</Type>
          <Size>3</Size>
          <Description>The possible values will be the ISO 4217 codes for currency.</Description>
        </Field>
        <Field>
          <Name>Lot Size</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Indicates the minimum quantity/nominal value tradable on the market for a security.</Description>
        </Field>
        <Field>
          <Name>Full Name</Name>
          <Type>Alphanumeric</Type>
          <Size>120</Size>
          <Description>The unique long name assigned to the symbol.</Description>
        </Field>
        <Field>
          <Name>Active Market Maker</Name>
          <Type>Binary</Type>
          <Size>2</Size>
          <Description>The active market maker broker id who will be carrying our market maker obligations for the instrument.</Description>
        </Field>
        <Field>
          <Name>Security Type</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>The security type of the instrument.</Description>
        </Field>
        <Field>
          <Name>Instrument Flags</Name>
          <Type>Bit Field</Type>
          <Size>1</Size>
          <Description>Instrument flags bit field.</Description>
        </Field>
        <Field>
          <Name>Previous Close</Name>
          <Type>Binary Price</Type>
          <Size>8</Size>
          <Description>The previous day's closing price.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trading Status Message -->
    <Message>
      <Name>Trading Status Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x61</Code>
      <Description>Indicates the current trading status of a security on the Cboe Canada NEO system. Sequenced Trading Status messages are sent upon system startup for all active securities with Trading Status = S (suspended).</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary Time</Type>
          <Size>8</Size>
          <Description>Time the message was generated. Only the latest Trading Status for each symbol/order book type pair will be sent during a Spin Request. When this message is received as part of a Spin Request, the Timestamp value will be set to 1 and should be ignored.</Description>
        </Field>
        <Field>
          <Name>Order Book Type</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Order book to which the trading status applies.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>14</Size>
          <Description>Symbol (right padded with spaces).</Description>
        </Field>
        <Field>
          <Name>Trading Status</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Current trading status code.</Description>
        </Field>
        <Field>
          <Name>Trading Sub-Status</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Current trading sub-status code.</Description>
        </Field>
        <Field>
          <Name>Halt Reason</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Reason code for a halt condition.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trade Message -->
    <Message>
      <Name>Trade Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x67</Code>
      <Description>Provides information about executions of orders not displayed on any Cboe Canada trading book. Trade messages may also provide information about displayed orders that are traded at a price other than their displayed price. Trade messages do not alter the book and can be ignored if messages are being used solely to build a book.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary Time</Type>
          <Size>8</Size>
          <Description>Time the message was generated.</Description>
        </Field>
        <Field>
          <Name>Order Book Type</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Order book on which the trade occurred.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>14</Size>
          <Description>Symbol (right padded with spaces).</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Incremental number of shares executed or reported.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary Price</Type>
          <Size>8</Size>
          <Description>The price of the trade.</Description>
        </Field>
        <Field>
          <Name>Execution Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Cboe Canada NEO generated day-unique execution identifier of this execution. Execution Id is also referenced in the Trade Break and Trade Correction messages.</Description>
        </Field>
        <Field>
          <Name>Buy Broker Id</Name>
          <Type>Binary</Type>
          <Size>2</Size>
          <Description>Trading participant identity of the buyer of the trade (or 1 for anonymous).</Description>
        </Field>
        <Field>
          <Name>Sell Broker Id</Name>
          <Type>Binary</Type>
          <Size>2</Size>
          <Description>Trading participant identity of the seller of the trade (or 1 for anonymous).</Description>
        </Field>
        <Field>
          <Name>Cross Type</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>The type of the Cross order.</Description>
        </Field>
        <Field>
          <Name>Trade Flags</Name>
          <Type>Bit Field</Type>
          <Size>1</Size>
          <Description>Trade flags bit field.</Description>
        </Field>
        <Field>
          <Name>Settlement Type</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Settlement terms of the order.</Description>
        </Field>
        <Field>
          <Name>Settlement Date</Name>
          <Type>Binary Date</Type>
          <Size>4</Size>
          <Description>The date the order would settle.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Reserved (undefined).</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trade Break Message -->
    <Message>
      <Name>Trade Break Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x68</Code>
      <Description>Sent whenever an execution on Cboe Canada NEO is cancelled. Applications that simply build a Cboe Canada NEO book can ignore Trade Break messages.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary Time</Type>
          <Size>8</Size>
          <Description>Time the message was generated.</Description>
        </Field>
        <Field>
          <Name>Order Book Type</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Order book on which the original execution occurred.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>14</Size>
          <Description>Symbol (right padded with spaces).</Description>
        </Field>
        <Field>
          <Name>Original Quantity</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Original number of shares executed or reported.</Description>
        </Field>
        <Field>
          <Name>Original Price</Name>
          <Type>Binary Price</Type>
          <Size>8</Size>
          <Description>Original price of the execution.</Description>
        </Field>
        <Field>
          <Name>Execution Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Cboe Canada NEO generated day-unique identifier of the execution that was broken. Execution Id refers to previously sent Order Executed or Trade message.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trade Correction Message -->
    <Message>
      <Name>Trade Correction Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x69</Code>
      <Description>Sent whenever an execution on Cboe Canada NEO is corrected. Applications that simply build a Cboe Canada NEO book can ignore Trade Correction messages.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary Time</Type>
          <Size>8</Size>
          <Description>Time the message was generated.</Description>
        </Field>
        <Field>
          <Name>Order Book Type</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Order book on which the original execution occurred.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>14</Size>
          <Description>Symbol (right padded with spaces).</Description>
        </Field>
        <Field>
          <Name>Original Quantity</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Original number of shares executed or reported.</Description>
        </Field>
        <Field>
          <Name>Original Price</Name>
          <Type>Binary Price</Type>
          <Size>8</Size>
          <Description>Original price of the execution.</Description>
        </Field>
        <Field>
          <Name>Original Settlement Type</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Original settlement terms of the order.</Description>
        </Field>
        <Field>
          <Name>Original Settlement Date</Name>
          <Type>Binary Date</Type>
          <Size>4</Size>
          <Description>Original date the order would settle.</Description>
        </Field>
        <Field>
          <Name>Corrected Quantity</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Corrected number of shares executed or reported.</Description>
        </Field>
        <Field>
          <Name>Corrected Price</Name>
          <Type>Binary Price</Type>
          <Size>8</Size>
          <Description>Corrected price of the execution.</Description>
        </Field>
        <Field>
          <Name>Corrected Settlement Type</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Corrected settlement terms of the order.</Description>
        </Field>
        <Field>
          <Name>Corrected Settlement Date</Name>
          <Type>Binary Date</Type>
          <Size>4</Size>
          <Description>Corrected date the order would settle.</Description>
        </Field>
        <Field>
          <Name>Execution Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Cboe Canada NEO generated day-unique identifier of the execution that was corrected. Execution Id refers to previously sent Order Executed or Trade message.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Single Side Update Message -->
    <Message>
      <Name>Single Side Update Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x6A</Code>
      <Description>Provides an updated displayed price and size for a single side of a Symbol. Used on NEO-N (market by price book).</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary Time</Type>
          <Size>8</Size>
          <Description>Time the message was generated.</Description>
        </Field>
        <Field>
          <Name>Order Book Type</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Order book on which the update applies (4=NEO-N).</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>14</Size>
          <Description>Symbol (right padded with spaces).</Description>
        </Field>
        <Field>
          <Name>Side Indicator</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Order side indicator.</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Total number of shares at this price level. A zero indicates there are no shares displayed for this side at the price level.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary Price</Type>
          <Size>8</Size>
          <Description>The price level.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Reserved (undefined).</Description>
        </Field>
      </Fields>
    </Message>

    <!-- End of Session Message -->
    <Message>
      <Name>End of Session Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x2D</Code>
      <Description>Sent for each unit when the unit shuts down. No additional sequenced messages will be delivered for this unit, but heartbeats from the unit may be received.</Description>
      <Fields>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Reserved (undefined).</Description>
        </Field>
      </Fields>
    </Message>


  </Messages>

  <Enums>

    <!-- Order Book Type -->
    <Enum>
      <Name>Order Book Type</Name>
      <Values>
        <Value><Data>0</Data><Name>All Books</Name></Value>
        <Value><Data>3</Data><Name>NEO-L</Name></Value>
        <Value><Data>4</Data><Name>NEO-N</Name></Value>
        <Value><Data>5</Data><Name>NEO-D</Name></Value>
        <Value><Data>6</Data><Name>Crossing Facility</Name></Value>
        <Value><Data>7</Data><Name>SST</Name></Value>
      </Values>
    </Enum>

    <!-- Security Type -->
    <Enum>
      <Name>Security Type</Name>
      <Values>
        <Value><Data>1</Data><Name>Equity</Name></Value>
        <Value><Data>2</Data><Name>Debt</Name></Value>
        <Value><Data>3</Data><Name>Closed End Fund</Name></Value>
        <Value><Data>4</Data><Name>Depositary Receipt</Name></Value>
        <Value><Data>5</Data><Name>Exchange Traded Fund</Name></Value>
        <Value><Data>6</Data><Name>Foreign Listed Security</Name></Value>
