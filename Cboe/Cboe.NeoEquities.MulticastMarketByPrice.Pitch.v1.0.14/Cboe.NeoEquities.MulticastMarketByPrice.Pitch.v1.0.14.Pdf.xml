        <Value><Data>O</Data><Name>Halt Lift Schedule for Opening</Name></Value>
        <Value><Data>R</Data><Name>Halt Lift Schedule for Re-Opening</Name></Value>
      </Values>
    </Enum>

    <!-- Halt Reason -->
    <Enum>
      <Name>Halt Reason</Name>
      <Values>
        <Value><Data>" "</Data><Name>None</Name></Value>
