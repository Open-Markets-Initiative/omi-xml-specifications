        <Value><Data>CSE</Data><Name>CSE Securities</Name></Value>
        <Value><Data>NEOC</Data><Name>NEO Connect Securities</Name></Value>
        <Value><Data>FOTS</Data><Name>Foreign Other Traded Securities</Name></Value>
      </Values>
    </Enum>

    <!-- Trading Status -->
    <Enum>
      <Name>Trading Status</Name>
      <Values>
        <Value><Data>A</Data><Name>Accepting</Name></Value>
