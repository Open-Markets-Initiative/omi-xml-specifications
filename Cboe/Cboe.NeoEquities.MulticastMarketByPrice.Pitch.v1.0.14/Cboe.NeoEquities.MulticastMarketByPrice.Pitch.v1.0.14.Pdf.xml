        <Value><Data>S</Data><Name>Suspension</Name></Value>
      </Values>
    </Enum>

    <!-- Side Indicator -->
    <Enum>
      <Name>Side Indicator</Name>
      <Values>
        <Value><Data>B</Data><Name>Buy Order</Name></Value>
        <Value><Data>S</Data><Name>Sell Order</Name></Value>
      </Values>
