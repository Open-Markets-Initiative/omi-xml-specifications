  </Enums>

  <Bitfields>

    <!-- Allowed Book Types -->
    <Bitfield>
      <Name>Allowed Book Types</Name>
      <Description>Defines the order book types allowed for the symbol. 0 means not allowed and 1 means allowed.</Description>
      <Fields>
        <Field>
          <Name>Reserved 0-2</Name>
          <Bits>3</Bits>
          <Type>bit</Type>
          <Description>Reserved.</Description>
        </Field>
        <Field>
          <Name>NEO-L</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>NEO-L book allowed.</Description>
        </Field>
        <Field>
          <Name>NEO-N</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>NEO-N book allowed.</Description>
        </Field>
        <Field>
          <Name>NEO-D</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>NEO-D book allowed.</Description>
        </Field>
        <Field>
          <Name>Crossing Facility</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>Crossing Facility allowed.</Description>
        </Field>
        <Field>
          <Name>SST</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>Special Settlement Term book allowed.</Description>
        </Field>
      </Fields>
    </Bitfield>

    <!-- Instrument Flags -->
    <Bitfield>
      <Name>Instrument Flags</Name>
      <Description>Instrument flags.</Description>
      <Fields>
        <Field>
          <Name>Odd Lot Allowed</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>0 = Not Allowed, 1 = Allowed.</Description>
        </Field>
        <Field>
          <Name>Closing Eligible</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>0 = Not eligible, 1 = Eligible.</Description>
        </Field>
        <Field>
          <Name>Reserved 2-7</Name>
          <Bits>6</Bits>
          <Type>bit</Type>
          <Description>Reserved.</Description>
        </Field>
      </Fields>
    </Bitfield>

    <!-- Execution Flags -->
    <Bitfield>
      <Name>Execution Flags</Name>
      <Description>Execution flags.</Description>
      <Fields>
        <Field>
          <Name>Reserved 0</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>Reserved.</Description>
        </Field>
        <Field>
          <Name>Auction</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>0 = Not an Auction Trade, 1 = Auction Trade.</Description>
        </Field>
        <Field>
          <Name>Reserved 2-7</Name>
          <Bits>6</Bits>
          <Type>bit</Type>
          <Description>Reserved.</Description>
        </Field>
      </Fields>
    </Bitfield>

    <!-- Trade Flags -->
    <Bitfield>
      <Name>Trade Flags</Name>
      <Description>Trade flags.</Description>
      <Fields>
        <Field>
          <Name>Bypass</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>0 = No Bypass, 1 = Bypass (always 0 if Cross Type is 0).</Description>
        </Field>
        <Field>
          <Name>Auction</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>0 = Not an Auction Trade, 1 = Auction Trade.</Description>
        </Field>
        <Field>
          <Name>Reserved 2-7</Name>
          <Bits>6</Bits>
          <Type>bit</Type>
          <Description>Reserved.</Description>
        </Field>
      </Fields>
    </Bitfield>

  </Bitfields>

</OmiPitchEquitiesPdf>
