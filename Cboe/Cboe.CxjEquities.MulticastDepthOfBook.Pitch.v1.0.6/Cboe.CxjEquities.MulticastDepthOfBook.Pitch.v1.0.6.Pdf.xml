<OmiCboeAustraliaPitchPdf>

  <Messages>

    <!-- Unit Clear Message -->
    <Message>
      <Name>Unit Clear Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x97</Code>
      <Description>Instructs feed recipients to clear all orders for the Cboe Japan book in the unit specified in the Sequenced Unit Header. It would be distributed in rare recovery events such as a datacenter fail-over.</Description>
      <Fields>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Reserved (undefined).</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trading Status Message -->
    <Message>
      <Name>Trading Status Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x50</Code>
      <Description>Used to indicate the current trading status of a security. A Trading Status message will be sent whenever trading status changes for a security.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary UTC Timestamp</Type>
          <Size>8</Size>
          <Description>Nanoseconds since epoch.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>6</Size>
          <Description>Symbol (right padded with spaces).</Description>
        </Field>
        <Field>
          <Name>Trading Status</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Trading status of the session for the symbol.</Description>
        </Field>
        <Field>
          <Name>Trading Status Flags</Name>
          <Type>Bit Field</Type>
          <Size>1</Size>
          <Description>Trading status flags bit field.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Add Order Message -->
    <Message>
      <Name>Add Order Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x51</Code>
      <Description>Represents a newly accepted order on the Cboe Japan book. It includes a day-specific Order Id assigned by Cboe Japan to the order.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary UTC Timestamp</Type>
          <Size>8</Size>
          <Description>Nanoseconds since epoch.</Description>
        </Field>
        <Field>
          <Name>Order Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Day-specific identifier assigned to this order.</Description>
        </Field>
        <Field>
          <Name>Side Indicator</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Side of the order.</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Number of shares being added to the book.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>6</Size>
          <Description>Symbol (right padded with spaces).</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary Price</Type>
          <Size>8</Size>
          <Description>The display price of the order.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Reserved (undefined).</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Executed Message -->
    <Message>
      <Name>Order Executed Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x52</Code>
      <Description>Sent when a visible order on the Cboe Japan book is executed in whole or in part. The execution price equals the order price found in the original Add Order message or the order price in the latest Modify Order message referencing the Order Id.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary UTC Timestamp</Type>
          <Size>8</Size>
          <Description>Nanoseconds since epoch.</Description>
        </Field>
        <Field>
          <Name>Order Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Order Id of a previously sent Add Order message that was executed.</Description>
        </Field>
        <Field>
          <Name>Executed Quantity</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Number of shares executed.</Description>
        </Field>
        <Field>
          <Name>Execution Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Cboe Japan generated day-unique execution identifier of this execution.</Description>
        </Field>
        <Field>
          <Name>Contra Order Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Order Id of the contra order to this execution. The contra order id may not have been previously sent in an Add Order message.</Description>
        </Field>
        <Field>
          <Name>Tick Direction</Name>
          <Type>Printable ASCII</Type>
          <Size>1</Size>
          <Description>The tick direction of this trade.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Reduce Size Message -->
    <Message>
      <Name>Reduce Size Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x39</Code>
      <Description>Sent when a visible order on the Cboe Japan book is partially reduced.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary UTC Timestamp</Type>
          <Size>8</Size>
          <Description>Nanoseconds since epoch.</Description>
        </Field>
        <Field>
          <Name>Order Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Order Id of a previously sent Add Order message that has been reduced.</Description>
        </Field>
        <Field>
          <Name>Cancelled Quantity</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Number of shares cancelled.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Modify Order Message -->
    <Message>
      <Name>Modify Order Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x3A</Code>
      <Description>Sent whenever an open order is visibly modified. The Order Id refers to the Order Id of the original Add Order message.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary UTC Timestamp</Type>
          <Size>8</Size>
          <Description>Nanoseconds since epoch.</Description>
        </Field>
        <Field>
          <Name>Order Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Order Id of a previously sent Add Order message that has been modified.</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Number of shares associated with this order after this modify (may be less than the number entered).</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary Price</Type>
          <Size>8</Size>
          <Description>The order price after this modify.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Reserved (undefined).</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Delete Order Message -->
    <Message>
      <Name>Delete Order Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x3C</Code>
      <Description>Sent whenever a booked order is cancelled or leaves the order book. The Order Id refers to the Order Id of the original Add Order message.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary UTC Timestamp</Type>
          <Size>8</Size>
          <Description>Nanoseconds since epoch.</Description>
        </Field>
        <Field>
          <Name>Order Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Order Id of a previously sent Add Order message that has been removed from order book.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trade Message -->
    <Message>
      <Name>Trade Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x53</Code>
      <Description>Sent when there is an execution against any non-displayed portion of an iceberg order. Trade messages do not alter the book and can be ignored if messages are being used solely to build a book.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary UTC Timestamp</Type>
          <Size>8</Size>
          <Description>Nanoseconds since epoch.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>6</Size>
          <Description>Symbol (right padded with spaces).</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Incremental number of shares executed or reported.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary Price</Type>
          <Size>8</Size>
          <Description>The price of the trade.</Description>
        </Field>
        <Field>
          <Name>Execution Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Cboe Japan generated day-unique execution identifier of this execution. Execution Id is also referenced in the Trade Break message.</Description>
        </Field>
        <Field>
          <Name>Order Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Order Id of the executed order.</Description>
        </Field>
        <Field>
          <Name>Contra Order Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Order Id of the contra order that executed with this order.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trade Break Message -->
    <Message>
      <Name>Trade Break Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x3E</Code>
      <Description>Sent whenever an execution on Cboe Japan is cancelled.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary UTC Timestamp</Type>
          <Size>8</Size>
          <Description>Nanoseconds since epoch.</Description>
        </Field>
        <Field>
          <Name>Execution Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Cboe Japan generated day-unique identifier of the execution that was broken. Execution Id refers to previously sent Order Executed or Trade message.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- End of Session Message -->
    <Message>
      <Name>End of Session Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x2D</Code>
      <Description>Sent for each unit when the unit shuts down. No additional sequenced messages will be delivered for this unit, but heartbeats from the unit may be received.</Description>
      <Fields>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Reserved (undefined).</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- Trading Status -->
    <Enum>
      <Name>Trading Status</Name>
      <Values>
        <Value>
          <Data>C</Data>
          <Name>Closed</Name>
        </Value>
        <Value>
          <Data>T</Data>
          <Name>Trading</Name>
        </Value>
        <Value>
          <Data>H</Data>
          <Name>Halted</Name>
        </Value>
        <Value>
          <Data>h</Data>
          <Name>Halted in Pre-Open</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Side Indicator -->
    <Enum>
      <Name>Side Indicator</Name>
      <Values>
        <Value>
          <Data>B</Data>
          <Name>Buy Order</Name>
        </Value>
        <Value>
          <Data>S</Data>
          <Name>Sell Order</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Tick Direction -->
    <Enum>
      <Name>Tick Direction</Name>
      <Values>
        <Value>
          <Data>-</Data>
          <Name>Lower than previous last sale</Name>
        </Value>
        <Value>
          <Data>+</Data>
          <Name>Higher than previous last sale</Name>
        </Value>
        <Value>
          <Data>0</Data>
          <Name>No change from or since TSE previous close (or first TSE trade of an IPO)</Name>
        </Value>
        <Value>
          <Data>D</Data>
          <Name>Same as previous last sale, and most recent price change was downward ("-").</Name>
        </Value>
        <Value>
          <Data>U</Data>
          <Name>Same as previous last sale, and most recent price change was upward ("+").</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

  <Bitfields>

    <!-- Trading Status Flags -->
    <Bitfield>
      <Name>Trading Status Flags</Name>
      <Description>Trading status flags.</Description>
      <Fields>
        <Field>
          <Name>Short sell price check</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>0 = Short sell price check not in effect, 1 = Short sell price check in effect.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>Reserved.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>Reserved.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>Reserved.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>Reserved.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>Reserved.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>Reserved.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>Reserved.</Description>
        </Field>
      </Fields>
    </Bitfield>

  </Bitfields>

