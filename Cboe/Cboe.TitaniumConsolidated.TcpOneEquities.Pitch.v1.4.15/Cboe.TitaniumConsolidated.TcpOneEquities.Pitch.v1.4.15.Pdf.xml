<OmiPitchEquitiesPdf>

  <Messages>

    <!-- Cboe One Login Message -->
    <Message>
      <Name>Cboe One Login Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0xA0</Code>
      <Description>The Cboe One Login message is the first message sent to the server by a user's process after its connection to the server is established.</Description>
      <Fields>
        <Field>
          <Name>Session Sub Id</Name>
          <Type>Alphanumeric</Type>
          <Size>4</Size>
          <Description>SessionSubId supplied by Cboe.</Description>
        </Field>
        <Field>
          <Name>Username</Name>
          <Type>Alphanumeric</Type>
          <Size>4</Size>
          <Description>Username supplied by Cboe</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Type>Alphanumeric</Type>
          <Size>2</Size>
          <Description>(space filled)</Description>
        </Field>
        <Field>
          <Name>Password</Name>
          <Type>Alphanumeric</Type>
          <Size>10</Size>
          <Description>Password supplied by Cboe</Description>
        </Field>
        <Field>
          <Name>Next Sequence</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Sequence number of the next sequenced message expected by the user.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Login Response Message -->
    <Message>
      <Name>Login Response Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x02</Code>
      <Description>The Login Response message is sent by the server to a user's process in response to a Login message.</Description>
      <Fields>
        <Field>
          <Name>Status</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Accepted or reason for reject</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Replay Complete Message -->
    <Message>
      <Name>Replay Complete Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0xA1</Code>
      <Description>The Replay Complete message is sent to indicate that messages related to refreshing the state of the Cboe books have been delivered.</Description>
      <Fields>
        <Field>
          <Name>Sequence</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Sequence number that reflects that last update on the feed.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Clear Quote Message  -->
    <Message>
      <Name>Clear Quote Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0xA2</Code>
      <Description>The Clear Quote message instructs feed recipients to clear all quotes and Summary and/or ADAP information for the specified symbol on the specified market(s).</Description>
      <Fields>
        <Field>
          <Name>Last Update Timestamp</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Timestamp of the last matching engine message that updated the quote information for this symbol in the Cboe One server's cache. Encoded as the number of nanoseconds since midnight.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Market Center</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>All Cboe Markets for this feed</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Fractional Symbol Summary Message  -->
    <Message>
      <Name>Fractional Symbol Summary Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0xE7</Code>
      <Description>The Fractional Symbol Summary message delivers the Cboe consolidated best bid/offer and total executed volume across all applicable Cboe One US and Cboe One Canada books.</Description>
      <Fields>
        <Field>
          <Name>Last Update Timestamp</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Timestamp of the last matching engine message that updated the quote information for this symbol in the Cboe One server's cache. Encoded as the number of nanoseconds since midnight.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Cboe Cumulative Executed Volume</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Cumulative number of shares traded today across all applicable Cboe books.</Description>
        </Field>
        <Field>
          <Name>Consolidated Best Bid Price</Name>
          <Type>Binary 8.4 Price</Type>
          <Size>8</Size>
          <Description>Titanium Equities best bid price.</Description>
        </Field>
        <Field>
          <Name>Consolidated Best Bid Quantity</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Titanium Equities number of buy-side shares available for this symbol.</Description>
        </Field>
        <Field>
          <Name>Consolidated Best Ask Price</Name>
          <Type>Binary 8.4 Price</Type>
          <Size>8</Size>
          <Description>Titanium Equities best ask price.</Description>
        </Field>
        <Field>
          <Name>Consolidated Best Ask Quantity</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Titanium Equities number of sell-side shares available for this symbol.</Description>
        </Field>
        <Field>
          <Name>National Cumulative Volume</Name>
          <Type>Binary 12.6</Type>
          <Size>8</Size>
          <Description>In the US, cumulative number of shares traded today as reported to the CTA and UTP SIPs.</Description>
        </Field>
        <Field>
          <Name>Fractional Symbol Summary Flags</Name>
          <Type>Bit Field</Type>
          <Size>1</Size>
          <Description>Fractional Symbol Summary Flags</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Best Quote Update Message  -->
    <Message>
      <Name>Best Quote Update Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0xA5</Code>
      <Description>The Best Quote Update message is used to update one side of the Cboe consolidated quote information for a symbol.</Description>
      <Fields>
        <Field>
          <Name>Last Update Timestamp</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Timestamp of the last matching engine message that updated the quote information for this symbol in the Cboe One server's cache. Encoded as the number of nanoseconds since midnight.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Side Indicator</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Side of the quote update</Description>
        </Field>
        <Field>
          <Name>Consolidated Best Quote Price</Name>
          <Type>Binary 8.4 Price</Type>
          <Size>8</Size>
          <Description>Titanium Equities best price.</Description>
        </Field>
        <Field>
          <Name>Consolidated Quote Quantity</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Titanium Equities number of shares available for this symbol.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Cboe Market Status Message  -->
    <Message>
      <Name>Cboe Market Status Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0xA6</Code>
      <Description>The Cboe Market Status message is disseminated to reflect a change in the status of a market.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Timestamp of when the Market Status changed for the specified Market Center. Encoded as the number of nanoseconds since midnight.</Description>
        </Field>
        <Field>
          <Name>Market Center</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Market Center identifier</Description>
        </Field>
        <Field>
          <Name>Market Status</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Market status indicator</Description>
        </Field>
        <Field>
          <Name>Session Indicator</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Session indicator</Description>
        </Field>
      </Fields>
    </Message>

    <!-- ADAP Message  -->
    <Message>
      <Name>ADAP Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0xA7</Code>
      <Description>Each ADAP message delivers one or more updates for a Symbol's ADAP book. Each ADAP message contains one or more ADAP Block messages.</Description>
      <Fields>
        <Field>
          <Name>Last Update Timestamp</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Timestamp of the last matching engine message that updated the quote information for this symbol in the Cboe One server's cache. Encoded as the number of nanoseconds since midnight.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>ADAP Flags</Name>
          <Type>Bit Field</Type>
          <Size>1</Size>
          <Description>ADAP Flags</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Reserved</Description>
        </Field>
        <Field>
          <Name>ADAP Blocks</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Number of ADAP Block messages to follow</Description>
        </Field>
        <Field>
          <Name>ADAP Block Size</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Size of each ADAP Block message</Description>
        </Field>
        <Field>
          <Name>ADAP Block</Name>
          <Type>Group</Type>
          <Size>1</Size>
          <Description>Size of each ADAP Block message</Description>
        </Field>
      </Fields>
    </Message>

    <!-- RPI Message  -->
    <Message>
      <Name>RPI Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0xA8</Code>
      <Description>The Retail Price Improvement (RPI) message is a retail liquidity indicator that includes symbol and side, but not price and size. US Only.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Timestamp of the matching engine RPI message emitted by the specified Market Center. Encoded as the number of nanoseconds since midnight.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Market Center</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Market Center identifier</Description>
        </Field>
        <Field>
          <Name>Retail Price Improvement</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Retail Price Improvement indicator</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Fractional Trade Message  -->
    <Message>
      <Name>Fractional Trade Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0xE8</Code>
      <Description>Fractional Trade messages are sent when an order is executed in whole or in part on a Cboe exchange.</Description>
      <Fields>
        <Field>
          <Name>Transaction Time</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>The time the trade occurred on the specified Market Center. Encoded as the number of nanoseconds since midnight.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Market Center</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Market Center on which the last trade was executed</Description>
        </Field>
        <Field>
          <Name>Market Center Execution ID</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Market center specific execution identifier of this Execution. Execution ID is also referenced in the Trade Break message.</Description>
        </Field>
        <Field>
          <Name>Last Price</Name>
          <Type>Binary 8.4 Price</Type>
          <Size>8</Size>
          <Description>Last trade price.</Description>
        </Field>
        <Field>
          <Name>Last Quantity</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Last trade quantity.</Description>
        </Field>
        <Field>
          <Name>Cboe Cumulative Executed Volume</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Cumulative number of shares traded today across all applicable books.</Description>
        </Field>
        <Field>
          <Name>National Cumulative Volume</Name>
          <Type>Binary 12.6</Type>
          <Size>8</Size>
          <Description>In the US, cumulative number of shares traded today as reported to the CTA and UTP SIPs.</Description>
        </Field>
        <Field>
          <Name>Fractional Trade Flags</Name>
          <Type>Bit Field</Type>
          <Size>1</Size>
          <Description>Fractional Trade Flags</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Fractional Trade Break Message  -->
    <Message>
      <Name>Fractional Trade Break Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0xE9</Code>
      <Description>The Fractional Trade Break message is sent whenever an execution on a Cboe exchange is broken.</Description>
      <Fields>
        <Field>
          <Name>Transaction Time</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>The time the trade break occurred on the specified Market Center. Encoded as the number of nanoseconds since midnight.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Market Center</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Market Center on which the last trade was executed</Description>
        </Field>
        <Field>
          <Name>Market Center Execution ID</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Market center specific execution identifier of trade to be broken.</Description>
        </Field>
        <Field>
          <Name>Cboe Cumulative Executed Volume</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Cumulative number of shares traded today across all applicable Cboe books.</Description>
        </Field>
        <Field>
          <Name>National Cumulative Volume</Name>
          <Type>Binary 12.6</Type>
          <Size>8</Size>
          <Description>In the US, cumulative number of shares traded today as reported to the CTA and UTP SIPs.</Description>
        </Field>
        <Field>
          <Name>Fractional Trade Break Flags</Name>
          <Type>Bit Field</Type>
          <Size>1</Size>
          <Description>Fractional Trade Break Flags</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trading Status Message  -->
    <Message>
      <Name>Trading Status Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0xAB</Code>
      <Description>The Trading Status message is used to indicate the current trading status of a security on a Cboe exchange.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Timestamp of the matching engine trading status message emitted by the specified Market Center. Encoded as the number of nanoseconds since midnight.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Market Center</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Market Center identifier</Description>
        </Field>
        <Field>
          <Name>Trading Status</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Trading status indicator</Description>
        </Field>
        <Field>
          <Name>Reg SHO Action</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Reg SHO Action indicator</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Opening/Closing Price Message  -->
    <Message>
      <Name>Opening Closing Price Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0xB0</Code>
      <Description>The Opening/Closing Price message is used to indicate the Opening or Closing price of a security on any of the Cboe markets and the primary listing market.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>The time the eligible trade occurred on the specified Market Center. Encoded as the number of nanoseconds since midnight.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Market Center</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Market Center identifier</Description>
        </Field>
        <Field>
          <Name>Open Close Indicator</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Open/Close indicator</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary 8.4 Price</Type>
          <Size>8</Size>
          <Description>Opening/Closing Price.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Fractional End of Day Summary Message  -->
    <Message>
      <Name>Fractional End of Day Summary Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0xEA</Code>
      <Description>The Fractional End of Day Summary message is used to give a consolidated, high-level overview of a security for the day.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>The timestamp of the originating SIP summary message. Encoded as the number of nanoseconds since midnight.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Data Source</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Data source indicator</Description>
        </Field>
        <Field>
          <Name>Opening Price</Name>
          <Type>Binary 8.4 Price</Type>
          <Size>8</Size>
          <Description>Opening Price. 0 if the system has not received an opening price for the security.</Description>
        </Field>
        <Field>
          <Name>Closing Price</Name>
          <Type>Binary 8.4 Price</Type>
          <Size>8</Size>
          <Description>Closing Price.</Description>
        </Field>
        <Field>
          <Name>High Price</Name>
          <Type>Binary 8.4 Price</Type>
          <Size>8</Size>
          <Description>Highest trade price of the day.</Description>
        </Field>
        <Field>
          <Name>Low Price</Name>
          <Type>Binary 8.4 Price</Type>
          <Size>8</Size>
          <Description>Lowest trade price of the day.</Description>
        </Field>
        <Field>
          <Name>National Cumulative Volume</Name>
          <Type>Binary 12.6</Type>
          <Size>8</Size>
          <Description>For US, cumulative volume of shares traded as reported to the national consolidators (SIPs).</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Groups>

    <!-- ADAP Block  -->
    <Group>
      <Name>ADAP Block</Name>
      <Dependency>ADAP Blocks</Dependency>
      <Description>ADAP Block</Description>
      <Fields>
        <Field>
          <Name>ADAP Update</Name>
          <Type>struct</Type>
          <Size>0</Size>
          <Description>ADAP block update</Description>
        </Field>
      </Fields>
    </Group>

  </Groups>

  <Structs>

    <!-- Short Update ADAP Block  -->
    <Struct>
      <Name>Short Update ADAP Block</Name>
      <Description>Short Update ADAP Block for ADAP messages. Contains price level updates with 4-byte Binary 4.4 prices.</Description>
      <Fields>
        <Field>
          <Name>Market Center</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Market Center identifier</Description>
        </Field>
        <Field>
          <Name>Side</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Side indicator</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary 4.4 Price</Type>
          <Size>4</Size>
          <Description>Price level to add/update for Market Center's ADAP book.</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Quantity of shares at this price level in the Market Center's ADAP book. A value of zero implies deletion of this ADAP level.</Description>
        </Field>
      </Fields>
    </Struct>

    <!-- Long Update ADAP Block  -->
    <Struct>
      <Name>Long Update ADAP Block</Name>
      <Description>Long Update ADAP Block for ADAP messages. Contains price level updates with 8-byte Binary 8.4 prices.</Description>
      <Fields>
        <Field>
          <Name>Market Center</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Market Center identifier</Description>
        </Field>
        <Field>
          <Name>Side</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Side indicator</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary 8.4 Price</Type>
          <Size>8</Size>
          <Description>Price level to add/update for Market Center's ADAP book.</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Quantity of shares at this price level in the Market Center's ADAP book. A value of zero implies deletion of this ADAP level.</Description>
        </Field>
      </Fields>
    </Struct>

  </Structs>

  <Enums>

    <!-- Login Response Status -->
    <Enum>
      <Name>Login Response Status</Name>
      <Values>
        <Value>
          <Data>A</Data>
          <Name>Login Accepted</Name>
        </Value>
        <Value>
          <Data>N</Data>
          <Name>Not authorized (Invalid Username/Password)</Name>
        </Value>
        <Value>
          <Data>B</Data>
          <Name>Session in use</Name>
        </Value>
        <Value>
          <Data>S</Data>
          <Name>Invalid Session</Name>
        </Value>
        <Value>
          <Data>Q</Data>
          <Name>Next Sequence is ahead of sequence</Name>
        </Value>
      </Values>
    </Enum>

    <!-- GRP Login Response Status -->
    <Enum>
      <Name>GRP Login Response Status</Name>
      <Values>
        <Value>
          <Data>A</Data>
          <Name>Login Accepted</Name>
        </Value>
        <Value>
          <Data>N</Data>
          <Name>Not authorized (Invalid Username/Password)</Name>
        </Value>
        <Value>
          <Data>B</Data>
          <Name>Session in use</Name>
        </Value>
        <Value>
          <Data>S</Data>
          <Name>Invalid Session</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Gap Response Status -->
    <Enum>
      <Name>Gap Response Status</Name>
      <Values>
        <Value>
          <Data>A</Data>
          <Name>Accepted</Name>
        </Value>
        <Value>
          <Data>O</Data>
          <Name>Out of range (ahead of sequence or too far behind)</Name>
        </Value>
        <Value>
          <Data>D</Data>
          <Name>Daily gap request allocation exhausted</Name>
        </Value>
        <Value>
          <Data>M</Data>
          <Name>Minute gap request allocation exhausted</Name>
        </Value>
        <Value>
          <Data>S</Data>
          <Name>Second gap request allocation exhausted</Name>
        </Value>
        <Value>
          <Data>C</Data>
          <Name>Count request limit for one gap request exceeded</Name>
        </Value>
        <Value>
          <Data>I</Data>
          <Name>Invalid Unit specified in request</Name>
        </Value>
        <Value>
          <Data>U</Data>
          <Name>Unit is currently unavailable</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Market Center -->
    <Enum>
      <Name>Market Center</Name>
      <Values>
        <Value>
          <Data>*</Data>
          <Name>All Cboe Markets</Name>
          <Description>All Cboe Markets for this feed</Description>
