        <Field>
          <Name>Execution Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>BATS generated day-unique execution identifier of this execution. Execution Id is also referenced in the Trade Break message</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary Long Price</Type>
          <Size>8</Size>
          <Description>The execution price of the</Description>
        </Field>
      </Fields>
    </Message>

