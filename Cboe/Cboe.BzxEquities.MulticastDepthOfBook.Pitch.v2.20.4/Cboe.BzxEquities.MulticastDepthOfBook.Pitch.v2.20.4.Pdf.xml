    <!-- Trading Status Message -->
    <Message>
      <Name>Trading Status Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Origin>Exchange</Origin>
      <Category>Application</Category>
      <Code>0x31</Code>
      <Description>Trading Status message</Description>
      <Fields>
        <Field>
          <Name>Time offset</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Nanosecond offset from last unit timestamp</Description>
        </Field>
        <Field>
