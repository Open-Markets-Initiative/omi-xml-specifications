          <Name>Trading Status</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>"H" = Halted "Q" = Quote-Only "T" = Trading Reg SHO</Description>
        </Field>
        <Field>
          <Name>Reg SHO Action</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>"0" = No price test in effect "1" = Reg SHO price test restriction in effect</Description>
        </Field>
        <Field>
          <Name>Reserved1</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Reserved</Description>
        </Field>
        <Field>
          <Name>Reserved2</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Reserved</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Auction Update Message -->
    <Message>
      <Name>Auction Update Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Origin>Exchange</Origin>
      <Category>Application</Category>
      <Code>0x95</Code>
      <Description>Auction Update message</Description>
      <Fields>
        <Field>
          <Name>Time offset</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Nanosecond offset from last unit timestamp</Description>
        </Field>
        <Field>
          <Name>Stock Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Stock Symbol right padded with spaces</Description>
        </Field>
        <Field>
          <Name>Auction Type</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>"O" = Opening Auction "C" = Closing Auction "H" = Halt Auction "I" = IPO Auction</Description>
        </Field>
        <Field>
          <Name>Reference Price</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>BBO Collared auction price (see Auction Process Spec)</Description>
        </Field>
        <Field>
          <Name>Buy Shares</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Number of shares on buy side at the Reference Price</Description>
        </Field>
        <Field>
          <Name>Sell Shares</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Number of shares on sell side at the Reference Price</Description>
        </Field>
        <Field>
          <Name>Indicative Price</Name>
          <Type>Binary</Type>
