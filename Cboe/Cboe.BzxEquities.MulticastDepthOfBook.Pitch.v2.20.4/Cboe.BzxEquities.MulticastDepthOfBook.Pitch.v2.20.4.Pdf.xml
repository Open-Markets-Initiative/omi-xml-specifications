<OmiCboeEquitiesPitchPdf>

  <Messages>

    <!-- Time Message -->
    <Message>
      <Name>Time Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Origin>Exchange</Origin>
      <Category>Application</Category>
      <Code>0x20</Code>
      <Description>Time message</Description>
      <Fields>
        <Field>
          <Name>Time</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Number of whole seconds</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Unit Clear Message -->
    <Message>
      <Name>Unit Clear Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Origin>Exchange</Origin>
      <Category>Application</Category>
      <Code>0x97</Code>
      <Description>Unit Clear message</Description>
      <Fields>
        <Field>
          <Name>Time offset</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Nanosecond offset from last</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Add Order Long Message -->
    <Message>
      <Name>Add Order Long Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Origin>Exchange</Origin>
      <Category>Application</Category>
      <Code>0x21</Code>
      <Description>Add Order message (long)</Description>
      <Fields>
        <Field>
          <Name>Time offset</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Nanosecond offset from last unit timestamp</Description>
        </Field>
        <Field>
          <Name>Order Id</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Day-specific identifier assigned to this order</Description>
        </Field>
        <Field>
          <Name>Side Indicator</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>"B" = Buy Order "S" = Sell Order</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Number of shares/contracts being added to the book (may be less than the number entered)</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>6</Size>
          <Description>Symbol right padded with spaces</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary Long Price</Type>
          <Size>8</Size>
          <Description>The limit order price</Description>
        </Field>
        <Field>
          <Name>Add Flags</Name>
          <Type>Bit Field</Type>
          <Size>1</Size>
          <Description>Bit 0 - Display 0 - Not displayed in SIP</Description>
        </Field>
      </Fields>
    </Message>

