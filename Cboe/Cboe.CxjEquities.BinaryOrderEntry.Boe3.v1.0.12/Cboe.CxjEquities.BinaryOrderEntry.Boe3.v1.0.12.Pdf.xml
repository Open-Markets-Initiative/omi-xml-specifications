    <!-- CancelOrigOnReject -->
    <Enum>
      <Name>CancelOrigOnReject</Name>
      <Values>
        <Value>
          <Name>Cancel original order if modification fails.</Name>
          <Data>Y</Data>
        </Value>
        <Value>
          <Name>Leave original order alone.</Name>
          <Data>N</Data>
        </Value>
        <Value>
          <Name>Apply port default</Name>
          <Data>0x00</Data>
        </Value>
      </Values>
    </Enum>

    <!-- CancelReason -->
    <Enum>
      <Name>CancelReason</Name>
      <Values>
        <Value>
          <Name>Admin</Name>
          <Data>A</Data>
          <Description>Most rejects due to field validation errors will be reported with a reason of Admin.</Description>
        </Value>
        <Value>
          <Name>Duplicate identifier (e.g., ClOrdID)</Name>
          <Data>D</Data>
          <Description>Duplicate ClOrdID detected. Note that Cboe Japan will not detect every possible occurrence of a duplicate by a participant.</Description>
        </Value>
        <Value>
          <Name>Halted</Name>
          <Data>H</Data>
        </Value>
        <Value>
          <Name>Incorrect data center</Name>
          <Data>I</Data>
          <Description>Message directed to the DR data center</Description>
        </Value>
        <Value>
          <Name>Order rate threshold exceeded</Name>
          <Data>K</Data>
        </Value>
        <Value>
          <Name>Ran out of liquidity to execute against</Name>
          <Data>N</Data>
          <Description>Cancel reason for the unexecuted size of an IOC/FOK order.</Description>
        </Value>
        <Value>
          <Name>ClOrdID does not match a known order</Name>
          <Data>O</Data>
        </Value>
        <Value>
          <Name>User requested</Name>
          <Data>U</Data>
        </Value>
        <Value>
          <Name>Add liquidity only order would remove</Name>
          <Data>W</Data>
        </Value>
        <Value>
          <Name>Order expired</Name>
          <Data>X</Data>
          <Description>Cancellation of an expired GTD order</Description>
        </Value>
        <Value>
          <Name>Symbol not supported</Name>
          <Data>Y</Data>
