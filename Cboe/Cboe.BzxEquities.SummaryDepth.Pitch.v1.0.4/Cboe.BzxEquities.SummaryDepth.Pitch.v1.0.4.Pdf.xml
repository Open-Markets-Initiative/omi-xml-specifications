<OmiPitchEquitiesPdf>

  <Messages>

    <!-- Clear Quote Message -->
    <Message>
      <Name>Clear Quote Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0xA2</Code>
      <Description>The Clear Quote message instructs feed recipients to clear all quotes and ADAP information for the specified symbol</Description>
      <Fields>
        <Field>
          <Name>Last Update Timestamp</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Timestamp of the last matching engine message that updated the quote information for this symbol in the Cboe Summary Depth server's cache.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Reserved</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Cboe Market Status Message -->
    <Message>
      <Name>Cboe Market Status Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0xA6</Code>
      <Description>The Cboe Market Status message is disseminated to reflect a change in the status of the market</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Timestamp of when the Market Status changed, encoded as the number of nanoseconds since midnight.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Reserved</Description>
        </Field>
        <Field>
          <Name>Market Status</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Market Status</Description>
        </Field>
        <Field>
          <Name>Session Indicator</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Session Indicator</Description>
        </Field>
      </Fields>
    </Message>

    <!-- ADAP Message -->
    <Message>
      <Name>ADAP Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0xA7</Code>
      <Description>Each ADAP message delivers one or more updates for a Symbol's ADAP book.</Description>
      <Fields>
        <Field>
          <Name>Last Update Timestamp</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Timestamp of the last matching engine message that updated the quote information for this symbol in the Cboe Summary Depth server's cache.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>ADAP Flags</Name>
          <Type>Bit Field</Type>
          <Size>1</Size>
          <Description>Flags</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Reserved</Description>
        </Field>
        <Field>
          <Name>ADAP Blocks</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Number of ADAP Blocks to follow</Description>
        </Field>
        <Field>
          <Name>ADAP Block</Name>
          <Type>group</Type>
          <Size>1</Size>
          <Description>Size of each ADAP Block</Description>
        </Field>
      </Fields>
    </Message>

    <!-- RPI Message -->
    <Message>
      <Name>RPI Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0xA8</Code>
      <Description>RPI Message</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Timestamp of the matching engine RPI message, encoded as the number of nanoseconds since midnight.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Reserved</Description>
        </Field>
        <Field>
          <Name>Retail Price Improvement</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Retail Price Improvement</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trade Message -->
    <Message>
      <Name>Trade Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0xA9</Code>
      <Description>Trade Message</Description>
      <Fields>
        <Field>
          <Name>Transaction Time</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>The time the trade occurred, encoded as the number of nanoseconds since midnight.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Reserved</Description>
        </Field>
        <Field>
          <Name>Execution ID</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Execution identifier of this trade.</Description>
        </Field>
        <Field>
          <Name>Last Price</Name>
          <Type>Binary 8.4 Price</Type>
          <Size>8</Size>
          <Description>Last trade price.</Description>
        </Field>
        <Field>
          <Name>Last Quantity</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Last trade quantity.</Description>
        </Field>
        <Field>
          <Name>Cboe Cumulative Executed Volume</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Cumulative number of shares traded today.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Reserved</Description>
        </Field>
        <Field>
          <Name>Trade Flags</Name>
          <Type>Bit Field</Type>
          <Size>1</Size>
          <Description>Bit 0: Reserved. Bit 1: 0: Trade is not last-sale eligible 1: Trade is last-sale eligible Bits 2-7: Reserved.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trade Break Message -->
    <Message>
      <Name>Trade Break Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0xAA</Code>
      <Description>Trade Break Message</Description>
      <Fields>
        <Field>
          <Name>Transaction Time</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>The time the trade break occurred, encoded as the number of nanoseconds since midnight.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Reserved</Description>
        </Field>
        <Field>
          <Name>Execution ID</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Execution identifier of trade to be broken.</Description>
        </Field>
        <Field>
          <Name>Cboe Cumulative Executed Volume</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Cumulative number of shares traded today.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Reserved</Description>
        </Field>
        <Field>
          <Name>Trade Break Flags</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Reserved</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trading Status Message -->
    <Message>
      <Name>Trading Status Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0xAB</Code>
      <Description>Trading Status Message</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Timestamp of the matching engine trading status message, encoded as the number of nanoseconds since midnight.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alphanumeric</Type>
          <Size>8</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Reserved</Description>
        </Field>
        <Field>
          <Name>Halt Status</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Halt Status</Description>
        </Field>
        <Field>
          <Name>Reg SHO Action</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Reg SHO Action</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <!-- Groups -->

  <Groups>

    <!-- ADAP Block -->
    <Group>
      <Name>ADAP Block</Name>
      <Dependency>ADAP Blocks</Dependency>
      <Description>Adap Block</Description>
      <Fields>
        <Field>
          <Name>Adap Block Size</Name>
          <Type>Binary</Type>
          <Size>1</Size>
          <Description>Size of each ADAP Block</Description>
        </Field>
        <Field>
          <Name>ADAP Update</Name>
          <Type>struct</Type>
          <Size>0</Size>
          <Description>Adap block update</Description>
        </Field>
      </Fields>
    </Group>

  </Groups>

  <!-- Structs -->

  <Structs>

    <!-- Short Update ADAP Block -->
    <Struct>
      <Name>Short Update ADAP Block</Name>
      <Description>Short Update ADAP Block</Description>
      <Fields>
        <Field>
          <Name>Side</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Side</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary 4.4 Price</Type>
          <Size>4</Size>
          <Description>Price level to add/update in the ADAP book</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Binary</Type>
          <Size>4</Size>
          <Description>Quantity of shares at this price level in the ADAP book</Description>
        </Field>
      </Fields>
    </Struct>

    <!-- Long Update ADAP Block -->
    <Struct>
      <Name>Long Update ADAP Block</Name>
      <Description>Long Update ADAP Block</Description>
      <Fields>
        <Field>
          <Name>Side</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Side</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary 8.4 Price</Type>
          <Size>8</Size>
          <Description>Price level to add/update in the ADAP book</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Binary</Type>
          <Size>8</Size>
          <Description>Quantity of shares at this price level in the ADAP book</Description>
        </Field>
      </Fields>
    </Struct>

  </Structs>

  <!-- Bitfields -->

  <Bitfields>

    <!-- ADAP Flags -->
    <Bitfield>
      <Name>Adap Flags</Name>
      <Description>Adap Flags</Description>
      <Fields>
        <Field>
          <Name>Clear</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>Update ADAP Blocks to follow</Description>
        </Field>
        <Field>
          <Name>Complete</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>Update ADAP Blocks to follow</Description>
        </Field>
        <Field>
          <Name>Block Type</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>Update ADAP Blocks to follow</Description>
        </Field>
        <Field>
          <Name>Adap Reserved Flags</Name>
          <Bits>5</Bits>
          <Type>bit</Type>
          <Description>Reserved 2-7 Bits</Description>
        </Field>
      </Fields>
    </Bitfield>

    <!-- Trade Flags -->
    <Bitfield>
      <Name>Trade Flags</Name>
      <Description>Trade Flags</Description>
      <Fields>
        <Field>
          <Name>Unused</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>Reserved</Description>
        </Field>
        <Field>
          <Name>last-sale eligible</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>last-sale eligible</Description>
        </Field>
        <Field>
          <Name>Reserved Trade Flags</Name>
          <Bits>6</Bits>
          <Type>bit</Type>
          <Description>Reserved 2-7 Bits</Description>
        </Field>
      </Fields>
    </Bitfield>

  </Bitfields>

  <!-- Enums -->

  <Enums>

    <!-- Market Status -->
    <Enum>
      <Name>Market Status</Name>
      <Values>
        <Value>
          <Data>N</Data>
          <Name>Normal</Name>
        </Value>
        <Value>
          <Data>E</Data>
          <Name>Excluded from ADAP updates</Name>
        </Value>
        <Value>
          <Data>I</Data>
          <Name>Incomplete</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Session Indicator -->
    <Enum>
      <Name>Session Indicator</Name>
      <Values>
        <Value>
          <Data>R</Data>
          <Name>Regular trading session</Name>
        </Value>
        <Value>
          <Data>P</Data>
          <Name>Pre or post market session</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Side Indicator -->
    <Enum>
      <Name>Side Indicator</Name>
      <Values>
        <Value>
          <Data>B</Data>
          <Name>Buy Order</Name>
        </Value>
        <Value>
          <Data>S</Data>
          <Name>Sell Order</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Retail Price Improvement -->
    <Enum>
      <Name>Retail Price Improvement</Name>
      <Values>
        <Value>
          <Data>B</Data>
          <Name>Buy Side RPI</Name>
        </Value>
        <Value>
          <Data>S</Data>
          <Name>Sell Side RPI</Name>
        </Value>
        <Value>
          <Data>A</Data>
          <Name>Buy And Sell RPI</Name>
        </Value>
        <Value>
          <Data>N</Data>
          <Name>No RPI</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Trading Status -->
    <Enum>
      <Name>Trading Status</Name>
      <Values>
        <Value>
          <Data>A</Data>
          <Name>Accepting Orders for Queuing</Name>
        </Value>
        <Value>
          <Data>H</Data>
          <Name>Halted</Name>
        </Value>
        <Value>
          <Data>Q</Data>
          <Name>Quote Only</Name>
        </Value>
        <Value>
          <Data>S</Data>
          <Name>Exchange Specific Suspension</Name>
        </Value>
        <Value>
          <Data>T</Data>
          <Name>Trading</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Reg SHO Action -->
    <Enum>
      <Name>Reg SHO Action</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>No price test in effect</Name>
        </Value>
        <Value>
          <Data>1</Data>
          <Name>Reg SHO price test restriction in effect</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiPitchEquitiesPdf>
