            <Field>
              <Tag>32</Tag>
              <Name>LastQty</Name>
              <Required>N</Required>
              <Type>Qty</Type>
              <Description>The corrected quantity. Required if Trade Correct.</Description>
            </Field>
            <Field>
              <Tag>6</Tag>
              <Name>AvgPx</Name>
              <Required>Y</Required>
              <Type>Price</Type>
              <Description>The calculated average price of all fills for the executed order.</Description>
            </Field>
          </Fields>
        </Branch>
      </Fields>
