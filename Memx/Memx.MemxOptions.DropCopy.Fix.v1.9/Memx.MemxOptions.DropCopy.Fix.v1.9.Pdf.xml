          <Description>Unique identifier for an Order assigned by the exchange.</Description>
        </Field>
        <Field>
          <Tag>11</Tag>
          <Name>ClOrdID</Name>
          <Required>Y</Required>
          <Type>String</Type>
          <Description>Unique identifier for an Order as assigned by the client.</Description>
        </Field>
        <Field>
          <Tag>17</Tag>
          <Name>ExecID</Name>
          <Required>Y</Required>
