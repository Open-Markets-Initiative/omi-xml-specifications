<OmiItchTradelogiqPdf>

  <Messages>

    <!-- System Event Message -->
    <Message>
      <Name>System Event Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>S</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>The spin consists of a Start-Of-Messages event, Add Order messages and an End-Of-Messages event, after which the Reallocation Server disconnects.</Description>
      <Fields>
        <Field>
          <Name>Event Code</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Start-Of-Messages opens the spin and End-Of-Messages closes it</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Alpha</Type>
          <Size>2</Size>
          <Description>Reserved</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Nanoseconds since midnight.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Stock Directory Message -->
    <Message>
      <Name>Stock Directory Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>R</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>A Requested Sequence Number of 1 returns the symbol spin, the Instrument Directory messages distributed early in the Tradelogiq start of day.</Description>
      <Fields>
        <Field>
          <Name>Market</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Indicates the listing market of security</Description>
        </Field>
        <Field>
          <Name>Stock</Name>
          <Type>Alphanumeric &amp; '.'</Type>
          <Size>10</Size>
          <Description>Denotes the security symbol on Omega ATS and Lynx ATS</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Nanoseconds since midnight.</Description>
        </Field>
        <Field>
          <Name>Board Lot Size</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Indicates a board lot size</Description>
        </Field>
        <Field>
          <Name>Instrument ID</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Internal instrument identifier for Omega ATS and Lynx ATS</Description>
        </Field>
        <Field>
          <Name>Shortable</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Indicates the short status of a security</Description>
        </Field>
        <Field>
          <Name>Dividend Indicator</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Dividend frequency of the security</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Alphanumeric</Type>
          <Size>9</Size>
          <Description>Reserved for future use</Description>
        </Field>
        <Field>
          <Name>Currency</Name>
          <Type>Alpha</Type>
          <Size>3</Size>
          <Description>Indicates currency for the symbol</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Extended Stock Directory Message -->
    <Message>
      <Name>Extended Stock Directory Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>r</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>The symbol spin carries the Extended Stock Directory of bonds, debentures, rights, notes and warrants alongside the Stock Directory.</Description>
      <Fields>
        <Field>
          <Name>Market</Name>
          <Type>Alphanumeric</Type>
          <Size>1</Size>
          <Description>Indicates the listing market of security</Description>
        </Field>
        <Field>
          <Name>Stock</Name>
          <Type>Alphanumeric &amp; '.'</Type>
          <Size>10</Size>
          <Description>Denotes the security symbol on Omega ATS and Lynx ATS</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Nanoseconds since midnight.</Description>
        </Field>
        <Field>
          <Name>Board Lot Size</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Indicates a board lot size</Description>
        </Field>
        <Field>
          <Name>Instrument ID</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Internal instrument identifier for Omega ATS and Lynx ATS</Description>
        </Field>
        <Field>
          <Name>Shortable</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Indicates the short status of a security</Description>
        </Field>
        <Field>
          <Name>Frequency</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Dividend frequency of the security</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Alphanumeric</Type>
          <Size>9</Size>
          <Description>Reserved for future use</Description>
        </Field>
        <Field>
          <Name>Currency</Name>
          <Type>Alpha</Type>
          <Size>3</Size>
          <Description>Indicates currency for the symbol</Description>
        </Field>
        <Field>
          <Name>Security Type</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Instrument class of the security</Description>
        </Field>
        <Field>
          <Name>Expiry Date</Name>
          <Type>Date</Type>
          <Size>8</Size>
          <Description>Date of expiry in the format YYYYMMDD</Description>
        </Field>
        <Field>
          <Name>Description</Name>
          <Type>Alphanumeric</Type>
          <Size>20</Size>
          <Description>Description of Security</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Alpha</Type>
          <Size>3</Size>
          <Description>Reserved</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Stock Trading Action Message -->
    <Message>
      <Name>Stock Trading Action Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>H</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>If sequence 1 is used for the Sequenced Number field the reallocation server will return the symbol spin with the stock trading status messages before returning all open orders seen on the book.</Description>
      <Fields>
        <Field>
          <Name>Trading State</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>The current trading state for the issue</Description>
        </Field>
        <Field>
          <Name>Instrument ID</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Internal instrument identifier for Omega ATS and Lynx ATS</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Nanoseconds since midnight.</Description>
        </Field>
        <Field>
          <Name>Reason</Name>
          <Type>Alphanumeric</Type>
          <Size>4</Size>
          <Description>Reason the security is halted. Note: Field may be blank</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Add Order Message -->
    <Message>
      <Name>Add Order Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>A</Code>
      <Category>Order</Category>
      <Origin>Exchange</Origin>
      <Description>Only open orders are sent in the spin; the spin will not contain any message for an order which is no longer in the book.</Description>
      <Fields>
        <Field>
          <Name>Buy/Sell Indicator</Name>
          <Type>Alphabetic</Type>
          <Size>1</Size>
          <Description>Side of order</Description>
        </Field>
        <Field>
          <Name>Instrument ID</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Internal instrument identifier for Omega ATS and Lynx ATS</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Nanoseconds since midnight.</Description>
        </Field>
        <Field>
          <Name>Order Reference Number</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Unique reference number assigned to the new order.</Description>
        </Field>
        <Field>
          <Name>Shares</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Total number of shares associated with the order being added to the book</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Format>$$$$$$dddd</Format>
          <Description>The display price of the new order.</Description>
        </Field>
        <Field>
          <Name>Exec Broker ID</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Firm number or '1' for anonymous orders</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Alpha</Type>
          <Size>2</Size>
          <Description>Reserved</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- Event Code -->
    <Enum>
      <Name>Event Code</Name>
      <Values>
        <Value>
          <Data>O</Data>
          <Name>Start of Messages</Name>
          <Description>Start-Of-Messages event, the first message of the spin</Description>
        </Value>
        <Value>
          <Data>S</Data>
          <Name>Start of System Hours</Name>
          <Description>This message indicates that Tradelogiq is open and ready to start accepting orders.</Description>
        </Value>
        <Value>
          <Data>Q</Data>
          <Name>Start of Market Hours</Name>
          <Description>This message is intended to indicate that Market Hours orders are available for execution.</Description>
        </Value>
        <Value>
          <Data>M</Data>
          <Name>End of Market Hours</Name>
          <Description>This message is intended to indicate that Market Hours orders are no longer available for execution.</Description>
        </Value>
        <Value>
          <Data>E</Data>
          <Name>End of System Hours</Name>
          <Description>It indicates that Tradelogiq is now closed and will not accept any new orders.</Description>
        </Value>
        <Value>
          <Data>C</Data>
          <Name>End of Messages</Name>
          <Description>End-Of-Messages event, after which the Reallocation Server disconnects</Description>
        </Value>
        <Value>
          <Data>B</Data>
          <Name>Trading Halted</Name>
          <Description>Trading Halted due to Market-Wide Circuit Breaker</Description>
        </Value>
        <Value>
          <Data>R</Data>
          <Name>Trading Resumed</Name>
          <Description>Trading Resumed following Market-Wide Circuit Breaker</Description>
        </Value>
      </Values>
    </Enum>

