  <Messages>

    <!-- Seconds Message -->
    <Message>
      <Name>Seconds Message</Name>
      <Branch>Sequenced Message</Branch>
      <Dependency>Sequenced Message Type</Dependency>
      <Code>T</Code>
      <Category>Control</Category>
      <Origin>Exchange</Origin>
      <Description>This message is sent every second for which at least one message is being generated.</Description>
      <Fields>
        <Field>
          <Name>Second</Name>
          <Type>Numeric</Type>
          <Size>4</Size>
          <Description>Unix time (number of seconds since 1970-01-01 00:00:00 UTC)</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Book Directory Message -->
    <Message>
      <Name>Order Book Directory Message</Name>
      <Branch>Sequenced Message</Branch>
      <Dependency>Sequenced Message Type</Dependency>
      <Code>R</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>Order book directory messages are disseminated for all active securities, including halted securities, in the AIX Trading system.</Description>
      <Fields>
        <Field>
          <Name>Nanoseconds</Name>
          <Type>Numeric</Type>
          <Size>4</Size>
          <Description>Nanoseconds portion of the timestamp.</Description>
        </Field>
        <Field>
          <Name>Order book ID</Name>
          <Type>Numeric</Type>
          <Size>4</Size>
          <Description>Denotes the primary identifier of an order book.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alpha</Type>
          <Size>32</Size>
          <Description>Security short name.</Description>
        </Field>
        <Field>
          <Name>Long Name</Name>
          <Type>Alpha</Type>
          <Size>32</Size>
          <Description>Human-readable long name of security.</Description>
        </Field>
        <Field>
          <Name>ISIN</Name>
          <Type>Alpha</Type>
          <Size>12</Size>
          <Description>ISIN code identifying security.</Description>
        </Field>
        <Field>
          <Name>Financial Product</Name>
          <Type>Numeric</Type>
          <Size>1</Size>
          <Description>Financial product type.</Description>
        </Field>
        <Field>
          <Name>Trading Currency</Name>
          <Type>Alpha</Type>
          <Size>3</Size>
          <Description>Trading currency.</Description>
        </Field>
        <Field>
          <Name>Number of decimals in Price</Name>
          <Type>Numeric</Type>
          <Size>2</Size>
          <Description>This value defines the number of decimals used in price for this order book.</Description>
        </Field>
        <Field>
          <Name>Number of decimals in Nominal Value</Name>
          <Type>Numeric</Type>
          <Size>2</Size>
          <Description>This value defines the number of decimals in Nominal Value.</Description>
        </Field>
        <Field>
          <Name>Odd Lot Size</Name>
          <Type>Numeric</Type>
          <Size>4</Size>
          <Description>Indicates the number of securities that represents an odd lot for the order book.</Description>
        </Field>
        <Field>
          <Name>Round Lot Size</Name>
          <Type>Numeric</Type>
          <Size>4</Size>
          <Description>Indicates the quantity that represents a round lot for the issue</Description>
        </Field>
        <Field>
          <Name>Block Lot Size</Name>
          <Type>Numeric</Type>
          <Size>4</Size>
          <Description>Indicates the number of securities that represents an odd lot for the order book.</Description>
        </Field>
        <Field>
          <Name>Nominal Value</Name>
          <Type>Numeric</Type>
          <Size>8</Size>
          <Description>Nominal value.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Reserved</Type>
          <Size>1</Size>
          <Description>Reserved</Description>
        </Field>
        <Field>
          <Name>Underlying Order book ID</Name>
          <Type>Numeric</Type>
          <Size>4</Size>
          <Description>Order book ID of underlying instrument.</Description>
        </Field>
        <Field>
          <Name>Strike Price</Name>
          <Type>Price</Type>
          <Size>4</Size>
          <Description>Strike Price</Description>
        </Field>
        <Field>
          <Name>Expiration Date</Name>
          <Type>Date</Type>
          <Size>4</Size>
          <Description>Date of expiration.</Description>
        </Field>
        <Field>
          <Name>Number of decimals in Strike Price</Name>
          <Type>Numeric</Type>
          <Size>2</Size>
          <Description>Number of decimals used in Strike Price for this order book.</Description>
        </Field>
        <Field>
          <Name>Put or Call</Name>
          <Type>Numeric</Type>
          <Size>1</Size>
          <Description>Option type.</Description>
        </Field>
        <Field>
          <Name>Ranking Type</Name>
          <Type>Numeric</Type>
          <Size>1</Size>
          <Description>Specify what ranking type should be used.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Tick Size Table Entry Message -->
    <Message>
      <Name>Tick Size Table Entry Message</Name>
      <Branch>Sequenced Message</Branch>
      <Dependency>Sequenced Message Type</Dependency>
      <Code>L</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>This message contains information on a tick size for a price range.</Description>
      <Fields>
        <Field>
          <Name>Nanoseconds</Name>
          <Type>Numeric</Type>
          <Size>4</Size>
          <Description>Nanoseconds portion of the timestamp.</Description>
        </Field>
        <Field>
          <Name>Order book ID</Name>
          <Type>Numeric</Type>
          <Size>4</Size>
          <Description>The order book this entry belongs to.</Description>
        </Field>
        <Field>
          <Name>Tick Size</Name>
          <Type>Numeric</Type>
          <Size>8</Size>
          <Description>Tick Size for the given price range.</Description>
        </Field>
        <Field>
          <Name>Price From</Name>
          <Type>Price</Type>
          <Size>4</Size>
          <Description>Start of price range for this entry.</Description>
        </Field>
        <Field>
          <Name>Price To</Name>
          <Type>Price</Type>
          <Size>4</Size>
          <Description>End of price range for this entry.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Short Sell Status Message -->
    <Message>
      <Name>Short Sell Status Message</Name>
      <Branch>Sequenced Message</Branch>
      <Dependency>Sequenced Message Type</Dependency>
      <Code>V</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>A Short Sell Status Message indicates the short sell rules of an order book.</Description>
      <Fields>
        <Field>
          <Name>Nanoseconds</Name>
          <Type>Numeric</Type>
          <Size>4</Size>
          <Description>Nanoseconds portion of the timestamp.</Description>
        </Field>
        <Field>
          <Name>Order book ID</Name>
          <Type>Numeric</Type>
          <Size>4</Size>
          <Description>Order book identifier.</Description>
        </Field>
        <Field>
          <Name>Short Sale Restriction</Name>
          <Type>Numeric</Type>
          <Size>1</Size>
          <Description>Specify Short Sell status and what Short Sell validation rule that should be used.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Book State Message -->
    <Message>
      <Name>Order Book State Message</Name>
      <Branch>Sequenced Message</Branch>
      <Dependency>Sequenced Message Type</Dependency>
      <Code>O</Code>
      <Category>Control</Category>
      <Origin>Exchange</Origin>
      <Description>The Order book state message relays information on state changes.</Description>
      <Fields>
        <Field>
          <Name>Nanoseconds</Name>
          <Type>Numeric</Type>
          <Size>4</Size>
          <Description>Nanoseconds portion of the timestamp.</Description>
        </Field>
        <Field>
          <Name>Order book ID</Name>
          <Type>Numeric</Type>
          <Size>4</Size>
          <Description>Order book identifier.</Description>
        </Field>
        <Field>
          <Name>State Name</Name>
          <Type>Alpha</Type>
          <Size>20</Size>
          <Description>Name of Order book State</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Add Order Message -->
    <Message>
      <Name>Add Order Message</Name>
      <Branch>Sequenced Message</Branch>
      <Dependency>Sequenced Message Type</Dependency>
      <Code>A</Code>
      <Category>Trade</Category>
      <Origin>Exchange</Origin>
      <Description>An Add Order Message indicates that a new order has been accepted by the AIX Trading system and was added to the displayable book.</Description>
      <Fields>
        <Field>
          <Name>Nanoseconds</Name>
          <Type>Numeric</Type>
          <Size>4</Size>
          <Description>Nanoseconds portion of the timestamp.</Description>
        </Field>
        <Field>
          <Name>Order ID</Name>
          <Type>Numeric</Type>
          <Size>8</Size>
          <Description>The identifier assigned to the new order.</Description>
        </Field>
        <Field>
          <Name>Order book ID</Name>
          <Type>Numeric</Type>
          <Size>4</Size>
          <Description>Order book identifier.</Description>
        </Field>
        <Field>
          <Name>Side</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>"B" = buy order. "S" = sell order.</Description>
        </Field>
        <Field>
          <Name>Ranking Sequence Number</Name>
          <Type>Numeric</Type>
          <Size>4</Size>
          <Description>Transaction-based and sequential number starting from 1.</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Numeric</Type>
          <Size>8</Size>
          <Description>The visible quantity of the order.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Price</Type>
          <Size>4</Size>
          <Description>The display price of the new order.</Description>
        </Field>
        <Field>
          <Name>Order Attributes</Name>
          <Type>Numeric</Type>
          <Size>2</Size>
          <Description>Order attributes.</Description>
        </Field>
        <Field>
          <Name>Lot Type</Name>
          <Type>Numeric</Type>
          <Size>1</Size>
          <Description>Lot type.</Description>
        </Field>
        <Field>
          <Name>Ranking Time</Name>
          <Type>Numeric</Type>
          <Size>8</Size>
          <Description>Ranking timestamp - Nanosecond</Description>
        </Field>
      </Fields>
    </Message>

    <!-- End of Snapshot Message -->
    <Message>
      <Name>End of Snapshot Message</Name>
      <Branch>Sequenced Message</Branch>
      <Dependency>Sequenced Message Type</Dependency>
      <Code>G</Code>
      <Category>Control</Category>
      <Origin>Exchange</Origin>
      <Description>The end of snapshot message returns the current ITCH sequence number to be used when connecting to the ITCH feed.</Description>
      <Fields>
        <Field>
          <Name>Sequence Number</Name>
          <Type>Alpha</Type>
          <Size>20</Size>
          <Description>AIX ITCH SoupBinTCP sequence number when the snapshot was taken.</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

