<OmiLinkPdf>

  <Messages>

    <!-- Start of Spin Message -->
    <Message>
      <Name>Start of Spin Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>11</Code>
      <Category>Technical</Category>
      <Description>After a Spin Response Message, with status 'S', this message appears on all channels and indicates the beginning of a spin message cycle.</Description>
      <Fields>
        <Field>
          <Name>SpinType</Name>
          <Type>Binary Byte</Type>
          <Size>1</Size>
          <Description>Spin type.</Description>
        </Field>
        <Field>
          <Name>SpinStartTimeMilli</Name>
          <Type>Binary Long</Type>
          <Size>8</Size>
          <Description>Milliseconds since UTC epoch.</Description>
        </Field>
        <Field>
          <Name>SpinLastSeqNum</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Ignore, not used.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- End of Spin Message -->
    <Message>
      <Name>End of Spin Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>12</Code>
      <Category>Technical</Category>
      <Description>This message appears on all channels and indicates the end of a spin message cycle. It will be followed by a Spin Response Message, with status 'E'.</Description>
      <Fields>
        <Field>
          <Name>SpinType</Name>
          <Type>Binary Byte</Type>
          <Size>1</Size>
          <Description>Spin type.</Description>
        </Field>
        <Field>
          <Name>SpinMsgCt</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Total messages in spin.</Description>
        </Field>
        <Field>
          <Name>SpinEndTimeMilli</Name>
          <Type>Binary Long</Type>
          <Size>8</Size>
          <Description>Milliseconds since UTC epoch.</Description>
        </Field>
        <Field>
          <Name>SpinLastSeqNum</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Number of messages in spin.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trading Session Message -->
    <Message>
      <Name>Trading Session Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>20</Code>
      <Category>Administrative</Category>
      <Description>This message appears on all channels and is sent out at the start of each Overnight OTC IDQS trading session: Order Acceptance at 7:00 PM, Market Open at 8:00 PM, Market Close at 7:45 AM. The message can also be sent mid-day if a technical outage caused a temporary closure of the market.</Description>
      <Sequenced>Yes</Sequenced>
      <Fields>
        <Field>
          <Name>Session Time</Name>
          <Type>Binary Long</Type>
          <Size>8</Size>
          <Description>"Time" in the PDF, renamed to disambiguate from the 4-byte midnight "Time" field used in other messages. Milliseconds since UTC epoch.</Description>
        </Field>
        <Field>
          <Name>TradingSession</Name>
          <Type>Binary Byte</Type>
          <Size>1</Size>
          <Description>Trading session indicator.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Security Message -->
    <Message>
      <Name>Security Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>9</Code>
      <Category>Reference</Category>
      <Description>The Security Message appears on all channels and provides basic security attribute information for all OTC equity securities.</Description>
      <Sequenced>Yes</Sequenced>
      <Fields>
        <Field>
          <Name>Symbol</Name>
          <Type>Printable ASCII</Type>
          <Size>14</Size>
          <Description>Ticker symbol.</Description>
        </Field>
        <Field>
          <Name>LastUpdateMilli</Name>
          <Type>Binary Long</Type>
          <Size>8</Size>
          <Description>Milliseconds from UTC epoch.</Description>
        </Field>
        <Field>
          <Name>SecurityAction</Name>
          <Type>Binary Integer</Type>
          <Size>1</Size>
          <Description>Security action.</Description>
        </Field>
        <Field>
          <Name>AssetClass</Name>
          <Type>Binary Byte</Type>
          <Size>1</Size>
          <Description>Asset class.</Description>
        </Field>
        <Field>
          <Name>SecurityID</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Unique security ID issued by OTC Markets.</Description>
        </Field>
        <Field>
          <Name>SecurityFlags</Name>
          <Type>Bit Field</Type>
          <Size>2</Size>
          <Description>Notes security level attributes.</Description>
        </Field>
        <Field>
          <Name>Tier</Name>
          <Type>Binary Byte</Type>
          <Size>1</Size>
          <Description>The market tier assigned by OTC Markets Group.</Description>
        </Field>
        <Field>
          <Name>ReportingStatus</Name>
          <Type>Printable ASCII</Type>
          <Size>1</Size>
          <Description>Reporting status of the security.</Description>
        </Field>
        <Field>
          <Name>SecurityStatus</Name>
          <Type>Printable ASCII</Type>
          <Size>1</Size>
          <Description>Security trading status.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Add Message -->
    <Message>
      <Name>Order Add Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>21</Code>
      <Category>Order</Category>
      <Description>This message appears on the DOB channel. Indicates a new order added to the book.</Description>
      <Sequenced>Yes</Sequenced>
      <Fields>
        <Field>
          <Name>Time</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Milliseconds from midnight.</Description>
        </Field>
        <Field>
          <Name>Order Id</Name>
          <Type>Printable ASCII</Type>
          <Size>14</Size>
          <Description>Day-specific identifier assigned to this order. The Order ID consists of 14 alphanumeric characters; use the first 12 characters and convert them from base-36 to a 64-bit integer.</Description>
        </Field>
        <Field>
          <Name>Side Indicator</Name>
          <Type>Printable ASCII</Type>
          <Size>1</Size>
          <Description>"B" = Buy Order, "S" = Sell Order.</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Number of shares being added to the book.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Printable ASCII</Type>
          <Size>14</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary Long Price</Type>
          <Size>8</Size>
          <Description>The limit order price. The long value represents the price scaled by 1,000,000 (6 decimal places).</Description>
        </Field>
        <Field>
          <Name>Firm Id</Name>
          <Type>Printable ASCII</Type>
          <Size>4</Size>
          <Description>Firm's MPID.</Description>
        </Field>
        <Field>
          <Name>Unsolicited</Name>
          <Type>Printable ASCII</Type>
          <Size>1</Size>
          <Description>"Y" = Unsolicited, "N" = Not Unsolicited.</Description>
        </Field>
        <Field>
          <Name>Order Flags</Name>
          <Type>Binary Short Integer</Type>
          <Size>2</Size>
          <Description>TBD.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Update Message -->
    <Message>
      <Name>Order Update Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>22</Code>
      <Category>Order</Category>
      <Description>This message appears on the DOB channel. Indicates an existing order has been modified.</Description>
      <Sequenced>Yes</Sequenced>
      <Fields>
        <Field>
          <Name>Time</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Milliseconds from midnight.</Description>
        </Field>
        <Field>
          <Name>Order Id</Name>
          <Type>Printable ASCII</Type>
          <Size>14</Size>
          <Description>Order Id of a previously sent Add Order message that has been modified.</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Number of shares associated with this order after this modify (may be less than the number entered).</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary Long Price</Type>
          <Size>8</Size>
          <Description>The limit order price after this modify. The long value represents the price scaled by 1,000,000 (6 decimal places).</Description>
        </Field>
        <Field>
          <Name>Order Flags</Name>
          <Type>Binary Short Integer</Type>
          <Size>2</Size>
          <Description>TBD.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Delete Message -->
    <Message>
      <Name>Order Delete Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>23</Code>
      <Category>Order</Category>
      <Description>This message appears on the DOB channel. Indicates an existing order has been deleted from the book.</Description>
      <Sequenced>Yes</Sequenced>
      <Fields>
        <Field>
          <Name>Time</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Milliseconds from midnight.</Description>
        </Field>
        <Field>
          <Name>Order Id</Name>
          <Type>Printable ASCII</Type>
          <Size>14</Size>
          <Description>Order Id of a previously sent Add Order message that has been deleted.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Execution Message -->
    <Message>
      <Name>Order Execution Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>24</Code>
      <Category>Trade</Category>
      <Description>This message appears on the DOB channel. An Order Executed message will be published when all or some of the displayed quantity of a previously published order executes at the published price.</Description>
      <Sequenced>Yes</Sequenced>
      <Fields>
        <Field>
          <Name>Time</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Milliseconds from midnight.</Description>
        </Field>
        <Field>
          <Name>Order Id</Name>
          <Type>Printable ASCII</Type>
          <Size>14</Size>
          <Description>Order Id of a previously sent Add Order message that was executed.</Description>
        </Field>
        <Field>
          <Name>Executed Quantity</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Number of shares executed.</Description>
        </Field>
        <Field>
          <Name>Remaining Quantity</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Number of shares remaining after the execution. Will be zero if fully filled.</Description>
        </Field>
        <Field>
          <Name>Execution Id</Name>
          <Type>Binary Long</Type>
          <Size>8</Size>
          <Description>System generated day-unique execution identifier of this execution.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Execution with Price Message -->
    <Message>
      <Name>Order Execution with Price Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>25</Code>
      <Category>Trade</Category>
      <Description>This message appears on the DOB channel. An Order Executed with Price message will be published when all or some of the displayed quantity of a previously published order executes at a price different than the published price.</Description>
      <Sequenced>Yes</Sequenced>
      <Fields>
        <Field>
          <Name>Time</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Milliseconds from midnight.</Description>
        </Field>
        <Field>
          <Name>Order Id</Name>
          <Type>Printable ASCII</Type>
          <Size>14</Size>
          <Description>Order Id of a previously sent Add Order message that was executed.</Description>
        </Field>
        <Field>
          <Name>Executed Quantity</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Number of shares executed.</Description>
        </Field>
        <Field>
          <Name>Remaining Quantity</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Number of shares remaining after the execution. Will be zero if fully filled.</Description>
        </Field>
        <Field>
          <Name>Execution Id</Name>
          <Type>Binary Long</Type>
          <Size>8</Size>
          <Description>System generated day-unique execution identifier of this execution.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary Long Price</Type>
          <Size>8</Size>
          <Description>The execution price of the order. The long value represents the price scaled by 1,000,000 (6 decimal places).</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trade Message -->
    <Message>
      <Name>Trade Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>26</Code>
      <Category>Trade</Category>
      <Description>This message appears on the DOB channel. A Trade message will be published when non-displayed quantity of a previously published reserve order executes or when an order executes that is less than Min Quote Size and does not currently have an active Order Add message.</Description>
      <Sequenced>Yes</Sequenced>
      <Fields>
        <Field>
          <Name>Time</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Milliseconds from midnight.</Description>
        </Field>
        <Field>
          <Name>Side Indicator</Name>
          <Type>Printable ASCII</Type>
          <Size>1</Size>
          <Description>Always "B" = Buy Order regardless of resting side.</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Incremental number of shares executed.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Printable ASCII</Type>
          <Size>14</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary Long Price</Type>
          <Size>8</Size>
          <Description>The execution price of the order. The long value represents the price scaled by 1,000,000 (6 decimal places).</Description>
        </Field>
        <Field>
          <Name>Execution Id</Name>
          <Type>Binary Long</Type>
          <Size>8</Size>
          <Description>System generated day-unique execution identifier of this trade.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary Long</Type>
          <Size>8</Size>
          <Description>Reserved.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Imbalance Message -->
    <Message>
      <Name>Imbalance Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>28</Code>
      <Category>Imbalance</Category>
      <Description>This message appears on all channels. This message is not available in the Overnight TradingSession.</Description>
      <Sequenced>Yes</Sequenced>
      <Fields>
        <Field>
          <Name>Time</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Milliseconds from midnight.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Printable ASCII</Type>
          <Size>14</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Current Inside Paired Shares</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Number of OC and IO shares that would be matched at the Current Inside Closing Price.</Description>
        </Field>
        <Field>
          <Name>Current Inside Closing Price</Name>
          <Type>Binary Long Price</Type>
          <Size>8</Size>
          <Description>The calculated closing price without Day / extended Day orders, bounded by the inside. The long value represents the price scaled by 1,000,000 (6 decimal places).</Description>
        </Field>
        <Field>
          <Name>Current Inside Imbalance Quantity</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Number of marketable OC and IO shares that would be left unmatched at the Current Inside Closing Price.</Description>
        </Field>
        <Field>
          <Name>Current Inside Imbalance Side</Name>
          <Type>Printable ASCII</Type>
          <Size>1</Size>
          <Description>Buy or sell side of the Current Inside Imbalance Quantity.</Description>
        </Field>
        <Field>
          <Name>Full Closing Price</Name>
          <Type>Binary Long Price</Type>
          <Size>8</Size>
          <Description>The calculated closing price. The long value represents the price scaled by 1,000,000 (6 decimal places).</Description>
        </Field>
        <Field>
          <Name>OC/IO Only Closing Price</Name>
          <Type>Binary Long Price</Type>
          <Size>8</Size>
          <Description>The calculated closing price without Day / extended Day orders. The long value represents the price scaled by 1,000,000 (6 decimal places).</Description>
        </Field>
        <Field>
          <Name>MOC shares unmatched</Name>
          <Type>Printable ASCII</Type>
          <Size>1</Size>
          <Description>Indicates if any MOC shares are left unmatched.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- System Recovery Event Message -->
    <Message>
      <Name>System Recovery Event Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>74</Code>
      <Category>Technical</Category>
      <Description>In case of a catastrophic issue at the exchange, the system sends a System Recovery Event. The first event (type 'S') instructs clients to prepare and reset caches; clients must clean all cached state. A second event (type 'B') indicates recovery begins, after which the system performs a spin for all symbols and open orders.</Description>
      <Fields>
        <Field>
          <Name>Deprecated</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Deprecated.</Description>
        </Field>
        <Field>
          <Name>Recovery Type</Name>
          <Type>Binary Byte</Type>
          <Size>1</Size>
          <Description>Recovery event type.</Description>
        </Field>
        <Field>
          <Name>Next Sequence Number</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Sequence Number that you should use when recovery starts. If set to 0, sequence number will not reset. Only set when Recovery Type is 'S'.</Description>
        </Field>
        <Field>
          <Name>Recovery Start time</Name>
          <Type>Binary Long</Type>
          <Size>8</Size>
          <Description>Expected time recovery spin will start.</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Bitfields>

    <!-- SecurityFlags -->
    <Bitfield>
      <Name>SecurityFlags</Name>
      <Description>This flag notes security level attributes and is only included in the Security Message.</Description>
      <Fields>
        <Field>
          <Name>PiggybackFlag</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>15c2-11 "PiggyBack" exempt security status flag.</Description>
        </Field>
        <Field>
          <Name>CaveatFlag</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>Indicates whether a Caveat Emptor warning has been applied to the security.</Description>
        </Field>
        <Field>
          <Name>QIB Only 144A</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>"144A QIB Only" in the PDF. Indicates that the security may only be purchased or sold by Qualified Institutional Buyers (QIBs) or agents acting on behalf of QIBs.</Description>
        </Field>
        <Field>
          <Name>UnsolicitedOnlyFlag</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>Indicates if a security may only be quoted Unsolicited.</Description>
        </Field>
        <Field>
          <Name>Closing Cross Auction</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>Indicates if security participates in the OTC Link Closing Cross Auction.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Bits>11</Bits>
          <Type>bit</Type>
          <Description>Reserved.</Description>
        </Field>
      </Fields>
    </Bitfield>

  </Bitfields>

