<OmiLinkPdf>

  <Messages>

    <!-- Start of Spin Message -->
    <Message>
      <Name>Start of Spin Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>11</Code>
      <Category>Technical</Category>
      <Description>Appears within the TCP spin response cycle (between Spin Response 'S' and 'E') and also on the UDP multicast feeds at the daily spin-out. Indicates the beginning of a spin message cycle.</Description>
      <Fields>
        <Field>
          <Name>SpinType</Name>
          <Type>Binary Byte</Type>
          <Size>1</Size>
          <Description>Spin type.</Description>
        </Field>
        <Field>
          <Name>SpinStartTimeMilli</Name>
          <Type>Binary Long</Type>
          <Size>8</Size>
          <Description>Milliseconds since UTC epoch.</Description>
        </Field>
        <Field>
          <Name>SpinLastSeqNum</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Ignore, not used.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- End of Spin Message -->
    <Message>
      <Name>End of Spin Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>12</Code>
      <Category>Technical</Category>
      <Description>Appears within the TCP spin response cycle (between Spin Response 'S' and 'E') and also on the UDP multicast feeds at the daily spin-out. Indicates the end of a spin message cycle.</Description>
      <Fields>
        <Field>
          <Name>SpinType</Name>
          <Type>Binary Byte</Type>
          <Size>1</Size>
          <Description>Spin type.</Description>
        </Field>
        <Field>
          <Name>SpinMsgCt</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Total messages in spin.</Description>
        </Field>
        <Field>
          <Name>SpinEndTimeMilli</Name>
          <Type>Binary Long</Type>
          <Size>8</Size>
          <Description>Milliseconds since UTC epoch.</Description>
        </Field>
        <Field>
          <Name>SpinLastSeqNum</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Number of messages in spin.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trading Session Message -->
    <Message>
      <Name>Trading Session Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>20</Code>
      <Category>Administrative</Category>
      <Description>Appears in the TCP spin response payload (and on all UDP channels). Sent at the start of each NQB IDQS trading session: Order Acceptance at 6 AM, Pre-Market Open at 8 AM, Market Open at 9:30 AM, After Hours at 4 PM, Market Close at 5 PM.</Description>
      <Sequenced>Yes</Sequenced>
      <Fields>
        <Field>
          <Name>Session Time</Name>
          <Type>Binary Long</Type>
          <Size>8</Size>
          <Description>"Time" in the PDF, renamed to disambiguate from the 4-byte midnight "Time" field used in other messages. Milliseconds since UTC epoch.</Description>
        </Field>
        <Field>
          <Name>TradingSession</Name>
          <Type>Binary Byte</Type>
          <Size>1</Size>
          <Description>Trading session indicator.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Security Message -->
    <Message>
      <Name>Security Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>9</Code>
      <Category>Reference</Category>
      <Description>Appears in the TCP spin response payload (and on all UDP channels). Provides basic security attribute information for all OTC equity securities.</Description>
      <Sequenced>Yes</Sequenced>
      <Fields>
        <Field>
          <Name>Symbol</Name>
          <Type>Printable ASCII</Type>
          <Size>14</Size>
          <Description>Ticker symbol.</Description>
        </Field>
        <Field>
          <Name>LastUpdateMilli</Name>
          <Type>Binary Long</Type>
          <Size>8</Size>
          <Description>Milliseconds from UTC epoch.</Description>
        </Field>
        <Field>
          <Name>SecurityAction</Name>
          <Type>Binary Integer</Type>
          <Size>1</Size>
          <Description>Security action.</Description>
        </Field>
        <Field>
          <Name>AssetClass</Name>
          <Type>Binary Byte</Type>
          <Size>1</Size>
          <Description>Asset class.</Description>
        </Field>
        <Field>
          <Name>SecurityID</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Unique security ID issued by OTC Markets.</Description>
        </Field>
        <Field>
          <Name>SecurityFlags</Name>
          <Type>Bit Field</Type>
          <Size>2</Size>
          <Description>Notes security level attributes.</Description>
        </Field>
        <Field>
          <Name>Tier</Name>
          <Type>Binary Byte</Type>
          <Size>1</Size>
          <Description>The market tier assigned by OTC Markets Group.</Description>
        </Field>
        <Field>
          <Name>ReportingStatus</Name>
          <Type>Printable ASCII</Type>
          <Size>1</Size>
          <Description>Reporting status of the security.</Description>
        </Field>
        <Field>
          <Name>SecurityStatus</Name>
          <Type>Printable ASCII</Type>
          <Size>1</Size>
          <Description>Security trading status.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Add Message -->
    <Message>
      <Name>Order Add Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>21</Code>
      <Category>Order</Category>
      <Description>Appears in the TCP spin response payload during DOB replay. Indicates a new order added to the book.</Description>
      <Sequenced>Yes</Sequenced>
      <Fields>
        <Field>
          <Name>Time</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Milliseconds from midnight.</Description>
        </Field>
        <Field>
          <Name>Order Id</Name>
          <Type>Printable ASCII</Type>
          <Size>14</Size>
          <Description>Day-specific identifier assigned to this order. The Order ID consists of 14 alphanumeric characters; use the first 12 characters and convert them from base-36 to a 64-bit integer.</Description>
        </Field>
        <Field>
          <Name>Side Indicator</Name>
          <Type>Printable ASCII</Type>
          <Size>1</Size>
          <Description>"B" = Buy Order, "S" = Sell Order.</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Number of shares being added to the book.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Printable ASCII</Type>
          <Size>14</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary Long Price</Type>
          <Size>8</Size>
          <Description>The limit order price. The long value represents the price scaled by 1,000,000 (6 decimal places).</Description>
        </Field>
        <Field>
          <Name>Firm Id</Name>
          <Type>Printable ASCII</Type>
          <Size>4</Size>
          <Description>Firm's MPID.</Description>
        </Field>
        <Field>
          <Name>Unsolicited</Name>
          <Type>Printable ASCII</Type>
          <Size>1</Size>
          <Description>"Y" = Unsolicited, "N" = Not Unsolicited.</Description>
        </Field>
        <Field>
          <Name>Order Flags</Name>
          <Type>Binary Short Integer</Type>
          <Size>2</Size>
          <Description>TBD.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Update Message -->
    <Message>
      <Name>Order Update Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>22</Code>
      <Category>Order</Category>
      <Description>Appears in the TCP spin response payload during DOB replay. Indicates an existing order has been modified.</Description>
      <Sequenced>Yes</Sequenced>
      <Fields>
        <Field>
          <Name>Time</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Milliseconds from midnight.</Description>
        </Field>
        <Field>
          <Name>Order Id</Name>
          <Type>Printable ASCII</Type>
          <Size>14</Size>
          <Description>Order Id of a previously sent Add Order message that has been modified.</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Number of shares associated with this order after this modify (may be less than the number entered).</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary Long Price</Type>
          <Size>8</Size>
          <Description>The limit order price after this modify. The long value represents the price scaled by 1,000,000 (6 decimal places).</Description>
        </Field>
        <Field>
          <Name>Order Flags</Name>
          <Type>Binary Short Integer</Type>
          <Size>2</Size>
          <Description>TBD.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Delete Message -->
    <Message>
      <Name>Order Delete Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>23</Code>
      <Category>Order</Category>
      <Description>Appears in the TCP spin response payload during DOB replay. Indicates an existing order has been deleted from the book.</Description>
      <Sequenced>Yes</Sequenced>
      <Fields>
        <Field>
          <Name>Time</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Milliseconds from midnight.</Description>
        </Field>
        <Field>
          <Name>Order Id</Name>
          <Type>Printable ASCII</Type>
          <Size>14</Size>
          <Description>Order Id of a previously sent Add Order message that has been deleted.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Execution Message -->
    <Message>
      <Name>Order Execution Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>24</Code>
      <Category>Trade</Category>
      <Description>Appears in the TCP spin response payload during DOB replay. Published when all or some of the displayed quantity of a previously published order executes at the published price.</Description>
      <Sequenced>Yes</Sequenced>
      <Fields>
        <Field>
          <Name>Time</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Milliseconds from midnight.</Description>
        </Field>
        <Field>
          <Name>Order Id</Name>
          <Type>Printable ASCII</Type>
          <Size>14</Size>
          <Description>Order Id of a previously sent Add Order message that was executed.</Description>
        </Field>
        <Field>
          <Name>Executed Quantity</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Number of shares executed.</Description>
        </Field>
        <Field>
          <Name>Remaining Quantity</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Number of shares remaining after the execution. Will be zero if fully filled.</Description>
        </Field>
        <Field>
          <Name>Execution Id</Name>
          <Type>Binary Long</Type>
          <Size>8</Size>
          <Description>System generated day-unique execution identifier of this execution.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Execution with Price Message -->
    <Message>
      <Name>Order Execution with Price Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>25</Code>
      <Category>Trade</Category>
      <Description>Appears in the TCP spin response payload during DOB replay. Published when all or some of the displayed quantity of a previously published order executes at a price different than the published price.</Description>
      <Sequenced>Yes</Sequenced>
      <Fields>
        <Field>
          <Name>Time</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Milliseconds from midnight.</Description>
        </Field>
        <Field>
          <Name>Order Id</Name>
          <Type>Printable ASCII</Type>
          <Size>14</Size>
          <Description>Order Id of a previously sent Add Order message that was executed.</Description>
        </Field>
        <Field>
          <Name>Executed Quantity</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Number of shares executed.</Description>
        </Field>
        <Field>
          <Name>Remaining Quantity</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Number of shares remaining after the execution. Will be zero if fully filled.</Description>
        </Field>
        <Field>
          <Name>Execution Id</Name>
          <Type>Binary Long</Type>
          <Size>8</Size>
          <Description>System generated day-unique execution identifier of this execution.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary Long Price</Type>
          <Size>8</Size>
          <Description>The execution price of the order. The long value represents the price scaled by 1,000,000 (6 decimal places).</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trade Message -->
    <Message>
      <Name>Trade Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>26</Code>
      <Category>Trade</Category>
      <Description>Appears in the TCP spin response payload during DOB replay. Published when non-displayed quantity of a previously published reserve order executes or when an order executes that is less than Min Quote Size and does not currently have an active Order Add message.</Description>
      <Sequenced>Yes</Sequenced>
      <Fields>
        <Field>
          <Name>Time</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Milliseconds from midnight.</Description>
        </Field>
        <Field>
          <Name>Side Indicator</Name>
          <Type>Printable ASCII</Type>
          <Size>1</Size>
          <Description>Always "B" = Buy Order regardless of resting side.</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Incremental number of shares executed.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Printable ASCII</Type>
          <Size>14</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Binary Long Price</Type>
          <Size>8</Size>
          <Description>The execution price of the order. The long value represents the price scaled by 1,000,000 (6 decimal places).</Description>
        </Field>
        <Field>
          <Name>Execution Id</Name>
          <Type>Binary Long</Type>
          <Size>8</Size>
          <Description>System generated day-unique execution identifier of this trade.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Binary Long</Type>
          <Size>8</Size>
          <Description>Reserved.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Top Of Book Message -->
    <Message>
      <Name>Top Of Book Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>27</Code>
      <Category>Quote</Category>
      <Description>Appears in the TCP spin response payload during TOB replay. Provides best bid and offer aggregated top-of-book.</Description>
      <Sequenced>Yes</Sequenced>
      <Fields>
        <Field>
          <Name>Time</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Milliseconds from midnight.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Printable ASCII</Type>
          <Size>14</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Ask Price</Name>
          <Type>Binary Long Price</Type>
          <Size>8</Size>
          <Description>Best Ask Price. The long value represents the price scaled by 1,000,000 (6 decimal places).</Description>
        </Field>
        <Field>
          <Name>Ask Volume</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Aggregate size at Ask Price.</Description>
        </Field>
        <Field>
          <Name>Bid Price</Name>
          <Type>Binary Long Price</Type>
          <Size>8</Size>
          <Description>Best Bid Price. The long value represents the price scaled by 1,000,000 (6 decimal places).</Description>
        </Field>
        <Field>
          <Name>Bid Volume</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Aggregate size at Bid Price.</Description>
        </Field>
        <Field>
          <Name>Unsolicited</Name>
          <Type>Printable ASCII</Type>
          <Size>1</Size>
          <Description>"Y" = Unsolicited, "N" = Not Unsolicited.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Imbalance Message -->
    <Message>
      <Name>Imbalance Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>28</Code>
      <Category>Imbalance</Category>
      <Description>Appears in the TCP spin response payload.</Description>
      <Sequenced>Yes</Sequenced>
      <Fields>
        <Field>
          <Name>Time</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Milliseconds from midnight.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Printable ASCII</Type>
          <Size>14</Size>
          <Description>Symbol right padded with spaces.</Description>
        </Field>
        <Field>
          <Name>Current Inside Paired Shares</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Number of OC and IO shares that would be matched at the Current Inside Closing Price.</Description>
        </Field>
        <Field>
          <Name>Current Inside Closing Price</Name>
          <Type>Binary Long Price</Type>
          <Size>8</Size>
          <Description>The calculated closing price without Day / extended Day orders, bounded by the inside. The long value represents the price scaled by 1,000,000 (6 decimal places).</Description>
        </Field>
        <Field>
          <Name>Current Inside Imbalance Quantity</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Number of marketable OC and IO shares that would be left unmatched at the Current Inside Closing Price.</Description>
        </Field>
        <Field>
          <Name>Current Inside Imbalance Side</Name>
          <Type>Printable ASCII</Type>
          <Size>1</Size>
          <Description>Buy or sell side of the Current Inside Imbalance Quantity.</Description>
        </Field>
        <Field>
          <Name>Full Closing Price</Name>
          <Type>Binary Long Price</Type>
          <Size>8</Size>
          <Description>The calculated closing price. The long value represents the price scaled by 1,000,000 (6 decimal places).</Description>
        </Field>
        <Field>
          <Name>OC/IO Only Closing Price</Name>
          <Type>Binary Long Price</Type>
          <Size>8</Size>
          <Description>The calculated closing price without Day / extended Day orders. The long value represents the price scaled by 1,000,000 (6 decimal places).</Description>
        </Field>
        <Field>
          <Name>MOC shares unmatched</Name>
          <Type>Printable ASCII</Type>
          <Size>1</Size>
          <Description>Indicates if any MOC shares are left unmatched.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- System Recovery Event Message -->
    <Message>
      <Name>System Recovery Event Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>74</Code>
      <Category>Technical</Category>
      <Description>System Recovery event. The first event (type 'S') instructs clients to prepare and reset caches; clients must clean all cached state. A second event (type 'B') indicates recovery begins, after which the system performs a spin for all symbols and open orders.</Description>
      <Fields>
        <Field>
          <Name>Deprecated</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Deprecated.</Description>
        </Field>
        <Field>
          <Name>Recovery Type</Name>
          <Type>Binary Byte</Type>
          <Size>1</Size>
          <Description>Recovery event type.</Description>
        </Field>
        <Field>
          <Name>Next Sequence Number</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Sequence Number that you should use when recovery starts. If set to 0, sequence number will not reset. Only set when Recovery Type is 'S'.</Description>
        </Field>
        <Field>
          <Name>Recovery Start time</Name>
          <Type>Binary Long</Type>
          <Size>8</Size>
          <Description>Expected time recovery spin will start.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Login Request Message -->
    <Message>
      <Name>Login Request Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>108</Code>
      <Category>Session</Category>
      <Description>"l" (lowercase L). Logon message is the first message required to send to the server once a connection is established. At minimum, the firm and user id should be provided.</Description>
      <Fields>
        <Field>
          <Name>UserId</Name>
          <Type>Printable ASCII</Type>
          <Size>16</Size>
          <Description>User id assigned by system.</Description>
        </Field>
        <Field>
          <Name>Password</Name>
          <Type>Printable ASCII</Type>
          <Size>16</Size>
          <Description>Password assigned by system.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Login Response Message -->
    <Message>
      <Name>Login Response Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>97</Code>
      <Category>Session</Category>
      <Description>"a". The Login Response Message is sent to a client's response to a TCP/IP Login Message. The status field is used to reflect an accepted login or the reason the session was not accepted. If login fails, the TCP/IP connection will be dropped.</Description>
      <Fields>
        <Field>
          <Name>UserId</Name>
          <Type>Printable ASCII</Type>
          <Size>16</Size>
          <Description>User id assigned by system.</Description>
        </Field>
        <Field>
          <Name>Login Status</Name>
          <Type>Binary Byte</Type>
          <Size>1</Size>
          <Description>Always "Y". If it is an invalid userid, system will close socket after 5 seconds without sending back a login response. Field renamed from "Status" in the PDF to disambiguate from sibling Status fields.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Retransmission Request Message -->
    <Message>
      <Name>Retransmission Request Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>114</Code>
      <Category>Recovery</Category>
      <Description>"r". Request retransmission of a range of messages.</Description>
      <Fields>
        <Field>
          <Name>Start Sequence</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Start sequence number.</Description>
        </Field>
        <Field>
          <Name>Number Of Messages</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Number of messages requested. -1 to indicate all messages up to date.</Description>
        </Field>
        <Field>
          <Name>Retran via TCP</Name>
          <Type>Binary Byte</Type>
          <Size>1</Size>
          <Description>"Y" - sent back on the same TCP channel.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Retransmission Response Message -->
    <Message>
      <Name>Retransmission Response Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>98</Code>
      <Category>Recovery</Category>
      <Description>"b". Response to a Retransmission Request. The replay server sends a heartbeat message every second. If the server replay response to a request takes too much time, then it is up to the client to either wait for a few heartbeats, or arbitrary time, then disconnect and send another replay request.</Description>
      <Fields>
        <Field>
          <Name>Start Sequence</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Start sequence number.</Description>
        </Field>
        <Field>
          <Name>Number Of Messages</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Number of messages requested.</Description>
        </Field>
        <Field>
          <Name>Retransmission Status</Name>
          <Type>Binary Byte</Type>
          <Size>1</Size>
          <Description>"Y" - retransmission will follow as requested. "N" - request ignored. Field renamed from "Status" in the PDF to disambiguate from sibling Status fields.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Spin Request Message -->
    <Message>
      <Name>Spin Request Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>115</Code>
      <Category>Recovery</Category>
      <Description>"s". Request a refresh spin of state from the server.</Description>
      <Fields>
        <Field>
          <Name>Client Identifier</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Optional client identifier.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Spin Response Message -->
    <Message>
      <Name>Spin Response Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>99</Code>
      <Category>Recovery</Category>
      <Description>"c". The server will send a Spin Response ("c") with status Start of Spin ("S"). It will then transmit Trading Session, Security, Orders or TOB, etc., followed by another Spin Response ("c") with status End of Spin ("E"). Ignore any Heartbeat messages. Spin messages are always returned to the same TCP socket from where they originated.</Description>
      <Fields>
        <Field>
          <Name>Client Identifier</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Echo back from spin request.</Description>
        </Field>
        <Field>
          <Name>Spin Status</Name>
          <Type>Binary Byte</Type>
          <Size>1</Size>
          <Description>"S" Start of Spin or "E" End of Spin. Field renamed from "Status" in the PDF to disambiguate from sibling Status fields.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Enhanced Spin Request Message -->
    <Message>
      <Name>Enhanced Spin Request Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>116</Code>
      <Category>Recovery</Category>
      <Description>"t". Request an enhanced spin which includes a last-sequence-number marker for syncing real time data.</Description>
      <Fields>
        <Field>
          <Name>Client Identifier</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Optional client identifier.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Enhanced Spin Response Message -->
    <Message>
      <Name>Enhanced Spin Response Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>100</Code>
      <Category>Recovery</Category>
      <Description>"d". The server will send an Enhanced Spin Response ("d") with status Start of Spin ("S"). It will then transmit Trading Session, Security, Orders or TOB, etc., followed by another Enhanced Spin Response ("d") with status End of Spin ("E"). Ignore any Heartbeat messages. Spin messages are always returned to the same TCP socket from where they originated.</Description>
      <Fields>
        <Field>
          <Name>Client Identifier</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Echo back from spin request.</Description>
        </Field>
        <Field>
          <Name>Enhanced Spin Status</Name>
          <Type>Binary Byte</Type>
          <Size>1</Size>
          <Description>"S" Start of Spin or "E" End of Spin. Field renamed from "Status" in the PDF to disambiguate from sibling Status fields.</Description>
        </Field>
        <Field>
          <Name>LastSeqNum</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Snapshot last sequence number to sync up with real time data. Start processing real time data from LastSeqNum + 1.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Heartbeat Message -->
    <Message>
      <Name>Heartbeat Message</Name>
      <Dependency>messagetype</Dependency>
      <Branch>payload</Branch>
      <Code>104</Code>
      <Category>Session</Category>
      <Description>"h". After login successful, FI will send a client a heartbeat once every 60 seconds. If there is no heartbeat from client for more than 5 minutes, system will disconnect.</Description>
      <Fields>
        <Field>
          <Name>Client Identifier</Name>
          <Type>Binary Integer</Type>
          <Size>4</Size>
          <Description>Optional identifier.</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

