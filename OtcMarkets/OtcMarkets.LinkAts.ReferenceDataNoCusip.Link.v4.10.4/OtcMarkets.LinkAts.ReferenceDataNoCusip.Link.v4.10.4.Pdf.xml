<OmiLinkPdf>

  <!-- OTC Markets Multicast Data Feeds v4.10.4 - Reference Data channel without CUSIP
       (Channel ID 7 real-time, 8 snapshot). Extended security (company name, etc.) information
       for market data recipients who do not own a cusip license. Same message shape as the
       cusip-bearing Reference Data channel except the trailing CUSIP field is omitted. -->

  <Messages>

    <!-- Start of Spin Message -->
    <Message>
      <Name>Start of Spin Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>11</Code>
      <Category>Reference Data</Category>
      <Description>This message appears on all channels and indicates the beginning of a spin message cycle.</Description>
      <Fields>
        <Field>
          <Name>ChannelSeqNum</Name>
          <Type>Unsigned Integer</Type>
          <Size>4</Size>
          <Description>Monotonically increasing message sequence number at the channel level.</Description>
        </Field>
        <Field>
          <Name>SpinType</Name>
          <Type>Unsigned Byte</Type>
          <Size>1</Size>
          <Description>Spin type</Description>
        </Field>
        <Field>
          <Name>SpinStartTimeMilli</Name>
          <Type>Unsigned Integer</Type>
          <Size>8</Size>
          <Description>Milliseconds since UTC epoch.</Description>
        </Field>
        <Field>
          <Name>SpinLastSeqNum</Name>
          <Type>Unsigned Integer</Type>
          <Size>4</Size>
          <Description>Last sequence number applied to this spin.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- End of Spin Message -->
    <Message>
      <Name>End of Spin Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>12</Code>
      <Category>Reference Data</Category>
      <Description>This message appears on all channels and indicates the end of a spin message cycle.</Description>
      <Fields>
        <Field>
          <Name>ChannelSeqNum</Name>
          <Type>Unsigned Integer</Type>
          <Size>4</Size>
          <Description>Monotonically increasing message sequence number at the channel level.</Description>
        </Field>
        <Field>
          <Name>SpinType</Name>
          <Type>Unsigned Byte</Type>
          <Size>1</Size>
          <Description>Spin type</Description>
        </Field>
        <Field>
          <Name>SpinMsgCt</Name>
          <Type>Unsigned Integer</Type>
          <Size>4</Size>
          <Description>Total number of messages in the spin.</Description>
        </Field>
        <Field>
          <Name>SpinEndTimeMilli</Name>
          <Type>Unsigned Integer</Type>
          <Size>8</Size>
          <Description>Milliseconds since UTC epoch.</Description>
        </Field>
        <Field>
          <Name>SpinLastSeqNum</Name>
          <Type>Unsigned Integer</Type>
          <Size>4</Size>
          <Description>Last sequence number applied to this spin.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Market Open Message -->
    <Message>
      <Name>Market Open Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>13</Code>
      <Category>Reference Data</Category>
      <Description>This message is sent out at 6 AM on all channels. The message can also be sent mid-day if a technical outage caused a temporary closure of the market.</Description>
      <Sequenced>Yes</Sequenced>
      <Fields>
        <Field>
          <Name>ChannelSeqNum</Name>
          <Type>Unsigned Integer</Type>
          <Size>4</Size>
          <Description>Monotonically increasing message sequence number at the channel level.</Description>
        </Field>
        <Field>
          <Name>MarketOpen</Name>
          <Type>Unsigned Integer</Type>
          <Size>8</Size>
          <Description>Market open time in milliseconds since UTC epoch.</Description>
        </Field>
        <Field>
          <Name>MarketClose</Name>
          <Type>Unsigned Integer</Type>
          <Size>8</Size>
          <Description>Anticipated market close time in milliseconds since UTC epoch.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Market Close Message -->
    <Message>
      <Name>Market Close Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>14</Code>
      <Category>Reference Data</Category>
      <Description>This message is sent out at 5 PM on all channels. The message can also be sent mid-day if a technical outage causes a temporary closure of the market.</Description>
      <Sequenced>Yes</Sequenced>
      <Fields>
        <Field>
          <Name>ChannelSeqNum</Name>
          <Type>Unsigned Integer</Type>
          <Size>4</Size>
          <Description>Monotonically increasing message sequence number at the channel level.</Description>
        </Field>
        <Field>
          <Name>MarketCloseTimeMilli</Name>
          <Type>Unsigned Integer</Type>
          <Size>8</Size>
          <Description>Market close time in milliseconds since UTC epoch midnight.</Description>
        </Field>
        <Field>
          <Name>MarketMsgCt</Name>
          <Type>Unsigned Integer</Type>
          <Size>4</Size>
          <Description>Total day message count.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Extended Security No Cusip Message -->
    <Message>
      <Name>Extended Security No Cusip Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>16</Code>
      <Category>Reference Data</Category>
      <Description>Extended security attribute information for OTC Markets securities. Sent on the Reference Data channel without CUSIP.</Description>
      <Sequenced>Yes</Sequenced>
      <Fields>
        <Field>
          <Name>ChannelSeqNum</Name>
          <Type>Unsigned Integer</Type>
          <Size>4</Size>
          <Description>Monotonically increasing message sequence number at the channel level.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>UTF-8</Type>
          <Size>10</Size>
          <Description>Ticker symbol.</Description>
        </Field>
        <Field>
          <Name>LastUpdateMilli</Name>
          <Type>Unsigned Integer</Type>
          <Size>8</Size>
          <Description>Milliseconds since UTC epoch.</Description>
        </Field>
        <Field>
          <Name>SecurityAction</Name>
          <Type>Unsigned Integer</Type>
          <Size>1</Size>
          <Description>Security action indicator.</Description>
        </Field>
        <Field>
          <Name>OTCIssuerID</Name>
          <Type>Unsigned Integer</Type>
          <Size>4</Size>
          <Description>Unique OTC issuer identifier.</Description>
        </Field>
        <Field>
          <Name>SecurityDesc</Name>
          <Type>UTF-8</Type>
          <Size>25</Size>
          <Description>Security description.</Description>
        </Field>
        <Field>
          <Name>ShortName</Name>
          <Type>UTF-8</Type>
          <Size>25</Size>
          <Description>Short name of the security.</Description>
        </Field>
        <Field>
          <Name>AssetClass</Name>
          <Type>Unsigned Integer</Type>
          <Size>1</Size>
          <Description>Asset class of the security.</Description>
        </Field>
        <Field>
          <Name>SecurityType</Name>
          <Type>UTF-8</Type>
          <Size>5</Size>
          <Description>Indicates the type of security.</Description>
        </Field>
        <Field>
          <Name>PrimaryMarket</Name>
          <Type>UTF-8</Type>
          <Size>3</Size>
          <Description>Primary market or exchange where the security trades.</Description>
        </Field>
        <Field>
          <Name>SecurityID</Name>
          <Type>Unsigned Integer</Type>
          <Size>4</Size>
          <Description>Unique security ID issued by OTC Markets.</Description>
        </Field>
        <Field>
          <Name>ExtendedSecurityFlags</Name>
          <Type>Bit Map</Type>
          <Size>2</Size>
          <Description>Extended security flags. See ExtendedSecurityFlags definition.</Description>
        </Field>
        <Field>
          <Name>Tier</Name>
          <Type>Unsigned Integer</Type>
          <Size>1</Size>
          <Description>Market tier assigned by OTC Markets Group.</Description>
        </Field>
        <Field>
          <Name>ReportingStatus</Name>
          <Type>UTF-8</Type>
          <Size>1</Size>
          <Description>Reporting status of the issuer.</Description>
        </Field>
        <Field>
          <Name>DisclosureStatus</Name>
          <Type>Unsigned Integer</Type>
          <Size>1</Size>
          <Description>Current disclosure status of the issuer.</Description>
        </Field>
        <Field>
          <Name>SecurityStatus</Name>
          <Type>UTF-8</Type>
          <Size>1</Size>
          <Description>Current security status.</Description>
        </Field>
        <Field>
          <Name>ParValue</Name>
          <Type>Unsigned Integer</Type>
          <Size>8</Size>
          <Description>Par value with 6 decimal places assumed. Zero indicates not available.</Description>
        </Field>
        <Field>
          <Name>Coupon</Name>
          <Type>Unsigned Integer</Type>
          <Size>8</Size>
          <Description>Coupon rate with 6 decimal places assumed. Fixed income only.</Description>
        </Field>
        <Field>
          <Name>MaturityDateMilli</Name>
          <Type>Unsigned Integer</Type>
          <Size>8</Size>
          <Description>Maturity date in milliseconds since UTC epoch. Fixed income only.</Description>
        </Field>
        <Field>
          <Name>CallableDateMilli</Name>
          <Type>Unsigned Integer</Type>
          <Size>8</Size>
          <Description>Callable date in milliseconds since UTC epoch. Fixed income only.</Description>
        </Field>
        <Field>
          <Name>ADRRatio</Name>
          <Type>Unsigned Integer</Type>
          <Size>8</Size>
          <Description>ADR ratio with 6 decimal places assumed. Equity ADR/GDR only.</Description>
        </Field>
        <Field>
          <Name>ADRLevel</Name>
          <Type>UTF-8</Type>
          <Size>15</Size>
          <Description>ADR level. Equity ADR/GDR only.</Description>
        </Field>
        <Field>
          <Name>SecurityDetail</Name>
          <Type>composite</Type>
          <Size>Variable</Size>
          <Description>Security detail information</Description>
        </Field>
        <Field>
          <Name>Issuer</Name>
          <Type>composite</Type>
          <Size>Variable</Size>
          <Description>Issuer information</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Composites>

    <!-- Issuer -->
    <Composite>
      <Name>Issuer</Name>
      <Description>Issuer information, including name and size.</Description>
      <Maximum>75</Maximum>
      <Size>
        <Name>IssuerSize</Name>
        <Type>Unsigned Integer</Type>
        <Size>1</Size>
        <Description>Size of the IssuerName field. If zero, IssuerName is not present.</Description>
      </Size>
      <Data>
        <Name>IssuerName</Name>
        <Type>UTF-8</Type>
        <Size>variable</Size>
        <Description>Issuer name</Description>
      </Data>
    </Composite>

    <!-- Security Detail -->
    <Composite>
      <Name>SecurityDetail</Name>
      <Description>Security Detail Information, including name and size.</Description>
      <Maximum>75</Maximum>
      <Size>
        <Name>SecurityDetailSize</Name>
        <Type>Unsigned Integer</Type>
        <Size>1</Size>
        <Description>Size of the SecurityDetail field. If zero, SecurityDetail is not present.</Description>
      </Size>
      <Data>
        <Name>SecurityDetailName</Name>
        <Type>UTF-8</Type>
        <Size>variable</Size>
        <Description>Security detail name</Description>
      </Data>
    </Composite>

  </Composites>

