        <Field>
          <Name>Callable</Name>
          <Bits>1</Bits>
          <Type>bit</Type>
          <Description>Indicates if the security is callable</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Bits>5</Bits>
          <Type>bit</Type>
          <Description>Reserved</Description>
        </Field>
      </Fields>
    </Bitfield>

  </Bitfields>

