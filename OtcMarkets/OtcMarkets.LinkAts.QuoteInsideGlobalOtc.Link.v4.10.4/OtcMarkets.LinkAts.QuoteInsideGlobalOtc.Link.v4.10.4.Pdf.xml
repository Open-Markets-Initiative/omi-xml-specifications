  <!-- OTC Markets Multicast Data Feeds v4.10.4 - Quote Inside with Global OTC channel (Channel ID 21 real-time, 22 snapshot).
       Consolidated OTC Link/Global OTC Best Bid and Offer: best bid price, aggregate bid size, best offer price, aggregate offer size. -->

  <Messages>

    <!-- Start of Spin Message -->
    <Message>
      <Name>Start of Spin Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>11</Code>
      <Category>Quote Inside with Global OTC</Category>
      <Description>This message appears on all quote channels and indicates the beginning of a spin message cycle.</Description>
      <Fields>
        <Field>
          <Name>ChannelSeqNum</Name>
          <Type>Unsigned Integer</Type>
          <Size>4</Size>
          <Description>Monotonically increasing message sequence number at the channel level.</Description>
        </Field>
        <Field>
          <Name>SpinType</Name>
          <Type>Unsigned Byte</Type>
          <Size>1</Size>
          <Description>Spin type</Description>
        </Field>
        <Field>
          <Name>SpinStartTimeMilli</Name>
          <Type>Unsigned Integer</Type>
          <Size>8</Size>
          <Description>Milliseconds since UTC epoch.</Description>
        </Field>
        <Field>
          <Name>SpinLastSeqNum</Name>
          <Type>Unsigned Integer</Type>
          <Size>4</Size>
          <Description>Last sequence number applied to this spin.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- End of Spin Message -->
    <Message>
      <Name>End of Spin Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>12</Code>
      <Category>Quote Inside with Global OTC</Category>
      <Description>This message appears on all quote channels and indicates the end of a spin message cycle.</Description>
      <Fields>
        <Field>
          <Name>ChannelSeqNum</Name>
          <Type>Unsigned Integer</Type>
          <Size>4</Size>
          <Description>Monotonically increasing message sequence number at the channel level.</Description>
        </Field>
        <Field>
          <Name>SpinType</Name>
          <Type>Unsigned Byte</Type>
          <Size>1</Size>
          <Description>Spin type</Description>
        </Field>
        <Field>
          <Name>SpinMsgCt</Name>
          <Type>Unsigned Integer</Type>
          <Size>4</Size>
          <Description>Total number of messages in the spin.</Description>
        </Field>
        <Field>
          <Name>SpinEndTimeMilli</Name>
          <Type>Unsigned Integer</Type>
          <Size>8</Size>
          <Description>Milliseconds since UTC epoch.</Description>
        </Field>
        <Field>
          <Name>SpinLastSeqNum</Name>
          <Type>Unsigned Integer</Type>
          <Size>4</Size>
          <Description>Last sequence number applied to this spin.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Market Open Message -->
    <Message>
      <Name>Market Open Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>13</Code>
      <Category>Quote Inside with Global OTC</Category>
      <Description>This message is sent out at 6 AM on all channels. The message can also be sent mid-day if a technical outage caused a temporary closure of the market.</Description>
      <Sequenced>Yes</Sequenced>
      <Fields>
        <Field>
          <Name>ChannelSeqNum</Name>
          <Type>Unsigned Integer</Type>
          <Size>4</Size>
          <Description>Monotonically increasing message sequence number at the channel level.</Description>
        </Field>
        <Field>
          <Name>MarketOpen</Name>
          <Type>Unsigned Integer</Type>
          <Size>8</Size>
          <Description>Market open time in milliseconds since UTC epoch.</Description>
        </Field>
        <Field>
          <Name>MarketClose</Name>
          <Type>Unsigned Integer</Type>
          <Size>8</Size>
          <Description>Anticipated market close time in milliseconds since UTC epoch.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Market Close Message -->
    <Message>
      <Name>Market Close Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>14</Code>
      <Category>Quote Inside with Global OTC</Category>
      <Description>This message is sent out at 5 PM on all channels. The message can also be sent mid-day if a technical outage causes a temporary closure of the market.</Description>
      <Sequenced>Yes</Sequenced>
      <Fields>
        <Field>
          <Name>ChannelSeqNum</Name>
          <Type>Unsigned Integer</Type>
          <Size>4</Size>
          <Description>Monotonically increasing message sequence number at the channel level.</Description>
        </Field>
        <Field>
          <Name>MarketCloseTimeMilli</Name>
          <Type>Unsigned Integer</Type>
          <Size>8</Size>
          <Description>Market close time in milliseconds since UTC epoch midnight.</Description>
        </Field>
        <Field>
          <Name>MarketMsgCt</Name>
          <Type>Unsigned Integer</Type>
          <Size>4</Size>
          <Description>Total day message count.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Security Message -->
    <Message>
      <Name>Security Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>9</Code>
      <Category>Quote Inside with Global OTC</Category>
      <Description>The Security Message is included in all quote channels and provides basic security attribute information.</Description>
      <Sequenced>Yes</Sequenced>
      <Fields>
        <Field>
          <Name>ChannelSeqNum</Name>
          <Type>Unsigned Integer</Type>
          <Size>4</Size>
          <Description>Monotonically increasing message sequence number at the channel level.</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>UTF-8</Type>
          <Size>10</Size>
          <Description>Ticker symbol. Fixed income symbols may not have a symbol. For these securities, the SecurityID or CUSIP (Reference Data Security Message) must be used as an identifier.</Description>
        </Field>
        <Field>
          <Name>LastUpdateMilli</Name>
          <Type>Unsigned Integer</Type>
          <Size>8</Size>
          <Description>Milliseconds since UTC epoch.</Description>
        </Field>
        <Field>
          <Name>SecurityAction</Name>
          <Type>Unsigned Integer</Type>
          <Size>1</Size>
          <Description>Security action indicator.</Description>
        </Field>
        <Field>
          <Name>AssetClass</Name>
          <Type>Unsigned Integer</Type>
          <Size>1</Size>
          <Description>Asset class of the security.</Description>
        </Field>
        <Field>
          <Name>SecurityID</Name>
          <Type>Unsigned Integer</Type>
          <Size>4</Size>
          <Description>Unique security ID issued by OTC Markets.</Description>
        </Field>
        <Field>
          <Name>SecurityFlags</Name>
          <Type>Bit Map</Type>
          <Size>1</Size>
          <Description>Security flags. See SecurityFlags definition.</Description>
        </Field>
        <Field>
          <Name>Tier</Name>
          <Type>Unsigned Integer</Type>
          <Size>1</Size>
          <Description>Market tier assigned by OTC Markets Group.</Description>
        </Field>
        <Field>
          <Name>ReportingStatus</Name>
          <Type>UTF-8</Type>
          <Size>1</Size>
          <Description>Reporting status of the issuer.</Description>
        </Field>
        <Field>
          <Name>SecurityStatus</Name>
          <Type>UTF-8</Type>
          <Size>1</Size>
          <Description>Current security status.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Inside Message -->
    <Message>
      <Name>Inside Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>3</Code>
      <Category>Quote Inside with Global OTC</Category>
      <Description>This message is sent on the Quote Inside Channel and the Quote Inside with Global OTC data channel.</Description>
      <Sequenced>Yes</Sequenced>
      <Fields>
        <Field>
          <Name>ChannelSeqNum</Name>
          <Type>Unsigned Integer</Type>
          <Size>4</Size>
          <Description>Monotonically increasing message sequence number at the channel level.</Description>
        </Field>
        <Field>
          <Name>InsideID</Name>
          <Type>Unsigned Integer</Type>
          <Size>4</Size>
          <Description>Unique inside quote identifier.</Description>
        </Field>
        <Field>
          <Name>InsideAction</Name>
          <Type>Unsigned Integer</Type>
          <Size>1</Size>
          <Description>Inside action indicator (Add, Delete, Spin).</Description>
        </Field>
        <Field>
          <Name>QuoteFlags</Name>
          <Type>Bit Map</Type>
          <Size>1</Size>
          <Description>Inside quote flags. See InsideQuoteFlags definition.</Description>
        </Field>
        <Field>
          <Name>SecurityID</Name>
          <Type>Unsigned Integer</Type>
          <Size>4</Size>
          <Description>OTC Markets security identifier.</Description>
        </Field>
        <Field>
          <Name>AskPrice</Name>
          <Type>Unsigned Integer</Type>
          <Size>8</Size>
          <Description>Ask price with 6 decimal places assumed.</Description>
        </Field>
        <Field>
          <Name>AskSize</Name>
          <Type>Unsigned Integer</Type>
          <Size>4</Size>
          <Description>Number of shares at the ask.</Description>
        </Field>
        <Field>
          <Name>AskTimeMilli</Name>
          <Type>Unsigned Integer</Type>
          <Size>8</Size>
          <Description>Ask timestamp in milliseconds since UTC epoch.</Description>
        </Field>
        <Field>
          <Name>BidPrice</Name>
          <Type>Unsigned Integer</Type>
          <Size>8</Size>
          <Description>Bid price with 6 decimal places assumed.</Description>
        </Field>
        <Field>
          <Name>BidSize</Name>
          <Type>Unsigned Integer</Type>
          <Size>4</Size>
          <Description>Number of shares at the bid.</Description>
        </Field>
        <Field>
          <Name>BidTimeMilli</Name>
          <Type>Unsigned Integer</Type>
          <Size>8</Size>
          <Description>Bid timestamp in milliseconds since UTC epoch.</Description>
        </Field>
        <Field>
          <Name>AskNumPricedMP</Name>
          <Type>Unsigned Integer</Type>
          <Size>1</Size>
          <Description>Number of market participants at the ask inside price level.</Description>
        </Field>
        <Field>
          <Name>BidNumPricedMP</Name>
          <Type>Unsigned Integer</Type>
          <Size>1</Size>
          <Description>Number of market participants at the bid inside price level.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Inside Update Message -->
    <Message>
      <Name>Inside Update Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Payload</Branch>
      <Code>4</Code>
      <Category>Quote Inside with Global OTC</Category>
      <Description>Quote update information for the Quote Inside channel and the Quote Inside with Global OTC data channel.</Description>
      <Sequenced>Yes</Sequenced>
      <Fields>
        <Field>
          <Name>ChannelSeqNum</Name>
          <Type>Unsigned Integer</Type>
          <Size>4</Size>
          <Description>Monotonically increasing message sequence number at the channel level.</Description>
        </Field>
        <Field>
          <Name>InsideID</Name>
          <Type>Unsigned Integer</Type>
          <Size>4</Size>
          <Description>Inside ID referring back to the original inside reference.</Description>
        </Field>
        <Field>
          <Name>QuoteFlags</Name>
          <Type>Bit Map</Type>
          <Size>1</Size>
          <Description>Inside quote flags. See InsideQuoteFlags definition.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Unsigned Integer</Type>
          <Size>8</Size>
          <Description>Price with 6 decimal places assumed.</Description>
        </Field>
        <Field>
          <Name>Size</Name>
          <Type>Unsigned Integer</Type>
          <Size>4</Size>
          <Description>Number of shares at the inside price level.</Description>
        </Field>
        <Field>
          <Name>InsideTimeMilli</Name>
          <Type>Unsigned Integer</Type>
          <Size>8</Size>
          <Description>Timestamp in milliseconds since UTC epoch.</Description>
        </Field>
        <Field>
          <Name>NumPricedMP</Name>
          <Type>Unsigned Integer</Type>
          <Size>1</Size>
          <Description>Number of market participants at the inside price level.</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

