    <!-- Orderbook Directory Message -->
    <Message>
      <Name>Orderbook Directory Message</Name>
      <Dependency>Sequenced Message Type</Dependency>
      <Branch>Sequenced Message</Branch>
      <Code>R</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>Orderbook directory</Description>
      <Fields>
        <Field>
          <Name>Nanoseconds</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Nanoseconds since last Time Stamp seconds message</Description>
        </Field>
        <!--
        Offsets 5 to 8 are not tabulated in the v1.12.0 pdf: Table 13 runs from
        Timestamp straight to Isin at offset 9, leaving a 4 byte hole. Section 5.5
        states the message "contains the unique integer Orderbook identifier for
        use in fast security lookup", and every other orderbook scoped message
        carries Orderbook as a 4 byte Integer, so it is modelled as that here.
        Confirm with Biva before relying on it.
        -->
        <Field>
          <Name>Orderbook</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Unique orderbook identifier</Description>
        </Field>
        <Field>
          <Name>Isin</Name>
          <Type>Alpha</Type>
          <Size>12</Size>
          <Description>Isin code</Description>
        </Field>
        <Field>
          <Name>Sec Code</Name>
          <Type>Alpha</Type>
          <Size>15</Size>
          <Description>Security code</Description>
        </Field>
        <Field>
          <Name>Currency</Name>
          <Type>Alpha</Type>
          <Size>3</Size>
          <Description>Trading currency</Description>
        </Field>
        <Field>
          <Name>Group</Name>
          <Type>Alpha</Type>
          <Size>8</Size>
          <Description>Id for symbol grouping board only</Description>
        </Field>
        <Field>
          <Name>Minimum Quantity</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Minimum quantity</Description>
        </Field>
        <Field>
          <Name>Quantity Tick Size Table Id</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Quantity tick size table cross reference</Description>
        </Field>
        <Field>
          <Name>Quantity Decimals</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Quantity decimals</Description>
        </Field>
        <Field>
          <Name>Price Tick Size Table Id</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Price tick size table cross reference</Description>
        </Field>
        <Field>
          <Name>Price Decimals</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Price decimals</Description>
        </Field>
        <Field>
          <Name>Delisting or Maturity Date</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Yyyymmdd, 0 represents no delisting date</Description>
        </Field>
        <Field>
          <Name>Delisting Time</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Hhmmss, ignore if delisting date is 0</Description>
        </Field>
        <Field>
          <Name>Turnover Ratio</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>High, Medium or Low, blank if Opel-W</Description>
        </Field>
        <Field>
          <Name>Quotation Basis</Name>
          <Type>Alpha</Type>
          <Size>3</Size>
          <Description>Quotation basis indicator, blank if not set</Description>
        </Field>
        <Field>
          <Name>Instrument</Name>
          <Type>Alpha</Type>
          <Size>12</Size>
          <Description>The instrument name</Description>
        </Field>
        <Field>
          <Name>Listing Type</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Regular or Sub-Rm securities</Description>
        </Field>
        <Field>
          <Name>Listing Exchange</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Identifies the security listing exchange</Description>
        </Field>
      </Fields>
    </Message>

