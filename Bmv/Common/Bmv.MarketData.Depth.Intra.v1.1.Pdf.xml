<OmiBmvIntraPdf>

  <!-- BMV INTRA Multicast v1.1 Depth message. Transcribed from the BMV Market Data Multicast product 3, 4, 7, 8, 16, 18 and 19 documents, Version 1.1. Message type is the header message type, so each table starts after it. The levels repeat Purchase or sale levels times; their -1 suffixes are dropped. Side prints O - Buy; it is 0. -->

  <Messages>

    <!-- Depth Message -->
    <Message>
      <Name>Depth Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x31</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Market depth: up to 20 best buy or sale price levels (10 on the derivatives groups 7, 8 and 19), as many as Purchase or sale levels.</Description>
      <Fields>
        <Field>
          <Name>Instrument number</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Unique code during instruments life</Description>
        </Field>
        <Field>
          <Name>Side</Name>
          <Type>Int8</Type>
          <Size>1</Size>
          <Description>O - Buy, 1 - Sell</Description>
        </Field>
        <Field>
          <Name>Purchase or sale levels</Name>
          <Type>Int8</Type>
          <Size>1</Size>
          <Description>Number of buy or sale levels to be sent</Description>
        </Field>
        <Field>
          <Name>Price Level</Name>
          <Type>Group</Type>
          <Size>Purchase or sale levels</Size>
          <Description>Price levels, as many as Purchase or sale levels</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Groups>

    <!-- Price Level -->
    <Group>
      <Name>Price Level</Name>
      <Description>One price level of the Depth message</Description>
      <Dependency>Purchase or sale levels</Dependency>
      <Fields>
        <Field>
          <Name>Price</Name>
          <Type>Price (8)</Type>
          <Size>8</Size>
          <Description>Level price (Document label: Price-1)</Description>
        </Field>
        <Field>
          <Name>Number of orders</Name>
          <Type>Int16</Type>
          <Size>2</Size>
          <Description>Level number of orders (Document label: Number of orders-1)</Description>
        </Field>
        <Field>
          <Name>Volume</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Level accrued volume (Document label: Volume-1)</Description>
        </Field>
      </Fields>
    </Group>

  </Groups>

  <Enums>

    <!-- Side -->
    <Enum>
      <Name>Side</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>Buy</Name>
          <Description>O - Buy (the document prints the letter O)</Description>
        </Value>
        <Value>
          <Data>1</Data>
          <Name>Sell</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiBmvIntraPdf>
