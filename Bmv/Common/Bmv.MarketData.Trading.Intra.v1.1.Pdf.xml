<OmiBmvIntraPdf>

  <!-- BMV INTRA Multicast v1.1 trading messages shared by the equities and derivatives products. Transcribed from the BMV Market Data Multicast product 1-11, 15-20 and 24 documents, Version 1.1. Message type is the header message type, so each table starts after it. -->

  <Messages>

    <!-- Trade Cancellation Message -->
    <Message>
      <Name>Trade Cancellation Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x48</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>This message is sent when a transaction is cancelled from the BMV system.</Description>
      <Fields>
        <Field>
          <Name>Instrument number</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Unique code during instruments life</Description>
        </Field>
        <Field>
          <Name>Trade Number</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Stamp number by instrument</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Status changes Message -->
    <Message>
      <Name>Status changes Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x34</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>All instruments are in a certain status before and during trading session.</Description>
      <Fields>
        <Field>
          <Name>Instrument number</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Unique code during instruments life</Description>
        </Field>
        <Field>
          <Name>Instrument status</Name>
          <Type>ALPHA</Type>
          <Size>1</Size>
          <Description>See the table of Instrument Status Catalog on the Connections and Appendix document</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Weighted Average Price - Settlement prices Message -->
    <Message>
      <Name>Weighted Average Price - Settlement prices Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x4D</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>For equities market, this message will be sent for each operation containing weighted average price per instrument generated within WAP calculation period (last 20 minutes of trading).</Description>
      <Fields>
        <Field>
          <Name>Instrument number</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Unique code during instruments life</Description>
        </Field>
        <Field>
          <Name>Weighted average price</Name>
          <Type>Price (8)</Type>
          <Size>8</Size>
          <Description>Average price instrument.</Description>
        </Field>
        <Field>
          <Name>Volatility</Name>
          <Type>Price (8)</Type>
          <Size>8</Size>
          <Description>Volatility instrument.</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- Instrument status -->
    <Enum>
      <Name>Instrument status</Name>
      <Values>
        <Value>
          <Data>C</Data>
          <Name>Cancellation of offers</Name>
        </Value>
        <Value>
          <Data>A</Data>
          <Name>Opening auction</Name>
        </Value>
        <Value>
          <Data>P</Data>
          <Name>Pre-opening</Name>
        </Value>
        <Value>
          <Data>E</Data>
          <Name>Being allocated</Name>
        </Value>
        <Value>
          <Data>G</Data>
          <Name>Auction allocated</Name>
        </Value>
        <Value>
          <Data>T</Data>
          <Name>Auction ended</Name>
        </Value>
        <Value>
          <Data>N</Data>
          <Name>Continuous trading</Name>
        </Value>
        <Value>
          <Data>K</Data>
          <Name>Breaking auction parameters</Name>
        </Value>
        <Value>
          <Data>M</Data>
          <Name>Continuous auction due to stop operating more than 20 working days</Name>
        </Value>
        <Value>
          <Data>U</Data>
          <Name>Cleaving auction</Name>
        </Value>
        <Value>
          <Data>O</Data>
          <Name>Suspended series</Name>
        </Value>
        <Value>
          <Data>V</Data>
          <Name>Suspended quotation</Name>
        </Value>
        <Value>
          <Data>L</Data>
          <Name>Auction for breach</Name>
        </Value>
        <Value>
          <Data>I</Data>
          <Name>Withdrawal of orders on continuous auction</Name>
        </Value>
        <Value>
          <Data>B</Data>
          <Name>Withdrawal of order on intraday auction</Name>
        </Value>
        <Value>
          <Data>W</Data>
          <Name>News pending</Name>
        </Value>
        <Value>
          <Data>X</Data>
          <Name>Settlement auction</Name>
        </Value>
        <Value>
          <Data>Y</Data>
          <Name>Extraordinary settlement auction</Name>
        </Value>
        <Value>
          <Data>R</Data>
          <Name>Auction total of CKDes</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiBmvIntraPdf>
