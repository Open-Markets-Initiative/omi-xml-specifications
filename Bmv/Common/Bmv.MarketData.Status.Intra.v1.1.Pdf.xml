<OmiBmvIntraPdf>

  <!-- BMV INTRA Multicast v1.1 System event message, carried by every INTRA product. Transcribed from the BMV Market Data Multicast product 1-24, 28, 35 and 36 documents, Version 1.1. Message type is the header message type, so each table starts after it. -->

  <Messages>

    <!-- Events system Message -->
    <Message>
      <Name>Events system Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x53</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>The system of events message is used to inform that an event has occurred, which needs to be of public domain.</Description>
      <Fields>
        <Field>
          <Name>Instrument number</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Always zero</Description>
        </Field>
        <Field>
          <Name>Event code</Name>
          <Type>ALPHA</Type>
          <Size>1</Size>
          <Description>See the table of System Event Codes Catalog on the Connections and Appendix document</Description>
        </Field>
        <Field>
          <Name>Market</Name>
          <Type>ALPHA</Type>
          <Size>1</Size>
          <Description>See the table of Markets Catalog (only used when there is an official recess) on the Connections and Appendix document</Description>
        </Field>
        <Field>
          <Name>Sending time</Name>
          <Type>Timestamp(2)</Type>
          <Size>8</Size>
          <Description>Recess’s official sending time. Only used when official recess has occurred.</Description>
        </Field>
        <Field>
          <Name>Ending time</Name>
          <Type>Timestamp(2)</Type>
          <Size>8</Size>
          <Description>Recess official ending time. Only used when an official recess or automatic recess occurred.</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- Event code -->
    <Enum>
      <Name>Event code</Name>
      <Values>
        <Value>
          <Data>A</Data>
          <Name>Start of system hours</Name>
        </Value>
        <Value>
          <Data>B</Data>
          <Name>Cancelation of offers</Name>
        </Value>
        <Value>
          <Data>C</Data>
          <Name>Start of Opening Auction</Name>
        </Value>
        <Value>
          <Data>D</Data>
          <Name>Start of continuous market</Name>
        </Value>
        <Value>
          <Data>E</Data>
          <Name>Start of WAP period</Name>
        </Value>
        <Value>
          <Data>F</Data>
          <Name>Continuous market ends</Name>
        </Value>
        <Value>
          <Data>G</Data>
          <Name>Start of after-closing phase</Name>
        </Value>
        <Value>
          <Data>H</Data>
          <Name>It ends after closing</Name>
        </Value>
        <Value>
          <Data>J</Data>
          <Name>Transmission of final prices ends</Name>
        </Value>
        <Value>
          <Data>K</Data>
          <Name>End of system hours</Name>
        </Value>
        <Value>
          <Data>M</Data>
          <Name>Start of administrative recess</Name>
        </Value>
        <Value>
          <Data>N</Data>
          <Name>End of administrative recess</Name>
        </Value>
        <Value>
          <Data>O</Data>
          <Name>Start DV/MA/MX markets</Name>
        </Value>
        <Value>
          <Data>P</Data>
          <Name>End of DV/MA markets</Name>
        </Value>
        <Value>
          <Data>Q</Data>
          <Name>End of MX markets</Name>
        </Value>
        <Value>
          <Data>R</Data>
          <Name>Start of OPC modality</Name>
        </Value>
        <Value>
          <Data>S</Data>
          <Name>End of OPC modality</Name>
        </Value>
        <Value>
          <Data>T</Data>
          <Name>Start of settlement auction</Name>
        </Value>
        <Value>
          <Data>U</Data>
          <Name>End of settlement auction</Name>
        </Value>
        <Value>
          <Data>V</Data>
          <Name>Final register of settlement prices</Name>
        </Value>
        <Value>
          <Data>W</Data>
          <Name>Open interest</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiBmvIntraPdf>
