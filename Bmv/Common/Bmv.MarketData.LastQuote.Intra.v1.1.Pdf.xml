<OmiBmvIntraPdf>

  <!-- BMV Consolidated Feed v1.1 Last Quote message. Transcribed from the BMV Market Data Multicast product 26 and 29 documents, Version 1.1. Message type is the header message type, so each table starts after it. -->

  <Messages>

    <!-- Last Quote Message -->
    <Message>
      <Name>Last Quote Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x6D</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Message sent by instrument when the best bid is modified in the electronic book by the Origin Exchange; denotes the side that is modified, the sale or the purchase.</Description>
      <Fields>
        <Field>
          <Name>Instrument Number</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Sole code throughout the life on the instrument</Description>
        </Field>
        <Field>
          <Name>Origin</Name>
          <Type>ALFA</Type>
          <Size>1</Size>
          <Description>M-BMV I-BIVA</Description>
        </Field>
        <Field>
          <Name>Volume</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Volume of the order</Description>
        </Field>
        <Field>
          <Name>Price / Rate</Name>
          <Type>Precio (8)</Type>
          <Size>8</Size>
          <Description>Price of the best bid</Description>
        </Field>
        <Field>
          <Name>Direction of the bid</Name>
          <Type>ALFA</Type>
          <Size>1</Size>
          <Description>C- Purchase V-Sale</Description>
        </Field>
        <Field>
          <Name>Type of trading</Name>
          <Type>ALFA</Type>
          <Size>1</Size>
          <Description>See Catalogue of Type of Trading on the Connections and Appendix document</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

</OmiBmvIntraPdf>
