<OmiBmvIntraPdf>

  <!-- BMV INTRA Multicast v1.1 capital market messages. Transcribed from the BMV Market Data Multicast product 1-6, 11, 15-18 and 24 documents, Version 1.1. Message type is the header message type, so each table starts after it. F Order change offset 17 is New date (printed Original date); product 15 prints Trade Number as Fact Number; V Status is Virtual Trades Status. -->

  <Messages>

    <!-- Capital trades Message -->
    <Message>
      <Name>Capital trades Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x50</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Contains information on any BMV accepted transaction.</Description>
      <Fields>
        <Field>
          <Name>Instrument number</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Unique code during instruments life</Description>
        </Field>
        <Field>
          <Name>Trade time</Name>
          <Type>Timestamp(2)</Type>
          <Size>8</Size>
          <Description>Time the operation was carried out</Description>
        </Field>
        <Field>
          <Name>Volume</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Traded stocks</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Price (8)</Type>
          <Size>8</Size>
          <Description>Operation price</Description>
        </Field>
        <Field>
          <Name>Concertation type</Name>
          <Type>ALPHA</Type>
          <Size>1</Size>
          <Description>See the table of Concertation Type Catalog on the Connections and Appendix document</Description>
        </Field>
        <Field>
          <Name>Trade Number</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Stamp number by instrument</Description>
        </Field>
        <Field>
          <Name>Price Setter</Name>
          <Type>ALPHA</Type>
          <Size>1</Size>
          <Description>For value equal to 1, be taken as true; otherwise, false.</Description>
        </Field>
        <Field>
          <Name>Operation type</Name>
          <Type>ALPHA</Type>
          <Size>1</Size>
          <Description>See the table of Type of Operation Catalog on the Connections and Appendix document</Description>
        </Field>
        <Field>
          <Name>Amount</Name>
          <Type>Precio(8)</Type>
          <Size>8</Size>
          <Description>Amount</Description>
        </Field>
        <Field>
          <Name>Buy</Name>
          <Type>ALPHA</Type>
          <Size>5</Size>
          <Description>Buyers’ brokerage house short key</Description>
        </Field>
        <Field>
          <Name>Sell</Name>
          <Type>ALPHA</Type>
          <Size>5</Size>
          <Description>Seller’s brokerage house short key</Description>
        </Field>
        <Field>
          <Name>Settlement</Name>
          <Type>ALPHA</Type>
          <Size>1</Size>
          <Description>See the table of Settlement Type Catalog on the Connections and Appendix document</Description>
        </Field>
        <Field>
          <Name>Auction Indicator</Name>
          <Type>ALPHA</Type>
          <Size>1</Size>
          <Description>"P" – Opening Auction "S" – Other Auctions " " – Continuous Market "N" – Not Applicable</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Probable allocation price Message -->
    <Message>
      <Name>Probable allocation price Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x32</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Sent during any auction type (Opening, Continuous, Volatility and Intraday) and only on instruments where there is already a virtual match or pre-allocation.</Description>
      <Fields>
        <Field>
          <Name>Instrument number</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Unique code during instruments life</Description>
        </Field>
        <Field>
          <Name>Probable allocation price</Name>
          <Type>Precio (8)</Type>
          <Size>8</Size>
          <Description>Probable allocation price</Description>
        </Field>
        <Field>
          <Name>Volume</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Maximum volume to be traded</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Continuous auctions beginning Message -->
    <Message>
      <Name>Continuous auctions beginning Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x33</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Sent at the moment one of the Continuous, Volatility or SIC auctions is generated.</Description>
      <Fields>
        <Field>
          <Name>Instrument number</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Unique code during instruments life</Description>
        </Field>
        <Field>
          <Name>Beginning time of auction</Name>
          <Type>Timestamp(2)</Type>
          <Size>8</Size>
          <Description>Time at which auction begins</Description>
        </Field>
        <Field>
          <Name>End auction time</Name>
          <Type>Timestamp(2)</Type>
          <Size>8</Size>
          <Description>Time at which auction ends</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Middle Price existing quotes Message -->
    <Message>
      <Name>Middle Price existing quotes Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x35</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Generated when an instrument enters a posture in the hidden electronic Middle Price book.</Description>
      <Fields>
        <Field>
          <Name>Instrument number</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Unique code during instruments life</Description>
        </Field>
        <Field>
          <Name>Existing Postures</Name>
          <Type>ALPHA</Type>
          <Size>1</Size>
          <Description>For value equal to "1", True (there are postures), otherwise False (there are no postures).</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Registry Operations Message -->
    <Message>
      <Name>Registry Operations Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x5A</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Sent whenever there is a debt or capital instrument placement.</Description>
      <Fields>
        <Field>
          <Name>Instrument Number</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Unique code during instruments life</Description>
        </Field>
        <Field>
          <Name>Offer Type</Name>
          <Type>ALPHA</Type>
          <Size>1</Size>
          <Description>See the Public Offerings Catalog on the Connections and Appendix document</Description>
        </Field>
        <Field>
          <Name>Income</Name>
          <Type>ALPHA</Type>
          <Size>1</Size>
          <Description>V-Variable income F-Fixed Income W-Warrants</Description>
        </Field>
        <Field>
          <Name>Value type</Name>
          <Type>ALPHA</Type>
          <Size>4</Size>
          <Description>Value type</Description>
        </Field>
        <Field>
          <Name>Issuer</Name>
          <Type>ALPHA</Type>
          <Size>7</Size>
          <Description>Issuers code</Description>
        </Field>
        <Field>
          <Name>Series</Name>
          <Type>ALPHA</Type>
          <Size>6</Size>
          <Description>Series code</Description>
        </Field>
        <Field>
          <Name>Maximum Volume</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Maximum Volume</Description>
        </Field>
        <Field>
          <Name>Registered Volume</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Registered Volume</Description>
        </Field>
        <Field>
          <Name>Price/Rate</Name>
          <Type>Price (8)</Type>
          <Size>8</Size>
          <Description>Operation registry price</Description>
        </Field>
        <Field>
          <Name>Settlement date</Name>
          <Type>Timestamp(1)</Type>
          <Size>8</Size>
          <Description>Settlement date</Description>
        </Field>
        <Field>
          <Name>Firm</Name>
          <Type>ALPHA</Type>
          <Size>5</Size>
          <Description>Managing Brokerage Firm</Description>
        </Field>
        <Field>
          <Name>Movement</Name>
          <Type>ALPHA</Type>
          <Size>1</Size>
          <Description>A-Registry operation U-Operation authorization C-Placement operation B-Delete operation</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Mutual fund trades Message -->
    <Message>
      <Name>Mutual fund trades Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x59</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Contains any mutual funds operation realized.</Description>
      <Fields>
        <Field>
          <Name>Instrument number</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Unique code during instruments life</Description>
        </Field>
        <Field>
          <Name>Trade date</Name>
          <Type>Timestamp(1)</Type>
          <Size>8</Size>
          <Description>Date operation was carried out</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Price (8)</Type>
          <Size>8</Size>
          <Description>Market price</Description>
        </Field>
        <Field>
          <Name>Book value</Name>
          <Type>Price (8)</Type>
          <Size>8</Size>
          <Description>Book value by stock</Description>
        </Field>
        <Field>
          <Name>Number of sales transactions</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Number of sales transactions</Description>
        </Field>
        <Field>
          <Name>Sales volume</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Sales volume</Description>
        </Field>
        <Field>
          <Name>Number of buy transactions</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Number of buy transactions</Description>
        </Field>
        <Field>
          <Name>Buy volume</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Buy volume</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Tradability Message -->
    <Message>
      <Name>Tradability Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x45</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Message sent every half hour during trading session, informing general tradability by instrument.</Description>
      <Fields>
        <Field>
          <Name>Instrument Number</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Unique code during instruments life</Description>
        </Field>
        <Field>
          <Name>Number of operations</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Number of operations</Description>
        </Field>
        <Field>
          <Name>Volume</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Traded volume</Description>
        </Field>
        <Field>
          <Name>Amount</Name>
          <Type>Price (8)</Type>
          <Size>8</Size>
          <Description>Traded amount</Description>
        </Field>
        <Field>
          <Name>Opening Price</Name>
          <Type>Price (8)</Type>
          <Size>8</Size>
          <Description>Opening price</Description>
        </Field>
        <Field>
          <Name>Maximum</Name>
          <Type>Price (8)</Type>
          <Size>8</Size>
          <Description>Maximum price</Description>
        </Field>
        <Field>
          <Name>Minimum</Name>
          <Type>Price (8)</Type>
          <Size>8</Size>
          <Description>Minimum price</Description>
        </Field>
        <Field>
          <Name>Average</Name>
          <Type>Price (8)</Type>
          <Size>8</Size>
          <Description>Average price of the day</Description>
        </Field>
        <Field>
          <Name>Last</Name>
          <Type>Price (8)</Type>
          <Size>8</Size>
          <Description>Last time price</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Virtual trades Message -->
    <Message>
      <Name>Virtual trades Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x56</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>When an operation has been pre-assigned to the at closing and average day Price electronic books, a virtual trade message is sent, where also notifying of this operation.</Description>
      <Fields>
        <Field>
          <Name>Instrument number</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Unique code during instruments life</Description>
        </Field>
        <Field>
          <Name>Virtual Trades Status</Name>
          <Type>ALPHA</Type>
          <Size>1</Size>
          <Description>A-Addition B-Deletion (Document label: Status)</Description>
        </Field>
        <Field>
          <Name>Operation type</Name>
          <Type>ALPHA</Type>
          <Size>1</Size>
          <Description>See the table of Operation Type Catalog on the Connections and Appendix document</Description>
        </Field>
        <Field>
          <Name>Number</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Virtual trade number</Description>
        </Field>
        <Field>
          <Name>Volume</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Virtually traded securities</Description>
        </Field>
        <Field>
          <Name>Concertation</Name>
          <Type>ALPHA</Type>
          <Size>1</Size>
          <Description>See the table of Concertation Type Catalog on the Connections and Appendix document</Description>
        </Field>
        <Field>
          <Name>Buy</Name>
          <Type>ALPHA</Type>
          <Size>5</Size>
          <Description>Buyers’ brokerage house short key</Description>
        </Field>
        <Field>
          <Name>Sell</Name>
          <Type>ALPHA</Type>
          <Size>5</Size>
          <Description>Seller’s brokerage house short key</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- Offer Type -->
    <Enum>
      <Name>Offer Type</Name>
      <Values>
        <Value>
          <Data>P</Data>
          <Name>Public offering</Name>
        </Value>
        <Value>
          <Data>R</Data>
          <Name>Registration operation</Name>
        </Value>
        <Value>
          <Data>C</Data>
          <Name>Buy public offering</Name>
        </Value>
        <Value>
          <Data>A</Data>
          <Name>Overallocation</Name>
        </Value>
        <Value>
          <Data>S</Data>
          <Name>Reciprocal subscription</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Income -->
    <Enum>
      <Name>Income</Name>
      <Values>
        <Value>
          <Data>V</Data>
          <Name>Variable income</Name>
        </Value>
        <Value>
          <Data>F</Data>
          <Name>Fixed Income</Name>
        </Value>
        <Value>
          <Data>W</Data>
          <Name>Warrants</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Movement -->
    <Enum>
      <Name>Movement</Name>
      <Values>
        <Value>
          <Data>A</Data>
          <Name>Registry operation</Name>
        </Value>
        <Value>
          <Data>U</Data>
          <Name>Operation authorization</Name>
        </Value>
        <Value>
          <Data>C</Data>
          <Name>Placement operation</Name>
        </Value>
        <Value>
          <Data>B</Data>
          <Name>Delete operation</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Virtual Trades Status -->
    <Enum>
      <Name>Virtual Trades Status</Name>
      <Values>
        <Value>
          <Data>A</Data>
          <Name>Addition</Name>
        </Value>
        <Value>
          <Data>B</Data>
          <Name>Deletion</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiBmvIntraPdf>
