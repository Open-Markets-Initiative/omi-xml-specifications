<OmiBmvIntraPdf>

  <!-- BMV INTRA Multicast v1.1 indices messages. Transcribed from the BMV Market Data Multicast product 12-14, 18, 23, 35 and 36 documents, Version 1.1. Message type is the header message type, so each table starts after it. -->

  <Messages>

    <!-- General Indices Message -->
    <Message>
      <Name>General Indices Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x55</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Information about the MSE Indices.</Description>
      <Fields>
        <Field>
          <Name>Component</Name>
          <Type>ALPHA</Type>
          <Size>2</Size>
          <Description>See Indices Components Catalog on the Connections and Appendix document</Description>
        </Field>
        <Field>
          <Name>Sector</Name>
          <Type>Int8</Type>
          <Size>1</Size>
          <Description>See Industry Classification on the Connections and Appendix document</Description>
        </Field>
        <Field>
          <Name>Indices Hour</Name>
          <Type>Timestamp(2)</Type>
          <Size>8</Size>
          <Description>Time Indices was calculated</Description>
        </Field>
        <Field>
          <Name>Volume</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Traded volume in the sample</Description>
        </Field>
        <Field>
          <Name>Indices</Name>
          <Type>Price (4)</Type>
          <Size>4</Size>
          <Description>Indices value</Description>
        </Field>
        <Field>
          <Name>Variation</Name>
          <Type>Price (4)</Type>
          <Size>4</Size>
          <Description>Variation points</Description>
        </Field>
        <Field>
          <Name>Percentage</Name>
          <Type>Price (4)</Type>
          <Size>4</Size>
          <Description>Percentage points</Description>
        </Field>
        <Field>
          <Name>Trend</Name>
          <Type>ALPHA</Type>
          <Size>1</Size>
          <Description>See Trend Catalog on the Connections and Appendix document</Description>
        </Field>
        <Field>
          <Name>Indices status</Name>
          <Type>ALPHA</Type>
          <Size>1</Size>
          <Description>See Indices Status Catalog on the Connections and Appendix document</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Indices Components Message -->
    <Message>
      <Name>Indices Components Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x57</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Indices components obtained during the day.</Description>
      <Fields>
        <Field>
          <Name>Date</Name>
          <Type>Timestamp(1)</Type>
          <Size>8</Size>
          <Description>Date</Description>
        </Field>
        <Field>
          <Name>Component</Name>
          <Type>ALPHA</Type>
          <Size>2</Size>
          <Description>See Indices Components Catalog on the Connections and Appendix document</Description>
        </Field>
        <Field>
          <Name>Sector</Name>
          <Type>Int8</Type>
          <Size>1</Size>
          <Description>See Industry Classification on the Connections and Appendix document</Description>
        </Field>
        <Field>
          <Name>Type</Name>
          <Type>ALPHA</Type>
          <Size>1</Size>
          <Description>See Equity’s Indices Components Catalog on the Connections and Appendix document</Description>
        </Field>
        <Field>
          <Name>Issuer</Name>
          <Type>ALPHA</Type>
          <Size>7</Size>
          <Description>Issuer code</Description>
        </Field>
        <Field>
          <Name>Series</Name>
          <Type>ALPHA</Type>
          <Size>6</Size>
          <Description>Series code</Description>
        </Field>
        <Field>
          <Name>Indices stocks</Name>
          <Type>Int64</Type>
          <Size>8</Size>
          <Description>Number of stocks of the issuer that making up the component</Description>
        </Field>
        <Field>
          <Name>Last price</Name>
          <Type>Price (8)</Type>
          <Size>8</Size>
          <Description>Last price</Description>
        </Field>
        <Field>
          <Name>Closing price</Name>
          <Type>Price (8)</Type>
          <Size>8</Size>
          <Description>Closing price</Description>
        </Field>
        <Field>
          <Name>Influence</Name>
          <Type>Price (8)</Type>
          <Size>8</Size>
          <Description>Issuer weight inside the Indices</Description>
        </Field>
      </Fields>
    </Message>

    <!-- INAV Message -->
    <Message>
      <Name>INAV Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x47</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>TRACS dissemination during continuous market trading hours.</Description>
      <Fields>
        <Field>
          <Name>Trac Number</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Unique code during TRACs life</Description>
        </Field>
        <Field>
          <Name>Theoretical Current Price</Name>
          <Type>Price (8)</Type>
          <Size>8</Size>
          <Description>Tracs' last theoretical price</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- Trend -->
    <Enum>
      <Name>Trend</Name>
      <Values>
        <Value>
          <Data>A</Data>
          <Name>Increase</Name>
        </Value>
        <Value>
          <Data>B</Data>
          <Name>Decrease</Name>
        </Value>
        <Value>
          <Data>S</Data>
          <Name>Without change</Name>
        </Value>
        <Value>
          <Data>" "</Data>
          <Name>Without operation</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Indices status -->
    <Enum>
      <Name>Indices status</Name>
      <Values>
        <Value>
          <Data>A</Data>
          <Name>Previous</Name>
        </Value>
        <Value>
          <Data>P</Data>
          <Name>Preliminary</Name>
        </Value>
        <Value>
          <Data>C</Data>
          <Name>Preliminary figures</Name>
        </Value>
        <Value>
          <Data>D</Data>
          <Name>Final</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Type -->
    <Enum>
      <Name>Type</Name>
      <Values>
        <Value>
          <Data>E</Data>
          <Name>Equity</Name>
        </Value>
        <Value>
          <Data>S</Data>
          <Name>Strategy</Name>
        </Value>
        <Value>
          <Data>G</Data>
          <Name>SPBMVESG</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiBmvIntraPdf>
