<OmiBmvIntraPdf>

  <!-- BMV INTRA Multicast v1.1 replay and snapshot channel messages, from the Connection and Appendix v1.1. Requests are read after their Length and Message type; responses in the INTRA Multicast Header. Status is qualified per response. -->

  <Messages>

    <!-- Login Message -->
    <Message>
      <Name>Login Message</Name>
      <Branch>clientpayload</Branch>
      <Dependency>clientmessagetype</Dependency>
      <Code>0x21</Code>
      <Category>Administrative</Category>
      <Origin>Firm</Origin>
      <Description>Logs the consumer in to the replay or snapshot channel.</Description>
      <Fields>
        <Field>
          <Name>Market Data Group</Name>
          <Type>Int8</Type>
          <Size>1</Size>
          <Description>See Market Data Groups Catalog</Description>
        </Field>
        <Field>
          <Name>User</Name>
          <Type>ALPHA</Type>
          <Size>6</Size>
          <Description>User assigned to receiver</Description>
        </Field>
        <Field>
          <Name>Password</Name>
          <Type>ALPHA</Type>
          <Size>10</Size>
          <Description>Password assigned to receiver, filled with blank spaces to the right</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Replay request Message -->
    <Message>
      <Name>Replay request Message</Name>
      <Branch>clientpayload</Branch>
      <Dependency>clientmessagetype</Dependency>
      <Code>0x23</Code>
      <Category>Administrative</Category>
      <Origin>Firm</Origin>
      <Description>Requests the replay of messages already published on a multicast group.</Description>
      <Fields>
        <Field>
          <Name>Market Data Group</Name>
          <Type>Int8</Type>
          <Size>1</Size>
          <Description>See Market Data Groups Catalog</Description>
        </Field>
        <Field>
          <Name>First Message</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Sequence number of the first message intended to recover</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Int16</Type>
          <Size>2</Size>
          <Description>Quantity of requested messages</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Snapshot request Message -->
    <Message>
      <Name>Snapshot request Message</Name>
      <Branch>clientpayload</Branch>
      <Dependency>clientmessagetype</Dependency>
      <Code>0x24</Code>
      <Category>Administrative</Category>
      <Origin>Firm</Origin>
      <Description>Requests a snapshot of a multicast group.</Description>
      <Fields>
        <Field>
          <Name>Market Data Group</Name>
          <Type>Int8</Type>
          <Size>1</Size>
          <Description>See Market Data Groups Catalog</Description>
        </Field>
        <Field>
          <Name>Instrument ID</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Instrument identifier to which request is related; zeros when not related to any instrument</Description>
        </Field>
        <Field>
          <Name>Snapshot type</Name>
          <Type>Int8</Type>
          <Size>1</Size>
          <Description>See Snapshot Type Catalog</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Snapshot Indices request Message -->
    <Message>
      <Name>Snapshot Indices request Message</Name>
      <Branch>clientpayload</Branch>
      <Dependency>clientmessagetype</Dependency>
      <Code>0x2D</Code>
      <Category>Administrative</Category>
      <Origin>Firm</Origin>
      <Description>Requests a snapshot of an index.</Description>
      <Fields>
        <Field>
          <Name>Market Data Group</Name>
          <Type>Int8</Type>
          <Size>1</Size>
          <Description>See Market Data Groups Catalog</Description>
        </Field>
        <Field>
          <Name>Component</Name>
          <Type>ALPHA</Type>
          <Size>2</Size>
          <Description>Component</Description>
        </Field>
        <Field>
          <Name>Recovery hour</Name>
          <Type>Timestamp(2)</Type>
          <Size>8</Size>
          <Description>Hour from which to recover the index; zero sends all the information of the sample of the day</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Snapshot consolidated Feed request Message -->
    <Message>
      <Name>Snapshot consolidated Feed request Message</Name>
      <Branch>clientpayload</Branch>
      <Dependency>clientmessagetype</Dependency>
      <Code>0x5F</Code>
      <Category>Administrative</Category>
      <Origin>Firm</Origin>
      <Description>Requests a snapshot of a Consolidated Feed group.</Description>
      <Fields>
        <Field>
          <Name>Market Data Group</Name>
          <Type>Int8</Type>
          <Size>1</Size>
          <Description>See Market Data Groups Catalog</Description>
        </Field>
        <Field>
          <Name>Instrument ID</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Instrument identifier to which request is related; zeros when not related to any instrument</Description>
        </Field>
        <Field>
          <Name>Snapshot type</Name>
          <Type>Int8</Type>
          <Size>1</Size>
          <Description>See Snapshot Type Catalog</Description>
        </Field>
        <Field>
          <Name>Origin</Name>
          <Type>ALPHA</Type>
          <Size>1</Size>
          <Description>Origin of the message: M (BMV), I (BIVA), A (Both)</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Login response Message -->
    <Message>
      <Name>Login response Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x26</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>Answers a login request.</Description>
      <Fields>
        <Field>
          <Name>Login Response Status</Name>
          <Type>ALPHA</Type>
          <Size>1</Size>
          <Description>Login status (Document label: Status)</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Replay response Message -->
    <Message>
      <Name>Replay response Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x2A</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>Answers a replay request; the replayed messages follow an accepted one.</Description>
      <Fields>
        <Field>
          <Name>Market Data Group</Name>
          <Type>Int8</Type>
          <Size>1</Size>
          <Description>See Market Data Groups Catalog</Description>
        </Field>
        <Field>
          <Name>First message</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Sequence number of the first message to be transmitted; zero when request not accepted</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Int16</Type>
          <Size>2</Size>
          <Description>Number of messages to be replayed; zero when request not accepted</Description>
        </Field>
        <Field>
          <Name>Replay Response Status</Name>
          <Type>ALPHA</Type>
          <Size>1</Size>
          <Description>Replay status (Document label: Status)</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Snapshot response message -->
    <Message>
      <Name>Snapshot response message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x2B</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>Answers a snapshot request.</Description>
      <Fields>
        <Field>
          <Name>Quantity of messages</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Number of messages to be transmitted for the request, including instrument status and Snapshot complete messages; zero for a request not accepted</Description>
        </Field>
        <Field>
          <Name>Snapshot Response Status</Name>
          <Type>ALPHA</Type>
          <Size>1</Size>
          <Description>Snapshot status (Document label: Status)</Description>
        </Field>
        <Field>
          <Name>Snapshot type</Name>
          <Type>Int8</Type>
          <Size>1</Size>
          <Description>See Snapshot Type Catalog</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Snapshot complete Message -->
    <Message>
      <Name>Snapshot complete Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x3F</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>Ends a snapshot with the sequence number it synchronizes with on the online channel.</Description>
      <Fields>
        <Field>
          <Name>Sequence number</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Sequence number on to which the snapshot synchronizes with respect to the online channel</Description>
        </Field>
        <Field>
          <Name>Market Data Group</Name>
          <Type>Int8</Type>
          <Size>1</Size>
          <Description>See Market Data Groups Catalog</Description>
        </Field>
        <Field>
          <Name>Snapshot type</Name>
          <Type>Int8</Type>
          <Size>1</Size>
          <Description>See Snapshot Type Catalog</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- Login Response Status -->
    <Enum>
      <Name>Login Response Status</Name>
      <Values>
        <Value>
          <Data>A</Data>
          <Name>Accepted session</Name>
        </Value>
        <Value>
          <Data>B</Data>
          <Name>Invalid Market Data group</Name>
        </Value>
        <Value>
          <Data>C</Data>
          <Name>Login on another channel</Name>
        </Value>
        <Value>
          <Data>D</Data>
          <Name>Unavailable service</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Replay Response Status -->
    <Enum>
