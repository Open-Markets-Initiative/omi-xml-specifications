<OmiBmvIntraPdf>

  <!-- BMV INTRA Multicast v1.1 Best Offer message. Transcribed from the BMV Market Data Multicast product 3-6, 9, 10, 16-18, 20 and 24 documents, Version 1.1. Message type is the header message type, so each table starts after it. -->

  <Messages>

    <!-- Best Offer Message -->
    <Message>
      <Name>Best Offer Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x4F</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Message sent by instrument when best offer changes in the electronic book.</Description>
      <Fields>
        <Field>
          <Name>Instrument number</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Unique code during instruments life</Description>
        </Field>
        <Field>
          <Name>Volume</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Best offer volume</Description>
        </Field>
        <Field>
          <Name>Price/Rate</Name>
          <Type>Price (8)</Type>
          <Size>8</Size>
          <Description>Best offer price</Description>
        </Field>
        <Field>
          <Name>Offer direction</Name>
          <Type>ALPHA</Type>
          <Size>1</Size>
          <Description>C-Buy V-Sell</Description>
        </Field>
        <Field>
          <Name>Operation type</Name>
          <Type>ALPHA</Type>
          <Size>1</Size>
          <Description>See the Operation Type Catalog on the Connections and Appendix document</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- Offer direction -->
    <Enum>
      <Name>Offer direction</Name>
      <Values>
        <Value>
          <Data>C</Data>
          <Name>Buy</Name>
        </Value>
        <Value>
          <Data>V</Data>
          <Name>Sell</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiBmvIntraPdf>
