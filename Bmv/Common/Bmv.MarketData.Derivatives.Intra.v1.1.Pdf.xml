<OmiBmvIntraPdf>

  <!-- BMV INTRA Multicast v1.1 derivatives market messages. Transcribed from the BMV Market Data Multicast product 7-10, 19 and 20 documents, Version 1.1. Message type is the header message type, so each table starts after it. -->

  <Messages>

    <!-- Open Interest Message -->
    <Message>
      <Name>Open Interest Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x49</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Open Interest</Description>
      <Fields>
        <Field>
          <Name>Instrument number</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Unique code during instruments life</Description>
        </Field>
        <Field>
          <Name>Open interest</Name>
          <Type>Price (4)</Type>
          <Size>4</Size>
          <Description>Open interest</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Derivatives market trades Message -->
    <Message>
      <Name>Derivatives market trades Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x51</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Contains information on any MexDer accepted transaction.</Description>
      <Fields>
        <Field>
          <Name>Instrument number</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Unique code during instruments life</Description>
        </Field>
        <Field>
          <Name>Trade time</Name>
          <Type>Timestamp(2)</Type>
          <Size>8</Size>
          <Description>Time the operation was carried out</Description>
        </Field>
        <Field>
          <Name>Volume</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Traded stocks</Description>
        </Field>
        <Field>
          <Name>Price/Rate</Name>
          <Type>Price (8)</Type>
          <Size>8</Size>
          <Description>Operation price</Description>
        </Field>
        <Field>
          <Name>Concertation type</Name>
          <Type>ALPHA</Type>
          <Size>1</Size>
          <Description>See Concertation Type Catalog on the Connections and Appendix document</Description>
        </Field>
        <Field>
          <Name>Trade number</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Stamp number by instrument</Description>
        </Field>
        <Field>
          <Name>Operation type</Name>
          <Type>ALPHA</Type>
          <Size>1</Size>
          <Description>See Operation Type Catalog on the Connections and Appendix document</Description>
        </Field>
        <Field>
          <Name>Amount</Name>
          <Type>Price (8)</Type>
          <Size>8</Size>
          <Description>Amount</Description>
        </Field>
        <Field>
          <Name>Parent trade number</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Will only contain a value if and only if is about a strategy leg.</Description>
        </Field>
        <Field>
          <Name>Leg type</Name>
          <Type>ALPHA</Type>
          <Size>1</Size>
          <Description>L-Long leg C-Short leg X-Forwards chain leg P-Indicates if its parent strategy ""-Fact not generated from a strategy</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Statistics of instruments Message -->
    <Message>
      <Name>Statistics of instruments Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x52</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Update message from derivatives statistics sent each time there is an update on the trading floor at any level price.</Description>
      <Fields>
        <Field>
          <Name>Instrument number</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Unique code during instruments life</Description>
        </Field>
        <Field>
          <Name>Previous settlement price</Name>
          <Type>Price (8)</Type>
          <Size>8</Size>
          <Description>Last day settlement price</Description>
        </Field>
        <Field>
          <Name>Opening price</Name>
          <Type>Price (8)</Type>
          <Size>8</Size>
          <Description>First price of the day or opening price</Description>
        </Field>
        <Field>
          <Name>Max price of the day</Name>
          <Type>Price (8)</Type>
          <Size>8</Size>
          <Description>Max price recorded on the day</Description>
        </Field>
        <Field>
          <Name>Lower price of the day</Name>
          <Type>Price (8)</Type>
          <Size>8</Size>
          <Description>Lower price recorded on the day</Description>
        </Field>
        <Field>
          <Name>Last price of the day</Name>
          <Type>Price (8)</Type>
          <Size>8</Size>
          <Description>Last price recorded on the day</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- Leg type -->
    <Enum>
      <Name>Leg type</Name>
      <Values>
        <Value>
          <Data>L</Data>
          <Name>Long leg</Name>
        </Value>
        <Value>
          <Data>C</Data>
          <Name>Short leg</Name>
        </Value>
        <Value>
          <Data>X</Data>
          <Name>Forwards chain leg</Name>
        </Value>
        <Value>
          <Data>P</Data>
          <Name>Parent strategy</Name>
          <Description>Indicates if its parent strategy</Description>
        </Value>
        <Value>
          <Data>" "</Data>
          <Name>Not generated from a strategy</Name>
          <Description>"" - Fact not generated from a strategy</Description>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiBmvIntraPdf>
