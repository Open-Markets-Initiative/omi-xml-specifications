<OmiBmvIntraPdf>

  <!-- BMV MOC v1.1 messages with two byte message types. Transcribed from the BMV Market Data Multicast product 37 documents, Version 1.1. Message type is the header message type, so each table starts after it. Operation type is the order type table of its page 2. -->

  <Messages>

    <!-- Order Adition Message -->
    <Message>
      <Name>Order Adition Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x4143</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>When the order is accepted by the BMV central system, this message is disseminated to the relevant media.</Description>
      <Fields>
        <Field>
          <Name>ID instrument</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Unique code during instrument life</Description>
        </Field>
        <Field>
          <Name>Date and hour</Name>
          <Type>Timestamp(2)</Type>
          <Size>8</Size>
          <Description>Date and time for the order adition</Description>
        </Field>
        <Field>
          <Name>Folio</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Assigned number to the order when registered</Description>
        </Field>
        <Field>
          <Name>Direction</Name>
          <Type>ALFA</Type>
          <Size>1</Size>
          <Description>C - Bid V - Ask</Description>
        </Field>
        <Field>
          <Name>Volume</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Order Volume</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Precio(8)</Type>
          <Size>8</Size>
          <Description>Order price</Description>
        </Field>
        <Field>
          <Name>Participant</Name>
          <Type>ALFA</Type>
          <Size>5</Size>
          <Description>Short key of participant (empty field)</Description>
        </Field>
        <Field>
          <Name>Operation type</Name>
          <Type>ALFA</Type>
          <Size>1</Size>
          <Description>Operation type, see operation type table in page 2</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Execution of orders Message -->
    <Message>
      <Name>Execution of orders Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x4343</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>The message is disseminated as soon as there is a match in the BMV's electronic system.</Description>
      <Fields>
        <Field>
          <Name>ID instrument</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Unique code during instrument life</Description>
        </Field>
        <Field>
          <Name>Date</Name>
          <Type>Timestamp(1)</Type>
          <Size>8</Size>
          <Description>Addition order date</Description>
        </Field>
        <Field>
          <Name>Folio</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Allocated Folio of the order when is registered</Description>
        </Field>
        <Field>
          <Name>Volume</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Order volume</Description>
        </Field>
        <Field>
          <Name>Trade number</Name>
          <Type>Int 32</Type>
          <Size>4</Size>
          <Description>Trade number</Description>
        </Field>
        <Field>
          <Name>Execution price</Name>
          <Type>Precio (8)</Type>
          <Size>8</Size>
          <Description>Price</Description>
        </Field>
        <Field>
          <Name>Operation Type</Name>
          <Type>ALFA</Type>
          <Size>1</Size>
          <Description>Operation type, see operation type table in page 2</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order cancellation Message -->
    <Message>
      <Name>Order cancellation Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x4443</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>This message indicates the fully elimination of an order in the trading floor</Description>
      <Fields>
        <Field>
          <Name>ID instrument</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Unique code during instrument life</Description>
        </Field>
        <Field>
          <Name>Date</Name>
          <Type>Timestamp(1)</Type>
          <Size>8</Size>
          <Description>Date</Description>
        </Field>
        <Field>
          <Name>Folio</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Allocated Folio of the order when is registered</Description>
        </Field>
        <Field>
          <Name>Operation Type</Name>
          <Type>ALFA</Type>
          <Size>1</Size>
          <Description>Operation type, see operation type table in page 2</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order change Message -->
    <Message>
      <Name>Order change Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x4643</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Message sent when the order modifies any of its data, the system assigns it a new priority in the electronic book, the order to be replaced is identified with the original Instrument, Date, and Folio, and the new priority assignment in the electronic book appears in the New Date and Folio fields.</Description>
      <Fields>
        <Field>
          <Name>ID instrument</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Unique code during instrument life</Description>
        </Field>
        <Field>
          <Name>Original date</Name>
          <Type>Timestamp(2)</Type>
          <Size>8</Size>
          <Description>Date and time of the original order</Description>
        </Field>
        <Field>
          <Name>Original folio</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Folio of the original order</Description>
        </Field>
        <Field>
          <Name>New date</Name>
          <Type>Timestamp(2)</Type>
          <Size>8</Size>
          <Description>New date and time of the order</Description>
        </Field>
        <Field>
          <Name>New folio</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>New Folio of the order</Description>
        </Field>
        <Field>
          <Name>Direction</Name>
          <Type>ALFA</Type>
          <Size>1</Size>
          <Description>C - Bid V - Ask</Description>
        </Field>
        <Field>
          <Name>Volume</Name>
          <Type>Int32</Type>
          <Size>4</Size>
          <Description>Volume</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Precio (8)</Type>
          <Size>8</Size>
          <Description>Price</Description>
        </Field>
        <Field>
          <Name>Operation type</Name>
          <Type>ALFA</Type>
          <Size>1</Size>
          <Description>Operation type, see operation type table in page 2</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- Direction -->
    <Enum>
      <Name>Direction</Name>
      <Values>
        <Value>
          <Data>C</Data>
          <Name>Bid</Name>
        </Value>
        <Value>
          <Data>V</Data>
          <Name>Ask</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Operation type -->
    <Enum>
      <Name>Operation type</Name>
      <Values>
        <Value>
          <Data>H</Data>
          <Name>At close</Name>
        </Value>
        <Value>
          <Data>D</Data>
          <Name>After close</Name>
        </Value>
        <Value>
          <Data>P</Data>
          <Name>Average price</Name>
        </Value>
        <Value>
          <Data>(</Data>
          <Name>INAV at close</Name>
        </Value>
        <Value>
          <Data>)</Data>
          <Name>INAV after close</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiBmvIntraPdf>
