              <Offset>+0</Offset>
              <Bytes>1</Bytes>
              <Type>CHAR</Type>
              <Description>Whether a reference price is available at this size tier</Description>
              <Values>
                <Value>
                  <Data>R</Data>
                  <Name>Valid Reference Price</Name>
                  <Description>Valid reference price</Description>
                </Value>
                <Value>
                  <Data>Z</Data>
                  <Name>Price Not Available</Name>
                  <Description>Price not available at this size tier</Description>
                </Value>
              </Values>
            </Field>
            <Field>
              <Name>Tier Size</Name>
              <Offset>+1</Offset>
              <Bytes>4</Bytes>
              <Type>UINT32</Type>
              <Description>Size Tier, not shifted</Description>
            </Field>
            <Field>
              <Name>Price Terms</Name>
              <Offset>+5</Offset>
              <Bytes>1</Bytes>
              <Type>CHAR</Type>
              <Nullable>FirstByte:NullCharacter</Nullable>
              <Description>Which currency the Tier Size is in and which way the prices are quoted. The section 3.3 example leaves it zero in every tier, though section 3 states only D and I</Description>
              <Values>
                <Value>
                  <Data>D</Data>
                  <Name>Direct Terms</Name>
                  <Description>Tier Size is in Currency 1 and prices are in units of Currency 2 per Currency 1</Description>
                </Value>
                <Value>
                  <Data>I</Data>
                  <Name>Inverted Terms</Name>
                  <Description>Tier Size is in Currency 2 and prices are in units of Currency 1 per Currency 2</Description>
                </Value>
              </Values>
            </Field>
            <Field>
              <Name>Bid Price</Name>
              <Offset>+6</Offset>
              <Bytes>4</Bytes>
              <Type>INT32</Type>
              <Nullable>Value</Nullable>
              <Null>0</Null>
              <Description>Bid Price mantissa, which Bid Price Exponent scales. Zero for Tier Status Z</Description>
            </Field>
            <Field>
              <Name>Bid Price Exponent</Name>
              <Offset>+10</Offset>
              <Bytes>1</Bytes>
              <Type>INT8</Type>
              <Description>Power of ten the Bid Price mantissa is multiplied by, for example -5 for 0.00001</Description>
            </Field>
