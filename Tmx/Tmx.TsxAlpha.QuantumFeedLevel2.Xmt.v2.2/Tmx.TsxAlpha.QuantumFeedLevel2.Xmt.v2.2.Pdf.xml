  <!-- Symbol Status Message: page 7 -->
  <Message>

    <Name>Symbol Status</Name>
    <Branch>Business Message</Branch>
    <Dependency>msgtype</Dependency>
    <Header>Business Header</Header>
    <Type>J</Type>
    <Category>Technical</Category>
    <Description>Symbol Status messages contain information regarding equity, debenture, or trading Instruments for the current trading day for the Alpha market. One message is disseminated for each valid symbol at the beginning of each trading day.</Description>

    <Fields>
      <Field>
        <Name>Symbol</Name>
        <Size>12</Size>
        <Encoding>Alphanumeric</Encoding>
        <Description>A unique alphanumeric identifier for a security</Description>
      </Field>
      <Field>
        <Name>Stock Group</Name>
        <Size>1</Size>
        <Encoding>Numeric</Encoding>
        <Description>An identifier of the stock group</Description>
      </Field>
      <Field>
        <Name>Listing Market</Name>
        <Size>1</Size>
        <Encoding>Alphanumeric</Encoding>
        <Description>The market on which a security is listed.</Description>
      </Field>
      <Field>
        <Name>Product Type</Name>
        <Size>1</Size>
        <Encoding>Alphanumeric</Encoding>
        <Description>The product type for a symbol</Description>
      </Field>
      <Field>
        <Name>CUSIP</Name>
        <Size>12</Size>
        <Encoding>Alphanumeric</Encoding>
        <Description>Clearing and settlement registration number</Description>
      </Field>
      <Field>
        <Name>Board Lot</Name>
        <Size>2</Size>
        <Encoding>Numeric</Encoding>
        <Description>Contains the board lot size</Description>
      </Field>
      <Field>
        <Name>Currency</Name>
        <Size>1</Size>
        <Encoding>Alphanumeric</Encoding>
        <Description>The currency associated with a reported price</Description>
      </Field>
      <Field>
        <Name>Face Value</Name>
        <Size>8</Size>
        <Encoding>Numeric</Encoding>
        <Description>The face value of a debenture</Description>
      </Field>
      <Field>
        <Name>Last Sale</Name>
        <Size>8</Size>
        <Encoding>Numeric</Encoding>
        <Description>Last sale price of a stock</Description>
      </Field>
      <Field>
        <Name>Min PO Qty</Name>
        <Size>4</Size>
        <Encoding>Numeric</Encoding>
        <Description>The minimum volume required for Post Only orders.</Description>
      </Field>
      <Field>
        <Name>Stock State</Name>
        <Size>2</Size>
        <Encoding>Alphanumeric</Encoding>
        <Description>The state of the stock</Description>
      </Field>
      <Field>
        <Name>Test Symbol</Name>
        <Size>1</Size>
        <Encoding>Alphanumeric</Encoding>
        <Description>Indicates the symbol is a test symbol</Description>
      </Field>
    </Fields>

  </Message>
  
