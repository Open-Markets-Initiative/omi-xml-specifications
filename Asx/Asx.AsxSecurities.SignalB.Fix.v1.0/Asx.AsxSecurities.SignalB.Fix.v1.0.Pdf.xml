      <Field><Tag>35</Tag><Name>MsgType</Name><Required>Y</Required><Type>String</Type><Fixed>Y</Fixed><Description>Defines message type. Always third field in message.</Description></Field>
      <Field><Tag>49</Tag><Name>SenderCompID</Name><Required>Y</Required><Type>String</Type><Description>ID of the party sending the message.</Description></Field>
      <Field><Tag>56</Tag><Name>TargetCompID</Name><Required>Y</Required><Type>String</Type><Description>ID of the party the message is sent to.</Description></Field>
      <Field><Tag>34</Tag><Name>MsgSeqNum</Name><Required>Y</Required><Type>SeqNum</Type><Description>Message sequence number.</Description></Field>
      <Field><Tag>52</Tag><Name>SendingTime</Name><Required>Y</Required><Type>UTCTimestamp</Type><Description>Time of message transmission in UTC.</Description></Field>
