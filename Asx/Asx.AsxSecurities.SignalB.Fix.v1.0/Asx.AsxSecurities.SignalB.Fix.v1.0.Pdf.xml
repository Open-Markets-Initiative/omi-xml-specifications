      <Field><Tag>97</Tag><Name>PossResend</Name><Required>N</Required><Type>Boolean</Type><Description>Indicates a possible resend of an application message.</Description></Field>
      <Field><Tag>122</Tag><Name>OrigSendingTime</Name><Required>N</Required><Type>UTCTimestamp</Type><Description>Original sending time for retransmitted messages.</Description></Field>
      <Field><Tag>1128</Tag><Name>ApplVerID</Name><Required>N</Required><Type>String</Type><Description>Application version ID.</Description></Field>
    </Fields>
  </Header>

  <Trailer>
