<OmiMachPdf>

  <Messages>

    <!-- System Time Message -->
    <Message>
      <Name>System Time Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Data</Branch>
      <Category>Administrative</Category>
      <Code>1</Code>
      <Description>This is the message format that will be used to disseminate the "seconds" part of the timestamp that is applicable to all messages that are sent in the current second.</Description>
      <Fields>
        <Field>
          <Name>Seconds</Name>
          <Size>4</Size>
          <Type>SecTime</Type>
          <Description>Seconds part of the time that applies to all messages that gets disseminated until this message gets sent again.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Series Update Message -->
    <Message>
      <Name>Series Update Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Data</Branch>
      <Category>Administrative</Category>
      <Code>P</Code>
      <Description>This is the message format that will be used to disseminate all Option series traded on Pearl for the current session.</Description>
      <Fields>
        <Field>
          <Name>Nanoseconds</Name>
          <Size>4</Size>
          <Type>NanoTime</Type>
          <Description>Time at which this product is added/updated on Pearl system today.</Description>
        </Field>
        <Field>
          <Name>Product ID</Name>
          <Size>4</Size>
          <Type>BinaryU</Type>
          <Description>Pearl Product ID mapped to a given option. It is assigned per trading session and is valid for that session.</Description>
        </Field>
        <Field>
          <Name>Underlying Symbol</Name>
          <Size>11</Size>
          <Type>Alphanumeric</Type>
          <Description>Stock Symbol for the option.</Description>
        </Field>
        <Field>
          <Name>Security Symbol</Name>
          <Size>6</Size>
          <Type>Alphanumeric</Type>
          <Description>Option Security Symbol</Description>
        </Field>
        <Field>
          <Name>Expiration Date</Name>
          <Size>8</Size>
          <Type>Alphanumeric</Type>
          <Description>Expiration date of the option in YYYYMMDD format</Description>
        </Field>
        <Field>
          <Name>Strike Price</Name>
          <Size>4</Size>
          <Type>BinaryPrc4U</Type>
          <Description>Explicit strike price of the option. Refer to data types for field processing notes</Description>
        </Field>
        <Field>
          <Name>Call or Put</Name>
          <Size>1</Size>
          <Type>Alphanumeric</Type>
          <Description>Option Type</Description>
        </Field>
        <Field>
          <Name>Opening Time</Name>
          <Size>8</Size>
          <Type>Alphanumeric</Type>
          <Description>Expressed in HH:MM:SS format. Eg: 09:30:00</Description>
        </Field>
        <Field>
          <Name>Closing Time</Name>
          <Size>8</Size>
          <Type>Alphanumeric</Type>
          <Description>Expressed in HH:MM:SS format. Eg: 16:15:00</Description>
        </Field>
        <Field>
          <Name>Restricted Option</Name>
          <Size>1</Size>
          <Type>Alphanumeric</Type>
          <Description>Restricted Option value</Description>
        </Field>
        <Field>
          <Name>Long Term Option</Name>
          <Size>1</Size>
          <Type>Alphanumeric</Type>
          <Description>Long Term Option value</Description>
        </Field>
        <Field>
          <Name>Active on Pearl</Name>
          <Size>1</Size>
          <Type>Alphanumeric</Type>
          <Description>Indicates if this symbol is tradable on MIAX in the current session</Description>
        </Field>
        <Field>
          <Name>Pearl BBO Posting Increment Indicator</Name>
          <Size>1</Size>
          <Type>Alphanumeric</Type>
          <Description>This is the Minimum Price Variation as agreed to by the Options industry (penny pilot program) and as published by Pearl</Description>
        </Field>
        <Field>
          <Name>Liquidity Acceptance Increment Indicator</Name>
          <Size>1</Size>
          <Type>Alphanumeric</Type>
          <Description>This is the Minimum Price Variation for Quote/Order acceptance as per Pearl rules</Description>
        </Field>
        <Field>
          <Name>Opening Underlying Market Code</Name>
          <Size>1</Size>
          <Type>Alphanumeric</Type>
          <Description>Options opening will be triggered on receipt of Opening quote/trade from this Underlying market</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Size>12</Size>
          <Type>BinaryU</Type>
          <Description>Reserved for future use</Description>
        </Field>
      </Fields>
    </Message>

    <!-- System State Message -->
    <Message>
      <Name>System State Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Data</Branch>
      <Category>Administrative</Category>
      <Code>S</Code>
      <Description>This message format is used to notify the firms of the state changes of the system. This is a notification that applies to each Underlying group. Firms can use notifications as triggers in their system to ensure electronic synchronization of systems.</Description>
      <Fields>
        <Field>
          <Name>Nanoseconds</Name>
          <Size>4</Size>
          <Type>NanoTime</Type>
          <Description>Time at which this was generated by Pearl system.</Description>
        </Field>
        <Field>
          <Name>PLF Version</Name>
          <Size>8</Size>
          <Type>Alphanumeric</Type>
          <Description>Eg: PLF1.0</Description>
        </Field>
        <Field>
          <Name>Session ID</Name>
          <Size>4</Size>
          <Type>BinaryU</Type>
          <Description>Pearl assigned ID for the current trading session</Description>
        </Field>
        <Field>
          <Name>System Status</Name>
          <Size>1</Size>
          <Type>Alphanumeric</Type>
          <Description>Current system status</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Underlying Trading Status Notification Message -->
    <Message>
      <Name>Underlying Trading Status Notification Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Data</Branch>
      <Category>Notification</Category>
      <Code>H</Code>
      <Description>This message format will be used to notify firms of changes to the trading status of all the options of an underlying.</Description>
      <Fields>
        <Field>
          <Name>Nanoseconds</Name>
          <Size>4</Size>
          <Type>NanoTime</Type>
          <Description>Time at which this was generated by Pearl system.</Description>
        </Field>
        <Field>
          <Name>Underlying Symbol</Name>
          <Size>11</Size>
          <Type>Alphanumeric</Type>
          <Description>Underlying Symbol</Description>
        </Field>
        <Field>
          <Name>Trading Status</Name>
          <Size>1</Size>
          <Type>Alphanumeric</Type>
          <Description>Trading Status value</Description>
        </Field>
        <Field>
          <Name>Event Reason</Name>
          <Size>1</Size>
          <Type>Alphanumeric</Type>
          <Description>Event Reason value</Description>
        </Field>
        <Field>
          <Name>Expected Event Time: Seconds Part</Name>
          <Size>4</Size>
          <Type>SecTime</Type>
          <Description>Seconds portion of the expected time of the event. Always use in conjunction with the Nano-seconds part field.</Description>
        </Field>
        <Field>
          <Name>Expected Event Time: Nano-Seconds Part</Name>
          <Size>4</Size>
          <Type>BinaryU</Type>
          <Description>Nano-seconds portion of the expected time of the event. Specifies number of nano-seconds since the seconds specified in "Expected Event Time Seconds" field.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Message -->
    <Message>
      <Name>Order Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Data</Branch>
      <Category>Market Data</Category>
      <Code>F</Code>
      <Description>This is the message format that will be used to disseminate Pearl Options Orders.</Description>
      <Fields>
        <Field>
          <Name>Nanoseconds</Name>
          <Size>4</Size>
          <Type>NanoTime</Type>
          <Description>Time at which this was generated by Pearl system.</Description>
        </Field>
        <Field>
          <Name>Action</Name>
          <Size>1</Size>
          <Type>Alphanumeric</Type>
          <Description>Order Status.</Description>
        </Field>
        <Field>
          <Name>Product ID</Name>
          <Size>4</Size>
          <Type>BinaryU</Type>
          <Description>Pearl Product ID mapped to a given option. It is assigned per trading session and is valid for that session.</Description>
        </Field>
        <Field>
          <Name>Order ID</Name>
          <Size>8</Size>
          <Type>BinaryU</Type>
          <Description>Pearl assigned Order ID</Description>
        </Field>
        <Field>
          <Name>Order Side</Name>
          <Size>1</Size>
          <Type>Alphanumeric</Type>
          <Description>Side of order.</Description>
        </Field>
        <Field>
          <Name>Order Type</Name>
          <Size>1</Size>
          <Type>Alphanumeric</Type>
          <Description>Order price type.</Description>
        </Field>
        <Field>
          <Name>Order Price</Name>
          <Size>4</Size>
          <Type>BinaryPrc4U</Type>
          <Description>Limit price of the order. Zero for market orders.</Description>
        </Field>
        <Field>
          <Name>Order Original Volume</Name>
          <Size>4</Size>
          <Type>BinaryU</Type>
          <Description>Number of contracts specified on the order.</Description>
        </Field>
        <Field>
          <Name>Remaining Volume Open</Name>
          <Size>4</Size>
          <Type>BinaryU</Type>
          <Description>Number of contracts that are still open for trading at Pearl.</Description>
        </Field>
        <Field>
          <Name>Time In Force (TIF)</Name>
          <Size>1</Size>
          <Type>Alphanumeric</Type>
          <Description>Specifies how long the order remains in effect.</Description>
        </Field>
        <Field>
          <Name>Origin</Name>
          <Size>1</Size>
          <Type>Alphanumeric</Type>
          <Description>Specifies the order origin type.</Description>
        </Field>
        <Field>
          <Name>Open/close indicator</Name>
          <Size>1</Size>
          <Type>Alphanumeric</Type>
          <Description>Specifies if this order opens a position or closes a position. N/A when Origin is set to 4 = Market Maker or 5 = Non-Member Market Maker</Description>
        </Field>
        <Field>
          <Name>Order instruction</Name>
          <Size>1</Size>
          <Type>Alphanumeric</Type>
          <Description>Order instruction that came with the order.</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Size>8</Size>
          <Type>BinaryU</Type>
          <Description>Reserved for future use</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Close Message -->
    <Message>
      <Name>Order Close Message</Name>
      <Dependency>Message Type</Dependency>
      <Branch>Data</Branch>
      <Category>Market Data</Category>
      <Code>x</Code>
      <Description>This is the message format that will be used to disseminate Order Close for Pearl Options Orders.</Description>
      <Fields>
        <Field>
          <Name>Nanoseconds</Name>
          <Size>4</Size>
          <Type>NanoTime</Type>
          <Description>Time at which this was generated by Pearl system.</Description>
        </Field>
        <Field>
          <Name>Order ID</Name>
          <Size>8</Size>
          <Type>BinaryU</Type>
          <Description>Pearl assigned Order ID</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

