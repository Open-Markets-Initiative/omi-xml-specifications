<OmiKrxXls>

<Messages>

    <!-- External Gold Spot Closing Price Message -->
    <Message>
      <Name>External Gold Spot Closing Price Message</Name>
      <Dependency>Message Code</Dependency>
      <Branch>Payload</Branch>
      <Code>M200G</Code>
      <Description>External Gold Spot (Closing Price) (IFMSRID0036) — Commodities A CMD variant. NESTED-BRANCH NOTE: TR-CODE M200G is shared with the Real-time variant (IFMSRID0035); the Data Type field (field 3) discriminates between Closing Price and Real-time. The loader will need an inner Branch on Data Type once the nested-Branch shape is settled. Real-time variant deferred.</Description>
      <Fields>
        <Field>
          <Name>Data Type</Name>
          <Identifier>datatype</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>1 : Real-Time 2 : Closing price.</Description>
        </Field>
        <Field>
          <Name>Job Code (symbol)</Name>
          <Identifier>jobcodesymbol</Identifier>
          <Type>String</Type>
          <Size>16</Size>
          <Description>"GOLDUSDOZ " or "GOLDKRWGR ".</Description>
        </Field>
        <Field>
          <Name>Trading date</Name>
          <Identifier>tradingdate</Identifier>
          <Type>String</Type>
          <Size>8</Size>
          <Format>YYYYMMDD</Format>
          <Description>YYYYMMDD.</Description>
        </Field>
        <Field>
          <Name>Trading Time</Name>
          <Identifier>tradingtime</Identifier>
          <Type>String</Type>
          <Size>6</Size>
          <Format>HHMMSS</Format>
          <Description>HHMMSS.</Description>
        </Field>
        <Field>
          <Name>Opening Price</Name>
          <Identifier>openingprice</Identifier>
          <Type>String</Type>
          <Size>9</Size>
          <Description>999999V999 ex) : " 1209855".</Description>
        </Field>
        <Field>
          <Name>High Price</Name>
          <Identifier>highprice</Identifier>
          <Type>String</Type>
          <Size>9</Size>
          <Description>999999V999 ex) : " 1209855".</Description>
        </Field>
        <Field>
          <Name>Low Price</Name>
          <Identifier>lowprice</Identifier>
          <Type>String</Type>
          <Size>9</Size>
          <Description>999999V999 ex) : " 1209855".</Description>
        </Field>
        <Field>
          <Name>Closing Price</Name>
          <Identifier>closingprice</Identifier>
          <Type>String</Type>
          <Size>9</Size>
          <Description>Average Price of Bid/Ask Quote 999999V999 ex) : " 1209855".</Description>
        </Field>
        <Field>
          <Name>Change from Previous Day Sign</Name>
          <Identifier>changefrompreviousdaysign</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>+' : up ' ' : steady '-' : down.</Description>
        </Field>
        <Field>
          <Name>Change from Previous Day</Name>
          <Identifier>changefrompreviousday</Identifier>
          <Type>String</Type>
          <Size>9</Size>
          <Description>999999V99 ex) : " 1471".</Description>
        </Field>
        <Field>
          <Name>Fluctuating rate</Name>
          <Identifier>fluctuatingrate</Identifier>
          <Type>String</Type>
          <Size>9</Size>
          <Description>+999999V99 ex1) +1% = " +100" ex2) : -1% = " -100" ex3) : 0% = " 0".</Description>
        </Field>
        <Field>
          <Name>Bid Quote</Name>
          <Identifier>bidquote</Identifier>
          <Type>String</Type>
          <Size>9</Size>
          <Description>999999V999 ex) : " 1209855".</Description>
        </Field>
        <Field>
          <Name>Ask Quote</Name>
          <Identifier>askquote</Identifier>
          <Type>String</Type>
          <Size>9</Size>
          <Description>999999V999 ex) : " 1209855".</Description>
        </Field>
        <Field>
          <Name>Currency Code</Name>
          <Identifier>currencycode</Identifier>
          <Type>String</Type>
          <Size>6</Size>
          <Description>Provided only in case of "USDKRW" - GOLDKRWGR.</Description>
        </Field>
        <Field>
          <Name>Conversion Basic Exchange Rate</Name>
          <Identifier>conversionbasicexchangerate</Identifier>
          <Type>String</Type>
          <Size>9</Size>
          <Description>Provided only in case of "USDKRW" - GOLDKRWGR ex) : " 1209855".</Description>
        </Field>
        <Field>
          <Name>End Keyword</Name>
          <Identifier>endkeyword</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>End of text sentinel (0xFF).</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

</OmiKrxXls>
