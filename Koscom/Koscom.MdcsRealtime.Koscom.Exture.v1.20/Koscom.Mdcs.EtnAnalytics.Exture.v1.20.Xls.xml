<OmiKrxXls>

<Messages>

    <!-- Etn Iiv Message -->
    <Message>
      <Name>Etn Iiv Message</Name>
      <Dependency>Message Code</Dependency>
      <Branch>Payload</Branch>
      <Code>S304S</Code>
      <Description>ETN intraday indicative value. Previous-day and during-market/final iIV per ETN.</Description>
      <Fields>
        <Field>
          <Name>ISIN</Name>
          <Identifier>isin</Identifier>
          <Type>String</Type>
          <Size>12</Size>
          <Description>Standard Code(ISIN) ISIN ← ETN Symbol Code.</Description>
        </Field>
        <Field>
          <Name>Hours</Name>
          <Identifier>hours</Identifier>
          <Type>String</Type>
          <Size>6</Size>
          <Format>HHMMSS</Format>
          <Description>HHMMSS:During Market hours JUNJJJ:Market Closure.</Description>
        </Field>
        <Field>
          <Name>Previous Day's IV</Name>
          <Identifier>previousdaysiv</Identifier>
          <Type>Double</Type>
          <Size>9</Size>
          <Format>Decimal:2</Format>
          <Description>9(7)V9(2).</Description>
        </Field>
        <Field>
          <Name>During Market hours/Final IV</Name>
          <Identifier>duringmarkethoursfinaliv</Identifier>
          <Type>Double</Type>
          <Size>9</Size>
          <Format>Decimal:2</Format>
          <Description>9(7)V9(2).</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Identifier>filler</Identifier>
          <Type>String</Type>
          <Size>28</Size>
          <Description>Reserved filler. ASCII spaces.</Description>
        </Field>
        <Field>
          <Name>End Keyword</Name>
          <Identifier>endkeyword</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>End of text sentinel (0xFF).</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Etn Disparate Ratio Message -->
    <Message>
      <Name>Etn Disparate Ratio Message</Name>
      <Dependency>Message Code</Dependency>
      <Branch>Payload</Branch>
      <Code>X404S</Code>
      <Description>ETN signed disparate ratio per ETN.</Description>
      <Fields>
        <Field>
          <Name>ISIN</Name>
          <Identifier>isin</Identifier>
          <Type>String</Type>
          <Size>12</Size>
          <Description>Standard Code(ISIN) ISIN ← ETN Symbol Code.</Description>
        </Field>
        <Field>
          <Name>Seq. number</Name>
          <Identifier>seqnumber</Identifier>
          <Type>Long</Type>
          <Size>8</Size>
          <Description>1~99999999 Transmission Sequence Number to check number of orders.</Description>
        </Field>
        <Field>
          <Name>Date</Name>
          <Identifier>date</Identifier>
          <Type>String</Type>
          <Size>8</Size>
          <Format>YYYYMMDD</Format>
          <Description>YYYMMDD:Last business day.</Description>
        </Field>
        <Field>
          <Name>Disparate Ratio Sign</Name>
          <Identifier>disparateratiosign</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>SPACE:0, '+':&gt;0, '-':&lt;0.</Description>
        </Field>
        <Field>
          <Name>Disparate Ratio</Name>
          <Identifier>disparateratio</Identifier>
          <Type>Double</Type>
          <Size>9</Size>
          <Format>Decimal:2</Format>
          <Description>9(7)V9(2), Unit:%.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Identifier>filler</Identifier>
          <Type>String</Type>
          <Size>56</Size>
          <Description>Reserved filler. ASCII spaces.</Description>
        </Field>
        <Field>
          <Name>End Keyword</Name>
          <Identifier>endkeyword</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>End of text sentinel (0xFF).</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

</OmiKrxXls>
