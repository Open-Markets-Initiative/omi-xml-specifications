<OmiKrxXls>

<Messages>

    <!-- Mkf Index Message -->
    <Message>
      <Name>Mkf Index Message</Name>
      <Dependency>Message Code</Dependency>
      <Branch>Payload</Branch>
      <Code>E2000</Code>
      <Description>MKF Index real-time message. Reports current index value, sign and magnitude of change against the previous day, and accumulated trading volume and value for one MKF index identifier.</Description>
      <Fields>
        <Field>
          <Name>Index ID</Name>
          <Identifier>indexid</Identifier>
          <Type>String</Type>
          <Size>6</Size>
          <Description>MKF Index identifier. Refer to the Code Table sheet.</Description>
        </Field>
        <Field>
          <Name>ISIN</Name>
          <Identifier>isin</Identifier>
          <Type>String</Type>
          <Size>12</Size>
          <Description>ISIN code for the index (typically SPACE filled for MKF indices).</Description>
        </Field>
        <Field>
          <Name>Time</Name>
          <Identifier>time</Identifier>
          <Type>String</Type>
          <Size>6</Size>
          <Format>HHMMSS</Format>
          <Description>Index calculation time in HHMMSS. Range 09:01 to extended off-hours closing (around 18:00).</Description>
        </Field>
        <Field>
          <Name>Index</Name>
          <Identifier>index</Identifier>
          <Type>Double</Type>
          <Size>9</Size>
          <Format>Decimal:2</Format>
          <Description>Current MKF Index value (9 ASCII digits with 2 implied decimal places).</Description>
        </Field>
        <Field>
          <Name>Sign</Name>
          <Identifier>sign</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Sign of the index change against the previous day. '+' ascended, ' ' steadiness, '-' declined.</Description>
        </Field>
        <Field>
          <Name>Comparison</Name>
          <Identifier>comparison</Identifier>
          <Type>Double</Type>
          <Size>9</Size>
          <Format>Decimal:2</Format>
          <Description>Magnitude of the index change against the previous day (9 ASCII digits with 2 implied decimal places).</Description>
        </Field>
        <Field>
          <Name>Trading Volume</Name>
          <Identifier>tradingvolume</Identifier>
          <Type>Long</Type>
          <Size>12</Size>
          <Description>Accumulated trading volume (12 ASCII digits). Unit: 1,000 shares.</Description>
        </Field>
        <Field>
          <Name>Trading Value</Name>
          <Identifier>tradingvalue</Identifier>
          <Type>Long</Type>
          <Size>12</Size>
          <Description>Accumulated trading value (12 ASCII digits). Unit: 1,000,000 KRW.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Identifier>filler</Identifier>
          <Type>String</Type>
          <Size>4</Size>
          <Description>Reserved filler. Always 4 ASCII space characters.</Description>
        </Field>
        <Field>
          <Name>End Keyword</Name>
          <Identifier>endkeyword</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>End of text sentinel (0xFF).</Description>
        </Field>
      </Fields>
    </Message>

