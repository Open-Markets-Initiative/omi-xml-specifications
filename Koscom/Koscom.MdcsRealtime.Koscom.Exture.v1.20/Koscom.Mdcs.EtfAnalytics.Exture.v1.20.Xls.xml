    <!-- Domestic Etf Inav Message -->
    <Message>
      <Name>Domestic Etf Inav Message</Name>
      <Dependency>Message Code</Dependency>
      <Branch>Payload</Branch>
      <Code>BV03S</Code>
      <Description>Domestic ETF intraday NAV (1-second interval). Carries previous-day and during-market/final NAV per ETF ISIN.</Description>
      <Fields>
        <Field>
          <Name>ISIN</Name>
          <Identifier>isin</Identifier>
          <Type>String</Type>
          <Size>12</Size>
          <Description>Standard code(ISIN) ISIN ← ETF Issue code.</Description>
        </Field>
        <Field>
          <Name>Time</Name>
          <Identifier>time</Identifier>
          <Type>String</Type>
          <Size>6</Size>
          <Format>HHMMSS</Format>
          <Description>HHMMSS:Regular Session JSAM00:Market Closing.</Description>
        </Field>
        <Field>
          <Name>Previous NAV</Name>
          <Identifier>previousnav</Identifier>
          <Type>Double</Type>
          <Size>9</Size>
          <Format>Decimal:2</Format>
          <Description>9(7)V9(2) Information Category 03S: Fund unit, 05S: TU unit.</Description>
        </Field>
        <Field>
          <Name>During market/final NAV</Name>
          <Identifier>duringmarketfinalnav</Identifier>
          <Type>Double</Type>
          <Size>9</Size>
          <Format>Decimal:2</Format>
          <Description>9(7)V9(2) Information Category 03S: Fund unit, 05S: TU unit.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Identifier>filler</Identifier>
          <Type>String</Type>
          <Size>28</Size>
          <Description>Reserved filler. ASCII spaces.</Description>
        </Field>
        <Field>
          <Name>End Keyword</Name>
          <Identifier>endkeyword</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>End of text sentinel (0xFF).</Description>
        </Field>
      </Fields>
    </Message>

