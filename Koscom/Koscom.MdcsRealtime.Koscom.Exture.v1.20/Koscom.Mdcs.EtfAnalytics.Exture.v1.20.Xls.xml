    <!-- Etp Pdf Message -->
    <Message>
      <Name>Etp Pdf Message</Name>
      <Dependency>Message Code</Dependency>
      <Branch>Payload</Branch>
      <Code>F803S</Code>
      <Description>ETP Portfolio Deposit File. One record per composition issue: unit share, market type, issue name, par value, appraised value, profit distribution basis date.</Description>
      <Fields>
        <Field>
          <Name>ISIN</Name>
          <Identifier>isin</Identifier>
