          <Identifier>dataseqnumber</Identifier>
          <Type>Long</Type>
          <Size>8</Size>
          <Description>Transmission seq. number.</Description>
        </Field>
        <Field>
          <Name>Date</Name>
          <Identifier>date</Identifier>
          <Type>String</Type>
          <Size>8</Size>
          <Format>YYYYMMDD</Format>
          <Description>YYYYMMDD(applicable date).</Description>
        </Field>
        <Field>
          <Name>Office Consignment company's registration number</Name>
          <Identifier>officeconsignmentcompanysregistrationnumber</Identifier>
          <Type>String</Type>
          <Size>3</Size>
          <Description>049: Korea Fund Partners ← Mirae Asset Fund Services 905: Shinhan Fund Partners ← Shinhanaitas 906: WOORI FUND SERVICES 2023.04.10 new 907: HANA FUND SERVICES 2024.09.09 new 909: KB FUND PARTNERS 2024.</Description>
        </Field>
        <Field>
          <Name>Composition issue number</Name>
          <Identifier>compositionissuenumber</Identifier>
          <Type>Long</Type>
          <Size>4</Size>
          <Description>Unit: issue (including cash).</Description>
        </Field>
        <Field>
          <Name>Composition issue code</Name>
          <Identifier>compositionissuecode</Identifier>
          <Type>String</Type>
          <Size>12</Size>
          <Description>KRD010010001:KRW CASH listed futures: isin code, in case of non-listed, separated definition: futures in case of non-listed, separate definition CP added : KRZ + 9 digits FXFWD0000USD : FX Forward(USD.</Description>
        </Field>
        <Field>
          <Name>1CU unit share/Number of contract/KRW Cash/USD Cash/Converted amount(KRW)</Name>
          <Identifier>1cuunitsharenumberofcontractkrwcashusdcashconvertedamountkrw</Identifier>
          <Type>Double</Type>
          <Size>18</Size>
          <Description>※1cu unit share/number of contract/krw cash/usd cash/warehouse warrant unit is defined by the composion issue code(7th field) - stock→unit:share (if the first field is "-"(minus signal), it means shor.</Description>
        </Field>
        <Field>
          <Name>Composition Issue Market Type</Name>
          <Identifier>compositionissuemarkettype</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>0: KOSPI(Including cash,KSP200T00001,FKSP200T0001) 1:KOSDAQ 2: Others 3:Bond 4: Futures 2010.04.09 5: spot.</Description>
        </Field>
        <Field>
          <Name>Composition Issue Name</Name>
          <Identifier>compositionissuename</Identifier>
          <Type>String</Type>
          <Size>40</Size>
          <Description>In case of foreign issue is issue name. For others, '0' or SPACE.</Description>
        </Field>
        <Field>
          <Name>Par value amount/Cash Amount/Converted amount(KRW)</Name>
          <Identifier>parvalueamountcashamountconvertedamountkrw</Identifier>
          <Type>Long</Type>
          <Size>18</Size>
          <Description>in case of par value, composition issue code is bond, futures, swap,FX Forward cash amount set:in case cu unit set redemption, possible cash setting is displayed based o etf code, current stock index .</Description>
        </Field>
        <Field>
          <Name>Profit Distribution Basis Date</Name>
          <Identifier>profitdistributionbasisdate</Identifier>
          <Type>String</Type>
          <Size>8</Size>
          <Format>YYYYMMDD</Format>
          <Description>only for bond etf. date when profit distribution occurs for the following etf. same value about the special date's duplicate etf code default : space or "0", yyyymmdd.</Description>
        </Field>
        <Field>
          <Name>Appraised Value</Name>
          <Identifier>appraisedvalue</Identifier>
          <Type>Long</Type>
          <Size>18</Size>
          <Description>Appraised Value.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Identifier>filler</Identifier>
          <Type>String</Type>
          <Size>4</Size>
          <Description>Reserved filler. ASCII spaces.</Description>
        </Field>
        <Field>
          <Name>End Keyword</Name>
          <Identifier>endkeyword</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>End of text sentinel (0xFF).</Description>
        </Field>
      </Fields>
    </Message>

