<OmiKrxXls>

<Messages>

    <!-- Elw Investment Indicator Sensitivity Message -->
    <Message>
      <Name>Elw Investment Indicator Sensitivity Message</Name>
      <Dependency>Message Code</Dependency>
      <Branch>Payload</Branch>
      <Code>C702S</Code>
      <Description>ELW Investment Indicator Sensitivity. Theoretical warrant price plus signed Delta/Gamma/Theta/Vega/Rho sensitivities, intrinsic volatility, and prerequisite cost.</Description>
      <Fields>
        <Field>
          <Name>ISIN</Name>
          <Identifier>isin</Identifier>
          <Type>String</Type>
          <Size>12</Size>
          <Description>Standard Code(ISIN) ISIN ← Issue code.</Description>
        </Field>
        <Field>
          <Name>Time</Name>
          <Identifier>time</Identifier>
          <Type>String</Type>
          <Size>6</Size>
          <Format>HHMMSS</Format>
          <Description>During market: HHMMSS (Time:min:Sec) 090000 ~ Market Closing: JUNJJJ.</Description>
        </Field>
        <Field>
          <Name>Theoretical warrant price</Name>
          <Identifier>theoreticalwarrantprice</Identifier>
          <Type>Double</Type>
          <Size>10</Size>
          <Format>Decimal:2</Format>
          <Description>9(8)9V9(2).</Description>
        </Field>
        <Field>
          <Name>Sensitivity - Delta sign</Name>
          <Identifier>sensitivitydeltasign</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>"+", "-", " ".</Description>
        </Field>
        <Field>
          <Name>Sensitivity - Delta</Name>
          <Identifier>sensitivitydelta</Identifier>
          <Type>Double</Type>
          <Size>7</Size>
          <Format>Decimal:6</Format>
          <Description>9V9(6).</Description>
        </Field>
        <Field>
          <Name>Sensitivity - Gamma sign</Name>
          <Identifier>sensitivitygammasign</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>"+", "-", " ".</Description>
        </Field>
        <Field>
          <Name>Sensitivity - Gamma</Name>
          <Identifier>sensitivitygamma</Identifier>
          <Type>Double</Type>
          <Size>7</Size>
          <Format>Decimal:6</Format>
          <Description>9V9(6).</Description>
        </Field>
        <Field>
          <Name>Sensitivity - Theta sign</Name>
          <Identifier>sensitivitythetasign</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>"+", "-", " ".</Description>
        </Field>
        <Field>
          <Name>Sensitivity - Theta</Name>
          <Identifier>sensitivitytheta</Identifier>
          <Type>Double</Type>
          <Size>12</Size>
          <Format>Decimal:6</Format>
          <Description>9(6)V9(6).</Description>
        </Field>
        <Field>
          <Name>Sensitivity - Vega sign</Name>
          <Identifier>sensitivityvegasign</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>"+", "-", " ".</Description>
        </Field>
        <Field>
          <Name>Sensitivity - Vega</Name>
          <Identifier>sensitivityvega</Identifier>
          <Type>Double</Type>
          <Size>12</Size>
          <Format>Decimal:6</Format>
          <Description>9(6)V9(6).</Description>
        </Field>
        <Field>
          <Name>Sensitivity - Rho sign</Name>
          <Identifier>sensitivityrhosign</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>"+", "-", " ".</Description>
        </Field>
        <Field>
          <Name>Sensitivity - Rho</Name>
          <Identifier>sensitivityrho</Identifier>
          <Type>Double</Type>
          <Size>12</Size>
          <Format>Decimal:6</Format>
          <Description>9(6)V9(6).</Description>
        </Field>
        <Field>
          <Name>Intrinsic volatility</Name>
          <Identifier>intrinsicvolatility</Identifier>
          <Type>Double</Type>
          <Size>5</Size>
          <Format>Decimal:2</Format>
          <Description>9(3)V9(2) "0" for Early Closed ELW.</Description>
        </Field>
        <Field>
          <Name>Prerequisite Cost</Name>
          <Identifier>prerequisitecost</Identifier>
          <Type>Double</Type>
          <Size>10</Size>
          <Format>Decimal:2</Format>
          <Description>9(8)V9(2) "0" for Standard ELW.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Identifier>filler</Identifier>
          <Type>String</Type>
          <Size>6</Size>
          <Description>Reserved filler. ASCII spaces.</Description>
        </Field>
        <Field>
          <Name>End Keyword</Name>
          <Identifier>endkeyword</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>End of text sentinel (0xFF).</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

</OmiKrxXls>
