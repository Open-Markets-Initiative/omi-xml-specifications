<OmiKrxXls>

<Messages>

    <!-- K Otc Issue Closing Message -->
    <Message>
      <Name>K Otc Issue Closing Message</Name>
      <Dependency>Message Code</Dependency>
      <Branch>Payload</Branch>
      <Code>A6013</Code>
      <Description>K-OTC Issue Closing. Reports closing price and the quotation category per ISIN.</Description>
      <Fields>
        <Field>
          <Name>ISIN</Name>
          <Identifier>isin</Identifier>
          <Type>String</Type>
          <Size>12</Size>
          <Description>Standard Code(ISIN) ISIN ← Issue code.</Description>
        </Field>
        <Field>
          <Name>Data seq. number</Name>
          <Identifier>dataseqnumber</Identifier>
          <Type>Long</Type>
          <Size>8</Size>
          <Description>Seq. number including quote, trading, market action.</Description>
        </Field>
        <Field>
          <Name>Closing Price</Name>
          <Identifier>closingprice</Identifier>
          <Type>Long</Type>
          <Size>9</Size>
          <Description>Closing Price.</Description>
        </Field>
        <Field>
          <Name>Quotation Category</Name>
          <Identifier>quotationcategory</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>0:Weighted Avg Price,1:Quotation,2:No Trade.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Identifier>filler</Identifier>
          <Type>String</Type>
          <Size>4</Size>
          <Description>Reserved filler. ASCII spaces.</Description>
        </Field>
        <Field>
          <Name>End Keyword</Name>
          <Identifier>endkeyword</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>End of text sentinel (0xFF).</Description>
        </Field>
      </Fields>
    </Message>

    <!-- K Otc Market Operation Message -->
    <Message>
      <Name>K Otc Market Operation Message</Name>
      <Dependency>Message Code</Dependency>
      <Branch>Payload</Branch>
      <Code>A7013</Code>
      <Description>K-OTC Market Operation. Trading halt / lift-after-halt events with reason code.</Description>
      <Fields>
        <Field>
          <Name>ISIN</Name>
          <Identifier>isin</Identifier>
          <Type>String</Type>
          <Size>12</Size>
          <Description>Standard Code(ISIN) ISIN ← Issue code.</Description>
        </Field>
        <Field>
          <Name>Data seq. number</Name>
          <Identifier>dataseqnumber</Identifier>
          <Type>Long</Type>
          <Size>8</Size>
          <Description>Seq. number including quote, trading, market action.</Description>
        </Field>
        <Field>
          <Name>Type</Name>
          <Identifier>type</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>1:trading halt 2: lift after trading halt.</Description>
        </Field>
        <Field>
          <Name>Reason</Name>
          <Identifier>reason</Identifier>
          <Type>String</Type>
          <Size>2</Size>
          <Description>Reason.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Identifier>filler</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Reserved filler. ASCII spaces.</Description>
        </Field>
        <Field>
          <Name>End Keyword</Name>
          <Identifier>endkeyword</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>End of text sentinel (0xFF).</Description>
        </Field>
      </Fields>
    </Message>

    <!-- K Otc Market Action Message -->
    <Message>
      <Name>K Otc Market Action Message</Name>
      <Dependency>Message Code</Dependency>
      <Branch>Payload</Branch>
      <Code>G5013</Code>
      <Description>K-OTC Market Action. Basis price and upper/lower limit price changes.</Description>
      <Fields>
        <Field>
          <Name>ISIN</Name>
          <Identifier>isin</Identifier>
          <Type>String</Type>
          <Size>12</Size>
          <Nullable>0</Nullable>
          <Description>Standard Code(ISIN) ISIN ← Issue code (in case that data type is not 01, then "0").</Description>
        </Field>
        <Field>
          <Name>Data type</Name>
          <Identifier>datatype</Identifier>
          <Type>String</Type>
          <Size>2</Size>
          <Description>01: change of basis price and upper/lower limit price 02: temporary halt, 03: resumption after temporary halt.</Description>
        </Field>
        <Field>
          <Name>Change date</Name>
          <Identifier>changedate</Identifier>
          <Type>String</Type>
          <Size>8</Size>
          <Format>YYYYMMDD</Format>
          <Nullable>0</Nullable>
          <Description>YYYYMMDD(in case that data type is not 01, then "0").</Description>
        </Field>
        <Field>
          <Name>Change time</Name>
          <Identifier>changetime</Identifier>
          <Type>String</Type>
          <Size>8</Size>
          <Format>HHMMSSMM</Format>
          <Nullable>0</Nullable>
          <Description>HHMMSSMM(in case that data type is not 01, then "0").</Description>
        </Field>
        <Field>
          <Name>Basis price before action</Name>
          <Identifier>basispricebeforeaction</Identifier>
          <Type>Long</Type>
          <Size>9</Size>
          <Nullable>0</Nullable>
          <Description>Unit: KRW (in case that data type is not 01, then "0").</Description>
        </Field>
        <Field>
          <Name>Upper limit price before action</Name>
          <Identifier>upperlimitpricebeforeaction</Identifier>
          <Type>Long</Type>
          <Size>9</Size>
          <Nullable>0</Nullable>
          <Description>Unit: KRW (in case that data type is not 01, then "0").</Description>
        </Field>
        <Field>
          <Name>Lower limit price before action</Name>
          <Identifier>lowerlimitpricebeforeaction</Identifier>
          <Type>Long</Type>
          <Size>9</Size>
          <Nullable>0</Nullable>
          <Description>Unit: KRW (in case that data type is not 01, then "0").</Description>
        </Field>
        <Field>
          <Name>Basis price after action</Name>
          <Identifier>basispriceafteraction</Identifier>
          <Type>Long</Type>
          <Size>9</Size>
          <Nullable>0</Nullable>
          <Description>Unit: KRW (in case that data type is not 01, then "0").</Description>
        </Field>
        <Field>
          <Name>Upper limit price after action</Name>
          <Identifier>upperlimitpriceafteraction</Identifier>
          <Type>Long</Type>
          <Size>9</Size>
          <Nullable>0</Nullable>
          <Description>Unit: KRW (in case that data type is not 01, then "0").</Description>
        </Field>
        <Field>
          <Name>Lower limit price after action</Name>
          <Identifier>lowerlimitpriceafteraction</Identifier>
          <Type>Long</Type>
          <Size>9</Size>
          <Nullable>0</Nullable>
          <Description>Unit: KRW (in case that data type is not 01, then "0").</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Identifier>filler</Identifier>
          <Type>String</Type>
          <Size>10</Size>
          <Description>Reserved filler. ASCII spaces.</Description>
        </Field>
        <Field>
          <Name>End Keyword</Name>
          <Identifier>endkeyword</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>End of text sentinel (0xFF).</Description>
        </Field>
      </Fields>
    </Message>

    <!-- K Otc Quote Message -->
    <Message>
      <Name>K Otc Quote Message</Name>
      <Dependency>Message Code</Dependency>
      <Branch>Payload</Branch>
      <Code>A2013</Code>
      <Description>K-OTC Quote. Bid/ask quote with remaining quantity at the best price.</Description>
      <Fields>
        <Field>
          <Name>ISIN</Name>
          <Identifier>isin</Identifier>
          <Type>String</Type>
          <Size>12</Size>
          <Description>Standard Code(ISIN) ISIN ← Issue Code.</Description>
        </Field>
        <Field>
          <Name>Data seq. number</Name>
          <Identifier>dataseqnumber</Identifier>
          <Type>Long</Type>
          <Size>8</Size>
          <Description>Seq. number including quote, trading and market action.</Description>
        </Field>
        <Field>
          <Name>Process type</Name>
          <Identifier>processtype</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>1: normal 2: correction 3: cancellation.</Description>
        </Field>
        <Field>
          <Name>Quote number</Name>
          <Identifier>quotenumber</Identifier>
          <Type>String</Type>
          <Size>6</Size>
          <Description>Quote number in case of normal process.</Description>
        </Field>
        <Field>
          <Name>Original quote number</Name>
          <Identifier>originalquotenumber</Identifier>
          <Type>String</Type>
          <Size>6</Size>
          <Description>Normal: 0, in case of correction/cancellation, relevant original quote is number.</Description>
        </Field>
        <Field>
          <Name>Original quote price</Name>
          <Identifier>originalquoteprice</Identifier>
          <Type>String</Type>
          <Size>9</Size>
          <Description>Normal: 0, in case of correction/cancellation, original price.</Description>
        </Field>
        <Field>
          <Name>Bid/ask type</Name>
          <Identifier>bidasktype</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>1: ask, 2:bid.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Identifier>price</Identifier>
          <Type>Long</Type>
          <Size>9</Size>
          <Description>Normal: order price Correction: correction price.</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Identifier>quantity</Identifier>
          <Type>Long</Type>
          <Size>10</Size>
          <Description>Normal: order quantity Correction/cancellation: actual correction/cancellation quantity.</Description>
        </Field>
        <Field>
          <Name>Subscription time</Name>
          <Identifier>subscriptiontime</Identifier>
          <Type>String</Type>
          <Size>6</Size>
          <Description>Subscription time.</Description>
        </Field>
        <Field>
          <Name>Total remaining quantity of ask</Name>
          <Identifier>totalremainingquantityofask</Identifier>
          <Type>Long</Type>
          <Size>10</Size>
          <Description>Total remaining quantity of ask.</Description>
        </Field>
        <Field>
          <Name>Total remaining quantity of bid</Name>
          <Identifier>totalremainingquantityofbid</Identifier>
          <Type>Long</Type>
          <Size>10</Size>
          <Description>Total remaining quantity of bid.</Description>
        </Field>
        <Field>
          <Name>Ask best order</Name>
          <Identifier>askbestorder</Identifier>
          <Type>Long</Type>
          <Size>9</Size>
          <Description>Ask best order.</Description>
        </Field>
        <Field>
          <Name>Remaining quantity of ask best order</Name>
          <Identifier>remainingquantityofaskbestorder</Identifier>
          <Type>Long</Type>
          <Size>10</Size>
          <Description>Remaining quantity of ask best order.</Description>
        </Field>
        <Field>
          <Name>Bid best order</Name>
          <Identifier>bidbestorder</Identifier>
          <Type>Long</Type>
          <Size>9</Size>
          <Description>Bid best order.</Description>
        </Field>
        <Field>
          <Name>Remaining quantity of bid best order</Name>
          <Identifier>remainingquantityofbidbestorder</Identifier>
          <Type>Long</Type>
          <Size>10</Size>
          <Description>Remaining quantity of bid best order.</Description>
        </Field>
        <Field>
          <Name>Price compare remaining quantity of order</Name>
          <Identifier>pricecompareremainingquantityoforder</Identifier>
          <Type>Long</Type>
          <Size>10</Size>
          <Description>Normal: remaining quantity of order Correction: remaining quantity of correction.</Description>
        </Field>
        <Field>
          <Name>Original price compare remaining quantity of order</Name>
          <Identifier>originalpricecompareremainingquantityoforder</Identifier>
          <Type>Long</Type>
          <Size>10</Size>
          <Description>Normal: 0, in case of correction/cancellation, original remaining quantity.</Description>
        </Field>
        <Field>
          <Name>Securities company number</Name>
          <Identifier>securitiescompanynumber</Identifier>
          <Type>Long</Type>
          <Size>3</Size>
          <Description>Refer to trading original type code.</Description>
        </Field>
        <Field>
          <Name>Branch name</Name>
          <Identifier>branchname</Identifier>
          <Type>String</Type>
          <Size>12</Size>
          <Description>SPACE.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Identifier>filler</Identifier>
          <Type>String</Type>
          <Size>33</Size>
          <Description>Reserved filler. ASCII spaces.</Description>
        </Field>
        <Field>
          <Name>End Keyword</Name>
          <Identifier>endkeyword</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>End of text sentinel (0xFF).</Description>
        </Field>
      </Fields>
    </Message>

    <!-- K Otc Order Filled Message -->
    <Message>
      <Name>K Otc Order Filled Message</Name>
      <Dependency>Message Code</Dependency>
      <Branch>Payload</Branch>
      <Code>A3013</Code>
      <Description>K-OTC Order Filled. Trade prints with running totals, high/low, weighted average price, and previous-day comparison.</Description>
      <Fields>
        <Field>
          <Name>ISIN</Name>
          <Identifier>isin</Identifier>
          <Type>String</Type>
          <Size>12</Size>
          <Description>Standard Code(ISIN) ISIN ← Issue code.</Description>
        </Field>
        <Field>
          <Name>Data seq. number</Name>
          <Identifier>dataseqnumber</Identifier>
          <Type>Long</Type>
          <Size>8</Size>
          <Description>Seq. number including quote, trading and market action.</Description>
        </Field>
        <Field>
          <Name>Trading number</Name>
          <Identifier>tradingnumber</Identifier>
          <Type>Long</Type>
          <Size>6</Size>
          <Description>Trading number for each issue.</Description>
        </Field>
        <Field>
          <Name>Trading price</Name>
          <Identifier>tradingprice</Identifier>
          <Type>Long</Type>
          <Size>9</Size>
          <Description>Trading price.</Description>
        </Field>
        <Field>
          <Name>Trading volume</Name>
          <Identifier>tradingvolume</Identifier>
          <Type>Long</Type>
          <Size>10</Size>
          <Description>Trading volume for each issue.</Description>
        </Field>
        <Field>
          <Name>Trading time</Name>
          <Identifier>tradingtime</Identifier>
          <Type>String</Type>
          <Size>6</Size>
          <Description>Trading time.</Description>
        </Field>
        <Field>
          <Name>Ask quote number</Name>
          <Identifier>askquotenumber</Identifier>
          <Type>Long</Type>
          <Size>6</Size>
          <Description>quote number for each issue.</Description>
        </Field>
        <Field>
          <Name>Bid quote number</Name>
          <Identifier>bidquotenumber</Identifier>
          <Type>Long</Type>
          <Size>6</Size>
          <Description>quote number for each issue.</Description>
        </Field>
        <Field>
          <Name>High price</Name>
          <Identifier>highprice</Identifier>
          <Type>Long</Type>
          <Size>9</Size>
          <Description>High price.</Description>
        </Field>
        <Field>
          <Name>Low price</Name>
          <Identifier>lowprice</Identifier>
          <Type>Long</Type>
          <Size>9</Size>
          <Description>Low price.</Description>
        </Field>
        <Field>
          <Name>Weighted average stock price</Name>
          <Identifier>weightedaveragestockprice</Identifier>
          <Type>Long</Type>
          <Size>9</Size>
          <Description>Weighted average stock price.</Description>
        </Field>
        <Field>
          <Name>Total trading accumulated Volume</Name>
          <Identifier>totaltradingaccumulatedvolume</Identifier>
          <Type>Long</Type>
          <Size>12</Size>
          <Description>Total trading accumulated Volume.</Description>
        </Field>
        <Field>
          <Name>Total trading accumulated value</Name>
          <Identifier>totaltradingaccumulatedvalue</Identifier>
          <Type>Long</Type>
          <Size>14</Size>
          <Description>Total trading accumulated value.</Description>
        </Field>
        <Field>
          <Name>Total remaining quantity of ask</Name>
          <Identifier>totalremainingquantityofask</Identifier>
          <Type>Long</Type>
          <Size>10</Size>
          <Description>Total remaining quantity of ask.</Description>
        </Field>
        <Field>
          <Name>Total remaining quantity of bid</Name>
          <Identifier>totalremainingquantityofbid</Identifier>
          <Type>Long</Type>
          <Size>10</Size>
          <Description>Total remaining quantity of bid.</Description>
        </Field>
        <Field>
          <Name>Best ask order</Name>
          <Identifier>bestaskorder</Identifier>
          <Type>Long</Type>
          <Size>9</Size>
          <Description>Best ask order.</Description>
        </Field>
        <Field>
          <Name>Remaining quantity of best ask order</Name>
          <Identifier>remainingquantityofbestaskorder</Identifier>
          <Type>Long</Type>
          <Size>10</Size>
          <Description>Remaining quantity of best ask order.</Description>
        </Field>
        <Field>
          <Name>Best bid order</Name>
          <Identifier>bestbidorder</Identifier>
          <Type>Long</Type>
          <Size>9</Size>
          <Description>Best bid order.</Description>
        </Field>
        <Field>
          <Name>Remaining quantity of Best bid order</Name>
          <Identifier>remainingquantityofbestbidorder</Identifier>
          <Type>Long</Type>
          <Size>10</Size>
          <Description>Remaining quantity of Best bid order.</Description>
        </Field>
        <Field>
          <Name>Compared to previous day type</Name>
          <Identifier>comparedtopreviousdaytype</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>+: up -: down space: steadiness.</Description>
        </Field>
        <Field>
          <Name>Compared to previous day</Name>
          <Identifier>comparedtopreviousday</Identifier>
          <Type>String</Type>
          <Size>9</Size>
          <Description>Compared to previous day.</Description>
        </Field>
        <Field>
          <Name>Trading price compare remaining quantity of ask</Name>
          <Identifier>tradingpricecompareremainingquantityofask</Identifier>
          <Type>Long</Type>
          <Size>10</Size>
          <Description>Trading price compare remaining quantity of ask.</Description>
        </Field>
        <Field>
          <Name>Trading price compare remaining quantity of bid</Name>
          <Identifier>tradingpricecompareremainingquantityofbid</Identifier>
          <Type>Long</Type>
          <Size>10</Size>
          <Description>Trading price compare remaining quantity of bid.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Identifier>filler</Identifier>
          <Type>String</Type>
          <Size>40</Size>
          <Description>Reserved filler. ASCII spaces.</Description>
        </Field>
        <Field>
          <Name>End Keyword</Name>
          <Identifier>endkeyword</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>End of text sentinel (0xFF).</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- Quotation Category -->
    <Enum>
      <Name>Quotation Category</Name>
      <Values>
        <Value><Data>0</Data><Name>Weighted Average Price</Name></Value>
        <Value><Data>1</Data><Name>Quotation</Name></Value>
        <Value><Data>2</Data><Name>No Trade</Name></Value>
      </Values>
    </Enum>

    <!-- Type -->
    <Enum>
      <Name>Type</Name>
      <Values>
        <Value><Data>1</Data><Name>Trading Halt</Name></Value>
        <Value><Data>2</Data><Name>Lift After Trading Halt</Name></Value>
      </Values>
    </Enum>

    <!-- Process Type -->
    <Enum>
      <Name>Process Type</Name>
      <Values>
        <Value><Data>1</Data><Name>Normal</Name></Value>
        <Value><Data>2</Data><Name>Correction</Name></Value>
        <Value><Data>3</Data><Name>Cancellation</Name></Value>
      </Values>
    </Enum>

    <!-- Bid/Ask Type -->
    <Enum>
      <Name>Bid/Ask Type</Name>
      <Values>
        <Value><Data>1</Data><Name>Ask</Name></Value>
        <Value><Data>2</Data><Name>Bid</Name></Value>
      </Values>
    </Enum>

    <!-- Compared To Previous Day Type -->
    <Enum>
      <Name>Compared To Previous Day Type</Name>
      <Values>
        <Value><Data>"+"</Data><Name>Up</Name></Value>
        <Value><Data>" "</Data><Name>Steadiness</Name></Value>
        <Value><Data>"-"</Data><Name>Down</Name></Value>
      </Values>
    </Enum>

  </Enums>

</OmiKrxXls>
