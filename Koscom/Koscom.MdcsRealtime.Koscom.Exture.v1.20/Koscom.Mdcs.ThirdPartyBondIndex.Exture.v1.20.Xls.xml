<OmiKrxXls>

<Messages>

    <!-- Mkf Bond Index Message -->
    <Message>
      <Name>Mkf Bond Index Message</Name>
      <Dependency>Message Code</Dependency>
      <Branch>Payload</Branch>
      <Code>K0000</Code>
      <Description>MKF Bond Index real-time message. Carries total profit / clean price / market price / call and zero re-investment indices, futures basis price, duration, convexity, and YTM for one bond index identifier.</Description>
      <Fields>
        <Field>
          <Name>Filler 1</Name>
          <Identifier>filler1</Identifier>
          <Type>String</Type>
          <Size>4</Size>
          <Description>Reserved filler. Always 4 ASCII space characters.</Description>
        </Field>
        <Field>
          <Name>Index ID</Name>
          <Identifier>indexid</Identifier>
          <Type>String</Type>
          <Size>6</Size>
          <Description>MKF Bond Index identifier. Refer to the Code Table sheet.</Description>
        </Field>
        <Field>
          <Name>Standard Date</Name>
          <Identifier>standarddate</Identifier>
          <Type>String</Type>
          <Size>8</Size>
          <Format>YYYYMMDD</Format>
          <Description>Standard date for the index calculation in YYYYMMDD format.</Description>
        </Field>
        <Field>
          <Name>Standard Time</Name>
          <Identifier>standardtime</Identifier>
          <Type>String</Type>
          <Size>6</Size>
          <Format>HHMMSS</Format>
          <Description>Standard time in HHMMSS. Range 09:00:00 to ~15:30. Cycle: 1 min.</Description>
        </Field>
        <Field>
          <Name>Total Profit Index</Name>
          <Identifier>totalprofitindex</Identifier>
          <Type>Double</Type>
          <Size>10</Size>
          <Format>Decimal:4</Format>
          <Description>Total profit index (10 ASCII digits with 4 implied decimal places). Standard 10,000.</Description>
        </Field>
        <Field>
          <Name>Clean Price Index</Name>
          <Identifier>cleanpriceindex</Identifier>
          <Type>Double</Type>
          <Size>10</Size>
          <Format>Decimal:4</Format>
          <Description>Clean price index (10 ASCII digits with 4 implied decimal places). Standard 10,000.</Description>
        </Field>
        <Field>
          <Name>Market Price Index</Name>
          <Identifier>marketpriceindex</Identifier>
          <Type>Double</Type>
          <Size>10</Size>
          <Format>Decimal:4</Format>
          <Description>Market price index (10 ASCII digits with 4 implied decimal places). Standard 10,000.</Description>
        </Field>
        <Field>
          <Name>Call Re-Investment Index</Name>
          <Identifier>callreinvestmentindex</Identifier>
          <Type>Double</Type>
          <Size>10</Size>
          <Format>Decimal:4</Format>
          <Description>Call re-investment index (10 ASCII digits with 4 implied decimal places).</Description>
        </Field>
        <Field>
          <Name>Zero Re-Investment Index</Name>
          <Identifier>zeroreinvestmentindex</Identifier>
          <Type>Double</Type>
          <Size>10</Size>
          <Format>Decimal:4</Format>
          <Description>Zero re-investment index (10 ASCII digits with 4 implied decimal places).</Description>
        </Field>
        <Field>
          <Name>Futures Basis Price</Name>
          <Identifier>futuresbasisprice</Identifier>
          <Type>Double</Type>
          <Size>9</Size>
          <Format>Decimal:2</Format>
          <Description>Futures basis price (9 ASCII digits with 2 implied decimal places).</Description>
        </Field>
        <Field>
          <Name>Average Duration</Name>
          <Identifier>averageduration</Identifier>
          <Type>Double</Type>
          <Size>6</Size>
          <Format>Decimal:3</Format>
          <Nullable>0</Nullable>
          <Description>Average duration (6 ASCII digits with 3 implied decimal places). Not calculated for MKF; set to '0'.</Description>
        </Field>
        <Field>
          <Name>Average Convexity</Name>
          <Identifier>averageconvexity</Identifier>
          <Type>Double</Type>
          <Size>6</Size>
          <Format>Decimal:3</Format>
          <Description>Average convexity (6 ASCII digits with 3 implied decimal places).</Description>
        </Field>
        <Field>
          <Name>Average YTM</Name>
          <Identifier>averageytm</Identifier>
          <Type>Double</Type>
          <Size>6</Size>
          <Format>Decimal:3</Format>
          <Description>Average yield to maturity (6 ASCII digits with 3 implied decimal places). Unit: percent.</Description>
        </Field>
        <Field>
          <Name>Average ForwardYTM</Name>
          <Identifier>averageforwardytm</Identifier>
          <Type>Double</Type>
          <Size>6</Size>
          <Format>Decimal:3</Format>
          <Description>Average forward yield to maturity (6 ASCII digits with 3 implied decimal places). Unit: percent.</Description>
        </Field>
        <Field>
          <Name>Filler 2</Name>
          <Identifier>filler2</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Reserved filler. ASCII space.</Description>
        </Field>
        <Field>
          <Name>End Keyword</Name>
          <Identifier>endkeyword</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>End of text sentinel (0xFF).</Description>
        </Field>
      </Fields>
    </Message>

