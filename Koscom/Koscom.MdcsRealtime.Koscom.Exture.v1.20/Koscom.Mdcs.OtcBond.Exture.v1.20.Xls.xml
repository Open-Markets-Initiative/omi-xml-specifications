<OmiKrxXls>

<Messages>

    <!-- Otc Bond Traded Info Message -->
    <Message>
      <Name>Otc Bond Traded Info Message</Name>
      <Dependency>Message Code</Dependency>
      <Branch>Payload</Branch>
      <Code>J6077</Code>
      <Description>OTC Bond Traded Information. Reports today's or prior-day trading history with volume, pretax unit price, yield, settlement date, and FX category.</Description>
      <Fields>
        <Field>
          <Name>ISIN</Name>
          <Identifier>isin</Identifier>
          <Type>String</Type>
          <Size>12</Size>
          <Description>Standard Code(ISIN).</Description>
        </Field>
        <Field>
          <Name>Subcategory</Name>
          <Identifier>subcategory</Identifier>
          <Type>String</Type>
          <Size>2</Size>
          <Description>51:Today's Trading History in OTC 52:Previous Day's Trading History in OTC 53:Omitted Info. in past OTC Trading History 54:Changed/Canceled Info. in past OTC Trading History.</Description>
        </Field>
        <Field>
          <Name>Trading Date</Name>
          <Identifier>tradingdate</Identifier>
          <Type>String</Type>
          <Size>8</Size>
          <Format>YYYYMMDD</Format>
          <Description>YYYYMMDD.</Description>
        </Field>
        <Field>
          <Name>Registered Time</Name>
          <Identifier>registeredtime</Identifier>
          <Type>String</Type>
          <Size>6</Size>
          <Format>HHMMSS</Format>
          <Description>HHMMSS.</Description>
        </Field>
        <Field>
          <Name>Process Category</Name>
          <Identifier>processcategory</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>1:Normal 2:Amended 3:Cancel.</Description>
        </Field>
        <Field>
          <Name>Registered Number</Name>
          <Identifier>registerednumber</Identifier>
          <Type>Long</Type>
          <Size>8</Size>
          <Description>Registered Number.</Description>
        </Field>
        <Field>
          <Name>Originally Registered Number</Name>
          <Identifier>originallyregisterednumber</Identifier>
          <Type>Long</Type>
          <Size>8</Size>
          <Description>0:Normal Originally Registered Number:Change/Cancel.</Description>
        </Field>
        <Field>
          <Name>Trading Type Category</Name>
          <Identifier>tradingtypecategory</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>1:Self-dealings 2:Cross Trading 3:Brokerage 9:Other.</Description>
        </Field>
        <Field>
          <Name>Volume</Name>
          <Identifier>volume</Identifier>
          <Type>Long</Type>
          <Size>16</Size>
          <Description>Unit: 1 KRW, 1 USD, 1 YEN, 1 EURO, 1 CNY, 1 GBP, 1 HKD, 1 AUD, 1 SGD, miscellaneous.</Description>
        </Field>
        <Field>
          <Name>Pretax Unit Price</Name>
          <Identifier>pretaxunitprice</Identifier>
          <Type>Double</Type>
          <Size>8</Size>
          <Description>999999V99(Unit:1 KRW, 1 USD, 1YEN, 1 EURO, 1CNY, 1GBP, 1HKD, 1AUD, 1SGD, miscellaneous).</Description>
        </Field>
        <Field>
          <Name>Pretax Yield</Name>
          <Identifier>pretaxyield</Identifier>
          <Type>Double</Type>
          <Size>8</Size>
          <Format>Decimal:5</Format>
          <Description>999V99999.</Description>
        </Field>
        <Field>
          <Name>Settlement Date</Name>
          <Identifier>settlementdate</Identifier>
          <Type>String</Type>
          <Size>8</Size>
          <Format>YYYYMMDD</Format>
          <Description>YYYYMMDD.</Description>
        </Field>
        <Field>
          <Name>Market Base Rate</Name>
          <Identifier>marketbaserate</Identifier>
          <Type>Double</Type>
          <Size>8</Size>
          <Format>Decimal:5</Format>
          <Description>999V99999, FRN.</Description>
        </Field>
        <Field>
          <Name>FX Category</Name>
          <Identifier>fxcategory</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>1:KRW 2:USD 3:YEN 4:EURO 5:CNY 6:GBP 7:HKD 8:AUD 9:SGD 0:miscellaneous.</Description>
        </Field>
        <Field>
          <Name>Based FX</Name>
          <Identifier>basedfx</Identifier>
          <Type>Double</Type>
          <Size>8</Size>
          <Format>Decimal:4</Format>
          <Description>9999V9999(KRW/USD, KRW/YEN, KRW/EURO, KRW/CNY, KRW/GBP, KRW/HKD, KRW/AUD, KRW/SGD, KRW/miscellaneous).</Description>
        </Field>
        <Field>
          <Name>Trading Category</Name>
          <Identifier>tradingcategory</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>2:Brokerage 4:Direct Participant.</Description>
        </Field>
        <Field>
          <Name>End Keyword</Name>
          <Identifier>endkeyword</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>End of text sentinel (0xFF).</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Otc Bond Trades Per Institution Message -->
    <Message>
      <Name>Otc Bond Trades Per Institution Message</Name>
      <Dependency>Message Code</Dependency>
      <Branch>Payload</Branch>
      <Code>J7077</Code>
      <Description>OTC Bond trade aggregates per institution. Reports bid and ask yields and trading volumes/values per institution code and bond type.</Description>
      <Fields>
        <Field>
          <Name>Data Process Category</Name>
          <Identifier>dataprocesscategory</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>I:Normal D:Delete E:End.</Description>
        </Field>
        <Field>
          <Name>Date</Name>
          <Identifier>date</Identifier>
          <Type>String</Type>
          <Size>8</Size>
          <Format>YYYYMMDD</Format>
          <Description>YYYYMMDD.</Description>
        </Field>
        <Field>
          <Name>Institution Code</Name>
          <Identifier>institutioncode</Identifier>
          <Type>String</Type>
          <Size>4</Size>
          <Description>Refer to Code Table.</Description>
        </Field>
        <Field>
          <Name>Bond Type Code</Name>
          <Identifier>bondtypecode</Identifier>
          <Type>String</Type>
          <Size>4</Size>
          <Description>1:KTB 2:MB 3:Special Bond 4:MSB 5:Financial Bond 6:Corporate Bond.</Description>
        </Field>
        <Field>
          <Name>Ask Yield</Name>
          <Identifier>askyield</Identifier>
          <Type>Double</Type>
          <Size>8</Size>
          <Format>Decimal:4</Format>
          <Description>9999V9999.</Description>
        </Field>
        <Field>
          <Name>Ask Trading Volume</Name>
          <Identifier>asktradingvolume</Identifier>
          <Type>Long</Type>
          <Size>15</Size>
          <Description>Unit:Thousand KRW.</Description>
        </Field>
        <Field>
          <Name>Ask Trading Value</Name>
          <Identifier>asktradingvalue</Identifier>
          <Type>Long</Type>
          <Size>15</Size>
          <Description>Unit:Thousand KRW.</Description>
        </Field>
        <Field>
          <Name>Bid Yield</Name>
          <Identifier>bidyield</Identifier>
          <Type>Double</Type>
          <Size>8</Size>
          <Format>Decimal:4</Format>
          <Description>9999V9999.</Description>
        </Field>
        <Field>
          <Name>Bid Trading Volume</Name>
          <Identifier>bidtradingvolume</Identifier>
          <Type>Long</Type>
          <Size>15</Size>
          <Description>Unit:Thousand KRW.</Description>
        </Field>
        <Field>
          <Name>Bid Trading Value</Name>
          <Identifier>bidtradingvalue</Identifier>
          <Type>Long</Type>
          <Size>15</Size>
          <Description>Unit:Thousand KRW.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Identifier>filler</Identifier>
          <Type>String</Type>
          <Size>11</Size>
          <Description>Reserved filler. ASCII spaces.</Description>
        </Field>
        <Field>
          <Name>End Keyword</Name>
          <Identifier>endkeyword</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>End of text sentinel (0xFF).</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Otc Bond Types Per Investor Message -->
    <Message>
      <Name>Otc Bond Types Per Investor Message</Name>
      <Dependency>Message Code</Dependency>
      <Branch>Payload</Branch>
      <Code>C1077</Code>
      <Description>OTC Bond trade aggregates per investor category. Bid/ask yields and trading volumes/values per ISIN and investor category.</Description>
      <Fields>
        <Field>
          <Name>ISIN</Name>
          <Identifier>isin</Identifier>
          <Type>String</Type>
          <Size>12</Size>
          <Description>Standard Code(ISIN).</Description>
        </Field>
        <Field>
          <Name>Sequence Number</Name>
          <Identifier>sequencenumber</Identifier>
          <Type>Long</Type>
          <Size>8</Size>
          <Description>1~99999999 Records Checking Purpose.</Description>
        </Field>
        <Field>
          <Name>Trading Date</Name>
          <Identifier>tradingdate</Identifier>
          <Type>String</Type>
          <Size>8</Size>
          <Format>YYYYMMDD</Format>
          <Description>YYYYMMDD.</Description>
        </Field>
        <Field>
          <Name>Investor Category</Name>
          <Identifier>investorcategory</Identifier>
          <Type>String</Type>
          <Size>4</Size>
          <Description>Refer to Code Table.</Description>
        </Field>
        <Field>
          <Name>Ask Yield</Name>
          <Identifier>askyield</Identifier>
          <Type>Double</Type>
          <Size>10</Size>
          <Format>Decimal:5</Format>
          <Description>99999V99999.</Description>
        </Field>
        <Field>
          <Name>Bid Yield</Name>
          <Identifier>bidyield</Identifier>
          <Type>Double</Type>
          <Size>10</Size>
          <Format>Decimal:5</Format>
          <Description>99999V99999.</Description>
        </Field>
        <Field>
          <Name>Ask Trading Volume</Name>
          <Identifier>asktradingvolume</Identifier>
          <Type>Long</Type>
          <Size>20</Size>
          <Description>Ask Trading Volume.</Description>
        </Field>
        <Field>
          <Name>Bid Trading Volume</Name>
          <Identifier>bidtradingvolume</Identifier>
          <Type>Long</Type>
          <Size>20</Size>
          <Description>Bid Trading Volume.</Description>
        </Field>
        <Field>
          <Name>Ask Trading Value</Name>
          <Identifier>asktradingvalue</Identifier>
          <Type>Long</Type>
          <Size>20</Size>
          <Description>Ask Trading Value.</Description>
        </Field>
        <Field>
          <Name>Bid Trading Value</Name>
          <Identifier>bidtradingvalue</Identifier>
          <Type>Long</Type>
          <Size>20</Size>
          <Description>Bid Trading Value.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Identifier>filler</Identifier>
          <Type>String</Type>
          <Size>2</Size>
          <Description>Reserved filler. ASCII spaces.</Description>
        </Field>
        <Field>
          <Name>End Keyword</Name>
          <Identifier>endkeyword</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>End of text sentinel (0xFF).</Description>
        </Field>
      </Fields>
    </Message>

    <!-- K Bond Message -->
    <Message>
      <Name>K Bond Message</Name>
      <Dependency>Message Code</Dependency>
      <Branch>Payload</Branch>
      <Code>L9077</Code>
      <Description>K-BOND dissemination. Quotes and trades with profit rate or price, contract category, settlement date, and replacement order details.</Description>
      <Fields>
        <Field>
          <Name>ISIN</Name>
          <Identifier>isin</Identifier>
          <Type>String</Type>
          <Size>12</Size>
          <Description>Trading Bond Issue code(ISIN) ISIN ← Issue code(isin).</Description>
        </Field>
        <Field>
          <Name>DATA Small Category</Name>
          <Identifier>datasmallcategory</Identifier>
          <Type>String</Type>
          <Size>2</Size>
          <Description>H1:Quotes /Trading H2:Quotes /Trading Change Detail.</Description>
        </Field>
        <Field>
          <Name>Data Source Type</Name>
          <Identifier>datasourcetype</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>SPACE set to FILLER.</Description>
        </Field>
        <Field>
          <Name>Sequence Number</Name>
          <Identifier>sequencenumber</Identifier>
          <Type>Long</Type>
          <Size>8</Size>
          <Description>Sequence Number ← ISIN.</Description>
        </Field>
        <Field>
          <Name>Original Sequence Number</Name>
          <Identifier>originalsequencenumber</Identifier>
          <Type>Long</Type>
          <Size>8</Size>
          <Description>In case of H1 data : 00000000 Original Sequence Number ← Previous ISIN.</Description>
        </Field>
        <Field>
          <Name>Replacement Type</Name>
          <Identifier>replacementtype</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>0:ordinary order, 1:replacement order.</Description>
        </Field>
        <Field>
          <Name>Previous ISIN of Replacement</Name>
          <Identifier>previousisinofreplacement</Identifier>
          <Type>Long</Type>
          <Size>8</Size>
          <Description>Except for the second price of replacement order : 00000000.</Description>
        </Field>
        <Field>
          <Name>Input Date</Name>
          <Identifier>inputdate</Identifier>
          <Type>String</Type>
          <Size>8</Size>
          <Format>YYYYMMDD</Format>
          <Description>YYYYMMDD.</Description>
        </Field>
        <Field>
          <Name>Quotes Offer Time</Name>
          <Identifier>quotesoffertime</Identifier>
          <Type>String</Type>
          <Size>6</Size>
          <Format>HHMMSS</Format>
          <Description>Quotes generated time(HHMMSS).</Description>
        </Field>
        <Field>
          <Name>Bond Type Name</Name>
          <Identifier>bondtypename</Identifier>
          <Type>String</Type>
          <Size>40</Size>
          <Description>Traded Bond Type Name.</Description>
        </Field>
        <Field>
          <Name>Change Category</Name>
          <Identifier>changecategory</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>1:Newly added, 2:Update a current announcemet, 3:Deleted.</Description>
        </Field>
        <Field>
          <Name>Market Data Type</Name>
          <Identifier>marketdatatype</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>1:Profit rate, 2:Price.</Description>
        </Field>
        <Field>
          <Name>Profit Rate(Quotes/Trading)</Name>
          <Identifier>profitratequotestrading</Identifier>
          <Type>Double</Type>
          <Size>8</Size>
          <Format>Decimal:5</Format>
          <Description>999V99999.</Description>
        </Field>
        <Field>
          <Name>Price (Quotes/Trading)</Name>
          <Identifier>pricequotestrading</Identifier>
          <Type>Double</Type>
          <Size>8</Size>
          <Format>Decimal:3</Format>
          <Description>99999V999 Unit: KRW.</Description>
        </Field>
        <Field>
          <Name>Contract Category</Name>
          <Identifier>contractcategory</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>1:Bid 2:Ask 3: Trading.</Description>
        </Field>
        <Field>
          <Name>Quotes Amount</Name>
          <Identifier>quotesamount</Identifier>
          <Type>String</Type>
          <Size>16</Size>
          <Description>KRW(Data transmitted only for Bid(1)/Ask(2) on 'Contract category' field).</Description>
        </Field>
        <Field>
          <Name>Contract Date</Name>
          <Identifier>contractdate</Identifier>
          <Type>String</Type>
          <Size>2</Size>
          <Description>1:Outstanding Negotiation, 2:T+0, 3:T+1, 4:T+2, ~ 32:T+30.</Description>
        </Field>
        <Field>
          <Name>Settlement Date</Name>
          <Identifier>settlementdate</Identifier>
          <Type>String</Type>
          <Size>2</Size>
          <Description>2:T+0(On one day), 3:T+1(Next day), 4:T+2, ~ 32:T+30.</Description>
        </Field>
        <Field>
          <Name>Filler</Name>
          <Identifier>filler</Identifier>
          <Type>String</Type>
          <Size>11</Size>
          <Description>Reserved filler. ASCII spaces.</Description>
        </Field>
        <Field>
          <Name>End Keyword</Name>
          <Identifier>endkeyword</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>End of text sentinel (0xFF).</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

</OmiKrxXls>
