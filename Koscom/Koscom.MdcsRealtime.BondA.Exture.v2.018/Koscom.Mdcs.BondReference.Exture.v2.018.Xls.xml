    <!-- Baby Bonds Reporting Market Yield Message -->
    <Message>
      <Name>Baby Bonds Reporting Market Yield Message</Name>
      <Dependency>Message Code</Dependency>
      <Branch>Payload</Branch>
      <Code>G001M</Code>
      <Description>Baby Bonds reporting market yield. Reference yields per issue.</Description>
      <Fields>
        <Field>
          <Name>Message sequence number</Name>
          <Identifier>messagesequencenumber</Identifier>
          <Type>Int</Type>
          <Size>8</Size>
          <Description>A message sequence number given by Market data team - Market data: seq number is given by instruments and boards (※ only for high-bandwidth service) - Batch Data: seq number is given by Information Ca.</Description>
        </Field>
        <Field>
          <Name>Business Date</Name>
          <Identifier>businessdate</Identifier>
          <Type>String</Type>
          <Size>8</Size>
          <Description>Business Date.</Description>
        </Field>
        <Field>
          <Name>Baby Bonds Type Code</Name>
          <Identifier>babybondstypecode</Identifier>
          <Type>String</Type>
          <Size>3</Size>
          <Description>Baby Bonds Type Code.</Description>
        </Field>
        <Field>
          <Name>Report Market_Yield Rate</Name>
          <Identifier>reportmarketyieldrate</Identifier>
          <Type>Double</Type>
          <Size>13</Size>
          <Format>Decimal:6</Format>
          <Description>Report Market_Yield Rate.</Description>
        </Field>
        <Field>
          <Name>Report Market_A price with Yield</Name>
          <Identifier>reportmarketapricewithyield</Identifier>
          <Type>Double</Type>
          <Size>11</Size>
          <Format>Decimal:3</Format>
          <Description>Report Market_A price with Yield.</Description>
        </Field>
        <Field>
          <Name>Closing Price_Yield Rate</Name>
          <Identifier>closingpriceyieldrate</Identifier>
          <Type>Double</Type>
          <Size>13</Size>
          <Format>Decimal:6</Format>
          <Description>Closing Price_Yield Rate.</Description>
        </Field>
        <Field>
          <Name>Closing Price with Yield</Name>
          <Identifier>closingpricewithyield</Identifier>
          <Type>Double</Type>
          <Size>11</Size>
          <Format>Decimal:3</Format>
          <Description>Closing Price with Yield.</Description>
        </Field>
        <Field>
          <Name>End Keyword</Name>
          <Identifier>endkeyword</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>End of text sentinel (0xFF).</Description>
        </Field>
      </Fields>
    </Message>

