    <!-- Regular Bonds Disclosure Basic Exchange Rate Message -->
    <Message>
      <Name>Regular Bonds Disclosure Basic Exchange Rate Message</Name>
      <Dependency>Message Code</Dependency>
      <Branch>Payload</Branch>
      <Code>R401B</Code>
      <Description>Regular Bonds Disclosure of Basic Exchange Rate for Settlement.</Description>
      <Fields>
        <Field>
          <Name>Disclosing Data_Type Code</Name>
          <Identifier>disclosingdatatypecode</Identifier>
          <Type>String</Type>
          <Size>3</Size>
          <Description>A data type code indicating a Batch data change and imposing/lifting sanctions to/from member firm.</Description>
        </Field>
        <Field>
          <Name>Disclosure Time</Name>
          <Identifier>disclosuretime</Identifier>
          <Type>String</Type>
          <Size>9</Size>
          <Description>The time to disclose market operation information and market measures for trade such as corrections for the previous day's notice, and today's notice.</Description>
        </Field>
        <Field>
          <Name>Applied Exchange Rate</Name>
          <Identifier>appliedexchangerate</Identifier>
          <Type>Double</Type>
          <Size>13</Size>
          <Format>Decimal:6</Format>
          <Description>Applied Exchange Rate.</Description>
        </Field>
        <Field>
          <Name>Currency Type Code</Name>
          <Identifier>currencytypecode</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Currency Codes 1: Korean Won(KRW) 2: US Dollar(USD) 3: Japanese Yen(JPY) 4: Euro(EUR) 5: Yuan Renminbi(CNY) 6: Pound Sterling(GBP) 7: Hong Kong Dollar(HKD) 8: Austrailian Dollar(AUD) 9: Singapore Doll.</Description>
