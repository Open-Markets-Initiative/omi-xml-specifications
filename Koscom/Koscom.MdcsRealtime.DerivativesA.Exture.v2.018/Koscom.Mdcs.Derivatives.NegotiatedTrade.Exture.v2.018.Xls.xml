      <Name>Derivatives Negotiated Trade Message</Name>
      <Dependency>Message Code</Dependency>
      <Branch>Payload</Branch>
      <Code>C401F</Code>
      <Description>Derivatives Negotiated Trade Data. Off-book negotiated trades for futures and options.</Description>
      <Fields>
        <Field>
          <Name>ISIN Code</Name>
          <Identifier>isincode</Identifier>
          <Type>String</Type>
          <Size>12</Size>
          <Description>ISIN Code.</Description>
        </Field>
        <Field>
          <Name>A designated number for an issue</Name>
          <Identifier>adesignatednumberforanissue</Identifier>
          <Type>Int</Type>
          <Size>6</Size>
          <Description>A designated number for each issue on a daily basis - Market(Information Product) : KOSPI(Securities A, Securities C), KOSDAQ(Securities B), KONEX(Securities B), Derivatives(DRV A), Spot Gold(Commodit.</Description>
        </Field>
        <Field>
          <Name>Total Accumulated Trading volume</Name>
          <Identifier>totalaccumulatedtradingvolume</Identifier>
          <Type>Long</Type>
          <Size>15</Size>
          <Description>Total Accumulated Trading volume.</Description>
        </Field>
        <Field>
          <Name>Total Accumulated Trading Value</Name>
          <Identifier>totalaccumulatedtradingvalue</Identifier>
          <Type>FLOAT128</Type>
          <Size>22</Size>
          <Format>Decimal:3</Format>
          <Description>Total Accumulated Trading Value.</Description>
        </Field>
        <Field>
          <Name>End Keyword</Name>
          <Identifier>endkeyword</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>End of text sentinel (0xFF).</Description>
        </Field>
      </Fields>
    </Message>

