          <Name>Public Announcement_Publishing Date</Name>
          <Identifier>publicannouncementpublishingdate</Identifier>
          <Type>String</Type>
          <Size>8</Size>
          <Description>Public Announcement_Publishing Date.</Description>
        </Field>
        <Field>
          <Name>Transmission Date</Name>
          <Identifier>transmissiondate</Identifier>
          <Type>String</Type>
          <Size>8</Size>
          <Description>Transmission Date.</Description>
        </Field>
        <Field>
          <Name>Public Announcement_Market Code</Name>
          <Identifier>publicannouncementmarketcode</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>1: KOSPI 2: KOSDAQ 3: Derivatives 4: Bonds 6: KONEX 7: Commodities 8: Others (non-listed company, ABS·asset backed securities) 9: Common E: Emission G: Gold Spot.</Description>
        </Field>
        <Field>
          <Name>Abbreviated issue Name</Name>
          <Identifier>abbreviatedissuename</Identifier>
          <Type>String</Type>
          <Size>40</Size>
          <Description>Abbreviated issue Name.</Description>
        </Field>
        <Field>
          <Name>Public Announcement_Process Code</Name>
          <Identifier>publicannouncementprocesscode</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>Public Announcement_Process Code 1: Normal 2: Revision 3: Deleted.</Description>
        </Field>
        <Field>
          <Name>Public Announcement_Reason Code</Name>
          <Identifier>publicannouncementreasoncode</Identifier>
          <Type>String</Type>
          <Size>5</Size>
          <Description>Public Announcement_Reason Code (Refer to the Code table) 01008: KOSPI/KOSDAQ/Bonds 12001: Futures Options market (futures market).</Description>
        </Field>
        <Field>
          <Name>Public Announcement_Language Type Code</Name>
          <Identifier>publicannouncementlanguagetypecode</Identifier>
          <Type>String</Type>
          <Size>1</Size>
          <Description>1: Korean 2: English.</Description>
        </Field>
        <Field>
          <Name>Public Announcement_Title</Name>
          <Identifier>publicannouncementtitle</Identifier>
          <Type>String</Type>
          <Size>264</Size>
          <Description>Public Announcement Title (Text).</Description>
        </Field>
        <Field>
          <Name>Public Announcement_Content</Name>
          <Identifier>publicannouncementcontent</Identifier>
          <Type>String</Type>
          <Size>1000</Size>
          <Description>Content of Public Announcement (HTML).</Description>
