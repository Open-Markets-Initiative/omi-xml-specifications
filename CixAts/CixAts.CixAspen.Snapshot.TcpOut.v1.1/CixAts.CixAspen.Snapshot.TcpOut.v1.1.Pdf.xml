<OmiAspenPdf>
  
  <Messages>

    <!-- Market Event Message -->
    <Message>
      <Name>Market Event Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>A</Code>
      <Origin>Exchange</Origin>
      <Description>Transitions in the overall session state</Description>
      <Fields>
        <Field>
          <Name>Reserved</Name>
          <Type>Alpha</Type>
          <Size>2</Size>
          <Description>Reserved for future use</Description>
        </Field>
        <Field>
          <Name>Timestamp</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Nanoseconds Since Epoch (UTC)</Description>
        </Field>
        <Field>
          <Name>Event</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Session state event code</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Symbol Information Message -->
    <Message>
      <Name>Symbol Information Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>B</Code>
      <Origin>Exchange</Origin>
      <Description>Reference data for each symbol that may be traded</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Nanoseconds Since Epoch (UTC)</Description>
        </Field>
        <Field>
          <Name>Symbol ID</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Symbol Index</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alpha</Type>
          <Size>11</Size>
          <Description>Stock Symbol</Description>
        </Field>
        <Field>
          <Name>Listing Market</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Code identifying the primary listing market</Description>
        </Field>
        <Field>
          <Name>Board Lot Size</Name>
          <Type>Integer</Type>
          <Size>4</Size>
          <Description>Board Lot Size in Shares</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Symbol State Message -->
    <Message>
      <Name>Symbol State Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>C</Code>
      <Origin>Exchange</Origin>
      <Description>Individual symbol trading state (halts)</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Nanoseconds Since Epoch (UTC)</Description>
        </Field>
        <Field>
          <Name>Symbol ID</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Symbol Index</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alpha</Type>
          <Size>11</Size>
          <Description>Symbol Code (Quick Code)</Description>
        </Field>
        <Field>
          <Name>State</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Symbol trading state</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Reserved for future use</Description>
        </Field>
        <Field>
          <Name>Info</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>optional text</Description>
        </Field>
      </Fields>
    </Message>

    <!-- New Order Add Message -->
    <Message>
      <Name>New Order Add Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>D</Code>
      <Origin>Exchange</Origin>
      <Description>A new resting order added to the book</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Nanoseconds Since Epoch (UTC)</Description>
        </Field>
        <Field>
          <Name>Symbol ID</Name>
          <Type>Integer</Type>
          <Size>2</Size>
          <Description>Symbol Index</Description>
        </Field>
        <Field>
          <Name>Order ID</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Market Issued Unique Order ID</Description>
        </Field>
        <Field>
          <Name>Side</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Side of the order</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Quantity - 6 implied decimals</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>Alpha</Type>
          <Size>11</Size>
          <Description>Symbol Code</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Price - 6 implied decimals</Description>
        </Field>
        <Field>
          <Name>Broker</Name>
          <Type>Alpha</Type>
          <Size>3</Size>
          <Description>Three digit number Broker Number or 001 for anonymous</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Reserved for future use</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Partial Cancel Message -->
    <Message>
      <Name>Order Partial Cancel Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>F</Code>
      <Origin>Exchange</Origin>
      <Description>Part of a resting order is canceled</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Nanoseconds Since Epoch (UTC)</Description>
        </Field>
        <Field>
          <Name>Order ID</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Market Issued Unique Order ID</Description>
        </Field>
        <Field>
          <Name>QuantityCanceled</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Quantity canceled - Quantity 6 implied decimals</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Cancel All Message -->
    <Message>
      <Name>Order Cancel All Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>G</Code>
      <Origin>Exchange</Origin>
      <Description>Sent when the order is canceled in its entirety</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Nanoseconds Since Epoch (UTC)</Description>
        </Field>
        <Field>
          <Name>Order ID</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Market Issued Unique Order ID</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Executed Message -->
    <Message>
      <Name>Order Executed Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>J</Code>
      <Origin>Exchange</Origin>
      <Description>Sent when an order is executed</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Nanoseconds Since Epoch (UTC)</Description>
        </Field>
        <Field>
          <Name>Order ID</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Market Issued Unique Order ID</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Quantity Executed - 6 implied decimals</Description>
        </Field>
        <Field>
          <Name>Execution ID</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Market Issued Unique Execution ID</Description>
        </Field>
        <Field>
          <Name>Side</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>Side of the order</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Price - 6 implied decimals</Description>
        </Field>
        <Field>
          <Name>Broker</Name>
          <Type>Alpha</Type>
          <Size>3</Size>
          <Description>Three digit number Broker Number or 001 for anonymous</Description>
        </Field>
        <Field>
          <Name>Contra Broker</Name>
          <Type>Alpha</Type>
          <Size>3</Size>
          <Description>Three digit number Broker Number of the contra order or 001 for anonymous</Description>
        </Field>
      </Fields>
    </Message>

    <!-- End of Snapshot Message -->
    <Message>
      <Name>End of Snapshot Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>X</Code>
      <Origin>Exchange</Origin>
      <Description>Sent once the snapshot has completed</Description>
      <Fields>
        <Field>
          <Name>Sequence</Name>
          <Type>Integer</Type>
          <Size>8</Size>
          <Description>Multicast output feed sequence number of the previous message, where this snapshot ends</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- Event -->
    <Enum>
      <Name>Event</Name>
      <Values>
        <Value>
          <Data>O</Data>
          <Name>Start of Session</Name>
        </Value>
        <Value>
          <Data>S</Data>
          <Name>Market accepting orders</Name>
        </Value>
        <Value>
          <Data>Q</Data>
          <Name>Market open for trading</Name>
        </Value>
        <Value>
          <Data>E</Data>
          <Name>Market closed for trading</Name>
        </Value>
        <Value>
          <Data>C</Data>
          <Name>End of Session</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Listing Market -->
    <Enum>
      <Name>Listing Market</Name>
      <Values>
        <Value>
          <Data>T</Data>
          <Name>TSX</Name>
        </Value>
        <Value>
          <Data>V</Data>
          <Name>Venture</Name>
        </Value>
        <Value>
          <Data>C</Data>
          <Name>CSE</Name>
        </Value>
        <Value>
          <Data>N</Data>
          <Name>Neo</Name>
        </Value>
      </Values>
    </Enum>

    <!-- State -->
    <Enum>
      <Name>State</Name>
      <Values>
        <Value>
          <Data>H</Data>
          <Name>Halted</Name>
        </Value>
        <Value>
          <Data>T</Data>
          <Name>Trading</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Side -->
    <Enum>
      <Name>Side</Name>
      <Values>
        <Value>
          <Data>B</Data>
          <Name>Buy</Name>
        </Value>
        <Value>
          <Data>S</Data>
          <Name>Sell</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiAspenPdf>
