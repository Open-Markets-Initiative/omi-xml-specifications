          <Description>Premium / Trade amount</Description>
        </Field>
        <Field>
          <Name>Designation</Name>
          <Type>C</Type>
          <Size>1</Size>
          <Description>Trade situation</Description>
        </Field>
        <Field>
          <Name>MarketMechanism</Name>
          <Type>C</Type>
          <Size>1</Size>
