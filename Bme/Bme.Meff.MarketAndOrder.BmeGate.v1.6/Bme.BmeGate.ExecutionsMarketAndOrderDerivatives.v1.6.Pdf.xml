        <Field>
          <Name>StrategyTrdMatchID</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>System Trade Number of the time-spread or strategy</Description>
        </Field>
        <Field>
          <Name>SecondaryOrderID</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>System Order Number</Description>
        </Field>
        <Field>
          <Name>EntryDate</Name>
          <Type>D</Type>
          <Size>4</Size>
          <Description>System order entry date (when System Order Number was assigned)</Description>
        </Field>
        <Field>
          <Name>Priority</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Priority</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>P</Type>
          <Size>8</Size>
          <Description>Limit price</Description>
        </Field>
        <Field>
          <Name>DisplayQty</Name>
          <Type>Q</Type>
          <Size>4</Size>
