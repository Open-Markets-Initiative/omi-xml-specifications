        </Field>
        <Field>
          <Name>OrderID</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Application Order ID (unique at security level)</Description>
        </Field>
        <Field>
          <Name>SecondaryExecID</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>History number</Description>
        </Field>
        <Field>
          <Name>OrderQty</Name>
          <Type>Q</Type>
          <Size>4</Size>
          <Description>Total order volume</Description>
        </Field>
        <Field>
          <Name>OrdStatus</Name>
          <Type>C</Type>
          <Size>1</Size>
          <Description>Order Status</Description>
        </Field>
