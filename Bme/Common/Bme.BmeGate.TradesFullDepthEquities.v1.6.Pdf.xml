<OmiBmeBmeGatePdf>

  <!-- Bme BmeGate the order by order trade message, the full depth feed's own, Equities environment (RV) -->

  <Messages>

    <!-- Trade Market Post-Transparency Information Full-Depth Message -->
    <Message>
      <Name>Trade Market Post-Transparency Information Full-Depth Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x11</Code>
      <Category>Market Information</Category>
      <Origin>Exchange</Origin>
      <Description>Used by the server to communicate trade information related to trades resulting from order matching. The message also contains the situation in which the relevant orders will remain in the books</Description>
      <Fields>
        <Field>
          <Name>SequenceNumber</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Message sequence number</Description>
        </Field>
        <Field>
          <Name>SecurityCode</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Instrument (or Book) code</Description>
        </Field>
        <Field>
          <Name>TransactionDateAndTime</Name>
          <Type>T</Type>
          <Size>8</Size>
          <Description>Transaction Date and Time in nanoseconds since 1-jan-1970 UTC</Description>
        </Field>
        <Field>
          <Name>MarketSegmentID</Name>
          <Type>C</Type>
          <Size>4</Size>
          <Description>MIC Code</Description>
        </Field>
        <Field>
          <Name>TradingSessionID</Name>
          <Type>U</Type>
          <Size>1</Size>
          <Description>Trading mode</Description>
        </Field>
        <Field>
          <Name>TrdMatchID</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>System Trade Number</Description>
        </Field>
        <Field>
          <Name>TradeType</Name>
          <Type>C</Type>
          <Size>1</Size>
          <Description>Trade type</Description>
        </Field>
        <Field>
          <Name>LastPX</Name>
          <Type>P</Type>
          <Size>8</Size>
          <Description>Trade price</Description>
        </Field>
        <Field>
          <Name>LastQty</Name>
          <Type>Q</Type>
          <Size>4</Size>
          <Description>Current trade volume</Description>
        </Field>
        <Field>
          <Name>GrossTradeAmt</Name>
          <Type>A</Type>
          <Size>8</Size>
          <Description>Premium / Trade amount</Description>
        </Field>
        <Field>
          <Name>Designation</Name>
          <Type>C</Type>
          <Size>1</Size>
          <Description>Trade situation</Description>
        </Field>
        <Field>
          <Name>MarketMechanism</Name>
          <Type>C</Type>
          <Size>1</Size>
          <Description>Market Mechanism</Description>
        </Field>
        <Field>
          <Name>AlgoFlag</Name>
          <Type>F</Type>
          <Size>1</Size>
          <Description>Algorithmic flag indicator</Description>
        </Field>
        <Field>
          <Name>BuyerBolsaCode</Name>
          <Type>C</Type>
          <Size>1</Size>
          <Description>Stock Exchange code of the buyer</Description>
        </Field>
        <Field>
          <Name>SettlDate</Name>
          <Type>D</Type>
          <Size>4</Size>
          <Description>Settlement date</Description>
        </Field>
        <Field>
          <Name>TransactionCategory</Name>
          <Type>C</Type>
          <Size>1</Size>
          <Description></Description>
        </Field>
        <Field>
          <Name>SecondaryOrderID</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>System Order Number</Description>
        </Field>
        <Field>
          <Name>EntryDate</Name>
          <Type>D</Type>
          <Size>4</Size>
          <Description>System order entry date (when System Order Number was assigned)</Description>
        </Field>
        <Field>
          <Name>Priority</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Priority</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>P</Type>
          <Size>8</Size>
          <Description>Limit price</Description>
        </Field>
        <Field>
          <Name>DisplayQty</Name>
          <Type>Q</Type>
          <Size>4</Size>
          <Description>Visible pending volume</Description>
        </Field>
        <Field>
          <Name>RetailFlag</Name>
          <Type>F</Type>
          <Size>1</Size>
          <Description>Order/Quote only for retailers</Description>
        </Field>
        <Field>
          <Name>SecondaryOrderID2</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>System Order Number</Description>
        </Field>
        <Field>
          <Name>EntryDate2</Name>
          <Type>D</Type>
          <Size>4</Size>
          <Description>System order entry date (when System Order Number was assigned)</Description>
        </Field>
        <Field>
          <Name>Priority2</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Priority</Description>
        </Field>
        <Field>
          <Name>Price2</Name>
          <Type>P</Type>
          <Size>8</Size>
          <Description>Limit price</Description>
        </Field>
        <Field>
          <Name>DisplayQty2</Name>
          <Type>Q</Type>
          <Size>4</Size>
          <Description>Visible pending volume</Description>
        </Field>
        <Field>
          <Name>RetailFlag2</Name>
          <Type>F</Type>
          <Size>1</Size>
          <Description>Order/Quote only for retailers</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- RetailFlag2 -->
    <Enum>
      <Name>RetailFlag2</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>False</Name>
        </Value>
        <Value>
          <Data>1</Data>
          <Name>True</Name>
        </Value>
        <Value>
          <Data>255</Data>
          <Name>Undefined</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiBmeBmeGatePdf>
