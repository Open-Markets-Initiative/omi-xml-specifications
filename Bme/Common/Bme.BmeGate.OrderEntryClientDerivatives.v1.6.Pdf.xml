          <Type>C</Type>
          <Size>1</Size>
          <Description>Persistence type</Description>
        </Field>
        <Field>
          <Name>SelfMatchPreventionType</Name>
          <Type>C</Type>
          <Size>1</Size>
          <Description></Description>
        </Field>
