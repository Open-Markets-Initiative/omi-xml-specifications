          <Name>ClientID</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Mifid II ClientID</Description>
        </Field>
        <Field>
          <Name>Account</Name>
          <Type>C</Type>
          <Size>5</Size>
          <Description>Account</Description>
        </Field>
        <Field>
          <Name>DEAFlag</Name>
          <Type>F</Type>
          <Size>1</Size>
          <Description>Direct Electronic Access indicator</Description>
        </Field>
        <Field>
          <Name>DecisorID</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>MIFID II DecisorID</Description>
        </Field>
        <Field>
          <Name>ExecutorID</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Mifid II ExecutorID</Description>
        </Field>
        <Field>
          <Name>LiquidityProvisionActivity</Name>
          <Type>F</Type>
          <Size>1</Size>
          <Description>Liquidity Provision Activity Flag</Description>
        </Field>
        <Field>
          <Name>GiveInMember</Name>
          <Type>C</Type>
          <Size>4</Size>
          <Description>Give-in member</Description>
        </Field>
        <Field>
          <Name>FirmMnemonic</Name>
          <Type>C</Type>
