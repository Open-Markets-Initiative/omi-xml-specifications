<OmiBmeBmeGatePdf>

  <!-- Bme BmeGate the network status message, which every channel but the Recovery server carries -->

  <Messages>

    <!-- Network Status Message -->
    <Message>
      <Name>Network Status Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x0A</Code>
      <Category>Session</Category>
      <Origin>Exchange</Origin>
      <Description>Message sent by the server with information about the connectivity between the Server and the central systems. In the Network Status message, the SequenceNumber of the previously received message will be repeated</Description>
      <Fields>
        <Field>
          <Name>SequenceNumber</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Message sequence number (previous SequenceNumber will be repeated)</Description>
        </Field>
        <Field>
          <Name>NetworkStatusValue</Name>
          <Type>U</Type>
          <Size>1</Size>
          <Description>Connection status</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- NetworkStatusValue -->
    <Enum>
      <Name>NetworkStatusValue</Name>
      <Values>
        <Value>
          <Data>1</Data>
          <Name>Connected</Name>
        </Value>
        <Value>
          <Data>2</Data>
          <Name>Not connected - down expected up</Name>
        </Value>
        <Value>
          <Data>3</Data>
          <Name>Not connected - down expected down</Name>
        </Value>
        <Value>
          <Data>4</Data>
          <Name>In process</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiBmeBmeGatePdf>
