<OmiBmeBmeGatePdf>

  <!-- Bme BmeGate order and quote pre-transparency prices and the order book clear, Equities environment (RV) -->

  <Messages>

    <!-- Order Book Clear Message -->
    <Message>
      <Name>Order Book Clear Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x81</Code>
      <Category>Market Information</Category>
      <Origin>Exchange</Origin>
      <Description>Message sent by the UDP full-depth server whenever the information about order prices must be reset. In particular, it is sent by the server when the trading mode changes from auction to open market and vice versa</Description>
      <Fields>
        <Field>
          <Name>SequenceNumber</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Message sequence number</Description>
        </Field>
        <Field>
          <Name>SecurityCode</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Instrument (or Book) code</Description>
        </Field>
        <Field>
          <Name>TransactionDateAndTime</Name>
          <Type>T</Type>
          <Size>8</Size>
          <Description>Transaction Date and Time in nanoseconds since 1-jan-1970 UTC</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Market Pre-Transparency Information Message -->
    <Message>
      <Name>Order Market Pre-Transparency Information Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x03</Code>
      <Category>Market Information</Category>
      <Origin>Exchange</Origin>
      <Description>Used by the Server to communicate information about all active visible orders. During a session, any order is uniquely identified by the SecondaryOrderID</Description>
      <Fields>
        <Field>
          <Name>SequenceNumber</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Message sequence number</Description>
        </Field>
        <Field>
          <Name>SecurityCode</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Instrument (or Book) code</Description>
        </Field>
        <Field>
          <Name>TransactionDateAndTime</Name>
          <Type>T</Type>
          <Size>8</Size>
          <Description>Transaction Date and Time in nanoseconds since 1-jan-1970 UTC</Description>
        </Field>
        <Field>
          <Name>SecondaryOrderID</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>System Order Number</Description>
        </Field>
        <Field>
          <Name>EntryDate</Name>
          <Type>D</Type>
          <Size>4</Size>
          <Description>System order entry date (when System Order Number was assigned)</Description>
        </Field>
        <Field>
          <Name>RetailFlag</Name>
          <Type>F</Type>
          <Size>1</Size>
          <Description>Order/Quote only for retailers</Description>
        </Field>
        <Field>
          <Name>Side</Name>
          <Type>C</Type>
          <Size>1</Size>
          <Description>Side</Description>
        </Field>
        <Field>
          <Name>Priority</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Priority</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>P</Type>
          <Size>8</Size>
          <Description>Limit price</Description>
        </Field>
        <Field>
          <Name>DisplayQty</Name>
          <Type>Q</Type>
          <Size>4</Size>
          <Description>Visible pending volume</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Quote Market Pre-Transparency Information Message -->
    <Message>
      <Name>Quote Market Pre-Transparency Information Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x07</Code>
      <Category>Market Information</Category>
      <Origin>Exchange</Origin>
      <Description>Used by the Server to communicate information about active quotes. In a session, a Quote is univoquely identified by its two orders: SecurityCode and SecondaryOrderID (buy order) and SecondaryOrderID2 (sell order)</Description>
      <Fields>
        <Field>
          <Name>SequenceNumber</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Message sequence number</Description>
        </Field>
        <Field>
          <Name>SecurityCode</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Instrument (or Book) code</Description>
        </Field>
        <Field>
          <Name>TransactionDateAndTime</Name>
          <Type>T</Type>
          <Size>8</Size>
          <Description>Transaction Date and Time in nanoseconds since 1-jan-1970 UTC</Description>
        </Field>
        <Field>
          <Name>SecondaryOrderID</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>System Order Number</Description>
        </Field>
        <Field>
          <Name>SecondaryOrderID2</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>System Order Number</Description>
        </Field>
        <Field>
          <Name>RetailFlag</Name>
          <Type>F</Type>
          <Size>1</Size>
          <Description>Order/Quote only for retailers</Description>
        </Field>
        <Field>
          <Name>Priority</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Priority</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>P</Type>
          <Size>8</Size>
          <Description>Limit price</Description>
        </Field>
        <Field>
          <Name>DisplayQty</Name>
          <Type>Q</Type>
          <Size>4</Size>
          <Description>Visible pending volume</Description>
        </Field>
        <Field>
          <Name>Priority2</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Priority</Description>
        </Field>
        <Field>
          <Name>Price2</Name>
          <Type>P</Type>
          <Size>8</Size>
          <Description>Limit price</Description>
        </Field>
        <Field>
          <Name>DisplayQty2</Name>
          <Type>Q</Type>
          <Size>4</Size>
          <Description>Visible pending volume</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- RetailFlag -->
    <Enum>
      <Name>RetailFlag</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>False</Name>
        </Value>
        <Value>
          <Data>1</Data>
          <Name>True</Name>
        </Value>
        <Value>
          <Data>255</Data>
          <Name>Undefined</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Side -->
    <Enum>
      <Name>Side</Name>
      <Values>
        <Value>
          <Data>1</Data>
          <Name>Buy</Name>
        </Value>
        <Value>
          <Data>2</Data>
          <Name>Sell</Name>
        </Value>
        <Value>
          <Data>7</Data>
          <Name>Undisclosed</Name>
        </Value>
        <Value>
          <Data>?</Data>
          <Name>Not-specified</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiBmeBmeGatePdf>
