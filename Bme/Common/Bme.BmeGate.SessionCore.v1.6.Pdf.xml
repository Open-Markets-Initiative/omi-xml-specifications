<OmiBmeBmeGatePdf>

  <!-- Bme BmeGate the session level messages every channel carries, section 4.1 -->

  <Messages>

    <!-- Logon Response Message -->
    <Message>
      <Name>Logon Response Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x08</Code>
      <Category>Session</Category>
      <Origin>Exchange</Origin>
      <Description>The Logon Response message is used by the Server to accept a new session. In this message the sequence number will always be 0</Description>
      <Fields>
        <Field>
          <Name>SequenceNumber</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Message sequence number</Description>
        </Field>
        <Field>
          <Name>HeartBtInt</Name>
          <Type>U</Type>
          <Size>1</Size>
          <Description>Interval at which messages are sent to verify the connection (Heartbeat message) expressed in seconds</Description>
        </Field>
        <Field>
          <Name>ProtocolVersion</Name>
          <Type>C</Type>
          <Size>6</Size>
          <Description>Identification of the binary protocol version</Description>
        </Field>
        <Field>
          <Name>TestProductionInd</Name>
          <Type>C</Type>
          <Size>1</Size>
          <Description>T: Test P: Production</Description>
        </Field>
        <Field>
          <Name>EnvironmentCode</Name>
          <Type>C</Type>
          <Size>2</Size>
          <Description>Environment code</Description>
        </Field>
        <Field>
          <Name>SessionDate</Name>
          <Type>D</Type>
          <Size>4</Size>
          <Description>Session Date</Description>
        </Field>
        <Field>
          <Name>ExpectedSequenceNumber</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Requested sequence number</Description>
        </Field>
        <Field>
          <Name>SequenceNumberTo</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Actual sequence number corresponding to the Snapshot</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Logout Response Message -->
    <Message>
      <Name>Logout Response Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x0B</Code>
      <Category>Session</Category>
      <Origin>Exchange</Origin>
      <Description>The Logout message is used by the Server to notify the end of a session, whether it is solicited or unsolicited. It may also be the answer to a failed logon attempt (see Logon message)</Description>
      <Fields>
        <Field>
          <Name>SequenceNumber</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Message sequence number</Description>
        </Field>
        <Field>
          <Name>LogoutReason</Name>
          <Type>U</Type>
          <Size>1</Size>
          <Description>Logout reason</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Heartbeat Message -->
    <Message>
      <Name>Heartbeat Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x30</Code>
      <Category>Session</Category>
      <Origin>Exchange</Origin>
      <Description>The Heartbeat message is used by the Server to indicate that the communication is active. In the Heartbeat message, the SequenceNumber of the previously received message will be repeated</Description>
      <Fields>
        <Field>
          <Name>SequenceNumber</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Message sequence number (previous SequenceNumber will be repeated)</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- LogoutReason -->
    <Enum>
      <Name>LogoutReason</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>Termination after a solicited Logout request</Name>
        </Value>
        <Value>
          <Data>1</Data>
          <Name>End of session termination. In Recovery Server, end of recovery snapshot</Name>
        </Value>
        <Value>
          <Data>2</Data>
          <Name>Timeout. Connection lost</Name>
        </Value>
        <Value>
          <Data>3</Data>
          <Name>Lack of heartbeat</Name>
        </Value>
        <Value>
          <Data>16</Data>
          <Name>Invalid username or password</Name>
        </Value>
        <Value>
          <Data>17</Data>
          <Name>Invalid ExpectedSequenceNumber</Name>
        </Value>
        <Value>
          <Data>18</Data>
          <Name>Invalid ProtocolVersion</Name>
        </Value>
        <Value>
          <Data>19</Data>
          <Name>New connection from user</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiBmeBmeGatePdf>
