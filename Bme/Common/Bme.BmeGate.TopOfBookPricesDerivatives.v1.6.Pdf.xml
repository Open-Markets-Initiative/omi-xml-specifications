<OmiBmeBmeGatePdf>

  <!-- Bme BmeGate the top of book price message, Derivatives environment (DE) -->

  <Messages>

    <!-- Top-of-book Message -->
    <Message>
      <Name>Top-of-book Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x82</Code>
      <Category>Market Information</Category>
      <Origin>Exchange</Origin>
      <Description>Used by the UDP Servers to communicate Top-of-book price information during auctions. When there is an indicative match price, the fields BidPx1 and AskPx1 will have the same value</Description>
      <Fields>
        <Field>
          <Name>SequenceNumber</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Message sequence number</Description>
        </Field>
        <Field>
          <Name>SecurityCode</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Instrument (or Book) code</Description>
        </Field>
        <Field>
          <Name>TransactionDateAndTime</Name>
          <Type>T</Type>
          <Size>8</Size>
          <Description>Transaction Date and Time in nanoseconds since 1-jan- 1970 UTC</Description>
        </Field>
        <Field>
          <Name>BidOrders1</Name>
          <Type>U</Type>
          <Size>2</Size>
          <Description>Buy number of orders</Description>
        </Field>
        <Field>
          <Name>BidSize1</Name>
          <Type>Q</Type>
          <Size>4</Size>
          <Description>Buy volume</Description>
        </Field>
        <Field>
          <Name>BidPx1</Name>
          <Type>P</Type>
          <Size>8</Size>
          <Description>Buy price</Description>
        </Field>
        <Field>
          <Name>RetailClBidFlag1</Name>
          <Type>F</Type>
          <Size>1</Size>
          <Description>The price is retail or has part of retail</Description>
        </Field>
        <Field>
          <Name>AskOrders1</Name>
          <Type>U</Type>
          <Size>2</Size>
          <Description>Sell number of orders</Description>
        </Field>
        <Field>
          <Name>AskSize1</Name>
          <Type>Q</Type>
          <Size>4</Size>
          <Description>Sell volume</Description>
        </Field>
        <Field>
          <Name>AskPx1</Name>
          <Type>P</Type>
          <Size>8</Size>
          <Description>Sell price</Description>
        </Field>
        <Field>
          <Name>RetailClAskFlag1</Name>
          <Type>F</Type>
          <Size>1</Size>
          <Description>The price is retail or has part of retail</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- RetailClAskFlag1 -->
    <Enum>
      <Name>RetailClAskFlag1</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>False</Name>
        </Value>
        <Value>
          <Data>1</Data>
          <Name>True</Name>
        </Value>
        <Value>
          <Data>255</Data>
          <Name>Undefined</Name>
        </Value>
      </Values>
    </Enum>

    <!-- RetailClBidFlag1 -->
    <Enum>
      <Name>RetailClBidFlag1</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>False</Name>
        </Value>
        <Value>
          <Data>1</Data>
          <Name>True</Name>
        </Value>
        <Value>
          <Data>255</Data>
          <Name>Undefined</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiBmeBmeGatePdf>
