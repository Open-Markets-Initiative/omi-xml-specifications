<OmiBmeBmeGatePdf>

  <!-- Bme BmeGate market messages whose fields are the same in all three environments -->

  <Messages>

    <!-- Trading Session Status Message -->
    <Message>
      <Name>Trading Session Status Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x68</Code>
      <Category>Market Information</Category>
      <Origin>Exchange</Origin>
      <Description>Sent by the server to inform about the session status in each Trading Mode</Description>
      <Fields>
        <Field>
          <Name>SequenceNumber</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Message sequence number</Description>
        </Field>
        <Field>
          <Name>TradingSessionID</Name>
          <Type>U</Type>
          <Size>1</Size>
          <Description>Trading mode</Description>
        </Field>
        <Field>
          <Name>TradingSessionSubID</Name>
          <Type>U</Type>
          <Size>1</Size>
          <Description>Session phase</Description>
        </Field>
        <Field>
          <Name>TradSesStatus</Name>
          <Type>U</Type>
          <Size>1</Size>
          <Description>Trading session status</Description>
        </Field>
        <Field>
          <Name>TransactionDateAndTime</Name>
          <Type>T</Type>
          <Size>8</Size>
          <Description>Transaction Date and Time in nanoseconds since 1-jan-1970 UTC</Description>
        </Field>
      </Fields>
    </Message>

    <!-- News Message -->
    <Message>
      <Name>News Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x42</Code>
      <Category>Market Information</Category>
      <Origin>Exchange</Origin>
      <Description>Used by the Server to communicate a Market Surveillance or system-wide text message</Description>
      <Fields>
        <Field>
          <Name>SequenceNumber</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Message sequence number</Description>
        </Field>
        <Field>
          <Name>NewsText</Name>
          <Type>C</Type>
          <Size>78</Size>
          <Description>News text</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Security List Cancellation Report Message -->
    <Message>
      <Name>Security List Cancellation Report Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x78</Code>
      <Category>Market Information</Category>
      <Origin>Exchange</Origin>
      <Description>Message sent by the server for cancelling previously defined securities</Description>
      <Fields>
        <Field>
          <Name>SequenceNumber</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Message sequence number</Description>
        </Field>
        <Field>
          <Name>MarketID</Name>
          <Type>C</Type>
          <Size>4</Size>
          <Description>Operating MIC Code</Description>
        </Field>
        <Field>
          <Name>MarketSegmentID</Name>
          <Type>C</Type>
          <Size>4</Size>
          <Description>Segment MIC Code</Description>
        </Field>
        <Field>
          <Name>SecurityCode</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Instrument (or Book) code</Description>
        </Field>
        <Field>
          <Name>Symbol</Name>
          <Type>C</Type>
          <Size>22</Size>
          <Description>Symbol</Description>
        </Field>
        <Field>
          <Name>SymbolISIN</Name>
          <Type>C</Type>
          <Size>12</Size>
          <Description>Instrument ISIN</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Statistics Message -->
    <Message>
      <Name>Statistics Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x84</Code>
      <Category>Market Information</Category>
      <Origin>Exchange</Origin>
      <Description>Message sent by the server to inform about closing prices and other statistics. Le n</Description>
      <Fields>
        <Field>
          <Name>SequenceNumber</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Message sequence number</Description>
        </Field>
        <Field>
          <Name>SecurityCode</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Instrument (or Book) code</Description>
        </Field>
        <Field>
          <Name>TransactionDateAndTime</Name>
          <Type>T</Type>
          <Size>8</Size>
          <Description>Transaction Date and Time in nanoseconds since 1-jan- 1970 UTC</Description>
        </Field>
        <Field>
          <Name>DataCount</Name>
          <Type>U</Type>
          <Size>1</Size>
          <Description>Number of data values</Description>
        </Field>
        <Field>
          <Name>DataCode</Name>
          <Type>C</Type>
          <Size>1</Size>
          <Description>Data field code</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- TradSesStatus -->
    <Enum>
      <Name>TradSesStatus</Name>
      <Values>
        <Value>
          <Data>1</Data>
          <Name>Halted</Name>
        </Value>
        <Value>
          <Data>2</Data>
          <Name>Open</Name>
        </Value>
        <Value>
          <Data>3</Data>
          <Name>Closed</Name>
        </Value>
        <Value>
          <Data>4</Data>
          <Name>Pre Open (Not started)</Name>
        </Value>
        <Value>
          <Data>5</Data>
          <Name>Pre-Close</Name>
        </Value>
        <Value>
          <Data>6</Data>
          <Name>Request Rejected</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiBmeBmeGatePdf>
