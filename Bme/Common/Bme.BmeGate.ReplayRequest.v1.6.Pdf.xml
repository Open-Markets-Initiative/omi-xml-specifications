<OmiBmeBmeGatePdf>

  <!-- Bme BmeGate the replay request and its acknowledgement, the Replay server's own -->

  <Messages>

    <!-- Replay Request Message -->
    <Message>
      <Name>Replay Request Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x09</Code>
      <Category>Session</Category>
      <Origin>Exchange</Origin>
      <Description>Message sent by the client application to request the replay of some specific UDP messages through the TCP Replay channel</Description>
      <Fields>
        <Field>
          <Name>SequenceNumberFrom</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Sequence number of first message to be replayed</Description>
        </Field>
        <Field>
          <Name>SequenceNumberTo</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Sequence number of last message to be replayed</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Replay Request Ack/Nack Message -->
    <Message>
      <Name>Replay Request Ack/Nack Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x0C</Code>
      <Category>Session</Category>
      <Origin>Exchange</Origin>
      <Description>Message sent by the Replay Server as an inmediate answer to a Replay Request (Msg Type = 0x09). In this message the sequence number will always be 0</Description>
      <Fields>
        <Field>
          <Name>SequenceNumber</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Message sequence number</Description>
        </Field>
        <Field>
          <Name>SequenceNumberFrom</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Actual sequence number of first message to be replayed</Description>
        </Field>
        <Field>
          <Name>SequenceNumberTo</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Actual sequence number of last message to be replayed</Description>
        </Field>
        <Field>
          <Name>RequestID</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Request ID (for application feedback)</Description>
        </Field>
        <Field>
          <Name>Status</Name>
          <Type>F</Type>
          <Size>1</Size>
          <Description>0x00 = Rejected/NAck</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- Status -->
    <Enum>
      <Name>Status</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>False</Name>
        </Value>
        <Value>
          <Data>1</Data>
          <Name>True</Name>
        </Value>
        <Value>
          <Data>255</Data>
          <Name>Undefined</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiBmeBmeGatePdf>
