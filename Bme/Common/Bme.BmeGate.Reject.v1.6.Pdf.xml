<OmiBmeBmeGatePdf>

  <!-- Bme BmeGate the session level reject, which the Tcp servers carry -->

  <Messages>

    <!-- Reject Message -->
    <Message>
      <Name>Reject Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x0D</Code>
      <Category>Session</Category>
      <Origin>Exchange</Origin>
      <Description>It may be sent by the server to inform about the rejection of an unsupported or syntactically incorrect message. In the Reject message, the SequenceNumber of the previously received message will be repeated</Description>
      <Fields>
        <Field>
          <Name>SequenceNumber</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Message sequence number (previous SequenceNumber will be repeated)</Description>
        </Field>
        <Field>
          <Name>SessionRejectReason</Name>
          <Type>U</Type>
          <Size>1</Size>
          <Description>Code indicating the rejection motive</Description>
        </Field>
        <Field>
          <Name>Text</Name>
          <Type>C</Type>
          <Size>58</Size>
          <Description>Explanation of rejection</Description>
        </Field>
        <Field>
          <Name>MsgRejectedReference</Name>
          <Type>(raw data)</Type>
          <Size>7</Size>
          <Description>Provides the seven first bytes of the message being rejected</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- SessionRejectReason -->
    <Enum>
      <Name>SessionRejectReason</Name>
      <Values>
        <Value>
          <Data>11</Data>
          <Name>Invalid MsgType</Name>
        </Value>
        <Value>
          <Data>30</Data>
          <Name>Wrong MessageSize</Name>
        </Value>
        <Value>
          <Data>31</Data>
          <Name>Throttle limit exceeded</Name>
        </Value>
        <Value>
          <Data>33</Data>
          <Name>Invalid client session status</Name>
        </Value>
        <Value>
          <Data>99</Data>
          <Name>Other</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiBmeBmeGatePdf>
