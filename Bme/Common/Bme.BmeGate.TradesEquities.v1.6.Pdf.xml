<OmiBmeBmeGatePdf>

  <!-- Bme BmeGate trades, as the top of book and full depth feeds both carry them, Equities environment (RV) -->

  <Messages>

    <!-- Trade Market Post-Transparency Information Top-of-book Message -->
    <Message>
      <Name>Trade Market Post-Transparency Information Top-of-book Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x10</Code>
      <Category>Market Information</Category>
      <Origin>Exchange</Origin>
      <Description>Used by the server to communicate trade information related to trades resulting from order matching in channels C/D and E/F. It is also used in channels A/B when the trade is the result of order matching at the end of an auction period (where only top-of-book information is shown)</Description>
      <Fields>
        <Field>
          <Name>SequenceNumber</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Message sequence number</Description>
        </Field>
        <Field>
          <Name>SecurityCode</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Instrument (or Book) code</Description>
        </Field>
        <Field>
          <Name>TransactionDateAndTime</Name>
          <Type>T</Type>
          <Size>8</Size>
          <Description>Transaction Date and Time in nanoseconds since 1-jan- 1970 UTC</Description>
        </Field>
        <Field>
          <Name>MarketSegmentID</Name>
          <Type>C</Type>
          <Size>4</Size>
          <Description>MIC Code</Description>
        </Field>
        <Field>
          <Name>TradingSessionID</Name>
          <Type>U</Type>
          <Size>1</Size>
          <Description>Trading mode</Description>
        </Field>
        <Field>
          <Name>TrdMatchID</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>System Trade Number</Description>
        </Field>
        <Field>
          <Name>TradeType</Name>
          <Type>C</Type>
          <Size>1</Size>
          <Description>Trade type</Description>
        </Field>
        <Field>
          <Name>LastPX</Name>
          <Type>P</Type>
          <Size>8</Size>
          <Description>Trade price</Description>
        </Field>
        <Field>
          <Name>LastQty</Name>
          <Type>Q</Type>
          <Size>4</Size>
          <Description>Current trade volume</Description>
        </Field>
        <Field>
          <Name>GrossTradeAmt</Name>
          <Type>A</Type>
          <Size>8</Size>
          <Description>Premium / Trade amount</Description>
        </Field>
        <Field>
          <Name>Designation</Name>
          <Type>C</Type>
          <Size>1</Size>
          <Description>Trade situation</Description>
        </Field>
        <Field>
          <Name>MarketMechanism</Name>
          <Type>C</Type>
          <Size>1</Size>
          <Description>Market Mechanism</Description>
        </Field>
        <Field>
          <Name>AlgoFlag</Name>
          <Type>F</Type>
          <Size>1</Size>
          <Description>Algorithmic flag indicator</Description>
        </Field>
        <Field>
          <Name>BuyerBolsaCode</Name>
          <Type>C</Type>
          <Size>1</Size>
          <Description>Stock Exchange code of the buyer</Description>
        </Field>
        <Field>
          <Name>SettlDate</Name>
          <Type>D</Type>
          <Size>4</Size>
          <Description>Settlement date</Description>
        </Field>
        <Field>
          <Name>TransactionCategory</Name>
          <Type>C</Type>
          <Size>1</Size>
          <Description></Description>
        </Field>
      </Fields>
    </Message>

