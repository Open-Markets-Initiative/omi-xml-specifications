<OmiBmeBmeGatePdf>

  <!-- Bme BmeGate the indication of interest, which every server carries, Derivatives environment (DE) -->

  <Messages>

    <!-- Indication of Interest Message -->
    <Message>
      <Name>Indication of Interest Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x36</Code>
      <Category>Market Information</Category>
      <Origin>Exchange</Origin>
      <Description>Used by the Server to notify an indication of interest on a specific instrument. This functionality is available in Fixed Income and Derivatives</Description>
      <Fields>
        <Field>
          <Name>SequenceNumber</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Message sequence number</Description>
        </Field>
        <Field>
          <Name>SecurityCode</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>Instrument (or Book) code</Description>
        </Field>
        <Field>
          <Name>TransactionDateAndTime</Name>
          <Type>T</Type>
          <Size>8</Size>
          <Description>Transaction Date and Time in nanoseconds since 1-jan-1970 UTC</Description>
        </Field>
        <Field>
          <Name>IOIID</Name>
          <Type>U</Type>
          <Size>4</Size>
          <Description>RFQ identifier</Description>
        </Field>
        <Field>
          <Name>IOITransType</Name>
          <Type>C</Type>
          <Size>1</Size>
          <Description>Message type</Description>
        </Field>
        <Field>
          <Name>Side</Name>
          <Type>C</Type>
          <Size>1</Size>
          <Description>Side</Description>
        </Field>
        <Field>
          <Name>IOIQty</Name>
          <Type>Q</Type>
          <Size>4</Size>
          <Description>Requested indicative volume</Description>
        </Field>
        <Field>
          <Name>IOIPrice</Name>
          <Type>P</Type>
          <Size>8</Size>
          <Description>Requested indicative price</Description>
        </Field>
        <Field>
          <Name>IOIQltyInd</Name>
          <Type>C</Type>
          <Size>1</Size>
          <Description>Request type</Description>
        </Field>
        <Field>
          <Name>TradingSessionID</Name>
          <Type>U</Type>
          <Size>1</Size>
          <Description>Trading mode</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Enums>

    <!-- IOIQltyInd -->
    <Enum>
      <Name>IOIQltyInd</Name>
      <Values>
        <Value>
          <Data>H</Data>
          <Name>High (RFQ requested)</Name>
        </Value>
        <Value>
          <Data>M</Data>
          <Name>Medium (order requested)</Name>
        </Value>
      </Values>
    </Enum>

    <!-- IOITransType -->
    <Enum>
      <Name>IOITransType</Name>
      <Values>
        <Value>
          <Data>N</Data>
          <Name>New</Name>
        </Value>
        <Value>
          <Data>C</Data>
          <Name>Cancel</Name>
        </Value>
        <Value>
          <Data>R</Data>
          <Name>Replace</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Side -->
    <Enum>
      <Name>Side</Name>
      <Values>
        <Value>
          <Data>1</Data>
          <Name>Buy</Name>
        </Value>
        <Value>
          <Data>2</Data>
          <Name>Sell</Name>
        </Value>
        <Value>
          <Data>7</Data>
          <Name>Undisclosed</Name>
        </Value>
        <Value>
          <Data>?</Data>
          <Name>Not-specified</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiBmeBmeGatePdf>
