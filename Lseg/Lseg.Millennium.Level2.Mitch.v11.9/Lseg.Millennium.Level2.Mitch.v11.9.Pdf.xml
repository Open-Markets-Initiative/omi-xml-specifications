<OmiMitchPdf>

  <!-- Lse Millennium Level2 Mitch v11.9 -->

  <Messages>

    <!-- Time Message -->
    <Message>
      <Name>Time Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x54</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Sent by the server for every second for which at least one application message is generated.</Description>
      <Fields>
        <Field>
          <Name>Seconds</Name>
          <Type>UInt32</Type>
          <Size>4</Size>
          <Description>Number of seconds since midnight. Midnight will be in terms of the local time for the server (i.e. not UTC).</Description>
        </Field>
      </Fields>
    </Message>

    <!-- System Event Message -->
    <Message>
      <Name>System Event Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x53</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Sent to indicate the start and end of the day.</Description>
      <Fields>
        <Field>
          <Name>Nanosecond</Name>
          <Type>UInt32</Type>
          <Size>4</Size>
          <Description>Nanoseconds since last message, accurate to the nearest microsecond.</Description>
        </Field>
        <Field>
          <Name>Event Code</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Refer to System Event Codes below</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Symbol Directory Message -->
    <Message>
      <Name>Symbol Directory Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x52</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Used to disseminate information (symbol, segment, ISIN, underlying, etc.) on each instrument</Description>
      <Fields>
        <Field>
          <Name>Nanosecond</Name>
          <Type>UInt32</Type>
          <Size>4</Size>
          <Description>Nanoseconds since last Time message, accurate to the nearest microsecond.</Description>
        </Field>
        <Field>
          <Name>Instrument ID</Name>
          <Type>UInt32</Type>
          <Size>4</Size>
          <Description>Instrument's symbol.</Description>
        </Field>
        <Field>
          <Name>Reserved A</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Reserved field</Description>
        </Field>
        <Field>
          <Name>Reserved B</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Reserved field</Description>
        </Field>
        <Field>
          <Name>Symbol Status</Name>
          <Type>Alpha</Type>
          <Size>1</Size>
          <Description>This field will contain a space if the instrument is active.</Description>
        </Field>
        <Field>
          <Name>ISIN</Name>
          <Type>Alpha</Type>
          <Size>12</Size>
          <Description>Instrument identification number</Description>
        </Field>
        <Field>
          <Name>SEDOL</Name>
          <Type>Alpha</Type>
          <Size>12</Size>
          <Description>Instrument identification number</Description>
        </Field>
        <Field>
          <Name>Segment</Name>
          <Type>Alpha</Type>
          <Size>6</Size>
          <Description>Segment the instrument is assigned to.</Description>
        </Field>
        <Field>
          <Name>Underlying</Name>
          <Type>Alpha</Type>
          <Size>6</Size>
          <Description>Reserved for future use</Description>
        </Field>
        <Field>
          <Name>Currency</Name>
          <Type>Alpha</Type>
          <Size>3</Size>
          <Description>ISO Currency Code</Description>
        </Field>
        <Field>
          <Name>Reserved Byte</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Reserved field</Description>
        </Field>
        <Field>
          <Name>Reserved Alpha</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Reserved field</Description>
        </Field>
        <Field>
          <Name>Previous Close Price</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Previous Close Price of instrument</Description>
        </Field>
      </Fields>
    </Message>

