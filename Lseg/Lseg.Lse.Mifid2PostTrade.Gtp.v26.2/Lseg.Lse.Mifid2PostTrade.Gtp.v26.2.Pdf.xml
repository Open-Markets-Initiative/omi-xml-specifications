<OmiGtpPdf>

  <Messages>

    <!-- System Event Message -->
    <Message>
      <Name>System Event Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x53</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Sent to indicate the start and end of the day.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>UDT</Type>
          <Size>8</Size>
          <Description>Time the message was generated.</Description>
        </Field>
        <Field>
          <Name>Event Code</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Start or end of day event code.</Description>
        </Field>
        <Field>
          <Name>Source Venue</Name>
          <Type>UInt16</Type>
          <Size>2</Size>
          <Description>Venue from which market data is received for the instrument.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Instrument Directory Message -->
    <Message>
      <Name>Instrument Directory Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x70</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Used to disseminate a common and limited set of data for all configured instrument types, except strategy instruments, on the real-time channels.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>UDT</Type>
          <Size>8</Size>
          <Description>Time the message was generated.</Description>
        </Field>
        <Field>
          <Name>Instrument</Name>
          <Type>UInt64</Type>
          <Size>8</Size>
          <Description>GTP Instrument identifier.</Description>
        </Field>
        <Field>
          <Name>ISIN</Name>
          <Type>Alpha</Type>
          <Size>12</Size>
          <Description>ISIN Code of an instrument.</Description>
        </Field>
        <Field>
          <Name>Allowed Book Types</Name>
          <Type>Bit Field</Type>
          <Size>1</Size>
          <Description>Defines the order-book types that are allowed for the instrument. Each designated bit represents a book type. '0' means not allowed and '1' means allowed.</Description>
        </Field>
        <Field>
          <Name>Source Venue</Name>
          <Type>UInt16</Type>
          <Size>2</Size>
          <Description>Venue from which market data is received for the instrument.</Description>
        </Field>
        <Field>
          <Name>Venue Instrument ID</Name>
          <Type>Alpha</Type>
          <Size>11</Size>
          <Description>Instrument identifier used by the source venue.</Description>
        </Field>
        <Field>
          <Name>Tick ID</Name>
          <Type>Alpha</Type>
          <Size>2</Size>
          <Description>The tick structure applicable for the instrument.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Dynamic Circuit Breaker Tolerances (%)</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Dynamic Circuit Breaker Tolerance (%) of the instrument.</Description>
        </Field>
        <Field>
          <Name>Static Circuit Breaker Tolerances (%)</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Static Circuit Breaker Tolerance (%) of the instrument.</Description>
        </Field>
        <Field>
          <Name>Segment</Name>
          <Type>Alpha</Type>
          <Size>6</Size>
          <Description>Segment the instrument is assigned to.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Alpha</Type>
          <Size>12</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Alpha</Type>
          <Size>11</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Currency</Name>
          <Type>Alpha</Type>
          <Size>3</Size>
          <Description>Currency Code as per ISO 4217.</Description>
        </Field>
        <Field>
          <Name>Partition ID</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Trading System's partition in which the instrument is traded.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Average Daily Turnover (ADT)</Name>
          <Type>Price4</Type>
          <Size>8</Size>
          <Description>Not Applicable to LSE.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Alpha</Type>
          <Size>8</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>UInt8</Type>
          <Size>1</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Reserved for future use.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Instrument Status Message -->
    <Message>
      <Name>Instrument Status Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x48</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Used to communicate scheduled and unscheduled session changes. When sent in the recovery channel, used to indicate the current trading status of an instrument.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>UDT</Type>
          <Size>8</Size>
          <Description>Time the message was generated.</Description>
        </Field>
        <Field>
          <Name>Instrument</Name>
          <Type>UInt64</Type>
          <Size>8</Size>
          <Description>GTP Instrument identifier.</Description>
        </Field>
        <Field>
          <Name>Source venue</Name>
          <Type>UInt16</Type>
          <Size>2</Size>
          <Description>Venue from which market data is received for the instrument.</Description>
        </Field>
        <Field>
          <Name>Trading Status</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Current trading status of the instrument.</Description>
        </Field>
        <Field>
          <Name>Session Change Reason</Name>
          <Type>UInt8</Type>
          <Size>1</Size>
          <Description>Reason the trading session changed.</Description>
        </Field>
        <Field>
          <Name>New End Time</Name>
          <Type>Time</Type>
          <Size>6</Size>
          <Description>New time the session will end. The field will contain only spaces if Session Change Reason is '0' or the Session Change Reason is not present. New End Time will be in terms of the local time on the server (i.e., not UTC).</Description>
        </Field>
        <Field>
          <Name>Order Book Type</Name>
          <Type>UInt8</Type>
          <Size>1</Size>
          <Description>Order book the status applies to.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Mifid II Trade Message -->
    <Message>
      <Name>Mifid II Trade Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x51</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Sent to represent different types of MiFID compliant trades published by markets.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>UDT</Type>
          <Size>8</Size>
          <Description>Message dissemination time.</Description>
        </Field>
        <Field>
          <Name>Source venue</Name>
          <Type>UInt16</Type>
          <Size>2</Size>
          <Description>Venue from which market data is received for the instrument.</Description>
        </Field>
        <Field>
          <Name>Instrument</Name>
          <Type>UInt64</Type>
          <Size>8</Size>
          <Description>GTP Instrument identifier.</Description>
        </Field>
        <Field>
          <Name>Transaction identification code</Name>
          <Type>Alpha</Type>
          <Size>52</Size>
          <Description>A unique trade identifier. The value will be right aligned.</Description>
        </Field>
        <Field>
          <Name>Mifid Trade Type</Name>
          <Type>UInt8</Type>
          <Size>1</Size>
          <Description>Type of the trade.</Description>
        </Field>
        <Field>
          <Name>Auction Type</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>The value in this field is only relevant when Trade Type is 1.</Description>
        </Field>
        <Field>
          <Name>Mifid Price</Name>
          <Type>MiFID Decimal</Type>
          <Size>20</Size>
          <Description>MiFID compliant Price field populated using either Price or Percentage. {DECIMAL-18/13} in case the price is expressed as monetary value. {DECIMAL-11/10} in case the price is expressed as percentage.</Description>
        </Field>
        <Field>
          <Name>Mifid Quantity</Name>
          <Type>MiFID Decimal</Type>
          <Size>20</Size>
          <Description>Number of units of the financial instrument. {DECIMAL-18/17} Will be set to default value (20 spaces) if the traded security is a bond.</Description>
        </Field>
        <Field>
          <Name>Trading Date and Time</Name>
          <Type>Date and Time</Type>
          <Size>27</Size>
          <Description>Date and time when the transaction was executed/agreed upon. If a trade is cancelled or amended, this field will contain the Trading Date and Time of the original trade.</Description>
        </Field>
        <Field>
          <Name>Instrument Identification Code Type</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Only relevant for non-equity instruments. Empty for equity and equity-like instruments.</Description>
        </Field>
        <Field>
          <Name>Instrument Identification Code</Name>
          <Type>Alpha</Type>
          <Size>12</Size>
          <Description>Instrument identification number (ISIN code).</Description>
        </Field>
        <Field>
          <Name>Price Notation</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Indicates if the price is expressed in monetary value or in percentage. Only relevant for non-equity instruments.</Description>
        </Field>
        <Field>
          <Name>Price Major Currency</Name>
          <Type>Alpha</Type>
          <Size>3</Size>
          <Description>Major currency in which the price is expressed (applicable if the price is expressed as monetary value). Currency Code as per ISO 4217.</Description>
        </Field>
        <Field>
          <Name>Notional Amount</Name>
          <Type>MiFID Decimal</Type>
          <Size>20</Size>
          <Description>Notional value relevant to the security. {DECIMAL-18/5} Only relevant for non-equity instruments.</Description>
        </Field>
        <Field>
          <Name>Notional Currency</Name>
          <Type>Alpha</Type>
          <Size>3</Size>
          <Description>Major Currency in which the notional amount is denominated. Only relevant for non-equity instruments.</Description>
        </Field>
        <Field>
          <Name>Venue of Execution</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Identification of the venue where the transaction was executed.</Description>
        </Field>
        <Field>
          <Name>Publication Date and Time</Name>
          <Type>Date and Time</Type>
          <Size>27</Size>
          <Description>Date and time when the transaction was published.</Description>
        </Field>
        <Field>
          <Name>PTRefPriceWaiverFlag</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Not Applicable to LSE.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Market Closing Price Flag</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Market closing price flag.</Description>
        </Field>
        <Field>
          <Name>PTAlgoTrade</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Algorithmic trade flag.</Description>
        </Field>
        <Field>
          <Name>PTCancellationFlag</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Trade cancellation flag.</Description>
        </Field>
        <Field>
          <Name>PTAmendmentFlag</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Trade amendment flag.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Alpha</Type>
          <Size>3</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>MiFID Decimal</Type>
          <Size>20</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Trade Qualifier</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Qualifier of the trade.</Description>
        </Field>
        <Field>
          <Name>Market Mechanism</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Market mechanism the trade was executed under.</Description>
        </Field>
        <Field>
          <Name>Trading Mode</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Trading mode the trade was executed under.</Description>
        </Field>
        <Field>
          <Name>Transaction Category</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Category of the transaction.</Description>
        </Field>
        <Field>
          <Name>Negotiation Indicator</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Indicates whether the trade was negotiated.</Description>
        </Field>
        <Field>
          <Name>Agency Cross Indicator</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Indicates whether the trade was an agency cross.</Description>
        </Field>
        <Field>
          <Name>Modification Indicator</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Indicates whether the report cancels or amends a previous report.</Description>
        </Field>
        <Field>
          <Name>Reference Price Indicator</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Indicates whether the trade was a reference price trade.</Description>
        </Field>
        <Field>
          <Name>Special Dividend Indicator</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Indicates whether the trade was a special dividend trade.</Description>
        </Field>
        <Field>
          <Name>Off Book Automated Indicator</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Indicates whether the off book trade was automated.</Description>
        </Field>
        <Field>
          <Name>Price Formation Indicator</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Indicates how the price was formed.</Description>
        </Field>
        <Field>
          <Name>Algorithmic Indicator</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Indicates whether the trade was algorithmic.</Description>
        </Field>
        <Field>
          <Name>Post-Trade Deferral Reason</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Reason publication of the trade was deferred.</Description>
        </Field>
        <Field>
          <Name>Deferral/Enrichment Type</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Type of deferral or enrichment applied.</Description>
        </Field>
        <Field>
          <Name>Duplicative Indicator</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Indicates whether the trade report is duplicative.</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

