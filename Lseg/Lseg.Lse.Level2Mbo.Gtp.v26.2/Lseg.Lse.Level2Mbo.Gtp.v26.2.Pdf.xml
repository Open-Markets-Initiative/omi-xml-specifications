<OmiGtpPdf>

  <Messages>

    <!-- System Event Message -->
    <Message>
      <Name>System Event Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x53</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Sent to indicate the start and end of the day.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>UDT</Type>
          <Size>8</Size>
          <Description>Time the message was generated.</Description>
        </Field>
        <Field>
          <Name>Event Code</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Start or end of day event code.</Description>
        </Field>
        <Field>
          <Name>Source Venue</Name>
          <Type>UInt16</Type>
          <Size>2</Size>
          <Description>Venue from which market data is received for the instrument.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Instrument Directory Message -->
    <Message>
      <Name>Instrument Directory Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x70</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Used to disseminate a common and limited set of data for all configured instrument types, except strategy instruments, on the real-time channels.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>UDT</Type>
          <Size>8</Size>
          <Description>Time the message was generated.</Description>
        </Field>
        <Field>
          <Name>Instrument</Name>
          <Type>UInt64</Type>
          <Size>8</Size>
          <Description>GTP Instrument identifier.</Description>
        </Field>
        <Field>
          <Name>ISIN</Name>
          <Type>Alpha</Type>
          <Size>12</Size>
          <Description>ISIN Code of an instrument.</Description>
        </Field>
        <Field>
          <Name>Allowed Book Types</Name>
          <Type>Bit Field</Type>
          <Size>1</Size>
          <Description>Defines the order-book types that are allowed for the instrument. Each designated bit represents a book type. '0' means not allowed and '1' means allowed.</Description>
        </Field>
        <Field>
          <Name>Source Venue</Name>
          <Type>UInt16</Type>
          <Size>2</Size>
          <Description>Venue from which market data is received for the instrument.</Description>
        </Field>
        <Field>
          <Name>Venue Instrument ID</Name>
          <Type>Alpha</Type>
          <Size>11</Size>
          <Description>Instrument identifier used by the source venue.</Description>
        </Field>
        <Field>
          <Name>Tick ID</Name>
          <Type>Alpha</Type>
          <Size>2</Size>
          <Description>The tick structure applicable for the instrument.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Dynamic Circuit Breaker Tolerances (%)</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Dynamic Circuit Breaker Tolerance (%) of the instrument.</Description>
        </Field>
        <Field>
          <Name>Static Circuit Breaker Tolerances (%)</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Static Circuit Breaker Tolerance (%) of the instrument.</Description>
        </Field>
        <Field>
          <Name>Segment</Name>
          <Type>Alpha</Type>
          <Size>6</Size>
          <Description>Segment the instrument is assigned to.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Alpha</Type>
          <Size>12</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Alpha</Type>
          <Size>11</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Currency</Name>
          <Type>Alpha</Type>
          <Size>3</Size>
          <Description>Currency Code as per ISO 4217.</Description>
        </Field>
        <Field>
          <Name>Partition ID</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Trading System's partition in which the instrument is traded.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Average Daily Turnover (ADT)</Name>
          <Type>Price4</Type>
          <Size>8</Size>
          <Description>Not Applicable to LSE.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Alpha</Type>
          <Size>8</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>UInt8</Type>
          <Size>1</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Reserved for future use.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Instrument Status Message -->
    <Message>
      <Name>Instrument Status Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x48</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Used to communicate scheduled and unscheduled session changes. When sent in the recovery channel, used to indicate the current trading status of an instrument.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>UDT</Type>
          <Size>8</Size>
          <Description>Time the message was generated.</Description>
        </Field>
        <Field>
          <Name>Instrument</Name>
          <Type>UInt64</Type>
          <Size>8</Size>
          <Description>GTP Instrument identifier.</Description>
        </Field>
        <Field>
          <Name>Source venue</Name>
          <Type>UInt16</Type>
          <Size>2</Size>
          <Description>Venue from which market data is received for the instrument.</Description>
        </Field>
        <Field>
          <Name>Trading Status</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Current trading status of the instrument.</Description>
        </Field>
        <Field>
          <Name>Session Change Reason</Name>
          <Type>UInt8</Type>
          <Size>1</Size>
          <Description>Reason the trading session changed.</Description>
        </Field>
        <Field>
          <Name>New End Time</Name>
          <Type>Time</Type>
          <Size>6</Size>
          <Description>New time the session will end. The field will contain only spaces if Session Change Reason is '0' or the Session Change Reason is not present. New End Time will be in terms of the local time on the server (i.e., not UTC).</Description>
        </Field>
        <Field>
          <Name>Order Book Type</Name>
          <Type>UInt8</Type>
          <Size>1</Size>
          <Description>Order book the status applies to.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Add Order MBO Message -->
    <Message>
      <Name>Add Order MBO Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x41</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Indicates the first order of a given side of an MBO snapshot.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>UDT</Type>
          <Size>8</Size>
          <Description>Time the message was generated.</Description>
        </Field>
        <Field>
          <Name>Order ID</Name>
          <Type>UInt64</Type>
          <Size>8</Size>
          <Description>Unique identifier of the order.</Description>
        </Field>
        <Field>
          <Name>Side</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Side of the order.</Description>
        </Field>
        <Field>
          <Name>Size</Name>
          <Type>Size</Type>
          <Size>8</Size>
          <Description>Displayed size of the order.</Description>
        </Field>
        <Field>
          <Name>Instrument</Name>
          <Type>UInt64</Type>
          <Size>8</Size>
          <Description>GTP Instrument identifier.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Limit price of the order.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Source venue</Name>
          <Type>UInt16</Type>
          <Size>2</Size>
          <Description>Venue from which market data is received for the instrument.</Description>
        </Field>
        <Field>
          <Name>Order Book Type</Name>
          <Type>UInt8</Type>
          <Size>1</Size>
          <Description>Order book the order rests on.</Description>
        </Field>
        <Field>
          <Name>Participant</Name>
          <Type>Alpha</Type>
          <Size>11</Size>
          <Description>Identity of trading participant that submitted the order.</Description>
        </Field>
        <Field>
          <Name>Depth</Name>
          <Type>UInt8</Type>
          <Size>1</Size>
          <Description>Total number of orders disseminated including this one, on this side of the book as indicated by Side field.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Add Order Short MBO Message -->
    <Message>
      <Name>Add Order Short MBO Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x65</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Used to indicate individual orders of an MBO snapshot.</Description>
      <Fields>
        <Field>
          <Name>Order ID</Name>
          <Type>UInt64</Type>
          <Size>8</Size>
          <Description>Unique identifier of the order.</Description>
        </Field>
        <Field>
          <Name>Size</Name>
          <Type>Size</Type>
          <Size>8</Size>
          <Description>Displayed size of the order.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Limit price of the order.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Participant</Name>
          <Type>Alpha</Type>
          <Size>11</Size>
          <Description>Identity of trading participant that submitted the order.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Book Clear Message -->
    <Message>
      <Name>Order Book Clear Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x79</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Sent to instruct recipients to remove all orders from the order book for the specified instrument.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>UDT</Type>
          <Size>8</Size>
          <Description>Time the message was generated.</Description>
        </Field>
        <Field>
          <Name>Source venue</Name>
          <Type>UInt16</Type>
          <Size>2</Size>
          <Description>Venue from which market data is received for the instrument.</Description>
        </Field>
        <Field>
          <Name>Instrument</Name>
          <Type>UInt64</Type>
          <Size>8</Size>
          <Description>GTP Instrument identifier.</Description>
        </Field>
        <Field>
          <Name>Order Book Type</Name>
          <Type>UInt8</Type>
          <Size>1</Size>
          <Description>Order book to be cleared.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Trade Message -->
    <Message>
      <Name>Trade Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x50</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Sent to indicate trades executed on supported markets.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>UDT</Type>
          <Size>8</Size>
          <Description>Time the message was generated.</Description>
        </Field>
        <Field>
          <Name>Transaction Time</Name>
          <Type>UDT</Type>
          <Size>8</Size>
          <Description>Execution timestamp as reported by the supported market. If a trade is cancelled or amended, this field will contain the transaction time of the original trade.</Description>
        </Field>
        <Field>
          <Name>Source venue</Name>
          <Type>UInt16</Type>
          <Size>2</Size>
          <Description>Venue from which market data is received for the instrument.</Description>
        </Field>
        <Field>
          <Name>Executed Size</Name>
          <Type>Size</Type>
          <Size>8</Size>
          <Description>Total executed quantity.</Description>
        </Field>
        <Field>
          <Name>Instrument</Name>
          <Type>UInt64</Type>
          <Size>8</Size>
          <Description>GTP Instrument identifier.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Executed price.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Trade ID</Name>
          <Type>UInt64</Type>
          <Size>8</Size>
          <Description>Unique identifier of the trade.</Description>
        </Field>
        <Field>
          <Name>Trade Type</Name>
          <Type>UInt8</Type>
          <Size>1</Size>
          <Description>Type of the trade.</Description>
        </Field>
        <Field>
          <Name>Auction Type</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>The value in this field is only relevant when Trade Type is 1.</Description>
        </Field>
        <Field>
          <Name>Trade Flags</Name>
          <Type>Bit Field</Type>
          <Size>1</Size>
          <Description>Trade cancellation and correction flags.</Description>
        </Field>
        <Field>
          <Name>Hidden Execution Indicator</Name>
          <Type>UInt8</Type>
          <Size>1</Size>
          <Description>For London Stock Exchange, during continuous trading and CPX session, 1[2] will be sent for execution of visible[hidden] quantities. For London Stock Exchange Auction Trades, 0 will be sent indicating 'Not Applicable' (N/A).</Description>
        </Field>
        <Field>
          <Name>Trade Qualifier</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Qualifier of the trade.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Statistics Message -->
    <Message>
      <Name>Statistics Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x77</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Contains a set of statistics that are updated frequently, usually as a result of executions.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>UDT</Type>
          <Size>8</Size>
          <Description>Time the message was generated.</Description>
        </Field>
        <Field>
          <Name>Instrument</Name>
          <Type>UInt64</Type>
          <Size>8</Size>
          <Description>GTP Instrument identifier.</Description>
        </Field>
        <Field>
          <Name>Source venue</Name>
          <Type>UInt16</Type>
          <Size>2</Size>
          <Description>Venue from which market data is received for the instrument.</Description>
        </Field>
        <Field>
          <Name>Volume</Name>
          <Type>Size4</Type>
          <Size>8</Size>
          <Description>Cumulative volume of all trades for the trading day.</Description>
        </Field>
        <Field>
          <Name>Volume (on-book only)</Name>
          <Type>Size4</Type>
          <Size>8</Size>
          <Description>Cumulative volume for the trading day excluding off-book trades.</Description>
        </Field>
        <Field>
          <Name>VWAP</Name>
          <Type>Price4</Type>
          <Size>8</Size>
          <Description>Volume weighted average price for the day for all trades.</Description>
        </Field>
        <Field>
          <Name>VWAP (on-book only)</Name>
          <Type>Price4</Type>
          <Size>8</Size>
          <Description>Volume weighted average price for the day excluding off-book trades.</Description>
        </Field>
        <Field>
          <Name>Number of trades</Name>
          <Type>UInt32</Type>
          <Size>4</Size>
          <Description>Count of all trades for the day.</Description>
        </Field>
        <Field>
          <Name>Number of trades (on-book only)</Name>
          <Type>UInt32</Type>
          <Size>4</Size>
          <Description>Count of trades for the day excluding off-book trades.</Description>
        </Field>
        <Field>
          <Name>Turnover</Name>
          <Type>Price4</Type>
          <Size>8</Size>
          <Description>Turnover of all trades for the day.</Description>
        </Field>
        <Field>
          <Name>Turnover (on-book only)</Name>
          <Type>Price4</Type>
          <Size>8</Size>
          <Description>Turnover for the day excluding off-book trades.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Statistics Update Message -->
    <Message>
      <Name>Statistics Update Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x6A</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Contains a set of statistics that are not updated frequently.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>UDT</Type>
          <Size>8</Size>
          <Description>Time the message was generated.</Description>
        </Field>
        <Field>
          <Name>Instrument</Name>
          <Type>UInt64</Type>
          <Size>8</Size>
          <Description>GTP Instrument identifier.</Description>
        </Field>
        <Field>
          <Name>Source venue</Name>
          <Type>UInt16</Type>
          <Size>2</Size>
          <Description>Venue from which market data is received for the instrument.</Description>
        </Field>
        <Field>
          <Name>Statistic Type</Name>
          <Type>UInt16</Type>
          <Size>2</Size>
          <Description>The statistic that is disseminated with this message instance.</Description>
        </Field>
        <Field>
          <Name>Statistic Price</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>The value of price type statistics. If the Opening or Closing Price is cleared manually by the venue, '-1' will be stamped.</Description>
        </Field>
        <Field>
          <Name>Statistic Size</Name>
          <Type>Size</Type>
          <Size>8</Size>
          <Description>The value of size type statistics.</Description>
        </Field>
        <Field>
          <Name>Auction Type</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Populated if the Statistic Type is 1.</Description>
        </Field>
        <Field>
          <Name>Imbalance Quantity</Name>
          <Type>Size</Type>
          <Size>8</Size>
          <Description>Quantity that is eligible to be matched at the indicative price but will not be matched.</Description>
        </Field>
        <Field>
          <Name>Auction Info</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Populated if the Statistic Type is 1.</Description>
        </Field>
        <Field>
          <Name>Opening/Closing Price Indicator</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Populated if the Statistic Type is 2 or 3.</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

  <Bitfields>

