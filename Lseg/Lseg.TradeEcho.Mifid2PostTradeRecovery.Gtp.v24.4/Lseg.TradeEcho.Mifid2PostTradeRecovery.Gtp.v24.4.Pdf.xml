    <!-- Mifid II Trade Report Message -->
    <Message>
      <Name>Mifid II Trade Report Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x54</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Sent to report the MiFID compliant details of a privately negotiated trade</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>UDT</Type>
          <Size>8</Size>
          <Description>Time the message was generated.</Description>
        </Field>
        <Field>
          <Name>Instrument</Name>
          <Type>UInt64</Type>
          <Size>8</Size>
          <Description>GTP Instrument Identifier. This field will be populated with 0 for Non-Exchange listed instruments.</Description>
        </Field>
        <Field>
          <Name>Transaction identification code</Name>
          <Type>Alpha</Type>
          <Size>52</Size>
          <Description>A unique trade identifier.</Description>
        </Field>
        <Field>
          <Name>Total Number of Transactions</Name>
          <Type>UInt32</Type>
          <Size>4</Size>
          <Description>Total Number of Transactions of aggregated trade</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Source venue</Name>
          <Type>UInt16</Type>
          <Size>2</Size>
          <Description>Venue from which market data is received for the instrument.</Description>
        </Field>
        <Field>
          <Name>MiFID Price</Name>
          <Type>MiFID Decimal</Type>
          <Size>20</Size>
          <Description>MiFID compliant Price field populated using either Price or Yield. Will be set to default value (20 spaces) if there is a pending price (PNDG)</Description>
        </Field>
        <Field>
          <Name>MiFID Quantity</Name>
          <Type>MiFID Decimal</Type>
          <Size>20</Size>
          <Description>Number of units of the financial instrument.  {DECIMAL-18/17}</Description>
        </Field>
        <Field>
          <Name>MiFID Trading Date and Time</Name>
          <Type>Date and Time</Type>
          <Size>27</Size>
          <Description>Date and time when the transaction was executed/ agreed upon.</Description>
        </Field>
        <Field>
          <Name>Instrument Identification Code Type</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Instrument Identification Code Type</Description>
        </Field>
        <Field>
          <Name>Instrument Identification Code</Name>
          <Type>Alpha</Type>
          <Size>12</Size>
          <Description>Instrument identification number (ISIN code).</Description>
        </Field>
        <Field>
          <Name>Price Notation</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Indicates if the price is expressed in monetary value, in percentage or yield.</Description>
        </Field>
        <Field>
          <Name>Price Currency</Name>
          <Type>Alpha</Type>
          <Size>3</Size>
          <Description>Currency Code as per ISO 4217</Description>
        </Field>
        <Field>
          <Name>Notional Amount</Name>
          <Type>MiFID Decimal</Type>
          <Size>20</Size>
          <Description>Notional value relevant to the security</Description>
        </Field>
        <Field>
          <Name>Notional Currency</Name>
          <Type>Alpha</Type>
          <Size>3</Size>
          <Description>Major currency in which the notional amount is denominated</Description>
        </Field>
        <Field>
          <Name>Venue of Execution</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Identification of the venue where the transaction was executed</Description>
        </Field>
        <Field>
          <Name>Publication Date and Time</Name>
          <Type>Date and Time</Type>
          <Size>27</Size>
          <Description>Date and time when the transaction was published</Description>
        </Field>
        <Field>
          <Name>Benchmark Transaction Flag</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Benchmark Transaction Flag</Description>
        </Field>
        <Field>
          <Name>Agency Cross Trade Flag</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Agency Cross Trade Flag</Description>
        </Field>
        <Field>
          <Name>Non Price Forming Transactions Flag</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Non Price Forming Transactions Flag</Description>
        </Field>
        <Field>
          <Name>Non Price Contribution to Discovery</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Non Price Contribution to Discovery</Description>
        </Field>
        <Field>
          <Name>Special Dividend Flag</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Special Dividend Flag</Description>
        </Field>
        <Field>
          <Name>PT Deferral Reason Flag</Name>
