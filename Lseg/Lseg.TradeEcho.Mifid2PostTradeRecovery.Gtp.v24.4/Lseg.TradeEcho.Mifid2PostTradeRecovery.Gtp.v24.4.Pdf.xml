<OmiGtpPdf>

  <Messages>

    <!-- Login Request Message -->
    <Message>
      <Name>Login Request Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x01</Code>
      <Category>Administrative</Category>
      <Origin>Firm</Origin>
      <Description>Used by the client to log in to the replay or recovery channel.</Description>
      <Fields>
        <Field>
          <Name>Username</Name>
          <Type>Alpha</Type>
          <Size>8</Size>
          <Description>CompID assigned to the client.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Recovery Request Message -->
    <Message>
      <Name>Recovery Request Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x81</Code>
      <Category>Administrative</Category>
      <Origin>Firm</Origin>
      <Description>Used by the client to request data on the recovery channel.</Description>
      <Fields>
        <Field>
          <Name>Request Level</Name>
          <Type>UInt8</Type>
          <Size>1</Size>
          <Description>Defines the level of the request.</Description>
        </Field>
        <Field>
          <Name>Instrument</Name>
          <Type>UInt64</Type>
          <Size>8</Size>
          <Description>GTP Instrument identifier if Request Level is 0. Blank if not.</Description>
        </Field>
        <Field>
          <Name>Group ID</Name>
          <Type>Alpha</Type>
          <Size>6</Size>
          <Description>Group/Segment ID if Request Level is 1. Blank if not.</Description>
        </Field>
        <Field>
          <Name>Request Order Book Type</Name>
          <Type>UInt8</Type>
          <Size>1</Size>
          <Description>Only considered if the Request Level is 0. If specified, only data related to the specified order book type is provided. If not specified, data for all available book types for the instrument are provided. For Recovery Type = 3 (Statistics) this has to be set to '0' = All.</Description>
        </Field>
        <Field>
          <Name>Source Venue</Name>
          <Type>UInt16</Type>
          <Size>2</Size>
          <Description>Venue from which market data is received for the instrument.</Description>
        </Field>
        <Field>
          <Name>Recovery Type</Name>
          <Type>UInt8</Type>
          <Size>1</Size>
          <Description>The type of messages to be replayed.</Description>
        </Field>
        <Field>
          <Name>Sequence Number</Name>
          <Type>UInt32</Type>
          <Size>4</Size>
          <Description>Only valid if Recovery Type = 2 (Trades). If specified, the trades reported with an equal or higher sequence number will be sent.</Description>
        </Field>
        <Field>
          <Name>Request ID</Name>
          <Type>UInt32</Type>
          <Size>4</Size>
          <Description>The value set in this will be echoed back in the corresponding Recovery Response and Recovery Complete. The system will not validate uniqueness of the set value.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Login Response Message -->
    <Message>
      <Name>Login Response Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x02</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>Used by the server to accept or reject a login request to the replay or recovery channel.</Description>
      <Fields>
        <Field>
          <Name>Login Status</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Status of the login request.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Recovery Response Message -->
    <Message>
      <Name>Recovery Response Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x82</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>Used by the server to respond to a snapshot request on the recovery channel.</Description>
      <Fields>
        <Field>
          <Name>Sequence Number</Name>
          <Type>UInt32</Type>
          <Size>4</Size>
          <Description>Sequence number on the real-time channel with which the snapshot is synchronised when Recovery Type = 1, 2, 3, 4. This will be zero for other Recovery Types or if Status is not 'A'.</Description>
        </Field>
        <Field>
          <Name>Count</Name>
          <Type>UInt32</Type>
          <Size>4</Size>
          <Description>Number of messages to follow, not including any Replay and Recovery Complete messages. This will be zero if Status is not 'A'.</Description>
        </Field>
        <Field>
          <Name>Recovery Status</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Status of the recovery request.</Description>
        </Field>
        <Field>
          <Name>Request ID</Name>
          <Type>UInt32</Type>
          <Size>4</Size>
          <Description>Will include the value set as Request ID in the Recovery Request message.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Replay and Recovery Complete Message -->
    <Message>
      <Name>Replay and Recovery Complete Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x83</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>Used by the server to indicate the successful completion of servicing a message replay or a recovery request.</Description>
      <Fields>
        <Field>
          <Name>Request ID</Name>
          <Type>UInt32</Type>
          <Size>4</Size>
          <Description>Will include the value set as Request ID in the Recovery Request message.</Description>
        </Field>
        <Field>
          <Name>Trading Status</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Current Trading status of the Instrument. Populated only when the message is sent at the end of individual order book snapshots during a trading session.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- System Event Message -->
    <Message>
      <Name>System Event Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x53</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Session transition is advertised via one system event message for all instruments allocated to the same multicast channel</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>UDT</Type>
          <Size>8</Size>
          <Description>Time the message was generated</Description>
        </Field>
        <Field>
          <Name>Event Code</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Session transition event.</Description>
        </Field>
        <Field>
          <Name>Source Venue</Name>
          <Type>UInt16</Type>
          <Size>2</Size>
          <Description>Venue from which market data is received for the instrument</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Instrument Directory Message -->
    <Message>
      <Name>Instrument Directory Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x70</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Used to disseminate a common and limited set of data for all configured instrument types (except strategy instruments) on the real time channels</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>UDT</Type>
          <Size>8</Size>
          <Description>Time the message was generated</Description>
        </Field>
        <Field>
          <Name>Instrument</Name>
          <Type>UInt64</Type>
          <Size>8</Size>
          <Description>GTP Instrument identifier.</Description>
        </Field>
        <Field>
          <Name>ISIN</Name>
          <Type>Alpha</Type>
          <Size>12</Size>
          <Description>ISIN Code of an instrument.</Description>
        </Field>
        <Field>
          <Name>Allowed Book Types</Name>
          <Type>Bit Field</Type>
          <Size>1</Size>
          <Description>Defines the order-book types that are allowed for the instrument. Each designated bit represents a book type. '0' means not allowed and '1' means allowed:</Description>
        </Field>
        <Field>
          <Name>Source Venue</Name>
          <Type>UInt16</Type>
          <Size>2</Size>
          <Description>Venue from which market data is received for the instrument.</Description>
        </Field>
        <Field>
          <Name>Venue Instrument ID</Name>
          <Type>Alpha</Type>
          <Size>11</Size>
          <Description>Instrument identifier used by the source venue.</Description>
        </Field>
        <Field>
          <Name>Tick ID</Name>
          <Type>Alpha</Type>
          <Size>2</Size>
          <Description>Not Applicable to TRADEcho</Description>
        </Field>
        <Field>
          <Name>Price Band Tolerances (%)</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Not Applicable to TRADEcho</Description>
        </Field>
        <Field>
          <Name>Dynamic Circuit Breaker Tolerances (%)</Name>
