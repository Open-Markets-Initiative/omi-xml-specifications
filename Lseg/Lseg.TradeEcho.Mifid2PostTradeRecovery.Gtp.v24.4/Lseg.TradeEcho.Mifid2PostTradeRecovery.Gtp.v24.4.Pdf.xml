          <Size>8</Size>
          <Description>Not Applicable to TRADEcho</Description>
        </Field>
        <Field>
          <Name>Static Circuit Breaker Tolerances (%)</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Not Applicable to TRADEcho</Description>
        </Field>
        <Field>
          <Name>Segment</Name>
          <Type>Alpha</Type>
          <Size>6</Size>
          <Description>Segment the instrument is assigned to.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Alpha</Type>
          <Size>12</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Alpha</Type>
          <Size>11</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Currency</Name>
          <Type>Alpha</Type>
          <Size>3</Size>
          <Description>Currency Code as per ISO 4217.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Average Daily Turnover</Name>
          <Type>Price4</Type>
          <Size>8</Size>
          <Description>Average Daily Turnover as reported by the Source Venue.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Alpha</Type>
          <Size>8</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>UInt8</Type>
          <Size>1</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Reserved for future use.</Description>
        </Field>
      </Fields>
    </Message>

