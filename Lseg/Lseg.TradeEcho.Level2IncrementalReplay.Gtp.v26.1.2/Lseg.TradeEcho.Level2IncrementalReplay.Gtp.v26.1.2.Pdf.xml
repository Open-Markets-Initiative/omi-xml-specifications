    <!-- Event Code -->
    <Enum>
      <Name>Event Code</Name>
      <Values>
        <Value>
          <Data>O</Data>
          <Name>Start of Day</Name>
        </Value>
        <Value>
          <Data>T</Data>
          <Name>Start of Open</Name>
        </Value>
        <Value>
          <Data>P</Data>
          <Name>Start of Pre Close</Name>
        </Value>
        <Value>
          <Data>C</Data>
          <Name>End of Day</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Source Venue -->
    <Enum>
      <Name>Source Venue</Name>
      <Values>
        <Value>
          <Data>11</Data>
          <Name>TRADEcho</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Trading Status -->
    <Enum>
      <Name>Trading Status</Name>
      <Values>
        <Value>
          <Data>1</Data>
          <Name>Inactive</Name>
        </Value>
        <Value>
          <Data>2</Data>
          <Name>Suspended</Name>
        </Value>
        <Value>
          <Data>3</Data>
          <Name>Active</Name>
        </Value>
        <Value>
          <Data>P</Data>
          <Name>Regulatory Halt</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Session Change Reason -->
    <Enum>
      <Name>Session Change Reason</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>Scheduled Transition</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Order Book Type -->
    <Enum>
      <Name>Order Book Type</Name>
      <Values>
        <Value>
          <Data>1</Data>
          <Name>SI Quote Book</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Side -->
    <Enum>
      <Name>Side</Name>
      <Values>
        <Value>
          <Data>B</Data>
          <Name>Buy Order</Name>
        </Value>
        <Value>
          <Data>S</Data>
          <Name>Sell Order</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Order Type -->
    <Enum>
      <Name>Order Type</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>SI Quote</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiGtpPdf>

