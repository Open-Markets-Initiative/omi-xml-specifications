<OmiMitchPdf>

  <!-- Lseg Millennium Level2 Recovery Mitch v11.9 -->

  <Messages>

    <!-- Login Request Message -->
    <Message>
      <Name>Login Request Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x01</Code>
      <Category>Administrative</Category>
      <Origin>Firm</Origin>
      <Description>Used by the client to log in to the recovery channel.</Description>
      <Fields>
        <Field>
          <Name>Username</Name>
          <Type>Alpha</Type>
          <Size>6</Size>
          <Description>CompID assigned to the client.</Description>
        </Field>
        <Field>
          <Name>Password</Name>
          <Type>Alpha</Type>
          <Size>10</Size>
          <Description>Password assigned to the CompID.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Login Response Message -->
    <Message>
      <Name>Login Response Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x02</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>Used by the server to accept or reject a login request.</Description>
      <Fields>
        <Field>
          <Name>Login Status</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Status of the login request.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Snapshot Request Message -->
    <Message>
      <Name>Snapshot Request Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x81</Code>
      <Category>Administrative</Category>
      <Origin>Firm</Origin>
      <Description>Used by the client to request a snapshot of the order book for a segment or an instrument.</Description>
      <Fields>
        <Field>
          <Name>Sequence Number</Name>
          <Type>UInt32</Type>
          <Size>4</Size>
          <Description>Sequence number from which client can build the order book, only required for instrument level requests.</Description>
        </Field>
        <Field>
          <Name>Segment</Name>
          <Type>Alpha</Type>
          <Size>6</Size>
          <Description>Segment the request relates to. The field should contain only spaces if the Instrument ID field is populated.</Description>
        </Field>
        <Field>
          <Name>Instrument ID</Name>
          <Type>UInt32</Type>
          <Size>4</Size>
          <Description>Instrument the request relates to. The field should contain only zeros if it does not relate to an instrument.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Snapshot Response Message -->
    <Message>
      <Name>Snapshot Response Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x82</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>Used by the server to accept or reject a snapshot request.</Description>
      <Fields>
        <Field>
          <Name>Sequence Number</Name>
          <Type>UInt32</Type>
          <Size>4</Size>
          <Description>This field will always be populated with 0.</Description>
        </Field>
        <Field>
          <Name>Order Count</Name>
          <Type>UInt32</Type>
          <Size>4</Size>
          <Description>This field will always be populated with 0.</Description>
        </Field>
        <Field>
          <Name>Snapshot Status</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Status of the snapshot request.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Snapshot Complete Message -->
    <Message>
      <Name>Snapshot Complete Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x83</Code>
      <Category>Administrative</Category>
      <Origin>Exchange</Origin>
      <Description>Sent once the details of all active orders of an order book, or of every instrument in a segment, are disseminated.</Description>
      <Fields>
        <Field>
          <Name>Sequence Number</Name>
          <Type>UInt32</Type>
          <Size>4</Size>
          <Description>Sequence number with which the snapshot is synchronised: the sequence number of the last message recovered.</Description>
        </Field>
        <Field>
          <Name>Segment</Name>
          <Type>Alpha</Type>
          <Size>6</Size>
          <Description>Segment the snapshot relates to. The field will contain only spaces if it does not relate to a segment.</Description>
        </Field>
        <Field>
          <Name>Instrument ID</Name>
          <Type>UInt32</Type>
          <Size>4</Size>
          <Description>Instrument the snapshot relates to. The field will contain zero if the snapshot does not relate to an instrument.</Description>
        </Field>
        <Field>
          <Name>Snapshot Complete Flags</Name>
          <Type>Bit Field</Type>
          <Size>1</Size>
          <Description>Whether the snapshot was of the order book or a quote book. The field will contain 0 for the order book.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Logout Request Message -->
    <Message>
      <Name>Logout Request Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x05</Code>
      <Category>Administrative</Category>
      <Origin>Firm</Origin>
      <Description>Used by the client to log out of the recovery channel.</Description>
      <Fields>
      </Fields>
    </Message>

    <!-- Symbol Status Message -->
    <Message>
      <Name>Symbol Status Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x48</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Indicates the trading session (pre-opening, regular trading, etc.) that currently applies to an instrument.</Description>
      <Fields>
        <Field>
          <Name>Nanosecond</Name>
          <Type>UInt32</Type>
          <Size>4</Size>
          <Description>Nanoseconds since last Time message, accurate to the nearest microsecond.</Description>
        </Field>
        <Field>
          <Name>Instrument ID</Name>
          <Type>UInt32</Type>
          <Size>4</Size>
          <Description>Instrument's symbol.</Description>
        </Field>
        <Field>
          <Name>Reserved A</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Reserved field</Description>
        </Field>
        <Field>
          <Name>Reserved B</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Reserved field</Description>
        </Field>
        <Field>
          <Name>Trading Status</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Trading Status</Description>
        </Field>
        <Field>
          <Name>Symbol Status Flags</Name>
          <Type>Bit Field</Type>
          <Size>1</Size>
          <Description>Symbol Status Flags</Description>
        </Field>
        <Field>
          <Name>Reason</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Reason for the manual session change or the trading halt.</Description>
        </Field>
        <Field>
          <Name>Session Change Reason</Name>
          <Type>UInt8</Type>
          <Size>1</Size>
          <Description>Session Change Reason</Description>
        </Field>
        <Field>
          <Name>New End Time</Name>
          <Type>Time</Type>
          <Size>8</Size>
          <Description>New time the session will end. Will only be stamped if the session change was not in the original schedule e.g. AESP auction call or unscheduled session.</Description>
        </Field>
        <Field>
          <Name>Book type</Name>
          <Type>UInt8</Type>
          <Size>1</Size>
          <Description>Book Type</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Add Order Message -->
    <Message>
      <Name>Add Order Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x41</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Sent to indicate that an anonymous limit or market order is added to the order book.</Description>
      <Fields>
        <Field>
          <Name>Nanosecond</Name>
          <Type>UInt32</Type>
          <Size>4</Size>
          <Description>Nanoseconds since last Time message, accurate to the nearest microsecond.</Description>
        </Field>
        <Field>
          <Name>Order ID</Name>
          <Type>UInt64</Type>
          <Size>8</Size>
          <Description>Unique identifier of the order.</Description>
        </Field>
        <Field>
          <Name>Side</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Side</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>UInt32</Type>
          <Size>4</Size>
          <Description>Displayed quantity of the order.</Description>
        </Field>
        <Field>
          <Name>Instrument ID</Name>
          <Type>UInt32</Type>
          <Size>4</Size>
          <Description>Instrument identifier</Description>
        </Field>
        <Field>
          <Name>Reserved A</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Reserved field</Description>
        </Field>
        <Field>
          <Name>Reserved B</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Reserved field</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Limit price of the order.</Description>
        </Field>
        <Field>
          <Name>Add Order Flags</Name>
          <Type>Bit Field</Type>
          <Size>1</Size>
          <Description>Flags</Description>
        </Field>
        <Field>
          <Name>Reserved</Name>
          <Type>Alpha</Type>
          <Size>10</Size>
          <Description>Reserved field</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Add Attributed Order Message -->
    <Message>
      <Name>Add Attributed Order Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x46</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Indicates that a named order is added to the order book.</Description>
      <Fields>
        <Field>
          <Name>Nanosecond</Name>
          <Type>UInt32</Type>
          <Size>4</Size>
          <Description>Nanoseconds since last message, accurate to the nearest microsecond</Description>
        </Field>
        <Field>
          <Name>Order ID</Name>
          <Type>UInt64</Type>
          <Size>8</Size>
          <Description>Unique identifier of the order.</Description>
        </Field>
        <Field>
          <Name>Side</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Side</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>UInt32</Type>
          <Size>4</Size>
          <Description>Displayed quantity of the order.</Description>
        </Field>
        <Field>
          <Name>Instrument ID</Name>
          <Type>UInt32</Type>
          <Size>4</Size>
          <Description>Instrument identifier</Description>
        </Field>
        <Field>
          <Name>Reserved A</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Reserved field</Description>
        </Field>
        <Field>
          <Name>Reserved B</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Reserved field</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Limit price of the order.</Description>
        </Field>
        <Field>
          <Name>Attribution</Name>
          <Type>Alpha</Type>
          <Size>11</Size>
          <Description>Identity of firm that submitted the order.</Description>
        </Field>
        <Field>
          <Name>Add Attributed Order Flags</Name>
          <Type>Bit Field</Type>
          <Size>1</Size>
          <Description>Flags</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

