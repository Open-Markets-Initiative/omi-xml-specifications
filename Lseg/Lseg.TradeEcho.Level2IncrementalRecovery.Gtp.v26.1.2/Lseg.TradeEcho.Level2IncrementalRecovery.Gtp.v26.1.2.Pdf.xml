    <!-- Order Book Type -->
    <Enum>
      <Name>Order Book Type</Name>
      <Values>
        <Value>
          <Data>1</Data>
          <Name>SI Quote Book</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Side -->
    <Enum>
      <Name>Side</Name>
      <Values>
        <Value>
          <Data>B</Data>
          <Name>Buy Order</Name>
        </Value>
        <Value>
          <Data>S</Data>
          <Name>Sell Order</Name>
        </Value>
      </Values>
    </Enum>

    <!-- Order Type -->
    <Enum>
      <Name>Order Type</Name>
      <Values>
        <Value>
          <Data>0</Data>
          <Name>SI Quote</Name>
        </Value>
      </Values>
    </Enum>

  </Enums>

</OmiGtpPdf>

