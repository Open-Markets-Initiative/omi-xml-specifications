    <!-- Mifid II Order Book Update Message -->
    <Message>
      <Name>Mifid II Order Book Update Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x62</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Aggregated order book price level update published on the MiFID II Pre Trade service</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>UDT</Type>
          <Size>8</Size>
          <Description>Time the message was generated</Description>
        </Field>
        <Field>
          <Name>Instrument</Name>
          <Type>UInt64</Type>
          <Size>8</Size>
          <Description>GTP Instrument identifier</Description>
        </Field>
        <Field>
          <Name>Source venue</Name>
          <Type>UInt16</Type>
          <Size>2</Size>
          <Description>Venue from which market data is received for the instrument.</Description>
        </Field>
        <Field>
          <Name>Level Identifier</Name>
          <Type>UInt8</Type>
          <Size>1</Size>
          <Description>For continuous trading, position of the price point in the order book. For periodic auction, this will be set to the default value.</Description>
        </Field>
        <Field>
          <Name>Update Date and Time</Name>
          <Type>MiFID Date and Time</Type>
          <Size>30</Size>
          <Description>For continuous trading, the date and time when the aggregated bid or offer price or volume was calculated following the receipt of an order for execution, cancellation, or modification into the trading system. For periodic auction, the date and time at which the price would best satisfy the trading algorithm.</Description>
        </Field>
        <Field>
          <Name>Instrument Identification Code</Name>
          <Type>Alpha</Type>
          <Size>12</Size>
          <Description>Code used to identify the financial instrument (ISIN code)</Description>
        </Field>
        <Field>
          <Name>Order Book Side</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>For continuous trading, the side corresponding to the price level in the order book. For periodic auction trading system, this will be set to the default value.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>MiFID Decimal</Type>
          <Size>20</Size>
          <Description>For continuous trading, a price of orders aggregated at a given price level. For periodic auctions, the price at which the auction trading system would best satisfy its trading algorithm. Will be set to 0 (zero) when the order book is cleared or the indicative auction price is reset.</Description>
        </Field>
        <Field>
          <Name>Price Currency</Name>
          <Type>Alpha</Type>
          <Size>3</Size>
          <Description>Major currency unit in which the price is expressed</Description>
        </Field>
        <Field>
          <Name>Price Notation</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Indicates the notation in which the price is expressed</Description>
        </Field>
        <Field>
          <Name>Quantity</Name>
          <Type>MiFID Decimal</Type>
          <Size>20</Size>
          <Description>For continuous trading, number of units of the financial instruments aggregated on the price level. For periodic auction, the aggregated quantity attached to the price that would best satisfy the trading algorithm. Will be set to 0 (zero) when the order book is cleared or the indicative auction price is reset.</Description>
        </Field>
        <Field>
          <Name>Aggregated no of orders and quotes</Name>
          <Type>MiFID Decimal</Type>
          <Size>20</Size>
          <Description>For continuous trading, the number of orders aggregated at a given price level. For periodic auction and empty side during continuous trading, this will be set to 0 (zero)</Description>
        </Field>
        <Field>
          <Name>Venue</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Identification of the trading venue through the system of which orders are advertised. In accordance with ISO 10383 segment MIC or, where the segment MIC does not exist, the operating MIC</Description>
        </Field>
        <Field>
          <Name>Trading System</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Type of trading system where the order is advertised</Description>
        </Field>
        <Field>
          <Name>Trading system phase</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Type of trading system phase where the order is advertised</Description>
        </Field>
        <Field>
          <Name>Publication Date and Time</Name>
          <Type>MiFID Date and Time</Type>
          <Size>30</Size>
          <Description>Date and time when the information was published by the trading venue.</Description>
        </Field>
        <Field>
          <Name>Order Book Update</Name>
          <Type>Bit Field</Type>
          <Size>1</Size>
          <Description>The position of the price level within the order book. This field should be ignored if the message is disseminated through the recovery service.</Description>
        </Field>
      </Fields>
    </Message>

  </Messages>

