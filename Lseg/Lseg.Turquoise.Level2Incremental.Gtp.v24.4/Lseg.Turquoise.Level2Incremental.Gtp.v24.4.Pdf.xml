<OmiGtpPdf>

  <Messages>
    
    <!-- System Event Message -->
    <Message>
      <Name>System Event Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x53</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Sent to indicate the start and end of the day.</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>UDT</Type>
          <Size>8</Size>
          <Description>Time the message was generated.</Description>
        </Field>
        <Field>
          <Name>Event Code</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Event Code</Description>
        </Field>
        <Field>
          <Name>Source Venue</Name>
          <Type>UInt16</Type>
          <Size>2</Size>
          <Description>Venue from which market data is received for the instrument</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Instrument Directory Message -->
    <Message>
      <Name>Instrument Directory Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x70 </Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Used to disseminate a common and limited set of data for all configured instrument types, except strategy instruments, on the real-time channels</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>UDT</Type>
          <Size>8</Size>
          <Description>Time the message was generated.</Description>
        </Field>
        <Field>
          <Name>Instrument</Name>
          <Type>UInt64</Type>
          <Size>8</Size>
          <Description>GTP Instrument identifier.</Description>
        </Field>
        <Field>
          <Name>ISIN</Name>
          <Type>Alpha</Type>
          <Size>12</Size>
          <Description>ISIN Code of an instrument.</Description>
        </Field>
        <Field>
          <Name>Allowed Book Types</Name>
          <Type>Bit Field</Type>
          <Size>1</Size>
          <Description>Defines the order-book types that are allowed for the instrument. Each designated bit represents a book type. '0' means not allowed and '1' means allowed:</Description>
        </Field>
        <Field>
          <Name>Source Venue</Name>
          <Type>UInt16</Type>
          <Size>2</Size>
          <Description>Venue from which market data is received for the instrument.</Description>
        </Field>
        <Field>
          <Name>Venue Instrument ID</Name>
          <Type>Alpha</Type>
          <Size>11</Size>
          <Description>MTF symbol used by the source venue. It will contain the suffixes as specified in the table below:</Description>
        </Field>
        <Field>
          <Name>Tick ID</Name>
          <Type>Alpha</Type>
          <Size>2</Size>
          <Description>The tick structure applicable for the instrument.</Description>
        </Field>
        <Field>
          <Name>Price Band Tolerances</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Price Band Tolerance (%) of the instrument.</Description>
        </Field>
        <Field>
          <Name>Dynamic Circuit Breaker Tolerances</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Dynamic Circuit Breaker Tolerance (%) of the instrument.</Description>
        </Field>
        <Field>
          <Name>Static Circuit Breaker Tolerances</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Static Circuit Breaker Tolerance (%) of the instrument.</Description>
        </Field>
        <Field>
          <Name>Segment</Name>
          <Type>Alpha</Type>
          <Size>6</Size>
          <Description>Segment the instrument is assigned to.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Alpha</Type>
          <Size>12</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Alpha</Type>
          <Size>11</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Currency</Name>
          <Type>Alpha</Type>
          <Size>3</Size>
          <Description>Currency Code as per ISO 4217.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Alpha</Type>
          <Size>4</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Average Daily Turnover (ADT)</Name>
          <Type>Price4</Type>
          <Size>8</Size>
          <Description>Not Applicable to Turquoise.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Alpha</Type>
          <Size>8</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>UInt8</Type>
          <Size>1</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Reserved for future use.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Reserved for future use.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Instrument Status Message -->
    <Message>
      <Name>Instrument Status Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x48</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Used to communicate scheduled and unscheduled session changes</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>UDT</Type>
          <Size>8</Size>
          <Description>Time the message was generated.</Description>
        </Field>
        <Field>
          <Name>Instrument</Name>
          <Type>UInt64</Type>
          <Size>8</Size>
          <Description>GTP Instrument identifier.</Description>
        </Field>
        <Field>
          <Name>Source venue</Name>
          <Type>UInt16</Type>
          <Size>2</Size>
          <Description>Venue from which market data is received for the instrument.</Description>
        </Field>
        <Field>
          <Name>Trading Status</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Current trading status of the instrument.</Description>
        </Field>
        <Field>
          <Name>Session Change Reason</Name>
          <Type>UInt8</Type>
          <Size>1</Size>
          <Description>Reason the trading session changed.</Description>
        </Field>
        <Field>
          <Name>New End Time</Name>
          <Type>Time</Type>
          <Size>6</Size>
          <Description>New time the session will end. The field will contain only spaces if Session Change Reason is "0" or the Session Change Reason is not present. New End Time will be in terms of the local time on the server (i.e., not UTC).</Description>
        </Field>
        <Field>
          <Name>Order Book Type</Name>
          <Type>UInt8</Type>
          <Size>1</Size>
          <Description>Order book the status applies to.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Add Order Incremental Message -->
    <Message>
      <Name>Add Order Incremental Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x46</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Sent to instruct recipients to add a new displayable order to the retrospective order book</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>UDT</Type>
          <Size>8</Size>
          <Description>Time the message was generated.</Description>
        </Field>
        <Field>
          <Name>Order ID</Name>
          <Type>UInt64</Type>
          <Size>8</Size>
          <Description>Unique identifier of the order.</Description>
        </Field>
        <Field>
          <Name>Side</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Side</Description>
        </Field>
        <Field>
          <Name>Size</Name>
          <Type>Size</Type>
          <Size>8</Size>
          <Description>Displayed Size of the order.</Description>
        </Field>
        <Field>
          <Name>Instrument</Name>
          <Type>UInt64</Type>
          <Size>8</Size>
          <Description>GTP Instrument identifier.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Limit price of the order</Description>
        </Field>
        <Field>
          <Name>Transaction Time</Name>
          <Type>UDT</Type>
          <Size>8</Size>
          <Description>Transaction execution timestamp as reported by the upstream system</Description>
        </Field>
        <Field>
          <Name>Source venue</Name>
          <Type>UInt16</Type>
          <Size>2</Size>
          <Description>Source venue</Description>
        </Field>
        <Field>
          <Name>Order Book Type</Name>
          <Type>UInt8</Type>
          <Size>1</Size>
          <Description>Order book the order rests on.</Description>
        </Field>
        <Field>
          <Name>Participant</Name>
          <Type>Alpha</Type>
          <Size>11</Size>
          <Description>Not Applicable to Turquoise</Description>
        </Field>
        <Field>
          <Name>Order Type</Name>
          <Type>UInt8</Type>
          <Size>1</Size>
          <Description>Type of the order.</Description>
        </Field>
        <Field>
          <Name>RFQ ID</Name>
          <Type>Alpha</Type>
          <Size>10</Size>
          <Description>Not Applicable to Turquoise.</Description>
        </Field>
      </Fields>
    </Message>

    <!-- Order Modify Message -->
    <Message>
      <Name>Order Modify Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x55</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Sent to instruct recipients to update an order's price and/or size on the retrospective order book</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>UDT</Type>
          <Size>8</Size>
          <Description>Time the message was generated.</Description>
        </Field>
        <Field>
          <Name>Order ID</Name>
          <Type>UInt64</Type>
          <Size>8</Size>
          <Description>Unique identifier of the order.</Description>
        </Field>
        <Field>
          <Name>Instrument</Name>
          <Type>UInt64</Type>
          <Size>8</Size>
          <Description>GTP Instrument identifier.</Description>
        </Field>
        <Field>
          <Name>Side</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Side</Description>
        </Field>
        <Field>
          <Name>Order Modify Flags</Name>
          <Type>Bit Field</Type>
          <Size>1</Size>
          <Description>Order Modify Flags</Description>
        </Field>
        <Field>
          <Name>Order Book Type</Name>
          <Type>UInt8</Type>
          <Size>1</Size>
          <Description>Order book the order rests on.</Description>
        </Field>
        <Field>
          <Name>New Quantity</Name>
          <Type>Size</Type>
          <Size>8</Size>
          <Description>New displayed quantity of the order.</Description>
        </Field>
        <Field>
          <Name>New Price</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>New price of the order.</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Reserved for future use</Description>
        </Field>
        <Field>
          <Name>Source venue</Name>
          <Type>UInt16</Type>
          <Size>2</Size>
          <Description>Please refer to the Additional Field Values section for valid values.</Description>
        </Field>
        <Field>
          <Name>Previous Price</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Previous price of the order.</Description>
        </Field>
        <Field>
          <Name>Previous Quantity</Name>
          <Type>Size</Type>
          <Size>8</Size>
          <Description>Previous displayed quantity of the order.</Description>
        </Field>
        <Field>
          <Name>Transaction Time</Name>
          <Type>UDT</Type>
          <Size>8</Size>
          <Description>Transaction execution timestamp as reported by the upstream system</Description>
        </Field>
      </Fields>
    </Message>

