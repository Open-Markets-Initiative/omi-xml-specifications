        </Field>
        <Field>
          <Name>Side</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>The side of the visible passive order(s) that triggered the trade summary.</Description>
        </Field>
        <Field>
          <Name>Best Bid Size</Name>
          <Type>Int Size</Type>
          <Size>8</Size>
          <Description>Aggregated size of all orders at the best buy price available on the book at execution completion</Description>
        </Field>
        <Field>
          <Name>Best Bid Price</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Price of best visible bid available on the book at execution completion</Description>
        </Field>
        <Field>
          <Name>Best Offer Size</Name>
          <Type>Int Size</Type>
          <Size>8</Size>
          <Description>Aggregated size of all orders at the best sell price available on the book at execution completion</Description>
        </Field>
        <Field>
          <Name>Best Offer Price</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Price of best visible bid available on the book at execution completion</Description>
        </Field>
      </Fields>
