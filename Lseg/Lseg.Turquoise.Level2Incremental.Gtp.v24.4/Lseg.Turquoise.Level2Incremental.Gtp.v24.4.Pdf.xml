    <!-- Trade Message -->
    <Message>
      <Name>Trade Message</Name>
      <Branch>payload</Branch>
      <Dependency>messagetype</Dependency>
      <Code>0x50</Code>
      <Category>Application</Category>
      <Origin>Exchange</Origin>
      <Description>Sent to indicate trades executed on supported markets</Description>
      <Fields>
        <Field>
          <Name>Timestamp</Name>
          <Type>UDT</Type>
          <Size>8</Size>
          <Description>Time the message was generated.</Description>
        </Field>
        <Field>
          <Name>Transaction Time</Name>
          <Type>UDT</Type>
          <Size>8</Size>
          <Description>Execution timestamp as reported by the supported market.</Description>
        </Field>
        <Field>
          <Name>Source venue</Name>
          <Type>UInt16</Type>
          <Size>2</Size>
          <Description>Venue from which market data is received for the instrument.</Description>
        </Field>
        <Field>
          <Name>Executed Size</Name>
          <Type>Size</Type>
          <Size>8</Size>
          <Description>Total executed quantity.</Description>
        </Field>
        <Field>
          <Name>Instrument</Name>
          <Type>UInt64</Type>
          <Size>8</Size>
          <Description>GTP Instrument identifier.</Description>
        </Field>
        <Field>
          <Name>Price</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Executed price</Description>
        </Field>
        <Field>
          <Name>Reserved Field</Name>
          <Type>Price</Type>
          <Size>8</Size>
          <Description>Reserved for future use</Description>
        </Field>
        <Field>
          <Name>Trade ID</Name>
          <Type>UInt64</Type>
          <Size>8</Size>
          <Description>Unique identifier of the trade.</Description>
        </Field>
        <Field>
          <Name>Trade Type</Name>
          <Type>UInt8</Type>
          <Size>1</Size>
          <Description>Type of the trade.</Description>
        </Field>
        <Field>
          <Name>Auction Type</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Not Applicable to Turquoise</Description>
        </Field>
        <Field>
          <Name>Trade Flags</Name>
          <Type>Bit Field</Type>
          <Size>1</Size>
          <Description>Trade Flags</Description>
        </Field>
        <Field>
          <Name>Hidden Execution Indicator</Name>
          <Type>UInt8</Type>
          <Size>1</Size>
          <Description>For Turquoise Lit Order Book, 1[2] will be sent for execution of visible[hidden] quantities. For Turquoise Plato Order Book, it will always be set to 2 (Hidden).</Description>
        </Field>
        <Field>
          <Name>Trade Qualifier</Name>
          <Type>Byte</Type>
          <Size>1</Size>
          <Description>Qualifier of the trade.</Description>
        </Field>
      </Fields>
    </Message>

